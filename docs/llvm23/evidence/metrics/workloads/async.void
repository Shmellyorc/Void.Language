use io
use convert
async func entry(n: i32) -> i32:
    var total: i32 = 0
    for index in 0..<n:
        convert.unwrap(await io.write_bytes_async("async-bench.bin", [1, 2, 3, 4]))
        var bytes = convert.unwrap(await io.read_bytes_async("async-bench.bin"))
        total += (bytes.count as i32) + (bytes[2] as i32)
    convert.unwrap(await io.remove_file_async("async-bench.bin"))
    return total
