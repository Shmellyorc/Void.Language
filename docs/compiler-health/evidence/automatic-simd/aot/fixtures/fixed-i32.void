func entry(n: i32) -> i32:
    var a: [i32, 1025]
    var b: [i32, 1025]
    var out: [i32, 1025]
    for i in 0..n:
        a[i] = (i % 31) as i32
        b[i] = (i % 7) as i32
    for i in 1..n:
        out[i] = a[i] * 3 + b[i]
    for i in 1..n:
        var expected: i32 = ((i % 31) as i32) * 3 + ((i % 7) as i32)
        if out[i] != expected:
            return 2
    return 1
