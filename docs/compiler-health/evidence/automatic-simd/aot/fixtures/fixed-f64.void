func entry(n: i32) -> i32:
    var a: [f64, 1025]
    var b: [f64, 1025]
    var out: [f64, 1025]
    for i in 0..n:
        a[i] = (i % 31) as f64
        b[i] = (i % 7) as f64
    for i in 1..n:
        out[i] = a[i] * 3 + b[i]
    for i in 1..n:
        var expected: f64 = ((i % 31) as f64) * 3 + ((i % 7) as f64)
        if out[i] != expected:
            return 2
    return 1
