func entry(n: i32) -> i32:
    var a: [i32] = []
    var b: [i32] = []
    var out: [i32] = []
    for i in 0..n:
        a.push((i % 31) as i32)
        b.push((i % 7) as i32)
        out.push(0)
    for i in 1..n:
        out[i] = a[i] * 3 + b[i]
    for i in 1..n:
        var expected: i32 = ((i % 31) as i32) * 3 + ((i % 7) as i32)
        if out[i] != expected:
            return 2
    return 1
