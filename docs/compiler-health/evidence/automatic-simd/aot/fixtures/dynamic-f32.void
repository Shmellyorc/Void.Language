func entry(n: i32) -> i32:
    var a: [f32] = []
    var b: [f32] = []
    var out: [f32] = []
    for i in 0..n:
        a.push((i % 31) as f32)
        b.push((i % 7) as f32)
        out.push(0)
    for i in 1..n:
        out[i] = a[i] * 3 + b[i]
    for i in 1..n:
        var expected: f32 = ((i % 31) as f32) * 3 + ((i % 7) as f32)
        if out[i] != expected:
            return 2
    return 1
