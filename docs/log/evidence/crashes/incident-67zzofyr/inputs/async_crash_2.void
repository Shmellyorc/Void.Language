use log
use convert
use io

async func exercise() -> result<i32, log.failure>:
    var options = log.config(timestamps = false, console = log.console_sink.none,
        file_path = "async 雪 %.log", rotation_bytes = 64, max_record_bytes = 64, backups = 3)
    for index in 0..3:
        var value = "async 雪 %.log"
        if index > 0:
            value = "{value}.{index}"
        convert.unwrap(await io.remove_file_async(value, true))
    var instance = (await log.open_async(options))?
    with instance as owned:
        var first = owned.write_async(log.level.info, "first")
        var second = owned.write_async(log.level.info, "must be busy")
        var filtered = owned.write_async(log.level.debug, "filtered while busy")
        var closing = owned.close_async()
        var configuring = owned.configure_async(options)
        var delivered = (await first)?
        var busy = await second
        if busy is Err(var problem):
            if not (problem.kind is log.failure_kind.busy):
                return Ok(3)
        else:
            return Ok(4)
        if (await filtered)?:
            return Ok(5)
        if await closing is Err(var problem):
            if not (problem.kind is log.failure_kind.busy):
                return Ok(6)
        else:
            return Ok(8)
        if await configuring is Err(var problem):
            if not (problem.kind is log.failure_kind.busy):
                return Ok(9)
        else:
            return Ok(10)
        var pending = owned.write_async(log.level.debug, "body-time configuration")
        options.minimum = log.level.trace
        var changed = owned.configure(options)?
        if not (await pending)?:
            return Ok(11)
        for index in 0..<20:
            var sent = (await owned.write_async(log.level.info, "record {index:00}"))?
            if not sent:
                return Ok(1)
        var flushed = (await owned.flush_async())?
        options.backups = 1
        var configured = (await owned.configure_async(options))?
        var sent = (await owned.write_async(log.level.warn, "last"))?
        var closed = (await owned.close_async())?
        var again = (await owned.close_async())?
    var shutdown_before = (await log.shutdown_async())?
    var replacing = log.configure_async(log.config(timestamps = false, minimum = log.level.off))
    var competing = log.configure_async(log.config(timestamps = false, minimum = log.level.off))
    var configured = (await replacing)?
    if await competing is Err(var problem):
        if not (problem.kind is log.failure_kind.busy):
            return Ok(12)
    else:
        return Ok(13)
    var skipped = (await log.write_async(log.level.info, "filtered"))?
    var flushed = (await log.flush_async())?
    var closed = (await log.shutdown_async())?
    var configured_again = (await log.configure_async(log.config(timestamps = false, minimum = log.level.off)))?
    var closed_again = (await log.shutdown_async())?
    if skipped:
        return Ok(2)
    return Ok(7)

async func entry(input: i32) -> i32:
    var answer = await exercise()
    if answer is Ok(var number):
        return number
    if answer is Err(var problem):
        print("{problem.operation}: {problem.message}")
    return 99
