use error as core

## Categories of recoverable text conversion failures.
enum error_kind:
    ## Text does not match the target's complete, case-sensitive grammar.
    invalid_text
    ## The value overflows the target or a nonzero float underflows its range.
    out_of_range

## Recoverable text conversion failure with the original input and common diagnostics.
struct error extends core.error:
    ## Exact grammar or representability failure category.
    kind: error_kind
    ## Original input text, retained without normalization.
    input: string

## Parse a complete invariant integer, decimal float, Boolean or payload-free enum.
## No whitespace, separators, radix prefixes or trailing characters are accepted.
## Floats round to the nearest representable target; range failures return Err.
## @param text Exact text to parse; Boolean and enum names are case-sensitive.
## @return Parsed value, or a structured invalid-text/out-of-range error.
func parse<t>(text: string) -> result<t, error>:
    var outcome = _convert_parse<t>(text)
    if outcome is Ok(var value):
        return Ok(value)
    if outcome is Err(var code):
        if code == 2:
            var reason = error(
                message = "Text is outside the target's representable range",
                code = 2,
                kind = error_kind.out_of_range,
                input = text
            )
            return Err(reason)
    return Err(error(
        message = "Text does not match the target's complete grammar",
        code = 1,
        kind = error_kind.invalid_text,
        input = text
    ))

## Convert a value using VOID's existing invariant display implementation.
## Payload-free enum output is accepted by parse of that same enum type.
## Ordinary generic-definition visibility applies to custom hooks; use string(value)
## in the caller's module when its imports provide a custom display hook.
## @param value Value to render using its ordinary numeric, Boolean or display hook.
## @return Owned display text, including canonical qualified enum case names.
func to_string<t>(const value: t) -> string:
    return string(value)

## Extract a successful result, or raise a checked Runtime failure at this call.
## @param outcome Result whose success payload is required.
## @return The unchanged success payload, preserving its type and managed identity.
func unwrap<t, e>(outcome: result<t, e>) -> t:
    return _convert_unwrap<t, e>(outcome)

## Extract success or return the eagerly evaluated fallback on error.
## @param outcome Result to inspect without changing its payload.
## @param fallback Value evaluated normally before this call, including on success.
## @return Success payload when Ok; otherwise the supplied fallback.
func unwrap_or<t, e>(outcome: result<t, e>, fallback: t) -> t:
    if outcome is Ok(var value):
        return value
    return fallback
