private func _collection_index(count: i64) -> result<i64, error>:
    if count == 0:
        return Err(_error(error_kind.empty_collection))
    if count == 1:
        return Ok(0)
    var ready = try_initialize()?
    return _default.try_rand_i64(count)

private func (self generator) _index(count: i64) -> result<i64, error>:
    if count == 0:
        return Err(_error(error_kind.empty_collection))
    return self.try_rand_i64(count)

## Choose a position uniformly for preserving readonly child identity.
## @param items Growable list; fixed callers must slice explicitly.
## @return Selected element; empty input raises checked failure, singleton consumes no word.
func (self generator) choose<t>(const items: [t]) -> t:
    var index = convert.unwrap(self._index(items.count))
    return items[index]

## Recoverably choose a position uniformly; const-input child references stay readonly.
## @param items Growable list, with no equality/hash/display requirements.
## @return Ok element or empty_collection; singleton consumes no word.
func (self generator) try_choose<t>(const items: [t]) -> result<t, error>:
    var index = self._index(items.count)?
    return Ok(items[index])

## Shuffle in place using descending unbiased Fisher-Yates; aliases observe replacements.
## @param items Mutable growable list with authority-compatible elements; count is unchanged.
func (self generator) shuffle<t>(items: [t]):
    var index = items.count - 1
    for index > 0:
        var selected = self.rand_range<i64>(0, index)
        if selected != index:
            var saved = items[index]
            items[index] = items[selected]
            items[selected] = saved
        index -= 1

## Shuffle a fresh outer copy; source and readonly child authority are preserved.
## @param items Growable list to slice and shuffle; no deep clone is performed.
## @return Independent outer list with shared readonly referenced children and copied value elements.
func (self generator) shuffled<t>(const items: [t]) -> [t]:
    var copy = items[0..<items.count]
    var index = copy.count - 1
    for index > 0:
        var selected = self.rand_range<i64>(0, index)
        if selected != index:
            var saved = copy[index]
            copy[index] = copy[selected]
            copy[selected] = saved
        index -= 1
    return copy

private var _default = generator(seed = 0)
private var _ready: bool = false

## Explicitly seed the Runtime-local default, bypassing OS entropy.
## @param value Exact u64 seed whose initial position replaces the default stream.
func seed(value: u64):
    _default.seed(value)
    _ready = true

## Construct an independent stream from exactly eight successful OS bytes, decoded little endian.
## @return Ok generator or entropy_unavailable with errno/NTSTATUS; no fallback seed is invented.
func from_entropy() -> result<generator, error>:
    var outcome = _random_seed()
    if outcome is Ok(var value):
        return Ok(generator(seed = value))
    if outcome is Err(var native):
        return Err(_error(error_kind.entropy_unavailable, native))
    return Err(_error(error_kind.entropy_unavailable))

## Lazily initialize the Runtime-local default; a ready stream is never reseeded.
## @return Ok(true) once ready; entropy failure leaves default state unchanged and permits retry.
func try_initialize() -> result<bool, error>:
    if _ready:
        return Ok(true)
    var state = from_entropy()?
    _default = state
    _ready = true
    return Ok(true)

## Draw a Boolean from the Runtime-local default stream, lazily seeded by the OS.
## @return Most significant bit of one word; seed errors raise checked Runtime failure.
func boolean() -> bool:
    return convert.unwrap(try_boolean())

## Recoverably draw a default Boolean, including first-use entropy initialization errors.
## @return Ok Boolean or entropy_unavailable; seed failure publishes no state.
func try_boolean() -> result<bool, error>:
    var ready = try_initialize()?
    return Ok(_default.boolean())

## Draw an inclusive integer interval using the shared default stream.
## @param lower Inclusive lower endpoint.
## @param upper Inclusive upper endpoint of the exact same integer primitive.
## @return Sample; reversed bounds raise checked failure, singleton skips entropy and draws.
func rand_range<t>(lower: t, upper: t) -> t:
    return convert.unwrap(try_rand_range(lower, upper))

## Recoverably draw an inclusive interval, including full-width integer extrema.
## @param lower Inclusive lower endpoint.
## @param upper Inclusive upper endpoint; reversed bounds fail without initialization.
## @return Ok sample, invalid_bounds or entropy_unavailable; singleton consumes no word.
func try_rand_range<t>(lower: t, upper: t) -> result<t, error>:
    var width = _width(lower, upper, true)?
    if width == 1:
        return Ok(lower)
    var ready = try_initialize()?
    return _default.try_rand_range(lower, upper)

