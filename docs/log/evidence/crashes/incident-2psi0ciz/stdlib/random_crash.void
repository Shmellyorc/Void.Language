    return Ok(items[index])

## Shuffle a mutable growable list in place, preserving identity, count and structural version.
## @param items Authority-compatible list; aliases see swaps, allocation failure need not roll back.
func shuffle<t>(items: [t]):
    var done = convert.unwrap(try_shuffle(items))

## Recoverably initialize and shuffle in place with unbiased descending Fisher-Yates.
## @param items Mutable growable list; empty/singleton inputs skip entropy and draws.
## @return Ok(true), or entropy_unavailable before any swap; allocation failures use Runtime policy.
func try_shuffle<t>(items: [t]) -> result<bool, error>:
    if items.count > 1:
        var ready = try_initialize()?
        _default.shuffle(items)
    return Ok(true)

## Return a shuffled outer copy for preserving readonly referenced children.
## @param items Const-input growable list; input outer storage is never changed.
## @return Fresh list; entropy/allocation failures use checked Runtime failure.
func shuffled<t>(const items: [t]) -> [t]:
    if items.count > 1:
        var ready = convert.unwrap(try_initialize())
    return _default.shuffled(items)

## Recoverably initialize and shuffle an independent outer copy.
## @param items Const-input list; fixed arrays require an explicit slice.
## @return Ok copy or entropy_unavailable; empty/singleton copies skip entropy and draws.
func try_shuffled<t>(const items: [t]) -> result<[t], error>:
    if items.count > 1:
        var ready = try_initialize()?
    return Ok(_default.shuffled(items))
