## Draw f32: zero arguments sample the precise [0, 1) unit grid.
## Direct calls also accept maximum: f32 for [0, maximum), or lower/upper: f32 for [lower, upper).
## Bounded arguments must be exact types; literals adapt contextually. Invalid bounds raise checked failure.
## @return Sample; each attempted candidate consumes one word, except integer singleton intervals.
func (self generator) rand_f32() -> f32:
    return ((self._word() / (1099511627776 as u64)) as f32) / 16777216.0

## Recoverably draw a bounded f32; two bounds select [lower, upper).
## @param maximum Exclusive upper endpoint; must be positive and finite.
## @return Ok sample or structured bounds error without advancing on invalid input.
func (self generator) try_rand_f32(maximum: f32) -> result<f32, error>:
    return self._arity_try_rand_f32_2(0, maximum)

## Bounded direct-call implementation of rand_f32.
## @param maximum Exclusive positive upper endpoint; finite for floats.
## @return Sample or checked result; invalid input consumes no word.
private func (self generator) _arity_rand_f32_1(maximum: f32) -> f32:
    return convert.unwrap(self.try_rand_f32(maximum))

## Bounded direct-call implementation of rand_f32.
## @param lower Inclusive lower endpoint; finite for floats.
## @param upper Exclusive upper endpoint; finite for floats.
## @return Sample or checked result; invalid input consumes no word.
private func (self generator) _arity_rand_f32_2(lower: f32, upper: f32) -> f32:
    return convert.unwrap(self._arity_try_rand_f32_2(lower, upper))

## Bounded direct-call implementation of try_rand_f32.
## @param lower Inclusive lower endpoint; finite for floats.
## @param upper Exclusive upper endpoint; finite for floats.
## @return Sample or checked result; invalid input consumes no word.
private func (self generator) _arity_try_rand_f32_2(lower: f32, upper: f32) -> result<f32, error>:
    var valid = _finite_bounds(lower, upper)?
    for true:
        var unit = self.rand_f32()
        var value: f32 = 0
        if lower < 0 and upper > 0:
            value = lower * (1 - unit) + upper * unit
        else:
            value = lower + (upper - lower) * unit
        if value >= lower and value < upper:
            return Ok(value)
    return Ok(lower)

