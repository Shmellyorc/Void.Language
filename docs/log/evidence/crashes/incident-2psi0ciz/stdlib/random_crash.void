use error as core
use convert

## Version of the seed, transition, sampling and draw-consumption contract.
const algorithm_version: i32 = 1

## Recoverable argument, collection and operating-system seed failures.
enum error_kind:
    ## Exclusive bounds are empty/nonpositive, or bounds are reversed.
    invalid_bounds
    ## A floating endpoint is NaN or infinity.
    nonfinite_bounds
    ## Choosing from an empty list has no valid position.
    empty_collection
    ## The operating system could not supply a complete eight-byte seed.
    entropy_unavailable

## Structured random failure; allocation failures use ordinary checked Runtime failure.
struct error extends core.error:
    ## Portable failure category; inherited code is the category number 1 through 4.
    kind: error_kind
    ## Preserved errno or signed NTSTATUS; zero for argument errors.
    native_code: i32 = 0

private func _error(kind: error_kind, native_code: i32 = 0) -> error:
    match kind:
        error_kind.invalid_bounds:
            return error(message = "Random bounds are empty or reversed", code = 1, kind = kind)
        error_kind.nonfinite_bounds:
            return error(message = "Random bounds must be finite", code = 2, kind = kind)
        error_kind.empty_collection:
            return error(message = "Cannot choose from an empty list", code = 3, kind = kind)
        error_kind.entropy_unavailable:
            return error(message = "OS random seed is unavailable", code = 4, kind = kind, native_code = native_code)
    return error(message = "Unknown random error", kind = kind)

## Copyable version-1 xoshiro256** stream with four private words and no native resource.
## Equal explicit seeds and call sequences replay exactly. Gameplay use only, never cryptography.
## Assignment snapshots the stream; mutating draws require writable receiver storage.
value struct generator:
    private s0: u64
    private s1: u64
    private s2: u64
    private s3: u64

private func _mix(value: u64) -> u64:
    var word = _random_xor(value, value / 1073741824) * (13787848793156543929 as u64)
    word = _random_xor(word, word / 134217728) * (10723151780598845931 as u64)
    return _random_xor(word, word / (2147483648 as u64))

## Construct a deterministic independent stream without requesting OS entropy.
## @param seed Exact u64 seed, including zero and u64.max_value.
func (self generator) init(seed: u64):
    var word = seed + (11400714819323198485 as u64)
    self.s0 = _mix(word)
    word += (11400714819323198485 as u64)
    self.s1 = _mix(word)
    word += (11400714819323198485 as u64)
    self.s2 = _mix(word)
    word += (11400714819323198485 as u64)
    self.s3 = _mix(word)

## Reset this stream to an explicit seed without entropy.
## @param value Seed whose initial stream position replaces this receiver.
func (self generator) seed(value: u64):
    self = generator(seed = value)

private func (self generator) _word() -> u64:
    var product = self.s1 * 5
    var output = (product * 128 + product / (144115188075855872 as u64)) * 9
    var shifted = self.s1 * 131072
    self.s2 = _random_xor(self.s2, self.s0)
    self.s3 = _random_xor(self.s3, self.s1)
    self.s1 = _random_xor(self.s1, self.s2)
    self.s0 = _random_xor(self.s0, self.s3)
    self.s2 = _random_xor(self.s2, shifted)
    self.s3 = self.s3 * (35184372088832 as u64) + self.s3 / 524288
    return output

private func _ordinal<t>(value: t) -> u64:
    var domain = _random_domain_max<t>()
    if t.min_value < 0:
        if value < 0:
            return (value - t.min_value) as u64
        return (value as u64) + domain / 2 + 1
    return value as u64

private func _value<t>(ordinal: u64) -> t:
    var domain = _random_domain_max<t>()
    if t.min_value < 0:
        var offset = domain / 2 + 1
        if ordinal < offset:
            return t.min_value + (ordinal as t)
        return (ordinal - offset) as t
    return ordinal as t

private func _width<t>(lower: t, upper: t, inclusive: bool) -> result<u64, error>:
    var domain = _random_domain_max<t>()
    if lower > upper or (not inclusive and lower == upper):
        return Err(_error(error_kind.invalid_bounds))
    var width = _ordinal(upper) - _ordinal(lower)
    if inclusive:
        width += 1
    return Ok(width)

private func (self generator) _candidate(domain: u64) -> u64:
    var word = self._word()
    if domain == u64.max_value:
        return word
    return word / (u64.max_value / (domain + 1) + 1)

private func (self generator) _sample(width: u64, domain: u64) -> u64:
    if width == 1:
        return 0
    if width == 0:
        return self._word()
    var threshold: u64 = 0
    if domain == u64.max_value:
        threshold = (0 - width) % width
    else:
        threshold = (domain + 1) % width
    for true:
        var candidate = self._candidate(domain)
        if candidate >= threshold:
            return candidate % width
    return 0

private func (self generator) _integer<t>(lower: t, upper: t, inclusive: bool) -> result<t, error>:
    var width = _width(lower, upper, inclusive)?
    return Ok(_value<t>(_ordinal(lower) + self._sample(width, _random_domain_max<t>())))

private func _finite_bounds<t>(lower: t, upper: t) -> result<bool, error>:
    if lower != lower or upper != upper or lower < t.min_value or lower > t.max_value or upper < t.min_value or upper > t.max_value:
        return Err(_error(error_kind.nonfinite_bounds))
    if lower >= upper:
        return Err(_error(error_kind.invalid_bounds))
    return Ok(true)

## Draw one Boolean from the most significant bit of one new word.
## @return True exactly when that bit is one.
func (self generator) boolean() -> bool:
    return self._word() >= (9223372036854775808 as u64)

## Draw an inclusive integer interval; equal bounds consume no word.
## @param lower Inclusive lower endpoint, with exact inferred integer type.
## @param upper Inclusive upper endpoint of that same integer primitive.
## @return Value including either endpoint; reversed bounds raise checked failure.
func (self generator) rand_range<t>(lower: t, upper: t) -> t:
    return convert.unwrap(self.try_rand_range(lower, upper))

## Recoverably draw an inclusive integer interval, including full i64/u64 domains.
## @param lower Inclusive lower endpoint.
## @param upper Inclusive upper endpoint; lower must not exceed upper.
## @return Ok value or invalid_bounds; errors and singletons consume no words.
func (self generator) try_rand_range<t>(lower: t, upper: t) -> result<t, error>:
    return self._integer(lower, upper, true)

## Draw i8: zero arguments cover the full signed/unsigned domain.
## Direct calls also accept maximum: i8 for [0, maximum), or lower/upper: i8 for [lower, upper).
## Bounded arguments must be exact types; literals adapt contextually. Invalid bounds raise checked failure.
## @return Sample; each attempted candidate consumes one word, except integer singleton intervals.
func (self generator) rand_i8() -> i8:
    return _value<i8>(self._candidate(_random_domain_max<i8>()))

## Recoverably draw a bounded i8; two bounds select [lower, upper).
## @param maximum Exclusive upper endpoint; must be positive.
## @return Ok sample or structured bounds error without advancing on invalid input.
func (self generator) try_rand_i8(maximum: i8) -> result<i8, error>:
    return self._arity_try_rand_i8_2(0, maximum)

## Bounded direct-call implementation of rand_i8.
## @param maximum Exclusive positive upper endpoint; finite for floats.
## @return Sample or checked result; invalid input consumes no word.
private func (self generator) _arity_rand_i8_1(maximum: i8) -> i8:
    return convert.unwrap(self.try_rand_i8(maximum))

## Bounded direct-call implementation of rand_i8.
## @param lower Inclusive lower endpoint; finite for floats.
## @param upper Exclusive upper endpoint; finite for floats.
## @return Sample or checked result; invalid input consumes no word.
private func (self generator) _arity_rand_i8_2(lower: i8, upper: i8) -> i8:
    return convert.unwrap(self._arity_try_rand_i8_2(lower, upper))

## Bounded direct-call implementation of try_rand_i8.
## @param lower Inclusive lower endpoint; finite for floats.
## @param upper Exclusive upper endpoint; finite for floats.
## @return Sample or checked result; invalid input consumes no word.
private func (self generator) _arity_try_rand_i8_2(lower: i8, upper: i8) -> result<i8, error>:
    return self._integer(lower, upper, false)

