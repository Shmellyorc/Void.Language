+## @return A fresh closed identity with no native resource or filesystem effects.
+internal func _prepare_open(value: string) -> file:
+    return file(value, binary.byte_order.little)
+
+## Acquire a fresh prepared identity already retained by the caller's cleanup guard.
+## @param mode Existing native opening policy; the identity must be fresh and unopened.
+## @return True after acquisition, or the original typed native failure.
