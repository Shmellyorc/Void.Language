use math
func main():
    var input: i16 = 1
    var abs_inferred: i16 = math.abs(input)
    var abs_explicit: i16 = math.abs<i16>(input)
    var min_inferred: i16 = math.min(input, input)
    var min_explicit: i16 = math.min<i16>(input, input)
    var max_inferred: i16 = math.max(input, input)
    var max_explicit: i16 = math.max<i16>(input, input)
    var clamp_inferred: i16 = math.clamp(input, input, input)
    var clamp_explicit: i16 = math.clamp<i16>(input, input, input)
    var sign_inferred: i16 = math.sign(input)
    var sign_explicit: i16 = math.sign<i16>(input)
