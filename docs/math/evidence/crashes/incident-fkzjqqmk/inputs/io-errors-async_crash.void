use io

func failure<t>(outcome: result<t, io.error>, code: i32, progress: i64) -> bool:
    if outcome is Err(var reason):
        return reason.code == code and reason.bytes_transferred == progress

    return false

async func exercise() -> result<i32, io.error>:
    const original: [u8] = [192, 175, 0]
    var written = (await io.write_bytes_async("errors.bin", original))?
    var snapshot = (await io.read_bytes_async("errors.bin"))?
    snapshot[0] = 1
    var independent = (await io.read_bytes_async("errors.bin"))?

    if independent[0] != 192:
        return Ok(1)

    with (await io.open_async("errors.bin", io.open_mode.read_write))? as handle:
        var short = (await handle.read_exact_async(4))

        if not failure(short, 9, 3):
            return Ok(2)

        if short is Err(var reason):
            if reason.partial.count != 3 or reason.partial[0] != 192:
                return Ok(3)

        var cursor = (await handle.position_async())?

        if cursor != 3 or not failure((await handle.seek_async(-4, io.seek_origin.current)), 6, 0):
            return Ok(4)

        var reset = (await handle.seek_async(0))?
        var malformed = (await handle.read_string_async(3))

        if not failure(malformed, 10, 3):
            return Ok(5)

        var beginning = (await handle.seek_async(0))?
        var line = (await handle.read_line_async())

        if not failure(line, 10, 3):
            return Ok(6)

        var negative = (await handle.read_exact_async(-1))

        if not failure(negative, 6, 0):
            return Ok(7)

        var closed = (await handle.close_async())?
        var closed_again = (await handle.close_async())?

        if not failure((await handle.read_bytes_async(1)), 7, 0):
            return Ok(8)

    var prefix = (await io.write_bytes_async("errors.bin", [255, 255, 255, 255]))?

    with (await io.open_async("errors.bin"))? as handle:
        var limited = (await handle.read_pascal_string_async(8))

        if not failure(limited, 12, 4):
            return Ok(9)

        var cursor = (await handle.position_async())?

        if cursor != 4 or not failure((await handle.write_string_async("x")), 5, 0):
            return Ok(10)

    var truncated = (await io.write_bytes_async("errors.bin", [5, 0, 0, 0, 65]))?

    with (await io.open_async("errors.bin"))? as handle:
        var partial = (await handle.read_pascal_string_async())

        if not failure(partial, 9, 5):
            return Ok(11)

        if partial is Err(var reason):
            if reason.partial.count != 5 or reason.partial[4] != 65:
                return Ok(12)

    var framed = (await io.write_text_async("lines.txt", "first\r\n\nlast\r"))?

    with (await io.open_async("lines.txt"))? as handle:
        var first = (await handle.read_line_async())?
        var blank = (await handle.read_line_async())?
        var last = (await handle.read_line_async())?
        var exhausted = (await handle.read_line_async())?

        if not (first is io.text_read.text(var first_text)):
            return Ok(13)

        if blank is io.text_read.text(var blank_text):
            if blank_text != "":
                return Ok(14)
        else:
            return Ok(15)

        if last is io.text_read.text(var last_text):
            if last_text != "last":
                return Ok(16)
        else:
            return Ok(17)

        if not (exhausted is io.text_read.eof):
            return Ok(18)

    var removed = (await io.remove_file_async("errors.bin"))?
    var removed_lines = (await io.remove_file_async("lines.txt"))?
    return Ok(7)

async func entry(input: i32) -> i32:
    var outcome = await exercise()
    if outcome is Ok(var answer):
        return answer
    return 99
