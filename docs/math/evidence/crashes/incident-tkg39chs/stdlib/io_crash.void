## Read one fixed-width number with encoding/binary in this file's byte order.
## Supports all ten integer and IEEE numeric primitives; truncation retains actual consumed bytes.
## @return Ok with the decoded value, or Err with EOF, closed, busy or native progress details.
func (self file) read<t>() -> result<t, error>:
    with _reserve(self, "read")? as lease:
        var width = binary.encode<t>(0).count
        var bytes = (self.read_exact(width))?

        if binary.decode<t>(bytes, self.order) is Ok(var value):
            return Ok(value)

        return Err(_reason("read", self._path, error_kind.unexpected_eof, bytes, bytes.count))


## Write one fixed-width numeric representation through the existing binary codec.
## Preserves all signed integer and IEEE bits, including NaN payloads, in the selected byte order.
## @param value One of the ten numeric primitives, inferred or explicitly selected without narrowing.
## @return Ok with bytes written, or Err retaining actual partial write progress.
func (self file) write<t>(value: t) -> result<i64, error>:
    return self.write_bytes(binary.encode(value, self.order))


## Read an exact UTF-8 byte count with strict decoding and actual cursor progress on failure.
## @param count Nonnegative number of bytes, including embedded NUL; no framing is assumed.
## @return Ok with owned text, or Err including invalid_utf8 with all consumed bytes.
func (self file) read_string(count: i64) -> result<string, error>:
    var bytes = (self.read_exact(count))?

    if string.from_utf8(bytes) is Ok(var value):
        return Ok(value)

    return Err(_reason("read_string", self._path, error_kind.invalid_utf8, bytes, bytes.count))


## Write raw UTF-8 with no prefix, newline, terminator, BOM or normalization.
## @param value Unicode text whose embedded NUL characters remain ordinary payload bytes.
## @return Ok with UTF-8 bytes written, or Err with actual partial write progress.
func (self file) write_string(value: string) -> result<i64, error>:
    return self.write_bytes(value.to_utf8())


## Read a u32 UTF-8 byte-length prefix and strict payload in this file's byte order.
## One reservation spans prefix and payload, including nested awaits; aliases cannot interleave them.
## @param max_bytes Nonnegative payload budget, checked before payload allocation; defaults to 64 MiB.
## @return Ok with text, or Err with consumed framing and payload progress; no cursor rollback is promised.
func (self file) read_pascal_string(max_bytes: i64 = 67108864) -> result<string, error>:
    if max_bytes < 0:
        return Err(_reason("read_pascal_string", self._path, error_kind.invalid_range))

    with _reserve(self, "read_pascal_string")? as lease:
        var prefix = (self.read_exact(4))?

        if binary.decode<u32>(prefix, self.order) is Ok(var length):
            var count = length as i64

            if count > max_bytes:
                return Err(_reason("read_pascal_string", self._path, error_kind.limit_exceeded, prefix, 4))

            var payload = self.read_exact(count)

            if payload is Err(var reason):
                reason.operation = "read_pascal_string"
                reason.bytes_transferred += 4
                var partial = prefix[0..<4]

                for byte in reason.partial:
                    partial.push(byte)

                reason.partial = partial
                return Err(reason)

            if payload is Ok(var bytes):
                if string.from_utf8(bytes) is Ok(var value):
                    return Ok(value)

                for byte in bytes:
                    prefix.push(byte)

                return Err(_reason("read_pascal_string", self._path, error_kind.invalid_utf8, prefix, 4 + count))

        return Err(_reason("read_pascal_string", self._path, error_kind.unexpected_eof, prefix, prefix.count))


## Write the same u32 byte-length-prefixed UTF-8 representation as io/memory.
## Prefix and payload are prepared before native writing and share one operation reservation.
## @param value Text whose UTF-8 byte count fits u32; embedded NUL is payload, not a terminator.
## @return Ok with total prefix and payload bytes written, or Err retaining actual progress.
func (self file) write_pascal_string(value: string) -> result<i64, error>:
    if value.byte_length > (u32.max_value as i64):
        return Err(_reason("write_pascal_string", self._path, error_kind.invalid_range))

    var frame = binary.encode(value.byte_length as u32, self.order)
    var payload = value.to_utf8()

    for byte in payload:
        frame.push(byte)

    return self.write_bytes(frame)


## Read an entire bounded file and decode strict UTF-8 without adding or removing bytes.
## @param value Host file path in strict UTF-8; embedded NUL in the path is invalid.
## @param max_bytes Nonnegative input byte budget; defaults to 64 MiB.
## @return Ok with owned Unicode text, or Err with native, size-limit or malformed-input details.
func read_text(value: string, max_bytes: i64 = 67108864) -> result<string, error>:
    var bytes = (read_bytes(value, max_bytes))?

    if string.from_utf8(bytes) is Ok(var text):
        return Ok(text)

    return Err(_reason("read_text", value, error_kind.invalid_utf8, bytes, bytes.count))


## Write raw UTF-8 text using an explicit writable creation policy.
