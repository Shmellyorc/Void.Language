use encoding/binary
use error as core


## Portable categories of recoverable file, directory and host-path failures.
enum error_kind:

    ## The named file, directory or parent does not exist.
    not_found

    ## The host denied access to the requested operation.
    permission_denied

    ## An exclusive destination or creation name already exists.
    already_exists

    ## A path, filename pattern or collision target is invalid.
    invalid_path

    ## The file mode does not permit this operation.
    invalid_mode

    ## A count, length, seek origin or position is invalid or overflows.
    invalid_range

    ## The shared file resource is closed or was never opened.
    closed

    ## An unrelated operation currently reserves this shared file.
    busy

    ## An exact read ended before its required byte count.
    unexpected_eof

    ## Consumed bytes are not a complete strict UTF-8 sequence.
    invalid_utf8

    ## The host or resource does not support this operation.
    unsupported

    ## A byte or traversal budget would be exceeded.
    limit_exceeded

    ## A native rename cannot cross filesystem volumes.
    cross_device

    ## An operation requiring a real directory received another entry type.
    not_directory

    ## A file operation received a directory.
    is_directory

    ## An empty-only directory operation found children.
    not_empty

    ## Another native transfer or filesystem operation failed.
    io_failure


## Managed filesystem failure retaining native diagnostics and actual progress.
## Writes and recursive mutations may leave partial changes; failures are not transactions.
struct error extends core.error:

    ## Public or underlying operation that failed.
    operation: string

    ## Portable category independent of native error numbers.
    kind: error_kind

    ## Original native platform error number, or zero for validation errors.
    os_code: i64

    ## Logical bytes consumed or written before failure, including a consumed Pascal prefix.
    bytes_transferred: i64

    ## Owned partial read bytes; changing these bytes cannot change the file.
    partial: [u8]

    ## Native close or restoration error accompanying the primary failure, or zero.
    cleanup_code: i64

    ## Relevant destination path for copy, move or link operations; empty otherwise.
    target: string

    ## Traversal entries inspected, or mutation entries completed before failure.
    entries_processed: i64


## Kind of a filesystem entry observed by metadata or directory enumeration.
enum entry_kind:
    ## An ordinary data file.
    file

    ## A real directory; recursive enumeration visits its children.
    directory

    ## A symbolic link or Windows reparse point; recursive operations do not descend through it.
    symlink

    ## Another native entry type, such as a FIFO or device.
    other


## Owned metadata snapshot; lexical paths and timestamps do not keep a native handle open.
value struct entry:
    ## Entry path in UTF-8, retaining the caller's relative or absolute root convention.
    path: string

    ## Final filename component, without its parent directory.
    name: string

    ## File, directory, link or other native entry category.
    kind: entry_kind

    ## Native size in bytes; non-file entry sizes are platform dependent.
    size: i64

    ## Modification timestamp's whole seconds since the Unix epoch; may be negative.
    modified_seconds: i64

    ## Nonnegative fractional modification nanoseconds, below one billion.
    modified_nanoseconds: i64


## Creation, truncation and access policy selected when opening a file.
enum open_mode:
    ## Read an existing file; writes fail with invalid_mode.
    read

    ## Create or truncate a file for writing; reading is prohibited.
    write

    ## Create or open for writing at EOF on every write, even after seeking.
    append

    ## Open an existing file for reading and writing without truncation.
    read_write

    ## Create or truncate a file for both reading and writing.
    create

    ## Create if absent, otherwise retain contents, with read/write access.
    open_or_create

    ## Exclusively create a new read/write file; an existing name fails.
    create_new


## Reference point for checked signed file seeks.
enum seek_origin:
    ## Absolute byte offset from the beginning.
    start

    ## Signed offset from the shared logical cursor, accounting for read-ahead.
    current

    ## Signed offset from the current native file length.
    end


## A decoded logical line or distinct end of input.
enum text_read:
    ## Strict UTF-8 text with LF, CRLF or CR removed; an empty line remains text.
    ## @param value Owned decoded line, including an empty entered line.
    ## @return A line result distinct from end of input.
    text(value: string)

    ## No further line data; a final unterminated nonempty line is returned first.
    eof


private value struct _reply:
    kind: i64
    os_code: i64
    completed: i64
    cleanup_code: i64
    entries_processed: i64
    number: i64
    eof: bool
    text: string
    bytes: [u8]
    entries: [entry]


private func _kind(code: i64) -> error_kind:
    if code == 1:
        return error_kind.not_found

    if code == 2:
        return error_kind.permission_denied

    if code == 3:
        return error_kind.already_exists

    if code == 4:
        return error_kind.invalid_path

    if code == 5:
        return error_kind.invalid_mode

    if code == 6:
        return error_kind.invalid_range

    if code == 7:
        return error_kind.closed

    if code == 8:
        return error_kind.busy

    if code == 9:
        return error_kind.unexpected_eof

    if code == 10:
        return error_kind.invalid_utf8

    if code == 11:
        return error_kind.unsupported

    if code == 12:
        return error_kind.limit_exceeded

    if code == 13:
        return error_kind.cross_device

    if code == 14:
        return error_kind.not_directory

    if code == 15:
        return error_kind.is_directory

    if code == 16:
        return error_kind.not_empty

    if code == 17:
        return error_kind.io_failure

    return error_kind.io_failure


private func _error(operation: string, path: string, target: string, reply: _reply) -> error:
    return error(
        message = "Filesystem {operation} failed; native code {reply.os_code}",
        path = path,
        code = reply.kind as i32,
        operation = operation,
        kind = _kind(reply.kind),
        os_code = reply.os_code,
        bytes_transferred = reply.completed,
        partial = reply.bytes,
        cleanup_code = reply.cleanup_code,
        target = target,
        entries_processed = reply.entries_processed
    )


private func _code(kind: error_kind) -> i32:
    match kind:
        error_kind.not_found:
            return 1
        error_kind.permission_denied:
            return 2
        error_kind.already_exists:
            return 3
        error_kind.invalid_path:
            return 4
        error_kind.invalid_mode:
            return 5
        error_kind.invalid_range:
            return 6
        error_kind.closed:
            return 7
        error_kind.busy:
            return 8
        error_kind.unexpected_eof:
            return 9
        error_kind.invalid_utf8:
            return 10
        error_kind.unsupported:
            return 11
        error_kind.limit_exceeded:
            return 12
        error_kind.cross_device:
            return 13
        error_kind.not_directory:
            return 14
        error_kind.is_directory:
            return 15
        error_kind.not_empty:
            return 16
        error_kind.io_failure:
            return 17
    return 17


private func _reason(operation: string, path: string, kind: error_kind, partial: [u8] = [], completed: i64 = 0) -> error:
    return error(
        message = "Filesystem {operation} validation failed",
        path = path,
        code = _code(kind),
        operation = operation,
        kind = kind,
        partial = partial,
        bytes_transferred = completed
    )


private func _flag(value: bool) -> i64:
    if value:
        return 1

    return 0


private func _mode(value: open_mode) -> i64:
    match value:

        open_mode.read:
            return 0

        open_mode.write:
            return 1

        open_mode.append:
            return 2

        open_mode.read_write:
            return 3

        open_mode.create:
            return 4

        open_mode.open_or_create:
            return 5

        open_mode.create_new:
            return 6

    return -1


private func _origin(value: seek_origin) -> i64:
    match value:

        seek_origin.start:
            return 0

        seek_origin.current:
            return 1

        seek_origin.end:
            return 2

    return -1


## Owned native file with shared cursor and closed state across aliases.
## Open through io.open/open_async; direct construction is private. GC does not call deinit.
## Forgotten resources remain Runtime-owned until explicit close, with/deinit or shutdown.
## File operations require their creating Runtime owner thread; source workers cannot share handles.
## Async operations use bounded native jobs; await close_async before leaving an async scope
## when disposal itself must not block. Synchronous deinit may wait for the native close.
struct file:
    internal const _path: string
    private _order: binary.byte_order


private func (self file) init(value: string, order: binary.byte_order):
    self._path = value
    self._order = order


## Numeric and Pascal-prefix byte order selected at opening.
## @return The canonical encoding/binary byte_order retained by this file.
property (self file) order: binary.byte_order:
    get:
        return self._order


private struct _lease:
    const owner: file
    active: bool = false


private func (self _lease) deinit():
    if self.active:
        _io_release(self.owner)


private func _reserve(const owner: file, operation: string, allow_closed: bool = false) -> result<_lease, error>:
    var guard = _lease(owner = owner)
    var code = _io_claim(owner)

    if allow_closed and code == (_code(error_kind.closed) as i64):
        return Ok(guard)

    if code != 0:
        return Err(_error(operation, owner._path, "", _reply(kind = code)))

    guard.active = true
    return Ok(guard)


private struct _acquisition:
    owner: file
    committed: bool = false


private func (self _acquisition) deinit():
    if not self.committed:
        _io_cleanup(self.owner)


## Open a shared file resource with explicit access, creation and endian policies.
## Parents must exist. Native handles are noninheritable; publication failures close acquisitions.
## This synchronous call may block until the host completes opening.
## @param value Nonempty host filesystem path in strict UTF-8; embedded NUL is invalid.
## @param mode Read, write/truncate, append or explicit read/write creation policy.
## @param order Byte order for all numeric values and u32 Pascal length prefixes.
## @return Ok with one shared managed file, or Err with path, mode or native failure details.
func open(value: string, mode: open_mode = open_mode.read, order: binary.byte_order = binary.byte_order.little) -> result<file, error>:
    var resource = file(value, order)

    with _acquisition(owner = resource) as guard:
        var reply = _io_open(resource, value, _mode(mode))

        if reply.kind != 0:
            return Err(_error("open", value, "", reply))

        guard.committed = true
        return Ok(resource)



## Open a shared file resource with explicit access, creation and endian policies.
## Parents must exist. Native handles are noninheritable; publication failures close acquisitions.
## Runs native opening off the owner; cancellation drains entered opening and rolls back unpublished ownership.
## @param value Nonempty host filesystem path in strict UTF-8; embedded NUL is invalid.
## @param mode Read, write/truncate, append or explicit read/write creation policy.
## @param order Byte order for all numeric values and u32 Pascal length prefixes.
## @return Ok with one shared managed file, or Err with path, mode or native failure details.
async func open_async(value: string, mode: open_mode = open_mode.read, order: binary.byte_order = binary.byte_order.little) -> result<file, error>:
    var resource = file(value, order)
    var reply = await _io_open_async(resource, value, _mode(mode))

    if reply.kind != 0:
        return Err(_error("open", value, "", reply))

    return Ok(resource)


## Close this shared native handle when leaving with, including early failure.
## Closing is idempotent; an actual native close failure becomes a checked Runtime failure.
func (self file) deinit():
    _io_cleanup(self)


## Read up to max_count owned bytes; a short native chunk need not mean EOF.
## This synchronous operation may block in the host filesystem.
## @param max_count Nonnegative upper bound; zero succeeds without moving the shared cursor.
## @return Ok with owned bytes; empty bytes signal EOF only for a positive request.
func (self file) read_bytes(max_count: i64) -> result<[u8], error>:
    with _reserve(self, "read_bytes")? as lease:
        var reply = _io_read_bytes(self, max_count)

        if reply.kind != 0:
            return Err(_error("read_bytes", self._path, "", reply))

        return Ok(reply.bytes)


## Read up to max_count owned bytes; a short native chunk need not mean EOF.
## Native work runs off the owner; cancellation drains entered syscalls before releasing this reservation.
## @param max_count Nonnegative upper bound; zero succeeds without moving the shared cursor.
## @return Ok with owned bytes; empty bytes signal EOF only for a positive request.
async func (self file) read_bytes_async(max_count: i64) -> result<[u8], error>:
    with _reserve(self, "read_bytes")? as lease:
        var reply = await _io_read_bytes_async(self, max_count)

        if reply.kind != 0:
            return Err(_error("read_bytes", self._path, "", reply))

        return Ok(reply.bytes)


## Read exactly count bytes, looping through short transfers until complete or EOF.
## This synchronous operation may block in the host filesystem.
## @param count Required nonnegative byte count; a failed exact read retains actual consumed progress.
## @return Ok with exactly count bytes, or Err(unexpected_eof) with owned partial bytes.
func (self file) read_exact(count: i64) -> result<[u8], error>:
    with _reserve(self, "read_exact")? as lease:
        var reply = _io_read_exact(self, count)

        if reply.kind != 0:
            return Err(_error("read_exact", self._path, "", reply))

        return Ok(reply.bytes)


## Read exactly count bytes, looping through short transfers until complete or EOF.
## Native work runs off the owner; cancellation drains entered syscalls before releasing this reservation.
## @param count Required nonnegative byte count; a failed exact read retains actual consumed progress.
## @return Ok with exactly count bytes, or Err(unexpected_eof) with owned partial bytes.
async func (self file) read_exact_async(count: i64) -> result<[u8], error>:
    with _reserve(self, "read_exact")? as lease:
        var reply = await _io_read_exact_async(self, count)

        if reply.kind != 0:
            return Err(_error("read_exact", self._path, "", reply))

        return Ok(reply.bytes)


## Read one strict UTF-8 line, removing LF, CRLF or CR without losing empty lines.
## This synchronous operation may block in the host filesystem.
## @param max_bytes Nonnegative maximum payload bytes in one line; defaults to 64 MiB.
## @return Ok(text/eof), or Err with consumed bytes and actual cursor progress.
func (self file) read_line(max_bytes: i64 = 67108864) -> result<text_read, error>:
    with _reserve(self, "read_line")? as lease:
        var reply = _io_read_line(self, max_bytes)

        if reply.kind != 0:
            return Err(_error("read_line", self._path, "", reply))

        if reply.eof:
            return Ok(text_read.eof)

        if string.from_utf8(reply.bytes) is Ok(var value):
            return Ok(text_read.text(value))

        return Err(_reason("read_line", self._path, error_kind.invalid_utf8, reply.bytes, reply.completed))


## Read one strict UTF-8 line, removing LF, CRLF or CR without losing empty lines.
## Native work runs off the owner; cancellation drains entered syscalls before releasing this reservation.
## @param max_bytes Nonnegative maximum payload bytes in one line; defaults to 64 MiB.
## @return Ok(text/eof), or Err with consumed bytes and actual cursor progress.
async func (self file) read_line_async(max_bytes: i64 = 67108864) -> result<text_read, error>:
    with _reserve(self, "read_line")? as lease:
        var reply = await _io_read_line_async(self, max_bytes)

        if reply.kind != 0:
            return Err(_error("read_line", self._path, "", reply))

        if reply.eof:
            return Ok(text_read.eof)

        if string.from_utf8(reply.bytes) is Ok(var value):
            return Ok(text_read.text(value))

        return Err(_reason("read_line", self._path, error_kind.invalid_utf8, reply.bytes, reply.completed))


## Write owned input bytes at the shared cursor, looping over short native transfers.
## This synchronous operation may block in the host filesystem.
## @param bytes Readonly or mutable input copied before native waiting; caller storage is never retained.
## @return Ok with bytes written, or Err with actual progress; earlier writes are not rolled back.
func (self file) write_bytes(const bytes: [u8]) -> result<i64, error>:
    with _reserve(self, "write_bytes")? as lease:
        var reply = _io_write_bytes(self, bytes)

        if reply.kind != 0:
            return Err(_error("write_bytes", self._path, "", reply))

        return Ok(reply.completed)


## Write owned input bytes at the shared cursor, looping over short native transfers.
## Native work runs off the owner; cancellation drains entered syscalls before releasing this reservation.
## @param bytes Readonly or mutable input copied before native waiting; caller storage is never retained.
## @return Ok with bytes written, or Err with actual progress; earlier writes are not rolled back.
async func (self file) write_bytes_async(const bytes: [u8]) -> result<i64, error>:
    with _reserve(self, "write_bytes")? as lease:
        var reply = await _io_write_bytes_async(self, bytes)

        if reply.kind != 0:
            return Err(_error("write_bytes", self._path, "", reply))

        return Ok(reply.completed)


## Seek relative to start, logical current position or native EOF with checked arithmetic.
## This synchronous operation may block in the host filesystem.
## @param offset Signed byte offset; the resulting absolute position must be nonnegative and fit i64.
## @param origin Reference point; append-mode writes still choose EOF after seeking.
## @return Ok with the new absolute cursor; invalid or unsupported seeks preserve the logical cursor.
func (self file) seek(offset: i64, origin: seek_origin = seek_origin.start) -> result<i64, error>:
    with _reserve(self, "seek")? as lease:
        var reply = _io_seek(self, offset, _origin(origin))

        if reply.kind != 0:
            return Err(_error("seek", self._path, "", reply))

        return Ok(reply.number)


## Seek relative to start, logical current position or native EOF with checked arithmetic.
## Native work runs off the owner; cancellation drains entered syscalls before releasing this reservation.
## @param offset Signed byte offset; the resulting absolute position must be nonnegative and fit i64.
## @param origin Reference point; append-mode writes still choose EOF after seeking.
## @return Ok with the new absolute cursor; invalid or unsupported seeks preserve the logical cursor.
async func (self file) seek_async(offset: i64, origin: seek_origin = seek_origin.start) -> result<i64, error>:
    with _reserve(self, "seek")? as lease:
        var reply = await _io_seek_async(self, offset, _origin(origin))

        if reply.kind != 0:
            return Err(_error("seek", self._path, "", reply))

        return Ok(reply.number)


## Inspect the shared logical cursor, accounting for buffered read-ahead.
## This synchronous operation may block in the host filesystem.
## @return Ok with the nonnegative logical byte position, or Err(closed/busy).
func (self file) position() -> result<i64, error>:
    with _reserve(self, "position")? as lease:
        var reply = _io_position(self)

        if reply.kind != 0:
            return Err(_error("position", self._path, "", reply))

        return Ok(reply.number)


## Inspect the shared logical cursor, accounting for buffered read-ahead.
## Native work runs off the owner; cancellation drains entered syscalls before releasing this reservation.
## @return Ok with the nonnegative logical byte position, or Err(closed/busy).
async func (self file) position_async() -> result<i64, error>:
    with _reserve(self, "position")? as lease:
        var reply = await _io_position_async(self)

        if reply.kind != 0:
            return Err(_error("position", self._path, "", reply))

        return Ok(reply.number)


## Inspect the current native file length without moving the logical cursor.
## This synchronous operation may block in the host filesystem.
## @return Ok with byte length, or Err with native or closed-resource details.
func (self file) length() -> result<i64, error>:
    with _reserve(self, "length")? as lease:
        var reply = _io_length(self)

        if reply.kind != 0:
            return Err(_error("length", self._path, "", reply))

        return Ok(reply.number)


## Inspect the current native file length without moving the logical cursor.
## Native work runs off the owner; cancellation drains entered syscalls before releasing this reservation.
## @return Ok with byte length, or Err with native or closed-resource details.
async func (self file) length_async() -> result<i64, error>:
    with _reserve(self, "length")? as lease:
        var reply = await _io_length_async(self)

        if reply.kind != 0:
            return Err(_error("length", self._path, "", reply))

        return Ok(reply.number)


## Truncate or extend a writable file without moving its logical cursor.
## This synchronous operation may block in the host filesystem.
## @param length New nonnegative byte length; host extension yields zero bytes where supported.
## @return Ok with the selected length, or Err with native progress and restoration details.
func (self file) set_length(length: i64) -> result<i64, error>:
    with _reserve(self, "set_length")? as lease:
        var reply = _io_set_length(self, length)

        if reply.kind != 0:
            return Err(_error("set_length", self._path, "", reply))

        return Ok(reply.number)


## Truncate or extend a writable file without moving its logical cursor.
## Native work runs off the owner; cancellation drains entered syscalls before releasing this reservation.
## @param length New nonnegative byte length; host extension yields zero bytes where supported.
## @return Ok with the selected length, or Err with native progress and restoration details.
async func (self file) set_length_async(length: i64) -> result<i64, error>:
    with _reserve(self, "set_length")? as lease:
        var reply = await _io_set_length_async(self, length)

        if reply.kind != 0:
            return Err(_error("set_length", self._path, "", reply))

        return Ok(reply.number)


## Ask the host to flush regular-file data; this is not an unconditional media-durability guarantee.
## This synchronous operation may block in the host filesystem.
## @return Ok(0) after native flushing, or Err with the host failure.
func (self file) flush() -> result<i64, error>:
    with _reserve(self, "flush")? as lease:
        var reply = _io_flush(self)

        if reply.kind != 0:
            return Err(_error("flush", self._path, "", reply))

        return Ok(0)


## Ask the host to flush regular-file data; this is not an unconditional media-durability guarantee.
## Native work runs off the owner; cancellation drains entered syscalls before releasing this reservation.
## @return Ok(0) after native flushing, or Err with the host failure.
async func (self file) flush_async() -> result<i64, error>:
    with _reserve(self, "flush")? as lease:
        var reply = await _io_flush_async(self)

        if reply.kind != 0:
            return Err(_error("flush", self._path, "", reply))

        return Ok(0)


## Close the shared handle exactly once; all aliases subsequently observe closed.
## This synchronous operation may block in the host filesystem.
## @return Ok(0), including double close, or Err(busy/native failure); a busy close leaves the handle open.
func (self file) close() -> result<i64, error>:
    with _reserve(self, "close", true)? as lease:
        if not lease.active:
            return Ok(0)

        var reply = _io_close(self)

        if reply.kind != 0:
            return Err(_error("close", self._path, "", reply))

        return Ok(0)


## Close the shared handle exactly once; all aliases subsequently observe closed.
## Native work runs off the owner; cancellation drains entered syscalls before releasing this reservation.
## @return Ok(0), including double close, or Err(busy/native failure); a busy close leaves the handle open.
async func (self file) close_async() -> result<i64, error>:
    with _reserve(self, "close", true)? as lease:
        if not lease.active:
            return Ok(0)

        var reply = await _io_close_async(self)

        if reply.kind != 0:
            return Err(_error("close", self._path, "", reply))

        return Ok(0)


## Read an entire file into independent owned bytes, continuing until actual EOF.
## This synchronous operation may block in the host filesystem.
## @param value UTF-8 host file path; no missing parent is created.
## @param max_bytes Nonnegative maximum bytes to return; defaults to 64 MiB.
## @return Ok with owned bytes, or Err with a bounded partial read and actual progress.
func read_bytes(value: string, max_bytes: i64 = 67108864) -> result<[u8], error>:
    var reply = _io_read_all(value, max_bytes)

    if reply.kind != 0:
        return Err(_error("read_bytes", value, "", reply))

    return Ok(reply.bytes)


## Read an entire file into independent owned bytes, continuing until actual EOF.
## Runs native filesystem work off the owner; cancellation drains entered native operations.
## @param value UTF-8 host file path; no missing parent is created.
## @param max_bytes Nonnegative maximum bytes to return; defaults to 64 MiB.
## @return Ok with owned bytes, or Err with a bounded partial read and actual progress.
async func read_bytes_async(value: string, max_bytes: i64 = 67108864) -> result<[u8], error>:
    var reply = await _io_read_all_async(value, max_bytes)

    if reply.kind != 0:
        return Err(_error("read_bytes", value, "", reply))

    return Ok(reply.bytes)


## Write bytes using explicit truncate, append, overwrite or exclusive-create policy.
## This synchronous operation may block in the host filesystem.
## @param value Destination path whose parent must already exist.
## @param bytes Input bytes copied before native waiting; readonly arrays are accepted.
## @param mode Writable open policy; default write creates or truncates, read mode is rejected.
## @return Ok with bytes written, or Err with completed bytes and cleanup details; changes are not atomic.
func write_bytes(value: string, const bytes: [u8], mode: open_mode = open_mode.write) -> result<i64, error>:
    var reply = _io_write_all(value, bytes, _mode(mode))

    if reply.kind != 0:
        return Err(_error("write_bytes", value, "", reply))

    return Ok(reply.completed)


## Write bytes using explicit truncate, append, overwrite or exclusive-create policy.
## Runs native filesystem work off the owner; cancellation drains entered native operations.
## @param value Destination path whose parent must already exist.
## @param bytes Input bytes copied before native waiting; readonly arrays are accepted.
## @param mode Writable open policy; default write creates or truncates, read mode is rejected.
## @return Ok with bytes written, or Err with completed bytes and cleanup details; changes are not atomic.
async func write_bytes_async(value: string, const bytes: [u8], mode: open_mode = open_mode.write) -> result<i64, error>:
    var reply = await _io_write_all_async(value, bytes, _mode(mode))

    if reply.kind != 0:
        return Err(_error("write_bytes", value, "", reply))

    return Ok(reply.completed)


## Inspect whether a file, directory or link entry exists, including dangling links.
## This synchronous operation may block in the host filesystem.
## @param value UTF-8 host entry path to inspect.
## @return Ok(false) only for a missing path; permission and genuine native errors remain Err.
func exists(value: string) -> result<bool, error>:
    var reply = _io_exists(value)

    if reply.kind != 0:
        return Err(_error("exists", value, "", reply))

    return Ok(reply.number != 0)


