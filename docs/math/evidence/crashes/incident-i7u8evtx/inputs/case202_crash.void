use math
func main():
    var input: f64 = 1
    var abs_inferred: f64 = math.abs(input)
    var abs_explicit: f64 = math.abs<f64>(input)
    var min_inferred: f64 = math.min(input, input)
    var min_explicit: f64 = math.min<f64>(input, input)
    var max_inferred: f64 = math.max(input, input)
    var max_explicit: f64 = math.max<f64>(input, input)
    var clamp_inferred: f64 = math.clamp(input, input, input)
    var clamp_explicit: f64 = math.clamp<f64>(input, input, input)
    var sign_inferred: f64 = math.sign(input)
    var sign_explicit: f64 = math.sign<f64>(input)
    var is_nan_inferred: bool = math.is_nan(input)
    var is_nan_explicit: bool = math.is_nan<f64>(input)
    var is_infinite_inferred: bool = math.is_infinite(input)
    var is_infinite_explicit: bool = math.is_infinite<f64>(input)
    var is_finite_inferred: bool = math.is_finite(input)
    var is_finite_explicit: bool = math.is_finite<f64>(input)
    var floor_inferred: f64 = math.floor(input)
    var floor_explicit: f64 = math.floor<f64>(input)
    var ceil_inferred: f64 = math.ceil(input)
    var ceil_explicit: f64 = math.ceil<f64>(input)
    var trunc_inferred: f64 = math.trunc(input)
    var trunc_explicit: f64 = math.trunc<f64>(input)
    var round_inferred: f64 = math.round(input)
    var round_explicit: f64 = math.round<f64>(input)
    var lerp_inferred: f64 = math.lerp(input, input, input)
    var lerp_explicit: f64 = math.lerp<f64>(input, input, input)
    var inverse_lerp_inferred: f64 = math.inverse_lerp(input, input, input)
    var inverse_lerp_explicit: f64 = math.inverse_lerp<f64>(input, input, input)
    var sin_inferred: f64 = math.sin(input)
    var sin_explicit: f64 = math.sin<f64>(input)
    var cos_inferred: f64 = math.cos(input)
    var cos_explicit: f64 = math.cos<f64>(input)
    var tan_inferred: f64 = math.tan(input)
    var tan_explicit: f64 = math.tan<f64>(input)
    var asin_inferred: f64 = math.asin(input)
    var asin_explicit: f64 = math.asin<f64>(input)
    var acos_inferred: f64 = math.acos(input)
    var acos_explicit: f64 = math.acos<f64>(input)
    var atan_inferred: f64 = math.atan(input)
    var atan_explicit: f64 = math.atan<f64>(input)
    var atan2_inferred: f64 = math.atan2(input, input)
    var atan2_explicit: f64 = math.atan2<f64>(input, input)
    var sqrt_inferred: f64 = math.sqrt(input)
    var sqrt_explicit: f64 = math.sqrt<f64>(input)
    var pow_inferred: f64 = math.pow(input, input)
    var pow_explicit: f64 = math.pow<f64>(input, input)
    var exp_inferred: f64 = math.exp(input)
    var exp_explicit: f64 = math.exp<f64>(input)
    var exp2_inferred: f64 = math.exp2(input)
    var exp2_explicit: f64 = math.exp2<f64>(input)
    var log_inferred: f64 = math.log(input)
    var log_explicit: f64 = math.log<f64>(input)
    var log2_inferred: f64 = math.log2(input)
    var log2_explicit: f64 = math.log2<f64>(input)
    var radians_inferred: f64 = math.radians(input)
    var radians_explicit: f64 = math.radians<f64>(input)
    var degrees_inferred: f64 = math.degrees(input)
    var degrees_explicit: f64 = math.degrees<f64>(input)
