use math
use encoding/binary
use convert

func raw_bits<t>(value: t) -> u64:
    var bytes = binary.encode(value)
    var result: u64 = 0
    for index in bytes.count - 1..0:
        result = result * 256 + (bytes[index] as u64)
    return result

func stored_f32(raw: u64) -> f32:
    var bytes: [u8] = []
    for index in 0..<4:
        bytes.push((raw % 256) as u8)
        raw = raw / 256
    return convert.unwrap(binary.decode<f32>(bytes))

func stored_f64(raw: u64) -> f64:
    var bytes: [u8] = []
    for index in 0..<8:
        bytes.push((raw % 256) as u8)
        raw = raw / 256
    return convert.unwrap(binary.decode<f64>(bytes))


func core_i8():
    print(math.min<i8>(-128, 127))
    print(math.min<i8>(127, -128))
    print(math.max<i8>(-128, 127))
    print(math.max<i8>(127, -128))
    print(math.clamp<i8>(-128, 0, 127))
    print(math.clamp<i8>(127, -128, 127))
    print(math.abs<i8>(127))
    print(math.sign<i8>(-128))
    print(math.sign<i8>(127))
    print(math.sign<i8>(0))

