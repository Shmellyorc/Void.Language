func entry(input: i32) -> i32:
    core_i8()
    core_u8()
    core_i16()
    core_u16()
    core_i32()
    core_u32()
    core_i64()
    core_u64()
    constants_f32()
    selectors_f32()
    rounding_f32()
    interpolation_f32()
    special_unary_f32()
    atan2_special_f32()
    pow_special_f32()
    constants_f64()
    selectors_f64()
    rounding_f64()
    interpolation_f64()
    special_unary_f64()
    atan2_special_f64()
    pow_special_f64()
    reference_sin_f32()
    reference_cos_f32()
    reference_tan_f32()
    reference_asin_f32()
    reference_acos_f32()
    reference_atan_f32()
    reference_atan2_f32()
    reference_sqrt_f32()
    reference_pow_f32()
    reference_exp_f32()
    reference_exp2_f32()
    reference_log_f32()
    reference_log2_f32()
    reference_sin_f64()
    reference_cos_f64()
    reference_tan_f64()
    reference_asin_f64()
    reference_acos_f64()
    reference_atan_f64()
    reference_atan2_f64()
    reference_sqrt_f64()
    reference_pow_f64()
    reference_exp_f64()
    reference_exp2_f64()
    reference_log_f64()
    reference_log2_f64()
    print(raw_bits(math.sin(input as f64)))
    return 0
