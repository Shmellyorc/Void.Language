diff --git a/tools/ci/stage10_macos_stack.sh b/tools/ci/stage10_macos_stack.sh
new file mode 100644
index 0000000..7b608c0
--- /dev/null
+++ b/tools/ci/stage10_macos_stack.sh
@@ -0,0 +1,11 @@
+#!/bin/bash
+# Set limits before starting Python: custom Mach-O stacks can reject setrlimit.
+set -euo pipefail
+printf 'stack before (KiB): soft=%s hard=%s\n' "$(ulimit -S -s)" "$(ulimit -H -s)"
+ulimit -S -s 1024
+ulimit -H -s 1024
+soft=$(ulimit -S -s)
+hard=$(ulimit -H -s)
+printf 'stack inherited (KiB): soft=%s hard=%s\n' "$soft" "$hard"
+[[ "$soft" == 1024 && "$hard" == 1024 ]]
+exec "$@"
