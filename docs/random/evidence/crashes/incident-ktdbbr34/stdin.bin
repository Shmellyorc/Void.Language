{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file:///tmp/VOID%20documentation%20%C3%A9%F0%9F%98%80%20uzwov069/main.void","version":40},"contentChanges":[{"text":"enum parcel:\n    empty\n    ## A parcel carrying a result.\n    data(item: result<i32, string>)\nstruct box:\n    value: i32\nfunc unused<t>(value: t) -> result<t, string>:\n    return Ok(value)\nfunc main():\n    var value: result<i32, string> = Ok(3)\n    var error: result<i32, string> = Err(\"bad\")\n    if value is Ok(var success):\n        print(success)\n    match value:\n        Ok(i32(var matched)):\n            print(matched)\n        Err(var failure):\n            print(failure)\n    var nested = parcel.data(value)\n    match nested:\n        parcel.data(Ok(var inner)):\n            print(inner)\n        _:\n            pass\n    var doubly: result<result<i32, string>, string> = Ok(Ok(5))\n    match doubly:\n        Ok(Ok(var deep)):\n            print(deep)\n        _:\n            pass\n    var maybe: box? = box(value = 2)\n    if maybe is Ok(var present):\n        print(present.value)\n"}]}}Content-Length: 49

