func numeric_case_5():
    var gu8 = random.generator(seed = 42)
    print(gu8.rand_u8())
    print(gu8.rand_u8(1))
    print(convert.unwrap(gu8.try_rand_u8(maximum = 1)))
    print(gu8.rand_u8(2))
    print(convert.unwrap(gu8.try_rand_u8(maximum = 2)))
    print(gu8.rand_u8(3))
    print(convert.unwrap(gu8.try_rand_u8(maximum = 3)))
    print(gu8.rand_u8(129))
    print(convert.unwrap(gu8.try_rand_u8(maximum = 129)))
    print(gu8.rand_u8(255))
    print(convert.unwrap(gu8.try_rand_u8(maximum = 255)))
    print(gu8.rand_u8(upper = 255, lower = 0))
    print(convert.unwrap(gu8.try_rand_u8(0, 255)))
    print(gu8.rand_u8(upper = 1, lower = 0))
    print(convert.unwrap(gu8.try_rand_u8(0, 1)))
    print(gu8.rand_u8(upper = 255, lower = 254))
    print(convert.unwrap(gu8.try_rand_u8(254, 255)))
    print(gu8.rand_u8(upper = 7, lower = 0))
    print(convert.unwrap(gu8.try_rand_u8(0, 7)))
    print(gu8.rand_range<u8>(0, 255))
    print(convert.unwrap(gu8.try_rand_range<u8>(0, 255)))
    print(gu8.rand_range<u8>(255, 255))
    random.seed(42)
    print(random.rand_u8())
    print(convert.unwrap(random.try_rand_u8()))
    print(random.rand_u8(7))
    print(convert.unwrap(random.try_rand_u8(7)))
    print(random.rand_u8(0, 255))
    print(convert.unwrap(random.try_rand_u8(upper = 255, lower = 0)))
    print(random.rand_range<u8>(0, 255))
    print(convert.unwrap(random.try_rand_range<u8>(0, 255)))
    if gu8.try_rand_u8(0) is Err(var reason):
        print(reason.code)
    else:
        print(-99)
    if gu8.try_rand_u8(2, 2) is Err(var reason):
        print(reason.code)
    else:
        print(-99)
    if gu8.try_rand_u8(3, 1) is Err(var reason):
        print(reason.code)
    else:
        print(-99)
    if gu8.try_rand_range<u8>(3, 1) is Err(var reason):
        print(reason.code)
    else:
        print(-99)
    if random.try_rand_u8(0) is Err(var reason):
        print(reason.code)
    else:
        print(-99)
    if random.try_rand_u8(2, 2) is Err(var reason):
        print(reason.code)
    else:
        print(-99)
    print(gu8.rand_u64())
    print(random.rand_u64())

