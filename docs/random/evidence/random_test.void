func numeric_case_16():
    var zero_f32 = random.generator(seed = 14092058508772706262)
    print(raw_bits(zero_f32.rand_f32()))
    var zero_f64 = random.generator(seed = 14092058508772706262)
    print(raw_bits(zero_f64.rand_f64()))
    var zero_i8 = random.generator(seed = 14092058508772706262)
    print(zero_i8.rand_i8())
    var zero_i16 = random.generator(seed = 14092058508772706262)
    print(zero_i16.rand_i16())
    var zero_i32 = random.generator(seed = 14092058508772706262)
    print(zero_i32.rand_i32())
    var zero_i64 = random.generator(seed = 14092058508772706262)
    print(zero_i64.rand_i64())
    var stream = random.generator(seed = 42)
    var saved_stream = stream
    print(stream.boolean())
    print(saved_stream.rand_u64())
    print(stream.rand_u64())
    stream.seed(42)
    var list = [0, 1, 2, 3]
    var alias = list
    stream.shuffle(list)
    print(alias[0])
    print(alias[1])
    print(alias[2])
    print(alias[3])
    print(stream.rand_u64())
    var empty: [i32] = []
    var one = [17]
    stream.shuffle(empty)
    stream.shuffle(one)
    print(stream.choose(one))
    var one_copy = stream.shuffled(one)
    one_copy[0] = 9
    print(one[0])
    print(stream.rand_range(-3, -3))
    print(stream.rand_u64())
    if stream.try_choose(empty) is Err(var reason):
        print(reason.code)
    else:
        print(-99)
    random.seed(42)
    var data = [10, 20, 30]
    var fixed: [i32, 3] = [10, 20, 30]
    print(random.choose(data))
    print(convert.unwrap(random.try_choose(fixed[0..<fixed.count])))
    var copy = random.shuffled(data)
    print(copy[0])
    print(copy[1])
    print(copy[2])
    var checked_copy = random.try_shuffled(data)
    if checked_copy is Ok(var inner):
        print(inner[0])
        print(inner[1])
        print(inner[2])
    var done = random.try_shuffle(data)
    print(data[0])
    print(data[1])
    print(data[2])
    print(random.rand_u64())

func numeric_case_17():
    var histogram = [0, 0, 0, 0, 0, 0, 0]
    var histogram_engine = random.generator(seed = 42)
    for index in 0..<4096:
        var position = histogram_engine.rand_i32(7)
        histogram[position] += 1
    print(histogram[0])
    print(histogram[1])
    print(histogram[2])
    print(histogram[3])
    print(histogram[4])
    print(histogram[5])
    print(histogram[6])

