use random
use convert
use encoding/binary

func raw_bits<t>(value: t) -> u64:
    var bytes = binary.encode(value)
    var result: u64 = 0
    for index in bytes.count - 1..0:
        result = result * 256 + (bytes[index] as u64)
    return result

func numeric_case_0():
    var engine0 = random.generator(seed = 0)
    for index in 0..<64:
        print(engine0.rand_u64())

func numeric_case_1():
    var engine1 = random.generator(seed = 1)
    for index in 0..<64:
        print(engine1.rand_u64())

