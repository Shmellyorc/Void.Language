value struct point:
    x: i32 = 4

func (p point) init(value: i32 = 3):
    p.x += value

value struct packet:
    child: point

func (p packet) init(copy: point):
    copy.x += 100
    p.child = copy

func copied(value: packet) -> packet:
    value.child.x++
    return value

func entry(value: i32) -> i32:
    const original = point(value)
    const packed = packet(original)
    const returned = copied(packed)
    return original.x + packed.child.x + returned.child.x
