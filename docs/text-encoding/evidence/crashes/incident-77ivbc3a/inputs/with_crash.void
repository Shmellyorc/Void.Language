struct log:
    values: [i32]

struct resource:
    log: log
    id: i32

func (r resource) deinit():
    r.log.values.push(r.id)

func work(l: log, value: i32) -> result<i32, i32>:
    with resource(log=l, id=value) as r:
        defer l.values.push(99)
        if value == 0:
            return Err(-1)
        l.values.push(10)
    l.values.push(20)
    return Ok(3)

func entry(value: i32) -> i32:
    var l = log(values=[])
    var result = work(l, value)
    var r = resource(log=l, id=50)
    var alias = r
    r.deinit()
    alias.deinit()
    return l.values[0] + l.values[1] + l.values[2] + l.values[3] + l.values[4]
