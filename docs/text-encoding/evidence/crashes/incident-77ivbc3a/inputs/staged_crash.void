struct node:
    value: i32

value struct packet:
    owner: node?
    count: i32

value struct outer:
    using nested: packet

struct owner:
    required: node
    using payload: outer

func update(o: owner):
    o.payload.count++

func (o owner) init(n: node):
    o.required = n
    o.payload = outer(nested = packet(owner = n, count = 3))
    update(o)

func entry(value: i32) -> i32:
    var n = node(value = value)
    var p = owner(n)
    var copy = p.payload
    copy.count++
    return (copy.owner as node).value + p.payload.count + copy.count
