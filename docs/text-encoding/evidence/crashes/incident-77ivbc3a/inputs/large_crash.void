func make(value: i32) -> func() -> i32:
    var items: [i32, 524288]
    items[524287] = value
    return func() -> i32:
        items[524287] += 1
        return items[524287]
func entry(value: i32) -> i32:
    var callback = make(value)
    var alias = callback
    var first = callback()
    return first + alias()
