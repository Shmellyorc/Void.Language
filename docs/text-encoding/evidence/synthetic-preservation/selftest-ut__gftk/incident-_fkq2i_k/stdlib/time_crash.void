func (self local_datetime) format(spec: string) -> result<string, error>:
    var outcome = _local_format(
        self.year,
        self.month,
        self.day,
        self.hour,
        self.minute,
        self.second,
        self.nanosecond as i64,
        spec
    )
    return _checked<string>(outcome)

## Render the default invariant temporal display.
