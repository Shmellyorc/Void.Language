## An opaque monotonic sample tied to its owning Runtime clock.
value struct monotonic_tick:
    private const _seconds: i64
    private const _nanosecond: i64
    private const _context: i64

private func (self monotonic_tick) init(seconds: i64, nanosecond: i64, context: i64):
    self._seconds = seconds
    self._nanosecond = nanosecond
    self._context = context

private property (self monotonic_tick) seconds: i64:
    get:
        return self._seconds

private property (self monotonic_tick) nanosecond: i64:
    get:
        return self._nanosecond

private property (self monotonic_tick) context: i64:
    get:
        return self._context

private value struct _clock_sample:
    private const _seconds: i64
    private const _nanosecond: i64
    private const _context: i64

private func (self _clock_sample) init(seconds: i64, nanosecond: i64, context: i64):
    self._seconds = seconds
    self._nanosecond = nanosecond
    self._context = context

## Read the validated seconds component.
## @return The stored validated component without changing this value.
property (self _clock_sample) seconds: i64:
    get:
        return self._seconds

## Read the validated nanosecond component.
## @return The stored validated component without changing this value.
property (self _clock_sample) nanosecond: i64:
    get:
        return self._nanosecond

## Read the validated context component.
## @return The stored validated component without changing this value.
property (self _clock_sample) context: i64:
    get:
        return self._context

## Read the validated rules version component.
## @return The stored validated component without changing this value.
property (self zone) rules_version: string:
    get:
        return "2026e"

## Policy for resolving ambiguous local times in a timezone.
enum local_choice:
    ## Reject ambiguous or nonexistent local times.
    reject
    ## Choose the earlier matching instant.
    earlier
    ## Choose the later matching instant.
    later

## Validate and construct a Gregorian calendar date.
## @param year The calendar year.
## @param month The month from 1 through 12.
## @param day The day of the month.
## @return Validated value on success; a managed temporal error on invalid data or range.
func make_date(year: i64, month: i64, day: i64) -> result<date, error>:
    var checked = _checked<i64>(_date_check(year, month, day))?
    return Ok(date(year, month, day))

## Validate and construct a wall clock time.
## @param hour Hour from 0 through 23.
## @param minute Minute from 0 through 59.
## @param second Second from 0 through 59.
## @param nanosecond Normalized fractional second from 0 through 999999999.
## @return Validated value on success; a managed temporal error on invalid data or range.
func make_time(hour: i64, minute: i64, second: i64, nanosecond: i64 = 0) -> result<time_of_day, error>:
    var checked = _checked<i64>(_time_check(hour, minute, second, nanosecond))?
    return Ok(time_of_day(hour, minute, second, nanosecond as u32))

## Combine a validated date and wall clock time.
## @param day Validated date, or day of month for date construction.
## @param clock Validated wall clock time to combine with the date.
## @return Validated value on success; a managed temporal error on invalid data or range.
func make_local_datetime(day: date, clock: time_of_day) -> result<local_datetime, error>:
    return Ok(local_datetime(day.year, day.month, day.day, clock.hour, clock.minute, clock.second, clock.nanosecond))

## Construct an instant with checked nanosecond normalization.
## @param seconds Signed whole seconds relative to the operation’s epoch.
## @param nanosecond Normalized fractional second from 0 through 999999999.
## @return Validated value on success; a managed temporal error on invalid data or range.
func make_instant(seconds: i64, nanosecond: i64 = 0) -> result<instant, error>:
    var checked = _checked<i64>(_time_check(0, 0, 0, nanosecond))?
    return Ok(instant(seconds, nanosecond as u32))

## Construct a duration with checked nanosecond normalization.
## @param seconds Signed whole seconds relative to the operation’s epoch.
## @param nanosecond Normalized fractional second from 0 through 999999999.
## @return Validated value on success; a managed temporal error on invalid data or range.
func make_duration(seconds: i64, nanosecond: i64 = 0) -> result<duration, error>:
    var checked = _checked<i64>(_time_check(0, 0, 0, nanosecond))?
    return Ok(duration(seconds, nanosecond as u32))

## Resolve a canonical timezone using the bundled database.
## @param name Timezone name to resolve using the bundled rules.
## @return Validated value on success; a managed temporal error on invalid data or range.
func find_zone(name: string) -> result<zone, error>:
    var canonical = _checked<string>(_zone(name))?
    return Ok(zone(canonical))

## Project an instant into a checked fixed UTC offset.
## @param value Validated temporal value to project or resolve.
## @param offset_seconds UTC offset in seconds, strictly between -86400 and 86400.
## @return Validated value on success; a managed temporal error on invalid data or range.
func at_offset(value: instant, offset_seconds: i64) -> result<offset_datetime, error>:
    var packed = _checked<i64>(_project(value.seconds, offset_seconds))?
    var second = packed % 100
    packed = packed / 100
    var minute = packed % 100
    packed = packed / 100
    var hour = packed % 100
    packed = packed / 100
    var day = packed % 100
    packed = packed / 100
    var month = packed % 100
    var year = packed / 100
    return Ok(offset_datetime(year, month, day, hour, minute, second, value.nanosecond, offset_seconds))

## Associate an instant with a canonical timezone.
## @param value Validated temporal value to project or resolve.
## @param selected Canonical timezone whose rules should be applied.
## @return Validated value on success; a managed temporal error on invalid data or range.
func in_zone(value: instant, selected: zone) -> result<zoned_datetime, error>:
    var offset = _checked<i64>(_zone_offset(value.seconds, selected.name))?
    var checked = _checked<i64>(_project(value.seconds, offset))?
    return Ok(zoned_datetime(value.seconds, value.nanosecond, selected.name))

## Resolve civil time using the selected timezone ambiguity policy.
## @param value Validated temporal value to project or resolve.
## @param selected Canonical timezone whose rules should be applied.
## @param choice Reject, earlier or later selection for ambiguous local time.
## @return Validated value on success; a managed temporal error on invalid data or range.
func resolve_local(value: local_datetime, selected: zone, choice: local_choice = local_choice.reject ) -> result<zoned_datetime, error>:
    var seconds = _checked<i64>(_civil_seconds(value.year, value.month, value.day, value.hour, value.minute, value.second))?
    var selection: i64 = 0
    if choice is local_choice.earlier:
        selection = 1
    if choice is local_choice.later:
        selection = 2
    var resolved = _checked<i64>(_resolve(seconds, selected.name, selection))?
    return Ok(zoned_datetime(resolved, value.nanosecond, selected.name))

## Sample the system UTC clock.
## @return Validated value on success; a managed temporal error on invalid data or range.
func now_utc() -> result<instant, error>:
    var sample = _checked<_clock_sample>(_now())?
    return make_instant(sample.seconds, sample.nanosecond)

## Sample the owning Runtime monotonic clock.
## @return Validated value on success; a managed temporal error on invalid data or range.
func monotonic_now() -> result<monotonic_tick, error>:
    var sample = _checked<_clock_sample>(_monotonic())?
    return Ok(monotonic_tick(sample.seconds, sample.nanosecond, sample.context))

## Query nominal UTC clock resolution in nanoseconds.
## @return Validated value on success; a managed temporal error on invalid data or range.
func utc_precision_ns() -> result<i64, error>:
    return _checked<i64>(_utc_precision())

## Query nominal monotonic clock resolution in nanoseconds.
## @return Validated value on success; a managed temporal error on invalid data or range.
func monotonic_precision_ns() -> result<i64, error>:
    return _checked<i64>(_monotonic_precision())

private func _combine(a: i64, an: i64, b: i64, bn: i64, subtract: bool) -> result<_clock_sample, error>:
    var ns: i64 = an + bn
    var carry: i64 = 0
    var operation: i64 = 0
    if subtract:
        operation = 1
        ns = an - bn
        if ns < 0:
            ns += 1000000000
            carry = -1
    else:
        if ns >= 1000000000:
            ns -= 1000000000
            carry = 1
    var seconds = _checked<i64>(_seconds(a, b, operation, carry))?
    return Ok(_clock_sample(seconds, ns, 0))

## Add a duration with checked seconds arithmetic.
## @param delta Duration to add or subtract with checked seconds arithmetic.
## @return Validated value on success; a managed temporal error on invalid data or range.
func (self instant) add(delta: duration) -> result<instant, error>:
    var value = _combine(self.seconds, self.nanosecond as i64, delta.seconds, delta.nanosecond as i64, false)?
    return make_instant(value.seconds, value.nanosecond)

## Subtract a duration with checked seconds arithmetic.
## @param delta Duration to add or subtract with checked seconds arithmetic.
## @return Validated value on success; a managed temporal error on invalid data or range.
func (self instant) subtract(delta: duration) -> result<instant, error>:
    var value = _combine(self.seconds, self.nanosecond as i64, delta.seconds, delta.nanosecond as i64, true)?
    return make_instant(value.seconds, value.nanosecond)

## Compute the checked duration between two instants.
## @param other Other temporal value used by this checked operation.
## @return Validated value on success; a managed temporal error on invalid data or range.
func (self instant) difference(other: instant) -> result<duration, error>:
    var value = _combine(self.seconds, self.nanosecond as i64, other.seconds, other.nanosecond as i64, true)?
    return make_duration(value.seconds, value.nanosecond)

## Add a duration with checked seconds arithmetic.
## @param other Other temporal value used by this checked operation.
## @return Validated value on success; a managed temporal error on invalid data or range.
func (self duration) add(other: duration) -> result<duration, error>:
    var value = _combine(self.seconds, self.nanosecond as i64, other.seconds, other.nanosecond as i64, false)?
    return make_duration(value.seconds, value.nanosecond)

## Subtract a duration with checked seconds arithmetic.
## @param other Other temporal value used by this checked operation.
## @return Validated value on success; a managed temporal error on invalid data or range.
func (self duration) subtract(other: duration) -> result<duration, error>:
    var value = _combine(self.seconds, self.nanosecond as i64, other.seconds, other.nanosecond as i64, true)?
    return make_duration(value.seconds, value.nanosecond)

## Compute elapsed time between samples from the same Runtime clock.
## @param start Earlier sample from the same Runtime monotonic clock.
## @param end Later sample from the same Runtime monotonic clock.
## @return Validated value on success; a managed temporal error on invalid data or range.
func elapsed(start: monotonic_tick, end: monotonic_tick) -> result<duration, error>:
    if start.context != end.context:
        return Err(error(message = "Monotonic values belong to different Runtime clock contexts", operation = "monotonic"))
    var value = _combine(end.seconds, end.nanosecond, start.seconds, start.nanosecond, true)?
    return make_duration(value.seconds, value.nanosecond)

## Project this zoned instant into its civil components and UTC offset.
## @return Validated value on success; a managed temporal error on invalid data or range.
func (self zoned_datetime) components() -> result<offset_datetime, error>:
    var point = make_instant(self.seconds, self.nanosecond as i64)?
    var offset = _checked<i64>(_zone_offset(self.seconds, self.zone_name))?
    return at_offset(point, offset)

## Format this temporal value with an invariant pattern.
## @param spec Invariant temporal format pattern; empty selects the default display.
## @return Validated value on success; a managed temporal error on invalid data or range.
func (self date) format(spec: string) -> result<string, error>:
    return _checked<string>(_date_format(self.year, self.month, self.day, spec))

## Render the default invariant temporal display.
## @return Owned invariant display text; checked Runtime failure if default formatting fails.
func (self date) string() -> string:
    return _temporal_unwrap(_temporal_result(self.format("")))

## Format this temporal value with an invariant pattern.
## @param spec Invariant temporal format pattern; empty selects the default display.
## @return Validated value on success; a managed temporal error on invalid data or range.
func (self time_of_day) format(spec: string) -> result<string, error>:
    return _checked<string>(_time_format(self.hour, self.minute, self.second, self.nanosecond as i64, spec))

## Render the default invariant temporal display.
## @return Owned invariant display text; checked Runtime failure if default formatting fails.
func (self time_of_day) string() -> string:
    return _temporal_unwrap(_temporal_result(self.format("")))

