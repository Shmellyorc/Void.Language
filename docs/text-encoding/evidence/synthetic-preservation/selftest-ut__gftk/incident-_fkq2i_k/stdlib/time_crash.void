use error as core

## Recoverable calendar, clock, zone, arithmetic or temporal-format failure.
struct error extends core.error:
    ## Operation family producing the failure; the message carries precise details.
    operation: string

private func _checked<t>(outcome: result<t, string>) -> result<t, error>:
    if outcome is Ok(var value):
        return Ok(value)
    if outcome is Err(var message):
        return Err(error(message = message, operation = "time"))
    return Err(error(message = "Invalid temporal result", operation = "time"))

# Validated temporal values over the compiler-owned, versioned Runtime kernel.

## A validated proleptic Gregorian calendar date.
value struct date:
    private const _year: i64
    private const _month: i64
    private const _day: i64

private func (self date) init(year: i64, month: i64, day: i64):
    self._year = year
    self._month = month
    self._day = day

## Read the validated year component.
## @return The stored validated component without changing this value.
property (self date) year: i64:
    get:
        return self._year

## Read the validated month component.
## @return The stored validated component without changing this value.
property (self date) month: i64:
    get:
        return self._month

## Read the validated day component.
## @return The stored validated component without changing this value.
property (self date) day: i64:
    get:
        return self._day

