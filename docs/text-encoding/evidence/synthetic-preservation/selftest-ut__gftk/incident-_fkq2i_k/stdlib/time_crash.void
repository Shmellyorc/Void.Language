## Read the validated date component.
## @return The stored validated component without changing this value.
property (self local_datetime) date: date:
    get:
        return date(self.year, self.month, self.day)

## Read the validated time component.
## @return The stored validated component without changing this value.
property (self local_datetime) time: time_of_day:
    get:
        return time_of_day(self.hour, self.minute, self.second, self.nanosecond)

## Read the validated local component.
## @return The stored validated component without changing this value.
property (self offset_datetime) local: local_datetime:
    get:
        return local_datetime(self.year, self.month, self.day, self.hour, self.minute, self.second, self.nanosecond)

## Convert fixed-offset civil time into a checked Unix instant.
## @return Validated value on success; a managed temporal error on invalid data or range.
func (self offset_datetime) to_instant() -> result<instant, error>:
    var seconds = _checked<i64>(_civil_seconds(self.year, self.month, self.day, self.hour, self.minute, self.second))?
    var shifted = _checked<i64>(_seconds(seconds, self.offset_seconds, 1, 0))?
    return make_instant(shifted, self.nanosecond as i64)

## Read the validated instant component.
## @return The stored validated component without changing this value.
property (self zoned_datetime) instant: instant:
    get:
        return instant(self.seconds, self.nanosecond)

## Read the validated zone component.
## @return The stored validated component without changing this value.
property (self zoned_datetime) zone: zone:
    get:
        return zone(self.zone_name)

## Compare monotonic samples from the same owning Runtime clock.
## @param other Other temporal value used by this checked operation.
## @return Validated value on success; a managed temporal error on invalid data or range.
func (self monotonic_tick) compare(other: monotonic_tick) -> result<i32, error>:
    if self.context != other.context:
        return Err(error(message = "Monotonic values belong to different Runtime clock contexts", operation = "monotonic"))
    if self.seconds < other.seconds:
        return Ok(-1)
    if self.seconds > other.seconds:
        return Ok(1)
    if self.nanosecond < other.nanosecond:
        return Ok(-1)
    if self.nanosecond > other.nanosecond:
        return Ok(1)
    return Ok(0)
