diff --git a/src/ir/numeric_enum_storage.inc b/src/ir/numeric_enum_storage.inc
new file mode 100644
index 0000000..9a073df
--- /dev/null
+++ b/src/ir/numeric_enum_storage.inc
@@ -0,0 +1,49 @@
+// Only inline fields can expose an uninitialized scalar discriminant. Heap and
+// collection references use their existing construction and publication checks.
+bool contains_numeric_enum(Type root) {
+    if(root.kind!=Type::aggregate)return root.kind==Type::numeric_enum;
+    std::vector<Type> pending{root};
+    std::set<const ValueType*> seen;
+    for(std::size_t n=0;n<pending.size();++n) {
+        const auto type=pending[n];
+        if(type.kind==Type::numeric_enum)return true;
+        if(type.kind==Type::aggregate && type.definition && seen.insert(type.definition.get()).second)
+            for(const auto& field:type.definition->fields)pending.emplace_back(field.type);
+    }
+    return false;
+}
+
+void validate_numeric_enum_slots(const Function& f) {
+    std::set<unsigned> tracked;
+    for(unsigned n=0;n<f.locals.size();++n)if(contains_numeric_enum(f.locals[n]))tracked.insert(n);
+    if(tracked.empty())return;
+
+    // Follow explicit control-flow edges, intersecting definitely initialized
+    // slots at joins. An aggregate receiver is bound by the incoming ABI.
+    std::vector<std::optional<std::set<unsigned>>> inputs(f.blocks.size());
+    inputs.front().emplace();
+    if(f.receiver && tracked.contains(0))inputs.front()->insert(0);
+    std::vector<unsigned> work{0};
+    while(!work.empty()) {
+        const auto id=work.back();work.pop_back();
+        auto state=*inputs[id];
+        const auto& block=f.blocks[id];
+        auto require=[&](unsigned slot) {
+            if(tracked.contains(slot) && !state.contains(slot))
+                throw std::invalid_argument("VOID IR: read of uninitialized numeric enum storage in "+f.name);
+        };
+        for(const auto& i:block.instructions) {
+            if(i.op==Op::load)require(i.a);
+            if(i.receiver)require(i.receiver->slot);
+            if(i.op==Op::store && tracked.contains(i.a))state.insert(i.a);
+        }
+        auto edge=[&](unsigned target) {
+            auto& known=inputs[target];
+            if(!known){known=state;work.push_back(target);return;}
+            const auto removed=std::erase_if(*known,[&](unsigned slot){return !state.contains(slot);});
+            if(removed)work.push_back(target);
+        };
+        if(block.end.kind==Terminator::Kind::jump || block.end.kind==Terminator::Kind::branch)edge(block.end.yes);
+        if(block.end.kind==Terminator::Kind::branch)edge(block.end.no);
+    }
+}
