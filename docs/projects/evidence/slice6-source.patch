index 0000000..5ef406e
--- /dev/null
+++ b/tests/numeric/enums.py
@@ -0,0 +1,244 @@
+"""Cross-mode tests for the eight integer backings and fallible cast boundaries."""
+from pathlib import Path
+import json
+import os
+import subprocess
+import sys
+import tempfile
+
+compiler, evidence = (Path(name).resolve() for name in sys.argv[1:])
+limits = {
+    f"{sign}{width}": (-(1 << (width - 1)), (1 << (width - 1)) - 1) if sign == "i" else (0, (1 << width) - 1)
+    for sign in ("i", "u") for width in (8, 16, 32, 64)
+}
+records = []
+cases = 0
+
+
+def invoke(argv, directory, expected=0, stack_bytes=None):
+    def limit_stack():
+        import resource
+        _, hard = resource.getrlimit(resource.RLIMIT_STACK)
+        resource.setrlimit(resource.RLIMIT_STACK, (stack_bytes, hard))
+
+    result = subprocess.run(list(map(str, argv)), cwd=directory, capture_output=True, timeout=150,
+                            preexec_fn=limit_stack if stack_bytes else None)
+    row = {"argv": list(map(str, argv)), "status": result.returncode,
+           "stdout": result.stdout.decode("utf-8", "replace"), "stderr": result.stderr.decode("utf-8", "replace")}
+    if stack_bytes:
+        row["stack_bytes"] = stack_bytes
+    records.append(row)
+    assert result.returncode == expected, row
+    return row
+
+
+def integer_cases():
+    global cases
+    declarations, calls = [], []
+    for src, (src_min, src_max) in limits.items():
+        for dest, (dest_min, dest_max) in limits.items():
+            name = f"cast_{src}_{dest}"
+            declarations.append(f"func {name}(value: {src}) -> option<{dest}>:\n    return value as? {dest}\n")
+            points = {src_min, src_max, -1, 0, 1, dest_min - 1, dest_min, dest_max, dest_max + 1}
+            for value in sorted(point for point in points if src_min <= point <= src_max):
+                pattern = f"Some({value})" if dest_min <= value <= dest_max else "None"
+                calls.append(f"    if not ({name}({value}) is {pattern}):\n        return 11")
+                cases += 1
+    return declarations, calls
+
+
+def enum_cases():
+    global cases
+    declarations, calls = [], []
+    for dest, (minimum, maximum) in limits.items():
+        # Sparse endpoints. A signed enum here excludes zero, including in inactive storage.
+        first = minimum
+        declarations += [f"enum enum_{dest}({dest}):\n    first = {first}\n    last = {maximum}\n"]
+        for src, (src_min, src_max) in limits.items():
+            name = f"decode_{src}_{dest}"
+            declarations += [f"func {name}(value: {src}) -> option<enum_{dest}>:\n    return value as? enum_{dest}\n"]
+            for value in sorted({first, maximum, first - 1, first + 1, maximum + 1, -1, 0}):
+                if not src_min <= value <= src_max:
+                    continue
+                pattern = f"Some(enum_{dest}.first)" if value == first else f"Some(enum_{dest}.last)" if value == maximum else "None"
+                calls.append(f"    if not ({name}({value}) is {pattern}):\n        return 12")
+                cases += 1
+    return declarations, calls
+
+
+interaction = """use "./modes.void" as modes
+
+private struct option<t>:
+    value: t
+
+struct record:
+    mode: modes.mode = modes.mode.quiet
+    previous: modes.mode
+
+struct owner:
+    state: modes.mode
+    history: [modes.mode]
+
+struct initialized:
+    state: modes.mode = modes.mode.quiet
+
+func (self initialized) init():
+    if self.state == modes.mode.loud:
+        self.state = modes.mode.quiet
+
+func identity<t>(value: t) -> t:
+    return value
+
+var evaluations: i32 = 0
+const one = 255 as? modes.mode
+const hole = 4 as? modes.mode
+const maximum = 18446744073709551615 as? u64
+const from_i64 = 2147483648 as? i64
+const from_i32 = 2147483647 as? i32
+const lower = -9223372036854775808 as? i64
+const too_narrow = -129 as? i8
+
+func next(value: i32) -> i32:
+    evaluations += 1
+    return value
+
+func main() -> i32:
+    if not (one is Some(modes.mode.loud)) or not (hole is None):
+        return 1
+    if not (maximum is Some(18446744073709551615)) or not (lower is Some(-9223372036854775808)):
+        return 2
+    if not (from_i64 is Some(2147483648)) or not (from_i32 is Some(2147483647)) or not (too_narrow is None):
+        return 3
+    var loud = modes.mode.quiet
+    if identity(next(255) as? modes.mode) is Some(var converted):
+        loud = converted
+    else:
+        return 4
+    if not (next(-1) as? modes.mode is None) or evaluations != 2 or loud != modes.mode.loud:
+        return 5
+    var shadow: option<i32> = option<i32>(value = 21)
+    if shadow.value != 21 or modes.score(loud) != 19 or modes.score_cast(next(255) as? modes.mode) != 19:
+        return 6
+    var defaults = initialized()
+    if defaults.state != modes.mode.quiet or not (modes.default_score() is None):
+        return 10
+    var data = record(previous = loud)
+    var recent: [modes.mode, 2] = [data.mode, data.previous]
+    var object = owner(state = recent[0], history = [recent[1]])
+    var table: {i32: modes.mode} = {1: object.history[0]}
+    for i in 0..<4000:
+        var transient = owner(state = modes.mode.quiet, history = [modes.mode.loud])
+        if transient.state != modes.mode.quiet:
+            return 7
+    if object.state != modes.mode.quiet or table[1] != modes.mode.loud:
+        return 8
+    var existing: i16 = 7
+    if not (existing as i64 as? u8 is Some(7)):
+        return 9
+    return 0
+"""
+modes = """public enum mode(u8):
+    quiet = 3
+    loud = 255
+
+public func score(value: mode) -> i32:
+    return match value:
+        mode.quiet: 7
+        mode.loud: 19
+
+struct maybe_state:
+    cached: option<mode> = None
+
+func (self maybe_state) init():
+    if self.cached is Some(mode.loud):
+        self.cached = None
+
+public func default_score() -> option<mode>:
+    return maybe_state().cached
+
+public func score_cast<t>(value: option<t>) -> i32:
+    if value is Some(var decoded):
+        return score(decoded)
+    return 0
+"""
+
+try:
+    with tempfile.TemporaryDirectory(prefix="VOID S6 numeric enum ") as temporary:
+        root = Path(temporary).resolve()
+        integer_functions, integer_checks = integer_cases()
+        enum_functions, enum_checks = enum_cases()
+        boundary = "\n".join(integer_functions + enum_functions)
+        # Split checks into bounded activations for Windows Debug stack and diagnostics.
+        checks = integer_checks + enum_checks
+        chunks = [checks[start:start+32] for start in range(0, len(checks), 32)]
+        for n, chunk in enumerate(chunks):
+            boundary += f"\nfunc boundary_{n}() -> i32:\n" + "\n".join(chunk) + "\n    return 0\n"
+        boundary += "\nfunc main() -> i32:\n" + "".join(
+            f"    if boundary_{n}() != 0:\n        return {20+n}\n" for n in range(len(chunks))) + "    return 0\n"
+        (root / "modes.void").write_text(modes, encoding="utf-8")
+        for name, source in [("matrix", boundary), ("integration", interaction)]:
+            file = root / (name + ".void")
+            file.write_text(source, encoding="utf-8")
+            for optimization in (["--no-opt"], []):
+                mode = "normal" if optimization else "o2"
+                row = invoke([compiler, "run", file, "--no-cache", *optimization], root)
+                assert not row["stderr"], row
+                output = root / (name + "-" + mode + (".exe" if os.name == "nt" else ""))
+                invoke([compiler, "build", file, "-o", output, *optimization], root)
+                invoke([output], root)
+        file = root / "integration.void"
+        if sys.platform == "linux":
+            for optimization in (["--no-opt"], []):
+                invoke([compiler, "run", file, "--no-cache", *optimization], root, stack_bytes=1024 * 1024)
+        # Persistent native cache publication is unavailable on Windows.
+        # Require that exact result and confirm both runs still execute correctly.
+        windows = os.name == "nt"
+        for expected_cache in (("unavailable", "unavailable") if windows else ("miss", "hit")):
+            row = invoke([compiler, "run", file, "--cache"], root)
+            assert f"Debug cache: {expected_cache}" in row["stderr"], row
+        # A discriminant-only edit changes the compiled semantics and cache key.
+        helper = root / "modes.void"
+        helper.write_text(modes.replace("loud = 255", "loud = 254"), encoding="utf-8")
+        row = invoke([compiler, "run", file, "--cache"], root, 1)
+        expected_cache = "unavailable" if windows else "miss"
+        assert f"Debug cache: {expected_cache}" in row["stderr"], row
+        if windows:
+            assert not (root / ".void" / "cache").exists(), "Windows published a native cache"
+
+        prefix = "enum mode(u8):\n    idle = 1\n"
+        invalid = [
+            ("duplicate name", prefix + "    idle = 2\n", "Duplicate enum"),
+            ("duplicate value", prefix + "    ready = +1\n", "Duplicate numeric enum"),
+            ("duplicate mathematical zero", "enum mode(i8):\n    idle = -0\n    ready = 0\n", "Duplicate numeric enum"),
+            ("invalid backing", "enum mode(f32):\n    idle = 1\n", "fixed-width integer"),
+            ("negative unsigned", "enum mode(u64):\n    idle = -1\n", "unsigned"),
+            ("payload", prefix + "    ready(x: i32)\n", "Expected '='"),
+            ("implicit", prefix + "    ready\n", "Expected '='"),
+            ("arithmetic member", prefix + "    ready = 2 + 3\n", "Expected end of statement"),
+            ("float cast", "func main():\n    var x = 1.0 as? i32\n", "as? requires an integer"),
+            ("bool cast", "func main():\n    var x = true as? i32\n", "as? requires an integer"),
+            ("tagged cast", "enum tag:\n    idle\nfunc main():\n    var x = 1 as? tag\n", "as? requires an integer"),
+            ("enum extraction", prefix + "func main():\n    var x = mode.idle as? u8\n", "as? requires an integer"),
+            ("unrelated enums", prefix + "enum other(u8):\n    idle = 1\nfunc main():\n    var x: mode = other.idle\n", "Type mismatch"),
+            ("enum arithmetic", prefix + "func main():\n    var x = mode.idle + mode.idle\n", "Type mismatch"),
+            ("implicit conversion", prefix + "func main():\n    var x: mode = 1\n", "Type mismatch"),
+            ("uninitialized enum", prefix + "func main():\n    var x: mode\n", "explicit initializer"),
+            ("default enum array", prefix + "func main():\n    var x: [mode, 2]\n", "explicit values"),
+            ("shadow is nominal", "struct option<t>:\n    value: t\nfunc main():\n    var x: option<i8> = 1 as? i8\n", "Type mismatch"),
+            ("None needs context", "func main():\n    var x = None\n", "contextual option"),
+            ("legacy as still checks", "func main():\n    var x = 256 as u8\n", "outside the u8 range"),
+            ("literal past unsigned domain", "func main():\n    var x = 18446744073709551616 as? u64\n", "fixed-width integer domain"),
+            ("literal below signed domain", "func main():\n    var x = -9223372036854775809 as? i64\n", "fixed-width integer domain"),
+            ("split operator", "func main():\n    var x = 1 as ? i32\n", "without an intervening space"),
+        ]
+        for kind, (lo, hi) in limits.items():
+            for value in (lo - 1, hi + 1):
+                invalid.append((f"{kind} bound {value}", f"enum mode({kind}):\n    invalid = {value}\n", "range"))
+        for n, (label, source, message) in enumerate(invalid):
+            file = root / f"invalid_{n}.void"
+            file.write_text(source + ("\nfunc main():\n    pass\n" if "func main" not in source else ""), encoding="utf-8")
+            row = invoke([compiler, "check", file], root, 1)
+            assert message in row["stderr"], (label, row)
+    print(f"S6 {cases} boundary pairs, {len(invalid)} invalid sources and {len(records)} executed processes")
+finally:
+    evidence.write_text(json.dumps({"boundary_cases": cases, "records": records}, indent=2) + "\n", encoding="utf-8")
diff --git a/tests/numeric/enums_ir.cpp b/tests/numeric/enums_ir.cpp
new file mode 100644
index 0000000..fc5bcd8
--- /dev/null
+++ b/tests/numeric/enums_ir.cpp
@@ -0,0 +1,160 @@
+#include "void/backend.hpp"
+#include "void/frontend.hpp"
+#include "void/runtime.hpp"
+#include <algorithm>
+#include <iostream>
+#include <stdexcept>
+#include <string_view>
+
+namespace {
+using namespace vd::ir;
+void check(bool condition,std::string_view message) {
+    if(!condition)throw std::runtime_error(std::string(message));
+}
+void rejects(const Module& module,std::string_view message) {
+    try {validate(module);}
+    catch(const std::invalid_argument& error) {
+        check(std::string_view(error.what()).find(message)!=std::string_view::npos,error.what());
+        return;
+    }
+    throw std::runtime_error("Malformed IR accepted");
+}
+std::shared_ptr<const vd::ValidatedAnalysis> analysis(const std::string& text) {
+    auto result=vd::analyze_source({"enum-reload.void",text});
+    if(!result.succeeded())throw vd::CompilationError(std::move(result.diagnostics));
+    return result.program;
+}
+std::string source(std::string_view backing,unsigned high,int answer) {
+    return "enum mode("+std::string(backing)+"):\n    low = 3\n    high = "+std::to_string(high)+R"(
+
+struct state:
+    current: option<mode>
+    payload: [mode]
+
+func entry(raw: i32) -> i32:
+    var held = state(current = raw as? mode, payload = [mode.low])
+    for index in 0..<1024:
+        var temp = state(current = None, payload = [mode.high])
+        if not (temp.current is None):
+            return 2
+    if held.current is Some(mode.high) and held.payload[0] is mode.low:
+        return )"+std::to_string(answer)+"\n    return 1\n";
+}
+void malformed() {
+    const auto valid=analysis(source("u8",255,17))->lower();
+    auto bad=valid;
+    auto& checked=*std::find_if(bad.functions.begin(),bad.functions.end(),[](const auto& function) {
+        return std::any_of(function.blocks.begin(),function.blocks.end(),[](const auto& block) {
+            return std::any_of(block.instructions.begin(),block.instructions.end(),[](const auto& i){return i.op==Op::try_convert;});
+        });
+    });
+    Type option;
+    for(auto& block:checked.blocks)for(auto& i:block.instructions)if(i.op==Op::try_convert) {
+        option=i.type;i.type=Type::i32;
+    }
+    rejects(bad,"invalid fallible integer conversion");
+
+    bad=valid;
+    const auto enumeration=field_type(option,1);
+    auto probe=Function{};
+    probe.name=valid.identity+"::invalid_enum_ir";
+    probe.module_identity=valid.identity;
+    probe.source_name="invalid_enum_ir";
+    probe.parameters.clear();
+    probe.result=option;
+    Instruction boolean{Op::constant};boolean.type=Type::boolean;boolean.immediate=1;
+    Instruction attempt{Op::try_convert};attempt.type=option;
+    probe.blocks={{{boolean,attempt},{Terminator::Kind::return_value,1}}};
+    bad.functions.push_back(probe);
+    rejects(bad,"invalid fallible integer conversion");
+
+    probe.result=enumeration;
+    Instruction raw{Op::constant};raw.type=enumeration;raw.immediate=4;
+    probe.blocks={{{raw},{Terminator::Kind::return_value,0}}};
+    bad.functions.back()=probe;
+    rejects(bad,"undeclared numeric enum constant");
+    probe.locals={enumeration};
+    probe.blocks={{{Instruction{Op::load,0}},{Terminator::Kind::return_value,0}}};
+    bad.functions.back()=probe;
+    rejects(bad,"uninitialized numeric enum storage");
+
+    auto duplicate=std::make_shared<ValueType>();
+    duplicate->identity=valid.identity+"::bad_members";
+    duplicate->module_identity=valid.identity;
+    duplicate->name="bad_members";
+    duplicate->enum_backing=Type::i8;
+    duplicate->numeric_members={{"a",127},{"b",127}};
+    duplicate->self=duplicate;
+    bad=valid;
+    bad.nominal_types.push_back(Type::nominal(duplicate));
+    rejects(bad,"duplicate numeric enum discriminant");
+    duplicate->numeric_members[1].bits=256;
+    rejects(bad,"numeric enum discriminant");
+    duplicate->enum_backing=Type::f64;
+    rejects(bad,"invalid numeric enum descriptor");
+
+    auto forged=std::make_shared<ValueType>(*option.definition);
+    forged->identity=forged->name="$option:wrong";
+    forged->self=forged;
+    bad=valid;
+    bad.nominal_types.emplace_back(forged);
+    rejects(bad,"invalid canonical option identity");
+}
+void literal_source_types() {
+    const auto module=analysis(R"(func probe():
+    var i32_min = -2147483648 as? i64
+    var i32_max = 2147483647 as? i64
+    var below_i32 = -2147483649 as? i64
+    var above_i32 = 2147483648 as? i64
+    var i64_min = -9223372036854775808 as? i64
+    var i64_max = 9223372036854775807 as? i64
+    var above_i64 = 9223372036854775808 as? u64
+    var u64_max = 18446744073709551615 as? u64
+)" )->lower();
+    std::vector<Type> sources;
+    for(const auto& f:module.functions)for(const auto& block:f.blocks)for(const auto& op:block.instructions) {
+        if(op.op!=Op::try_convert)continue;
+        const auto& source=block.instructions.at(op.a);
+        check(source.op==Op::constant,"literal cast lowered a nonconstant operand");
+        sources.push_back(source.type);
+    }
+    check(sources==std::vector<Type>{Type::i32,Type::i32,Type::i64,Type::i64,Type::i64,Type::i64,Type::u64,Type::u64},
+          "literal fallible-cast source types disagree at an integer boundary");
+}
+void reload_and_gc() {
+    auto initial=analysis(source("u8",255,17));
+    auto body=analysis(source("u8",255,23));
+    auto value_edit=analysis(source("u8",254,23));
+    auto backing_edit=analysis(source("u16",255,23));
+    for(bool optimize:{false,true}) {
+        auto runtime=std::make_shared<vd::Runtime>(16);
+        vd::Jit jit;
+        auto code=jit.compile(initial->lower(),"entry",optimize,{},runtime);
+        check(code->invoke(255)==17 && code->invoke(4)==1,"checked option changed across GC allocations");
+        check(runtime->snapshot().completed_epoch>0,"no collection took place during live enum/option use");
+        {
+            vd::Runtime::Attachment attached(*runtime);
+            vd::Runtime::Managed managed(*runtime);
+            check(runtime->collect()==vd::Runtime::Collection::completed,"forced collection failed");
+        }
+        check(code->invoke(255)==17,"forced GC invalidated enum or option");
+        // Use the ordinary validated-analysis path for generation replacement.
+        vd::ReloadSlot slot(jit.compile(*initial,optimize));
+        check(jit.replace(slot,*body,optimize) && slot.invoke(255)==23,"body-only edit refused");
+        check(!jit.replace(slot,*value_edit,optimize),"discriminant edit reused a generation");
+        check(!jit.replace(slot,*backing_edit,optimize),"backing edit reused a generation");
+        check(slot.invoke(255)==23 && slot.invoke(254)==1,"rejected reload changed live enum semantics");
+    }
+}
+}
+int main() {
+    try {
+        malformed();
+        literal_source_types();
+        reload_and_gc();
+        std::cout<<"numeric enum IR rejection, normal/O2 GC and reload passed\n";
+    } catch(const std::exception& error) {
+        std::cerr<<error.what()<<'\n';
+        return 1;
+    }
+}
diff --git a/tests/numeric/enums_lsp.py b/tests/numeric/enums_lsp.py
new file mode 100644
index 0000000..3af9022
--- /dev/null
+++ b/tests/numeric/enums_lsp.py
@@ -0,0 +1,100 @@
+"""Exercise numeric enum declarations, cast tokens and overlays over real LSP pipes."""
+from pathlib import Path
+import json
+import sys
+import tempfile
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "tools"))
+from lsp_client import Client
+
+server, evidence = (Path(arg).resolve() for arg in sys.argv[1:])
+events = []
+main = '''use "./modes.void" as m
+
+func main() -> i32:
+    var raw: i32 = 7
+    if raw as? m.mode is Some(var picked):
+        if picked is m.mode.ready:
+            return 7
+    return 1
+'''
+modes = '''# Snow 🎮
+public enum mode(i8):
+    ## Value used when ready.
+    ready = 7
+    gone = -128
+'''
+
+
+def point(source, offset):
+    prefix = source[:offset]
+    return {"line": prefix.count("\n"), "character": len(prefix.rsplit("\n", 1)[-1].encode("utf-16-le")) // 2}
+
+
+def request(client, method, params):
+    response, notes = client.request(method, params)
+    events.append({"method": method, "params": params, "response": response, "diagnostics": notes})
+    assert "result" in response, response
+    return response["result"]
+
+
+def overlay(client, path, text, version, opened=False):
+    document = {"uri": path.as_uri(), "version": version}
+    if opened:
+        client.notify("textDocument/didOpen", {"textDocument": dict(document, text=text, languageId="void")})
+    else:
+        client.notify("textDocument/didChange", {"textDocument": document, "contentChanges": [{"text": text}]})
+    notes = client.sync()
+    events.append({"uri": path.as_uri(), "version": version, "text": text, "diagnostics": notes})
+    return [diagnostic for note in notes if note["uri"] == path.as_uri() for diagnostic in note["diagnostics"]]
+
+
+try:
+    with tempfile.TemporaryDirectory(prefix="VOID S6 LSP ") as temporary:
+        root = Path(temporary).resolve()
+        entry, owner = root / "entry.void", root / "modes.void"
+        entry.write_bytes(main.encode())
+        owner.write_bytes(modes.encode())
+        with Client(server, entry) as client:
+            assert not any(note["diagnostics"] for note in client.initialize())
+            document = {"uri": entry.as_uri()}
+            position = point(main, main.index(".ready") + 2)
+            params = {"textDocument": document, "position": position}
+            location = request(client, "textDocument/definition", params)
+            assert location["uri"] == owner.as_uri() and location["range"]["start"] == point(modes, modes.index("ready =")), location
+            hover = request(client, "textDocument/hover", params)
+            assert "mode.ready = 7 (i8)" in hover["contents"]["value"], hover
+            references = request(client, "textDocument/references", dict(params, context={"includeDeclaration": True}))
+            assert {ref["uri"] for ref in references} == {entry.as_uri(), owner.as_uri()}, references
+
+            assert not overlay(client, owner, modes, 1, opened=True)
+            duplicate = modes.replace("gone = -128", "gone = 7")
+            diagnostics = overlay(client, owner, duplicate, 2)
+            error = next(item for item in diagnostics if "Duplicate numeric enum discriminant" in item["message"])
+            assert error["range"]["start"] == point(duplicate, duplicate.rindex("7")), error
+            assert request(client, "textDocument/definition", params) is None
+            assert not overlay(client, owner, modes, 3)
+            assert request(client, "textDocument/definition", params) == location
+
+            bad = main.replace("raw as?", '"🎮" as?')
+            diagnostics = overlay(client, entry, bad, 1, opened=True)
+            error = next(item for item in diagnostics if "as? requires an integer" in item["message"])
+            offset = bad.index("as?")
+            assert error["range"] == {"start": point(bad, offset), "end": point(bad, offset + 3)}, error
+            dirty = main.replace("m.mode.ready", "m.mode.")
+            overlay(client, entry, dirty, 2)
+            completion = request(client, "textDocument/completion", {"textDocument": document,
+                "position": point(dirty, dirty.index("m.mode.") + len("m.mode."))})
+            candidates = completion if isinstance(completion, list) else completion["items"]
+            assert any(item["label"] == "gone" and "-128" in item["detail"] for item in candidates), candidates
+            rough = main.replace("raw as? m.mode", "raw   as?    m.mode")
+            assert not overlay(client, entry, rough, 3)
+            edits = request(client, "textDocument/formatting", {"textDocument": document,
+                "options": {"tabSize": 4, "insertSpaces": True}})
+            assert edits[0]["newText"] == main, edits
+            assert not overlay(client, entry, main, 4)
+            assert request(client, "textDocument/definition", params) == location
+            client.shutdown()
+    print(f"S6 LSP passed {len(events)} recorded requests and overlay revisions")
+finally:
+    evidence.write_text(json.dumps(events, indent=2) + "\n", encoding="utf-8")
