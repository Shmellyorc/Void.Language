diff --git a/tests/ffi/callback_process.py b/tests/ffi/callback_process.py
new file mode 100644
--- /dev/null
+++ b/tests/ffi/callback_process.py
@@ -0,0 +1,157 @@
+"""Exercise G5 with a separate C provider and generated checked adapter."""
+from contextlib import nullcontext
+from hashlib import sha256
+from pathlib import Path
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+
+sys.stdout.reconfigure(encoding='utf-8')
+compiler, clang = map(Path, sys.argv[1:3])
+windows = os.name == 'nt'
+sanitized = sys.argv[3] == 'ON'
+sources = Path(__file__).resolve().parent
+environment = dict(os.environ)
+environment.pop('VOID_STDLIB_ROOT', None)
+if sanitized:
+    environment.update(ASAN_OPTIONS='halt_on_error=1:abort_on_error=1:detect_leaks=1',
+                       UBSAN_OPTIONS='halt_on_error=1:print_stacktrace=1')
+suffix = '.dll' if windows else '.so'
+exe = '.exe' if windows else ''
+
+
+def run(cwd, *args, status=0, expected=None, env=None):
+    command = list(map(str, args))
+    print('cwd=', cwd, 'argv=', command, flush=True)
+    completed = subprocess.run(command, cwd=cwd, env=env or environment, capture_output=True, timeout=90)
+    output = (completed.stdout + completed.stderr).decode('utf-8', errors='replace')
+    print(f'exit={completed.returncode}\n{output}', flush=True)
+    assert completed.returncode != 0 if status is None else completed.returncode == status, output
+    if expected:
+        assert expected in output, output
+    assert 'AddressSanitizer' not in output and 'UndefinedBehaviorSanitizer' not in output, output
+    return output
+
+
+def qualify(root):
+    global compiler
+    cwd = root / 'independent cwd'
+    cwd.mkdir()
+    prefix = root / 'compiler install'
+    if len(sys.argv) > 5:
+        cmake, build, config = sys.argv[5:8]
+        run(cwd, cmake, '--install', build, '--prefix', prefix, '--config', config, '--component', 'compiler')
+        compiler = prefix / 'bin' / ('voidc' + exe)
+    project = root / 'native callbacks project'
+    run(cwd, compiler, 'new', project, '--source', 'src/main.void', '--project-id', 'org.voidlang.callback-qual')
+    native = project / 'native'
+    native.mkdir()
+    provider = native / ('g5_fixture' + suffix)
+    adapter = native / ('g5_adapter' + suffix)
+    descriptor = native / 'callback.descriptor'
+    manifest = project / 'void.project.toml'
+    with manifest.open('a', encoding='utf-8') as stream:
+        stream.write(f'\n[native.{"windows" if windows else "linux"}]\ndescriptor = "{descriptor.name}"\n'
+                     f'library = "{provider.name}"\nadapter = "{adapter.name}"\n')
+    digest = lambda p: sha256(p.read_bytes()).hexdigest()
+    text = (sources / 'callback.descriptor.in').read_text()
+    for key, value in {
+        'TARGET': 'x86_64-pc-windows-msvc msvc-x64' if windows else 'x86_64-unknown-linux-gnu sysv-x64',
+        'LONG': 'i32' if windows else 'i64', 'THUNK': digest(sources / 'callback_fixture.h'),
+        'FIXTURE': digest(sources / 'callback_fixture.c'),
+    }.items():
+        text = text.replace(f'@{key}@', value)
+    descriptor.write_bytes(text.encode('ascii'))
+    source = project / 'src/main.void'
+    shutil.copyfile(sources / 'callback.void', source)
+    generated = root / 'callback_adapter.c'
+    run(cwd, compiler, 'native-bind', descriptor, 'callback_fixture.h', '-o', generated)
+    flags = ['-std=c11', '-O2', '-Wall', '-Wextra', '-Werror', '-shared', '-fuse-ld=lld']
+    if windows:
+        flags += ['--target=x86_64-pc-windows-msvc', '-fms-runtime-lib=static']
+        import_library = root / 'g5_fixture.lib'
+        provider_flags = ['-Wl,/implib:' + str(import_library)]
+    else:
+        flags += ['-fPIC', '-fvisibility=hidden', '-pthread', '-Wl,-rpath,$ORIGIN']
+        if sanitized:
+            flags += ['-fsanitize=address,undefined', '-fno-sanitize-recover=all']
+        import_library = provider
+        provider_flags = ['-Wl,-soname,' + provider.name]
+    run(cwd, clang, *flags, *provider_flags, '-DG5_FIXTURE_BUILD', sources / 'callback_fixture.c', '-o', provider)
+    run(cwd, clang, *flags, '-I' + str(sources), generated, import_library, '-o', adapter)
+
+    bad_header = root / 'callback_fixture.h'
+    bad_header.write_text((sources / bad_header.name).read_text().replace(
+        '(*G5Float)(void*, double, float)', '(*G5Float)(void*, double, double)'))
+    run(cwd, clang, '-std=c11', '-fsyntax-only', generated, status=None, expected='C signature g5_mix')
+    bad_header.unlink()
+    bad_descriptor = root / 'unsupported.descriptor'
+    bad_descriptor.write_bytes(text.replace('context-first', 'no-context', 1).encode('ascii'))
+    run(cwd, compiler, 'native-bind', bad_descriptor, 'callback_fixture.h', '-o', root/'bad.c',
+        status=None, expected='context-first')
+    select = ['--project', project]
+    run(cwd, compiler, 'check', *select)
+    run(cwd, compiler, 'run', *select, status=2, expected='Pass --allow-native')
+
+    original = source.read_bytes()
+    source.write_bytes(original.replace(b'g5.twice(-2, local.step)', b'g5.twice(-2, mix_value)'))
+    run(cwd, compiler, 'check', *select, status=None, expected='Type mismatch')
+    source.write_bytes(original.replace(b'    if g5.twice(-2, local.step)', b'    var indirect = local.step\n    if g5.twice(-2, indirect)'))
+    run(cwd, compiler, 'check', *select, status=None, expected='from this generation')
+    source.write_bytes(original)
+
+    if len(sys.argv) > 4:
+        reload = root / 'reload.void'
+        shutil.copyfile(sources / 'callback_reload.void', reload)
+        run(cwd, sys.argv[4], reload, native, provider.name, adapter.name, descriptor,
+            expected='compatible/incompatible reload, retirement and self-drain passed')
+
+    def cases(command, env):
+        for mode in ('normal', 'implicit', 'retired', 'failure'):
+            argv = [*command, mode]
+            if mode == 'failure':
+                output = run(cwd, *argv, status=1, expected='Division by zero', env=env)
+                assert 'G5 native unregistered' not in output
+            else:
+                retired = mode == 'retired'
+                output = run(cwd, *argv, status=1 if retired else 0, expected='retained foreign callbacks passed', env=env)
+                assert output.count('G5 native unregistered and drained') == 1
+                barrier = 'G5 barrier mode=1 result=0' if mode == 'implicit' else 'G5 barrier mode=2 result=140'
+                assert barrier in output
+                if retired:
+                    assert 'closed, null or invalid' in output
+
+    packages = []
+    for name, options in (('normal', ['--no-opt']), ('optimized', [])):
+        cases([compiler, 'run', *select, '--allow-native', '--no-cache', *options, '--'], environment)
+        output = root / ('linked-' + name) / ('g5' + exe)
+        run(cwd, compiler, 'build', *select, '--allow-native', *options, '-o', output)
+        package = root / ('relocated ' + name + ' 雪')
+        output.parent.rename(package)
+        (package / 'native').mkdir()
+        for binary in (provider, adapter):
+            shutil.copy2(binary, package / 'native' / binary.name)
+        packages.append(package / output.name)
+    project.rename(root / 'retained original project')
+    if prefix.exists():
+        prefix.rename(root / 'retained compiler install')
+    runtime_path = str(Path(os.environ['SystemRoot']) / 'System32') if windows else '/usr/bin:/bin'
+    relocated_env = environment | {'PATH': runtime_path, 'VOID_STDLIB_ROOT': str(root / 'absent stdlib')}
+    for binary in packages:
+        cases([binary], relocated_env)
+    print('G5 passed all four compiled and relocated execution modes with independent C')
+    print('artifact identities', [(str(p), digest(p)) for p in (generated, *packages)])
+
+
+retained = os.environ.get('VOID_G5_EVIDENCE_ROOT')
+if retained:
+    root = Path(retained)
+    root.mkdir(parents=True, exist_ok=True)
+    scratch = nullcontext(tempfile.mkdtemp(prefix='g5-', dir=root))
+else:
+    scratch = tempfile.TemporaryDirectory(prefix='VOID G5 ')
+with scratch as directory:
+    qualify(Path(directory))
diff --git a/tests/ffi/callback_reload.cpp b/tests/ffi/callback_reload.cpp
new file mode 100644
--- /dev/null
+++ b/tests/ffi/callback_reload.cpp
@@ -0,0 +1,125 @@
+#include "void/backend.hpp"
+#include "void/c_primitive.hpp"
+#include "void/frontend.hpp"
+#include "void/runtime.hpp"
+
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+
+namespace {
+using Path = std::filesystem::path;
+
+void require(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+
+void write(const Path& path, const std::string& data) {
+    std::ofstream output(path, std::ios::binary);
+    output << data;
+    require(bool(output), "write callback reload fixture");
+}
+
+auto analyze(const Path& entry, const vd::CPrimitiveAdmission::Owner& contract) {
+    auto analysis = vd::analyze_project(entry, contract);
+    if (!analysis.succeeded()) throw vd::CompilationError(analysis.diagnostics);
+    return analysis.program;
+}
+
+void check_ir(const vd::ValidatedAnalysis& analysis) {
+    auto reject = [&](auto mutate, const std::string& diagnostic) {
+        auto module = analysis.lower();
+        mutate(module);
+        try { vd::ir::validate(module); }
+        catch (const std::invalid_argument& error) {
+            require(std::string(error.what()).find(diagnostic) != std::string::npos, error.what());
+            return;
+        }
+        throw std::runtime_error("forged C callback IR accepted");
+    };
+    reject([](auto& module) { module.imports.emplace_back(vd::c_callback_bridge); }, "requires host admission");
+    reject([](auto& module) {
+        for (auto& function : module.functions) for (auto& block : function.blocks)
+            for (auto& instruction : block.instructions)
+                if (instruction.op == vd::ir::Op::call &&
+                    instruction.callee.starts_with("/callback_checked.void::register")) {
+                    for (unsigned n = instruction.arguments.front() + 1; n < block.instructions.size(); ++n)
+                        if (&block.instructions[n] == &instruction) break;
+                        else if (block.instructions[n].op == vd::ir::Op::load) {
+                            instruction.arguments.front() = n;
+                            return;
+                        }
+                }
+        throw std::runtime_error("callback invocation missing a rooted reload control");
+    }, "generation-local");
+}
+
+void qualify(const Path& entry, const Path& native, const std::string& provider, const std::string& adapter,
+             const std::string& descriptor, const std::string& original, bool optimize) {
+    write(entry, original);
+    auto contract = vd::CPrimitiveAdmission::admit_conventional(descriptor, native, provider, adapter);
+    auto before = analyze(entry, contract);
+    check_ir(*before);
+    vd::Jit jit;
+    auto old = jit.compile(*before, optimize);
+    auto runtime = old->runtime_owner();
+    vd::ReloadSlot slot(old);
+    require(slot.invoke(0) == 1, "register original generation");
+
+    auto edited = original;
+    const std::string result = "return s.bias + value";
+    const auto position = edited.find(result);
+    require(position != std::string::npos, "fixture callback body");
+    edited.replace(position, result.size(), result + " + 100");
+    write(entry, edited);
+    auto replacement = analyze(entry, contract);
+    require(jit.replace(slot, *replacement, optimize), "compatible callback body reload rejected");
+    old.reset();
+    require(jit.live_generations() == 2, "registration lost its original ORC generation");
+    {
+        vd::Runtime::Attachment attachment(*runtime);
+        vd::Runtime::Managed managed(*runtime);
+        require(runtime->collect() == vd::Runtime::Collection::completed, "collect while retained");
+    }
+    require(slot.invoke(2) == 42, "old callback dispatched to the replacement body");
+    auto incompatible = descriptor;
+    const auto found = incompatible.find("callback integer context-first i32 i32");
+    require(found != std::string::npos, "fixture callback signature");
+    incompatible.replace(found, std::string("callback integer context-first i32 i32").size(),
+                         "callback integer context-first c_int c_int");
+    auto mismatched = vd::CPrimitiveAdmission::admit_conventional(incompatible, native, provider, adapter);
+    require(!jit.replace(slot, *analyze(entry, mismatched), optimize), "incompatible callback C contract reloaded");
+    require(slot.invoke(3) == 43, "incompatible candidate touched original registration");
+    require(slot.invoke(-1) == 0 && jit.live_generations() == 1, "unregister did not retire original ORC generation");
+    require(slot.invoke(0) == 1 && slot.invoke(2) == 142, "replacement registration did not use replacement body");
+    bool rejected = false;
+    try { (void)slot.invoke(-20); }
+    catch (const std::runtime_error& error) {
+        rejected = std::string(error.what()).find("Retained C callback failed") != std::string::npos;
+    }
+    require(rejected, "retained self-unregister was not rejected");
+    const auto failure = runtime->close();
+    require(failure.kind == vd::console::ErrorKind::io_failure &&
+            failure.os_code == static_cast<int>(std::errc::operation_canceled),
+            "retained failure was not reported after shutdown drain");
+    std::cout << "G5 ORC " << (optimize ? "O2" : "normal")
+              << " capture, compatible/incompatible reload, retirement and self-drain passed\n";
+}
+} // namespace
+
+int main(int argc, char** argv) {
+    try {
+        require(argc == 6, "expected entry, native root, provider, adapter and descriptor");
+        const Path entry = argv[1];
+        const auto descriptor = vd::read_source(argv[5]).text();
+        const auto source = vd::read_source(entry).text();
+        for (bool optimize : {false, true}) qualify(entry, argv[2], argv[3], argv[4], descriptor, source, optimize);
+        write(entry, source);
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
diff --git a/tests/ffi/callback_reload.void b/tests/ffi/callback_reload.void
new file mode 100644
--- /dev/null
+++ b/tests/ffi/callback_reload.void
@@ -0,0 +1,26 @@
+use "/callback_checked.void" as g5
+
+var saved_registration: g5.registration? = null
+
+struct capture:
+    bias: i32
+
+func (s capture) receive(value: i32) -> i32:
+    if value == -20:
+        var owner = saved_registration as g5.registration
+        return g5.unregister(owner)
+    return s.bias + value
+
+func entry(value: i32) -> i32:
+    if value == 0:
+        var state = capture(bias=40)
+        saved_registration = g5.register(state.receive)
+        if saved_registration == null:
+            return -1
+        return 1
+    var owner = saved_registration as g5.registration
+    if value == -1:
+        var result = g5.unregister(owner)
+        saved_registration = null
+        return result
+    return g5.fire(owner, value, 0)
