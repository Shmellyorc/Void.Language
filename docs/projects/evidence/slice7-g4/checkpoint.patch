+#!/usr/bin/env bash
+set -euo pipefail
+evidence=$(realpath "$(dirname "$0")")
+work=$1
+cc=$2
+mkdir "$work"
+work=$(realpath "$work")
+"$cc" --version
+uname -m
+ldd --version
+"$cc" -fuse-ld=lld -nostdlib -fPIC -shared "$evidence/dependency.c" -Wl,-soname,libvoid_g4_probe_dep.so -o "$work/libvoid_g4_probe_dep.so"
