diff --git a/docs/projects/evidence/slice7-g4/checkpoint/cleanup-windows.py b/docs/projects/evidence/slice7-g4/checkpoint/cleanup-windows.py
new file mode 100644
index 00000000..4a482043
--- /dev/null
+++ b/docs/projects/evidence/slice7-g4/checkpoint/cleanup-windows.py
@@ -0,0 +1,55 @@
+from hashlib import file_digest
+from pathlib import Path
+import csv
+import json
+import platform
+import shutil
+import subprocess
+import sys
+import traceback
+
+share = Path(r'\\vboxsvr\VM\project-slice7-g4-checkpoint')
+home = Path.home().resolve(strict=True)
+system = Path(home.anchor)
+work = home/'VoidS7-G4-checkpoint'
+replacement = work/'replacement'
+disposable = replacement/'void_g4_probe_dep.dll'
+equivalent = work/'bad'/'void_g4_probe_dep.dll'
+report = {'platform':platform.platform(), 'build':sys.getwindowsversion().build,
+          'free_before':shutil.disk_usage(system).free, 'deleted':[], 'retained':{}}
+
+def digest(path):
+    with path.open('rb') as file:
+        return file_digest(file, 'sha256').hexdigest()
+
+try:
+    assert report['build']==19045
+    for name, expected in json.loads((share/'preserved-evidence.json').read_text()).items():
+        assert digest(share/name)==expected, name
+    tasks = subprocess.run(['tasklist.exe','/FO','CSV','/NH'],capture_output=True,text=True,check=True)
+    running = {row[0].lower() for row in csv.reader(tasks.stdout.splitlines()) if row}
+    assert not running.intersection({'probe.exe','bare.exe','manifested.exe','activation.exe','edge.exe',
+                                     'edge-process-default.exe','clang-cl.exe','lld-link.exe'}), running
+    for path in (work,replacement,disposable,equivalent):
+        assert path.resolve(strict=True)==path and not path.is_symlink() and not path.is_junction(), path
+    assert list(replacement.iterdir()) == [disposable]
+    assert disposable.stat().st_nlink==1 and digest(disposable)==digest(equivalent)
+    for name in ('probe.exe', 'dep.lib', 'good/void_g4_probe_dep.dll', 'good/void_g4_probe_main.dll',
+                 'bad/void_g4_probe_dep.dll', 'redirection/bare.exe', 'redirection/manifested.exe',
+                 'redirection/activation.exe', 'redirection/edge.exe', 'redirection/edge-process-default.exe',
+                 'redirection/void_g4_probe_dep.dll', 'redirection/void_g4_probe_main.dll'):
+        path = work/name
+        assert path.resolve(strict=True)==path and path.stat().st_nlink==1, path
+        report['retained'][str(path)] = digest(path)
+    report['removed_duplicate_sha256'] = digest(disposable)
+    disposable.unlink()
+    report['deleted'].append(str(disposable))
+    replacement.rmdir()
+    report['deleted'].append(str(replacement))
+    report['status'] = 'PASS'
+except BaseException:
+    report['status'] = 'RETAINED_OR_PARTIAL'
+    report['error'] = traceback.format_exc()
+finally:
+    report['free_after'] = shutil.disk_usage(system).free
+    (share/'cleanup-results.json').write_text(json.dumps(report,indent=2)+'\n')
diff --git a/docs/projects/evidence/slice7-g4/checkpoint/collect-windows.py b/docs/projects/evidence/slice7-g4/checkpoint/collect-windows.py
new file mode 100644
index 00000000..b7f134b1
--- /dev/null
+++ b/docs/projects/evidence/slice7-g4/checkpoint/collect-windows.py
@@ -0,0 +1,40 @@
+from hashlib import sha256
+from pathlib import Path
+import json
+
+root = Path(__file__).resolve().parent
+share = Path.home()/'VM/project-slice7-g4-checkpoint'
+outputs = (
+    'vcvars.log', 'windows-build.log', 'windows-clean.log', 'windows-collision.log',
+    'windows-replace.log', 'windows-status.txt', 'redirection-vcvars.log',
+    'redirection-build.log', 'redirection-registry.log', 'redirection-baseline.log',
+    'redirection-bare.log', 'redirection-manifested.log', 'redirection-status.txt',
+    'activation-vcvars.log', 'activation-build.log', 'activation-override.log',
+    'activation-default.log', 'activation-status.txt', 'edge-vcvars.log',
+    'edge-build.log', 'edge-override.log', 'edge-default.log', 'edge-status.txt',
+    'process-default-vcvars.log', 'process-default-build.log', 'process-default-run.log',
+    'process-default-status.txt',
+)
+inputs = (
+    'dependency.c', 'provider.c', 'windows-mapping.c', 'windows-probe.cmd',
+    'redirected.c', 'windows-redirection.c', 'windows-redirection.cmd',
+    'windows-activation.c', 'override.manifest', 'windows-activation.cmd',
+    'windows-activation-edge.c', 'override-dependency.manifest',
+    'windows-activation-edge.cmd', 'windows-process-default.cmd',
+)
+hashes = {}
+for name in outputs + inputs:
+    payload = (share/name).read_bytes()
+    target = root/Path(name).with_suffix('.txt') if name in outputs else root/name
+    if target.exists() or name in inputs:
+        assert target.read_bytes() == payload, target
+    else:
+        target.write_bytes(payload)
+    hashes[name] = sha256(payload).hexdigest()
+assert b'result=134' in (root/'windows-collision.txt').read_bytes()
+assert b'initializer-marker=1' in (root/'edge-override.txt').read_bytes()
+assert b'kernel-oracle-dependency=c00000d4' in (root/'process-default-run.txt').read_bytes()
+assert b'process-default=1' in (root/'process-default-status.txt').read_bytes()
+for target in (share/'preserved-evidence.json', root/'preserved-evidence.json'):
+    target.write_text(json.dumps(hashes,indent=2)+'\n')
+print(f'Preserved {len(hashes)} exact native evidence inputs and outputs.')
