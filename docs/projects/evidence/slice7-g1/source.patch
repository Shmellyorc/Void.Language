+class DescriptorReader {
+    std::string_view input_;
+public:
+    std::size_t line = 0;
+    explicit DescriptorReader(std::string_view input) : input_(input) {}
+    bool done() const { return input_.empty(); }
+    std::vector<std::string_view> take() {
