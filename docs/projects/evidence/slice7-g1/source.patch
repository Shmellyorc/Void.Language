+    test("return signedness", abi, [](auto&, auto&, auto& i) { i.type = Type::u32; });
+    test("return count", abi, [](auto&, auto&, auto& i) { i.type = Type::none; });
+    test("aggregate result", abi, [](auto&, auto&, auto& i) { i.type = Type::aggregate; });
