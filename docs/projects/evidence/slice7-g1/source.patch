+std::string CPrimitiveAdmission::source() const {
+    std::string text = "# Host-admitted C primitive declarations for " + provider_ + "\n";
+    for (const auto& binding : bindings_) {
+        text += "func " + binding.name + "(";
+        for (std::size_t index = 0; index < binding.parameters.size(); ++index) {
+            if (index) text += ", ";
+            text += "arg" + std::to_string(index) + ": ";
+            text += void_spelling(binding.parameters[index]);
+        }
+        text += ")";
+        if (binding.result != Type::none) {
+            text += " -> ";
+            text += void_spelling(binding.result);
+        }
+        text += ":\n    pass\n";
+    }
+    return text;
