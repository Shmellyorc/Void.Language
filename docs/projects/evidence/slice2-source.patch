+    assert p.returncode==status,(args,status,p.returncode,p.stdout,p.stderr)
+    if stdout is not None:assert p.stdout==stdout,(args,p.stdout)
+    if contains is not None:assert contains in p.stderr,(args,p.stderr)
+    checks+=1
+    return p
+
