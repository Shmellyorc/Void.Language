+#define FIELD(record, field, type, offset) \
+    _Static_assert(offsetof(record, field) == offset && _Generic(((record*)0)->field, type:1, default:0), #record "." #field)
+_Static_assert(sizeof(G2Color) == 4 && _Alignof(G2Color) == 1, "color layout");
