+        if(++i==argc || std::string_view(argv[i]).starts_with("--"))throw UsageError("Missing value for "+arg+".");
+        std::string value=argv[i];
+        if(arg=="--kind") {
+            if(value!="application" && value!="library")throw UsageError("Expected --kind application or library.");
