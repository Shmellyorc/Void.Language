use net/http
use io

func suite() -> result<bool, http.error>:
    with http.open_client()? as owner:
        var reply = owner.get("http://127.0.0.1:41627/plain")?
        if reply.info.status != 200 or reply.bytes.count != 11 or reply.bytes[5] != 0:
            return Ok(false)
        if reply.text()? != "hello\0world":
            return Ok(false)
        var status_ok = reply.require_success()?
        var echoed = owner.send(http.request(method = "PATCH", target = "http://127.0.0.1:41627/echo", body = http.body.text("packet")))?
        if echoed.text()? != "PATCH:packet":
            return Ok(false)
        with owner.start(http.request(target = "http://127.0.0.1:41627/plain"))? as exchange:
            var info = exchange.response()?
            if info.status != 200:
                return Ok(false)
            var received: i64 = 0
            var done = false
            for not done:
                var block = exchange.read_bytes(3)?
                received += block.bytes.count
                done = block.eof
            var finished = exchange.finish()?
            if received != 11:
                return Ok(false)
        if io.open("/tmp/VOID HTTP source o_3u4mu0/file.bin", io.open_mode.create) is Ok(var source_file):
            with source_file:
                source_file.write_bytes("payload".to_utf8())
                source_file.seek(0)
                var uploaded = owner.upload(http.request(method = "POST", target = "http://127.0.0.1:41627/echo"), source_file, 7)?
                if uploaded.text()? != "POST:payload":
                    return Ok(false)
                if source_file.position() is Ok(var position):
                    if position != 7:
                        return Ok(false)
                else:
                    return Ok(false)
                source_file.seek(0)
                source_file.write_bytes("ppppppp".to_utf8())
                source_file.seek(0)
                var file_part = http.part(name = "file", filename = "payload.bin", data = http.part_data.file(source_file, 7))
                var multipart = owner.send(http.request(method = "POST", target = "http://127.0.0.1:41627/multipart", body = http.body.multipart([file_part])))?
                if multipart.text()? != "file:7:p":
                    return Ok(false)
        else:
            return Ok(false)
        var cleared = owner.clear_cookies()?
        var closed = owner.close()?
        var closed_again = owner.close()?
    return Ok(true)

if suite() is Ok(var passed):
    print(passed)
else:
    print(false)
return 0
