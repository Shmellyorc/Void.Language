  "title": "[WIP] Wrap per data-type functions in thunk wrappers",
  "user": {
    "login": "nhorman",
    "id": 1032926,
    "node_id": "MDQ6VXNlcjEwMzI5MjY=",
    "avatar_url": "https://avatars.githubusercontent.com/u/1032926?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/nhorman",
    "html_url": "https://github.com/nhorman",
