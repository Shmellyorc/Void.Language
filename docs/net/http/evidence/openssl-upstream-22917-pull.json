    "starred_url": "https://api.github.com/users/nhorman/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/nhorman/subscriptions",
    "organizations_url": "https://api.github.com/users/nhorman/orgs",
    "repos_url": "https://api.github.com/users/nhorman/repos",
    "events_url": "https://api.github.com/users/nhorman/events{/privacy}",
