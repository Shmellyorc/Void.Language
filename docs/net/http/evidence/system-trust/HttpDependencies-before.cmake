# Variables deliberately remain in void_add_curl_provider's scope. Explicit
# filenames prevent Find modules from selecting an ambient system dependency.
macro(void_import_http_dependencies)
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "Pinned native HTTP dependency recipes for this platform are not yet implemented")
  endif()
  if(VOID_SANITIZERS)
    set(_http_profile strict)
  elseif(CMAKE_BUILD_TYPE STREQUAL "Debug")
    set(_http_profile Debug)
  else()
    set(_http_profile Release)
  endif()
  file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../third_party/http-versions.json" _http_pins)
  file(SHA256 "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../third_party/http-versions.json" _http_provider_id)
  if(NOT VOID_HTTP_PROVIDER_CHECK_ID STREQUAL _http_provider_id)
    # CMake's symbol checks are cached independently of dependency paths. A
    # pinned backend change must not retain OpenSSL-3-only/AWS-LC feature results
    # from a previously configured disposable build directory.
    get_cmake_property(_http_cached_variables CACHE_VARIABLES)
    foreach(_http_cached IN LISTS _http_cached_variables)
      if(_http_cached MATCHES "^(HAVE_|CURL_HAVE_|_?OPENSSL_VERSION)")
        unset("${_http_cached}" CACHE)
      endif()
    endforeach()
    set(VOID_HTTP_PROVIDER_CHECK_ID "${_http_provider_id}" CACHE INTERNAL "Pinned HTTP feature-check identity" FORCE)
  endif()
  string(JSON _http_bundle GET "${_http_pins}" bundle)
  set(VOID_HTTP_DEPS_ROOT "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.toolchains/http/prefix/${_http_bundle}/${_http_profile}"
    CACHE PATH "Verified pinned HTTP native dependency prefix")
  get_filename_component(VOID_HTTP_DEPS_ROOT "${VOID_HTTP_DEPS_ROOT}" ABSOLUTE)
  if(NOT EXISTS "${VOID_HTTP_DEPS_ROOT}/VOID-HTTP-DEPENDENCIES.json")
    message(FATAL_ERROR "Pinned HTTP dependencies missing. Run python3 tools/setup_http_deps.py --profile ${_http_profile}")
  endif()
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools/verify_http_dependencies.py" "${VOID_HTTP_DEPS_ROOT}" "${_http_profile}"
    RESULT_VARIABLE _http_verified OUTPUT_VARIABLE _http_verification ERROR_VARIABLE _http_error)
  if(NOT _http_verified EQUAL 0)
    message(FATAL_ERROR "${_http_verification}${_http_error}")
  endif()
  message(STATUS "${_http_verification}")
  set(CURL_USE_CMAKECONFIG OFF)
  set(CURL_ENABLE_SSL ON)
  set(CURL_USE_OPENSSL ON)
  set(CURL_DISABLE_OPENSSL_AUTO_LOAD_CONFIG ON)
  set(OPENSSL_USE_STATIC_LIBS ON)
  set(OPENSSL_INCLUDE_DIR "${VOID_HTTP_DEPS_ROOT}/include")
  set(OPENSSL_SSL_LIBRARY "${VOID_HTTP_DEPS_ROOT}/lib/libssl.a")
  set(OPENSSL_CRYPTO_LIBRARY "${VOID_HTTP_DEPS_ROOT}/lib/libcrypto.a")
  set(USE_NGHTTP2 ON)
  set(NGHTTP2_USE_STATIC_LIBS ON)
  set(NGHTTP2_INCLUDE_DIR "${VOID_HTTP_DEPS_ROOT}/include")
  set(NGHTTP2_LIBRARY "${VOID_HTTP_DEPS_ROOT}/lib/libnghttp2.a")
  set(ENABLE_ARES ON)
  set(CARES_USE_STATIC_LIBS ON)
  set(CARES_INCLUDE_DIR "${VOID_HTTP_DEPS_ROOT}/include")
  set(CARES_LIBRARY "${VOID_HTTP_DEPS_ROOT}/lib/libcares.a")
  set(USE_LIBIDN2 ON)
  set(LIBIDN2_INCLUDE_DIR "${VOID_HTTP_DEPS_ROOT}/include")
  set(LIBIDN2_LIBRARY "${VOID_HTTP_DEPS_ROOT}/lib/libidn2.so")
  set(CURL_USE_LIBPSL ON)
  set(LIBPSL_INCLUDE_DIR "${VOID_HTTP_DEPS_ROOT}/include")
  set(LIBPSL_LIBRARY "${VOID_HTTP_DEPS_ROOT}/lib/libpsl.a")
  # Linux trust uses the native distribution root locations; neither a packaged
  # stale CA bundle nor an application-time download is an acceptable substitute.
  set(CURL_CA_BUNDLE auto)
  set(CURL_CA_PATH auto)
  set(VOID_HTTP_LINK_FILES
    "${VOID_HTTP_DEPS_ROOT}/lib/libpsl.a"
    "${NGHTTP2_LIBRARY}" "${OPENSSL_SSL_LIBRARY}" "${OPENSSL_CRYPTO_LIBRARY}"
    "${CARES_LIBRARY}" "${LIBIDN2_LIBRARY}"
    "${VOID_HTTP_DEPS_ROOT}/lib/libunistring.so" "${VOID_HTTP_DEPS_ROOT}/lib/libz.a")
  foreach(_http_file IN LISTS VOID_HTTP_LINK_FILES)
    if(NOT EXISTS "${_http_file}")
      message(FATAL_ERROR "Pinned HTTP dependency absent: ${_http_file}")
    endif()
  endforeach()
endmacro()
