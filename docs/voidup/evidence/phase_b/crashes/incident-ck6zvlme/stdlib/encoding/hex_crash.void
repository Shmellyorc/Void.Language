use error as core
use convert


## Recoverable strict hexadecimal codec failure categories.
enum error_kind:
    ## Hex text must contain an even number of UTF-8 bytes.
    invalid_length

    ## A byte is not an ASCII hexadecimal digit.
    invalid_digit

    ## Encoded text or decoded bytes would exceed 64 MiB.
    limit_exceeded


## Managed strict hexadecimal failure, without mutating or retaining input storage.
struct error extends core.error:
    ## Portable failure category.
    kind: error_kind

    ## Zero-based UTF-8 byte offset of an invalid digit, or -1 for length/limit errors.
    offset: i64


private const _limit: i64 = 67108864


private func _error(kind: error_kind, offset: i64 = -1) -> error:
    var code: i32 = 1
    var message = "Hexadecimal text must have an even byte length"

    if kind is error_kind.invalid_digit:
        code = 2
        message = "Invalid hexadecimal digit at byte {offset}"
    else if kind is error_kind.limit_exceeded:
        code = 3
        message = "Hexadecimal output exceeds 64 MiB"

    return error(message = message, code = code, kind = kind, offset = offset)


private func _digit(byte: u8) -> i64:
    if byte >= 48 and byte <= 57:
        return (byte as i64) - 48

    if byte >= 65 and byte <= 70:
        return (byte as i64) - 55

    if byte >= 97 and byte <= 102:
        return (byte as i64) - 87

    return -1


## Encode each byte as two ASCII hexadecimal digits in independent text.
## @param bytes Readonly or mutable input, including all 256 possible byte values.
## @param uppercase Select A–F instead of the default a–f.
## @return Independent text; output above 64 MiB or allocation exhaustion uses checked Runtime failure. Use try_encode for recoverable limits.
func encode(const bytes: [u8], uppercase: bool = false) -> string:
    return convert.unwrap(try_encode(bytes, uppercase))


## Encode each input byte as exactly two ASCII hexadecimal digits in independent text.
## @param bytes Readonly or mutable input, including all 256 possible byte values.
## @param uppercase Select A–F instead of the default a–f.
## @return Ok with text, or limit_exceeded above 64 MiB; allocation uses checked Runtime failure.
func try_encode(const bytes: [u8], uppercase: bool = false) -> result<string, error>:
    if bytes.count > _limit / 2:
        return Err(_error(error_kind.limit_exceeded))

    var alphabet = "0123456789abcdef"

    if uppercase:
        alphabet = "0123456789ABCDEF"

    var digits = alphabet.to_utf8()
    var output: [u8] = []

    for byte in bytes:
        output.push(digits[(byte / 16) as i64])
        output.push(digits[(byte % 16) as i64])

    return Ok(convert.unwrap(string.from_utf8(output)))


## Decode strict pairs of ASCII hexadecimal digits into independent writable bytes.
## No prefixes, separators or whitespace are accepted; non-ASCII and NUL reject.
## @param value Hex text, accepting either digit case and empty input.
## @return Ok with bytes, or invalid_length/invalid_digit/limit_exceeded with a useful offset.
func decode(value: string) -> result<[u8], error>:
    if value.byte_length % 2 != 0:
        return Err(_error(error_kind.invalid_length))

    if value.byte_length / 2 > _limit:
        return Err(_error(error_kind.limit_exceeded))

    var bytes = value.to_utf8()
    var output: [u8] = []
    var cursor: i64 = 0

    for cursor < bytes.count:
        var high = _digit(bytes[cursor])
        var low = _digit(bytes[cursor + 1])

        if high < 0:
            return Err(_error(error_kind.invalid_digit, cursor))

        if low < 0:
            return Err(_error(error_kind.invalid_digit, cursor + 1))

        output.push((high * 16 + low) as u8)
        cursor += 2

    return Ok(output)
