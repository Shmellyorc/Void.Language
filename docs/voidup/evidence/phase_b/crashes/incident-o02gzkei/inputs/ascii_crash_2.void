use error as core
use convert


## Recoverable strict ASCII conversion failure categories.
enum error_kind:
    ## Text contains a scalar above U+007F or bytes contain a value above 0x7F.
    non_ascii

    ## Converted output would exceed 64 MiB.
    limit_exceeded


## Managed strict ASCII failure, preserving immutable input and owned output rules.
struct error extends core.error:
    ## Portable failure category.
    kind: error_kind

    ## First invalid UTF-8/input byte offset, or -1 for an output-limit error.
    offset: i64


private const _limit: i64 = 67108864


private func _error(kind: error_kind, offset: i64 = -1) -> error:
    var code: i32 = 1
    var message = "Non-ASCII value at byte {offset}"

    if kind is error_kind.limit_exceeded:
        code = 2
        message = "ASCII output exceeds 64 MiB"

    return error(message = message, code = code, kind = kind, offset = offset)


## Encode only U+0000–U+007F into independent writable bytes without substitutions.
## @param value Immutable text; NUL is valid and every non-ASCII scalar rejects.
## @return Ok with exact ASCII bytes, or non_ascii/limit_exceeded; allocation uses checked Runtime failure.
func encode(value: string) -> result<[u8], error>:
    if value.byte_length > _limit:
        return Err(_error(error_kind.limit_exceeded))

    var bytes = value.to_utf8()

    for index in 0..<bytes.count:
        if bytes[index] > 127:
            return Err(_error(error_kind.non_ascii, index))

    return Ok(bytes)


## Decode only bytes 0x00–0x7F as immutable ASCII text without substitutions.
## @param bytes Readonly or mutable input; high bytes reject and embedded NUL survives.
## @return Ok with independent text, or non_ascii/limit_exceeded with the first invalid byte offset.
func decode(const bytes: [u8]) -> result<string, error>:
    if bytes.count > _limit:
        return Err(_error(error_kind.limit_exceeded))

    for index in 0..<bytes.count:
        if bytes[index] > 127:
            return Err(_error(error_kind.non_ascii, index))

    return Ok(convert.unwrap(string.from_utf8(bytes)))


## Classify an ASCII alphabetic byte, A–Z or a–z.
## @param byte Any u8; values above 0x7F return false.
## @return True only for the 52 ASCII letters.
func is_alpha(byte: u8) -> bool:
    return (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122)


## Classify an ASCII decimal digit, 0–9.
## @param byte Any u8; values above 0x7F return false.
## @return True only for bytes 0x30–0x39.
func is_digit(byte: u8) -> bool:
    return byte >= 48 and byte <= 57


## Classify an ASCII letter or decimal digit.
## @param byte Any u8; values above 0x7F return false.
## @return True for A–Z, a–z or 0–9.
func is_alphanumeric(byte: u8) -> bool:
    return is_alpha(byte) or is_digit(byte)


## Classify an ASCII uppercase letter.
## @param byte Any u8; values above 0x7F return false.
## @return True only for A–Z (0x41–0x5A).
func is_upper(byte: u8) -> bool:
    return byte >= 65 and byte <= 90


## Classify an ASCII lowercase letter.
## @param byte Any u8; values above 0x7F return false.
## @return True only for a–z (0x61–0x7A).
func is_lower(byte: u8) -> bool:
    return byte >= 97 and byte <= 122


## Classify ASCII whitespace: tab, LF, vertical tab, form feed, CR and space.
## @param byte Any u8; values above 0x7F return false.
## @return True for 0x09–0x0D or 0x20.
func is_whitespace(byte: u8) -> bool:
    return (byte >= 9 and byte <= 13) or byte == 32


## Classify printable ASCII, including space and excluding DEL.
## @param byte Any u8; values above 0x7F return false.
## @return True exactly for 0x20–0x7E.
func is_printable(byte: u8) -> bool:
    return byte >= 32 and byte <= 126


## Classify ASCII control bytes, including NUL and DEL.
## @param byte Any u8; values above 0x7F return false.
## @return True for 0x00–0x1F or 0x7F.
func is_control(byte: u8) -> bool:
    return byte <= 31 or byte == 127


## Convert one ASCII uppercase byte to lowercase; every other u8 is unchanged.
## @param byte Any u8; A–Z maps to a–z without locale or Unicode rules.
## @return Converted ASCII byte or the exact unrelated input byte.
func to_lower(byte: u8) -> u8:
    if is_upper(byte):
        return byte + 32

    return byte


## Convert one ASCII lowercase byte to uppercase; every other u8 is unchanged.
## @param byte Any u8; a–z maps to A–Z without locale or Unicode rules.
## @return Converted ASCII byte or the exact unrelated input byte.
func to_upper(byte: u8) -> u8:
    if is_lower(byte):
        return byte - 32

    return byte
