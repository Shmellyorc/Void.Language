use error as core


## Byte order for portable fixed-width numeric representations.
enum byte_order:
    ## Store the least significant byte first.
    little

    ## Store the most significant byte first.
    big


## Recoverable errors when decoding a fixed-width numeric representation.
enum error_kind:
    ## The input count differs from the requested numeric type's exact byte width.
    wrong_width


## Recoverable codec failure with exact category and common diagnostic fields.
struct error extends core.error:
    ## Exact codec failure category.
    kind: error_kind


## Encode one fixed-width number into a fresh owned byte array.
## Supports i8/u8, i16/u16, i32/u32, i64/u64 and f32/f64; other types fail compilation.
## Preserves two's-complement and IEEE bits, including signed zero and NaN payloads.
## Allocation failures follow the ordinary Runtime array failure policy.
## @param value Numeric value whose representation is encoded without conversion.
## @param order Byte order; defaults to little endian independently of the host CPU.
## @return Exactly the numeric type's width in bytes, in independent writable storage.
func encode<t>(value: t, order: byte_order = byte_order.little) -> [u8]:
    var width = _binary_width<t>()
    var bits = _binary_bits<t>(value)
    var bytes: [u8] = []

    for index in 0..<width:
        bytes.push((bits % 256) as u8)
        bits = bits / 256

    if order is byte_order.big:
        return bytes[width - 1..0]

    return bytes


## Decode exactly one fixed-width number without modifying or retaining the input.
## Supports i8/u8, i16/u16, i32/u32, i64/u64 and f32/f64; other types fail compilation.
## Every exact-width bit pattern is valid, including infinities and all IEEE NaNs.
## @param bytes Complete representation; short and oversized arrays return error_kind.wrong_width.
## @param order Byte order; defaults to little endian independently of the host CPU.
## @return Ok with the exact represented number, or a managed wrong_width error for a count mismatch.
func decode<t>(const bytes: [u8], order: byte_order = byte_order.little) -> result<t, error>:
    var width = _binary_width<t>()

    if bytes.count != width:
        var reason = error(
            message = "Binary input has the wrong byte width",
            code = 1,
            kind = error_kind.wrong_width
        )
        return Err(reason)

    var bits: u64 = 0

    for index in 0..<width:
        var selected = width - 1 - index

        if order is byte_order.big:
            selected = index

        bits = bits * 256 + (bytes[selected] as u64)

    return Ok(_binary_value<t>(bits))
