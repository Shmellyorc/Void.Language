use collections as c
value struct marker:
    number: i32
    operator ==(const left: marker, const right: marker) -> bool:
        return left.number == right.number
struct callback_frame:
    number: i32
var calls = 0
var items = [3, 1, 2]
func make() -> func(const i32, const i32) -> bool:
    var step = 1
    return func(const left: i32, const right: i32) -> bool:
        var frame = callback_frame(number = 1)
        calls += step
        return left < right
var saved: (func(const i32, const i32) -> bool)? = null
func entry(command: i32) -> i32:
    if command == 0:
        saved = make()
        calls = 0
        return 0
    if command == 4:
        if c.contains([marker(number = 1)], marker(number = 1)):
            return 7
        return 0
    if command == 3:
        return calls
    if saved is Ok(var callable):
        var ordered = c.sorted(items, callable)
        return ordered[0] + calls * 100
    return -1
