struct node:
    value: i32
value struct storage<t>:
    fixed: [t, 2]
    grow: [t]
func identity<t>(value: t) -> t:
    return value
func changed<t>(values: [t, 2], replacement: t) -> [t, 2]:
    values[0] = replacement
    return values
func entry(value: i32) -> i32:
    var original: [i32, 2] = [1, 2]
    var copy = changed(original, value)
    copy[1] = 30
    if original[0] != 1 or original[1] != 2:
        return -100
    var list = [1, 2]
    var alias = identity(list)
    alias.push(value)
    if list.count != 3 or list[-1] != value:
        return -200
    var records = storage(fixed = [1, 2])
    var records_copy = identity(records)
    records_copy.fixed[0] = 9
    records_copy.grow.push(8)
    if records.fixed[0] != 1 or records.grow.count != 1:
        return -300
    var references: storage<node?>
    references.fixed[0] = node(value = value)
    references.grow.push(references.fixed[0])
    var nested: [[storage<i32>, 2]] = [[records, records_copy]]
    var selected = nested[0]
    selected[0].fixed[0] = 50
    if nested[0][0].fixed[0] != 1:
        return -400
    var got = references.grow[0] as node
    return copy[0] + list[-1] + got.value
