use collections as c
use console as con
func require(ok: bool):
    if not ok:
        var zero = 0
        var failed = 1 / zero
var callbacks = 0
var items: {i32: i32} = {}

func entry(iterations: i32) -> i32:
    if iterations == 0:
        for index in 0..<1024:
            items[index] = index
        return 0
    callbacks = 0
    var checksum = 0
    for repetition in 0..<iterations:
        var output = c.copy_dictionary(items)
        require(output.count == 1024)
        checksum += 7
    print(callbacks, file = con.stderr)
    return checksum
