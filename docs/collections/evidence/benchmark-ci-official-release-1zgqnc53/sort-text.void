use collections as c
use console as con
func require(ok: bool):
    if not ok:
        var zero = 0
        var failed = 1 / zero
var callbacks = 0
var items: [string] = []
func less(const left: string, const right: string) -> bool:
    callbacks += 1
    return c.text_less(left, right)

func entry(iterations: i32) -> i32:
    if iterations == 0:
        for index in 0..<32:
            items.push("common-雪-{31 - index:000}")
        return 0
    callbacks = 0
    var checksum = 0
    for repetition in 0..<iterations:
        var output = c.sorted(items, less)
        require(output[0] == "common-雪-000" and output[-1] == "common-雪-031")
        checksum += 7
    print(callbacks, file = con.stderr)
    return checksum
