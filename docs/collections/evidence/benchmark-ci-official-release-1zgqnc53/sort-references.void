use collections as c
use console as con
func require(ok: bool):
    if not ok:
        var zero = 0
        var failed = 1 / zero
var callbacks = 0
struct node:
    key: i32
var items: [node] = []
func less(const left: node, const right: node) -> bool:
    callbacks += 1
    return left.key < right.key

func entry(iterations: i32) -> i32:
    if iterations == 0:
        for index in 0..<128:
            items.push(node(key = 127 - index))
        return 0
    callbacks = 0
    var checksum = 0
    for repetition in 0..<iterations:
        var output = c.sorted(items, less)
        require(output[0].key == 0 and output[-1].key == 127)
        checksum += 7
    print(callbacks, file = con.stderr)
    return checksum
