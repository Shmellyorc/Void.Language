## @param file_type File format extension, including the leading dot, such as ".png".
## Native lifetime, thread, input-extent and required device/context checks retain their checked failures.
## @return Ok with one byte_buffer owner to release using buffer_close; Err(load_error) if no owner is acquired or resource validation fails. Rejected temporary owners are released.
func try_export_image_to_memory(image_value: image, file_type: string) -> result<byte_buffer, load_error>:
    return _try_byte_buffer(export_image_to_memory(image_value, file_type), "export_image_to_memory")

## Try to compress input bytes using DEFLATE.
## @param data Input data, borrowed for this call.
## @param data_size Number of input bytes to read, within the supplied buffer.
## Native lifetime, thread, input-extent and required device/context checks retain their checked failures.
## @return Ok with one byte_buffer owner to release using buffer_close; Err(load_error) if no owner is acquired or resource validation fails. Rejected temporary owners are released.
func try_compress_data(data: byte_buffer, data_size: i32) -> result<byte_buffer, load_error>:
    return _try_byte_buffer(compress_data(data, data_size), "compress_data")

## Try to decompress DEFLATE bytes into an owning byte buffer.
## @param comp_data Compressed bytes in a live buffer.
## @param comp_data_size Number of compressed input bytes to read.
## Native lifetime, thread, input-extent and required device/context checks retain their checked failures.
## @return Ok with one byte_buffer owner to release using buffer_close; Err(load_error) if no owner is acquired or resource validation fails. Rejected temporary owners are released.
func try_decompress_data(comp_data: byte_buffer, comp_data_size: i32) -> result<byte_buffer, load_error>:
    return _try_byte_buffer(decompress_data(comp_data, comp_data_size), "decompress_data")

## Try to save data to file from byte array (write), returns true on success.
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param file_name Path to the file. Relative paths use the process working directory.
## @param data Input data, borrowed for this call.
## @param data_size Number of input bytes to read, within the supplied buffer.
## Input resources are borrowed and remain caller-owned. Native guard violations retain their checked failures.
## @return Ok(true) when raylib reports success; Err(load_error) when it returns false. No more specific filesystem or encoding cause is available.
func try_save_file_data(file_name: string, data: byte_buffer, data_size: i32) -> result<bool, load_error>:
    if save_file_data(file_name, data, data_size):
        return Ok(true)
    return Err(_load_failure("save_file_data", load_error_kind.operation_failed))

## Try to save NUL-free UTF-8 text to a file.
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param file_name Path to the file. Relative paths use the process working directory.
## @param text Text supplied to this operation.
## Input resources are borrowed and remain caller-owned. Native guard violations retain their checked failures.
## @return Ok(true) when raylib reports success; Err(load_error) when it returns false. No more specific filesystem or encoding cause is available.
func try_save_file_text(file_name: string, text: string) -> result<bool, load_error>:
    if save_file_text(file_name, text):
        return Ok(true)
    return Err(_load_failure("save_file_text", load_error_kind.operation_failed))

