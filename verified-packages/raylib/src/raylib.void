func get_pixel_color(src_ptr: byte_buffer, format: i32) -> native.color:
    var value = native.get_pixel_color(src_ptr.owner, format)
    _check()
    return value

## Write a color into a byte buffer using the requested pixel format.
## This mutation requires an exclusive owning resource and invalidates earlier views.
## @param dst_ptr Writable destination pixel bytes in a live byte buffer.
## @param color_value Color including its alpha channel.
## @param format Pixel format from the pixel-format constants.
func set_pixel_color(dst_ptr: byte_buffer, color_value: native.color, format: i32):
    native.set_pixel_color(dst_ptr.owner, color_value, format)
    _check()

## Acquire a parent-retained view of the default font.
## @return A view of the default font, or null if unavailable. Release the view with font_close. The native font remains window-owned.
func get_font_default() -> font?:
    var value = native.get_font_default()
    return _wrap_font(value)

## Load font from file into GPU memory (VRAM).
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param file_name Path to the file. Relative paths use the process working directory.
## @return An owning font, or null if acquisition fails. Release with unload_font.
func load_font(file_name: string) -> font?:
    var file_name_bytes = _string_buffer(file_name)
    defer native.buffer_close(file_name_bytes)
    var value = native.load_font(file_name_bytes)
    return _wrap_font(value)

## Load a font with an explicit size and codepoint array.
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param file_name Path to the file. Relative paths use the process working directory.
## @param font_size Font size in pixels.
## @param codepoints Unicode codepoint array, borrowed for this call.
## @param codepoint_count Number of codepoints to use from the supplied array.
## @return An owning font, or null if acquisition fails. Release with unload_font.
func load_font_ex(file_name: string, font_size: i32, codepoints: int_array, codepoint_count: i32) -> font?:
    var file_name_bytes = _string_buffer(file_name)
    defer native.buffer_close(file_name_bytes)
    var value = native.load_font_ex(file_name_bytes, font_size, codepoints.owner, codepoint_count)
    return _wrap_font(value)

## Load font from Image (XNA style).
## @param image_value Image resource, borrowed for this call.
## @param key Image background and transparency color key used to locate glyphs.
## @param first_char Unicode codepoint assigned to the first glyph in the image.
## @return An owning font, or null if acquisition fails. Release with unload_font.
func load_font_from_image(image_value: image, key: native.color, first_char: i32) -> font?:
    var value = native.load_font_from_image(image_value.owner, key, first_char)
    return _wrap_font(value)

## Load font from memory buffer, fileType refers to extension: i.e. '.ttf'.
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param file_type Font format extension, including the leading dot, such as ".ttf".
## @param file_data Encoded file bytes in a live buffer.
## @param data_size Number of input bytes to read, within the supplied buffer.
## @param font_size Font size in pixels.
## @param codepoints Unicode codepoint array, borrowed for this call.
## @param codepoint_count Number of codepoints to use from the supplied array.
## @return An owning font, or null if acquisition fails. Release with unload_font.
func load_font_from_memory(file_type: string, file_data: byte_buffer, data_size: i32, font_size: i32, codepoints: int_array, codepoint_count: i32) -> font?:
    var file_type_bytes = _string_buffer(file_type)
    defer native.buffer_close(file_type_bytes)
    var value = native.load_font_from_memory(file_type_bytes, file_data.owner, data_size, font_size, codepoints.owner, codepoint_count)
    return _wrap_font(value)

## Check if a font is valid (font data loaded, WARNING: GPU texture not checked).
## @param font_value Font resource, borrowed for this call.
## @return True when the font data is valid according to raylib. This check does not verify the GPU texture.
func is_font_valid(font_value: font) -> bool:
    var value = native.is_font_valid(font_value.owner)
    _check()
    return value

## Load font data for further use.
## @param file_data Encoded file bytes in a live buffer.
## @param data_size Number of input bytes to read, within the supplied buffer.
## @param font_size Font size in pixels.
## @param codepoints Unicode codepoint array, borrowed for this call.
## @param codepoint_count Number of codepoints to use from the supplied array.
## @param type Glyph rasterization mode selected from font_default, font_bitmap or font_sdf.
## @return An owning glyph info array, or null if acquisition fails. Release with glyph_info_array_close.
func load_font_data(file_data: byte_buffer, data_size: i32, font_size: i32, codepoints: int_array, codepoint_count: i32, type: i32) -> glyph_info_array?:
    var value = native.load_font_data(file_data.owner, data_size, font_size, codepoints.owner, codepoint_count, type)
    _check()
    if value == null:
        return null
    var owner = value as native.owner_buffer
    return glyph_info_array(owner = owner)

## Unload font chars info data (RAM).
## @param glyphs Owner consumed by this release. Its aliases become unusable.
## @param glyph_count Number of glyphs in the supplied array.
## @return The resource-ledger close status. This operation consumes the supplied owner.
func unload_font_data(glyphs: glyph_info_array, glyph_count: i32) -> i32:
    _require(glyph_count as u64 == native.buffer_count(glyphs.owner))
    return native.buffer_close(glyphs.owner)

## Unload font from GPU memory (VRAM).
## @param font_value Owner consumed by this release. Its aliases become unusable.
## @return The resource-ledger close status. This operation consumes the supplied owner.
func unload_font(font_value: font) -> i32:
    return native.owner_font_close(font_value.owner)

## Export font as code file, returns true on success.
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param font_value Font resource, borrowed for this call.
## @param file_name Path to the file. Relative paths use the process working directory.
## @return Whether the requested save or export succeeded.
func export_font_as_code(font_value: font, file_name: string) -> bool:
    var file_name_bytes = _string_buffer(file_name)
    defer native.buffer_close(file_name_bytes)
    var value = native.export_font_as_code(font_value.owner, file_name_bytes)
    _check()
    return value

