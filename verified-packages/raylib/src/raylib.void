## @param size Default buffer size passed to raylib for newly created audio streams. The pinned header does not specify the unit.
func set_audio_stream_buffer_size_default(size: i32):
    native.set_audio_stream_buffer_size_default(size)
    _check()

private func _check():
    var code = native.api_error()
    if code != 0:
        var refused: result<bool, core_error.error> = Err(core_error.error(message = "Raylib adapter rejected invalid or stale native input", code = code))
        conversion.unwrap(refused)

private func _require(condition: bool):
    if not condition:
        var refused: result<bool, core_error.error> = Err(core_error.error(message = "Raylib argument outside native extent", code = 1))
        conversion.unwrap(refused)

private func _bytes_buffer(const bytes: [u8], kind: u32) -> native.owner_buffer:
    var owner = native.buffer_new(bytes.count as u64, kind) as native.owner_buffer
    var at: i64 = 0
    for at < bytes.count:
        var count = bytes.count - at
        if count > 65536:
            count = 65536
        native.buffer_write(owner, at as u64, bytes, at as u64, count as u64)
        _check()
        at += count
    return owner

private func _string_buffer(value: string) -> native.owner_buffer:
    return _bytes_buffer(value.to_utf8(), 1 as u32)

private func _optional_string_buffer(value: c_string?) -> native.owner_buffer:
    if value == null:
        return native.buffer_new(0, 3 as u32) as native.owner_buffer
    return _string_buffer((value as c_string).value)

private func _buffer_bytes(owner: native.owner_buffer, requested: i64 = -1) -> [u8]:
    var length = native.buffer_count(owner) as i64
    _check()
    if requested >= 0:
        _require(requested <= length)
        length = requested
    var bytes: [u8] = []
    for index in 0..<length:
        bytes.push(0)
    var at: i64 = 0
    for at < length:
        var count = length - at
        if count > 65536:
            count = 65536
        native.buffer_read(owner, at as u64, bytes, at as u64, count as u64)
        _check()
        at += count
    return bytes

struct c_string:
    value: string

struct byte_buffer:
    owner: native.owner_buffer

## Copy VOID bytes into an owning native byte buffer.
## @param bytes Bytes copied into native storage.
## @return An owning byte buffer. Release with buffer_close.
func buffer_from_bytes(const bytes: [u8]) -> byte_buffer:
    return byte_buffer(owner = _bytes_buffer(bytes, 0 as u32))

## Copy the counted native bytes into a VOID byte array.
## @param byte_buffer_value Byte buffer owner, borrowed for this call.
## @return An independent copy of the bytes as a VOID array.
func buffer_bytes(byte_buffer_value: byte_buffer) -> [u8]:
    return _buffer_bytes(byte_buffer_value.owner)

## Decode UTF-8 from a native byte buffer up to its first bounded NUL.
## @param byte_buffer_value Byte buffer owner, borrowed for this call.
## @return The copied or decoded VOID string.
func buffer_text(byte_buffer_value: byte_buffer) -> string:
    var length = native.buffer_text_length(byte_buffer_value.owner)
    _check()
    return conversion.unwrap(string.from_utf8(_buffer_bytes(byte_buffer_value.owner, length as i64)))

## Consume the buffer owner and release its native reference.
## @param byte_buffer_value Owner consumed by this release. Its aliases become unusable.
## @return The resource-ledger close status. This operation consumes the supplied owner.
func buffer_close(byte_buffer_value: byte_buffer) -> i32:
    return native.buffer_close(byte_buffer_value.owner)

struct string_array:
    owner: native.owner_buffer

## Create an owning string array from copied source elements.
## @param values Elements copied into the new array.
## @return An owning string array. Release with string_array_close.
func string_array_from(const values: [string]) -> string_array:
    var array = native.strings_new(values.count as u64) as native.owner_buffer
    _check()
    for index in 0..<values.count:
        var value = _string_buffer(values[index])
        native.strings_set(array, index as u64, value)
        native.buffer_close(value)
        _check()
    return string_array(owner = array)

## Get the number of elements in the string array.
## @param string_array_value String array owner, borrowed for this call.
## @return The number of elements in the array.
func string_array_count(string_array_value: string_array) -> i64:
    return native.buffer_count(string_array_value.owner) as i64

## Read an element from the string array.
## @param array Array, borrowed for this call.
## @param index Zero-based element index.
## @return A copy of the element at index.
func string_array_get(array: string_array, index: i64) -> string:
    var value = native.strings_get(array.owner, index as u64) as native.owner_buffer
    _check()
    defer native.buffer_close(value)
    return conversion.unwrap(string.from_utf8(_buffer_bytes(value)))

## Consume the string array owner and release its native reference.
## @param string_array_value Owner consumed by this release. Its aliases become unusable.
## @return The resource-ledger close status. This operation consumes the supplied owner.
func string_array_close(string_array_value: string_array) -> i32:
    return native.buffer_close(string_array_value.owner)

struct window:
    owner: native.owner_window

## Initialize window and OpenGL context.
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param width Width in pixels.
## @param height Height in pixels.
## @param title UTF-8 window title.
## @return An owning window, or null if acquisition fails. Release with close_window.
func init_window(width: i32, height: i32, title: string) -> window?:
    var text = _string_buffer(title)
    defer native.buffer_close(text)
    var value = native.init_window(width, height, text)
    _check()
    if value == null:
        return null
    return window(owner = value as native.owner_window)

## Consume the window owner and close it after retained GPU dependents release.
## @param window_value Owner consumed by this release. Its aliases become unusable.
## @return The resource-ledger close status. This operation consumes the supplied owner.
func close_window(window_value: window) -> i32:
    return native.close_window(window_value.owner)

