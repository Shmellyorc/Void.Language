func image_draw_triangle_fan(dst: image, points: vector2_array, point_count: i32, color_value: native.color):
    native.image_draw_triangle_fan(dst.owner, points.owner, point_count, color_value)
    _check()

## Draw a triangle strip defined by points within an image.
## This mutation requires an exclusive owning resource and invalidates earlier views.
## @param dst Destination modified by this operation.
## @param points Point array, borrowed for this call.
## @param point_count Number of points to use from the supplied array.
## @param color_value Color including its alpha channel.
func image_draw_triangle_strip(dst: image, points: vector2_array, point_count: i32, color_value: native.color):
    native.image_draw_triangle_strip(dst.owner, points.owner, point_count, color_value)
    _check()

## Draw a source image within a destination image (tint applied to source).
## This mutation requires an exclusive owning resource and invalidates earlier views.
## @param dst Destination modified by this operation.
## @param src Source read by this operation.
## @param src_rec Source rectangle.
## @param dst_rec Destination rectangle.
## @param tint Color multiplied with the source colors.
func image_draw(dst: image, src: image, src_rec: native.rectangle, dst_rec: native.rectangle, tint: native.color):
    native.image_draw(dst.owner, src.owner, src_rec, dst_rec, tint)
    _check()

## Draw text (using default font) within an image (destination).
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## This mutation requires an exclusive owning resource and invalidates earlier views.
## @param dst Destination modified by this operation.
## @param text Text supplied to this operation.
## @param pos_x Horizontal position in pixels.
## @param pos_y Vertical position in pixels.
## @param font_size Font size in pixels.
## @param color_value Color including its alpha channel.
func image_draw_text(dst: image, text: string, pos_x: i32, pos_y: i32, font_size: i32, color_value: native.color):
    var text_bytes = _string_buffer(text)
    defer native.buffer_close(text_bytes)
    native.image_draw_text(dst.owner, text_bytes, pos_x, pos_y, font_size, color_value)
    _check()

## Draw text (custom sprite font) within an image (destination).
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## This mutation requires an exclusive owning resource and invalidates earlier views.
## @param dst Destination modified by this operation.
## @param font_value Font resource, borrowed for this call.
## @param text Text supplied to this operation.
## @param position Position used by this operation.
## @param font_size Font size in pixels.
## @param spacing Extra spacing between characters in pixels.
## @param tint Color multiplied with the source colors.
func image_draw_text_ex(dst: image, font_value: font, text: string, position: native.vector2, font_size: f32, spacing: f32, tint: native.color):
    var text_bytes = _string_buffer(text)
    defer native.buffer_close(text_bytes)
    native.image_draw_text_ex(dst.owner, font_value.owner, text_bytes, position, font_size, spacing, tint)
    _check()

## Load texture from file into GPU memory (VRAM).
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param file_name Path to the file. Relative paths use the process working directory.
## @return An owning texture, or null if acquisition fails. Release with unload_texture.
func load_texture(file_name: string) -> texture?:
    var file_name_bytes = _string_buffer(file_name)
    defer native.buffer_close(file_name_bytes)
    var value = native.load_texture(file_name_bytes)
    return _wrap_texture(value)

## Load texture from image data.
## @param image_value Image resource, borrowed for this call.
## @return An owning texture, or null if acquisition fails. Release with unload_texture.
func load_texture_from_image(image_value: image) -> texture?:
    var value = native.load_texture_from_image(image_value.owner)
    return _wrap_texture(value)

## Load cubemap from image, multiple image cubemap layouts supported.
## @param image_value Image resource, borrowed for this call.
## @param layout Layout selector from the constants for this operation.
## @return An owning texture, or null if acquisition fails. Release with unload_texture.
func load_texture_cubemap(image_value: image, layout: i32) -> texture?:
    var value = native.load_texture_cubemap(image_value.owner, layout)
    return _wrap_texture(value)

## Load texture for rendering (framebuffer).
## @param width Width in pixels.
## @param height Height in pixels.
## @return An owning render texture, or null if acquisition fails. Release with unload_render_texture.
func load_render_texture(width: i32, height: i32) -> render_texture?:
    var value = native.load_render_texture(width, height)
    return _wrap_render_texture(value)

## Check if a texture is valid (loaded in GPU).
## @param texture_value Texture resource, borrowed for this call.
## @return True when raylib reports the texture as valid on the GPU.
func is_texture_valid(texture_value: texture) -> bool:
    var value = native.is_texture_valid(texture_value.owner)
    _check()
    return value

## Unload texture from GPU memory (VRAM).
## @param texture_value Owner consumed by this release. Its aliases become unusable.
## @return The resource-ledger close status. This operation consumes the supplied owner.
func unload_texture(texture_value: texture) -> i32:
    return native.owner_texture_close(texture_value.owner)

## Check if a render texture is valid (loaded in GPU).
## @param target Render texture whose native validity is queried.
## @return True when raylib reports the render texture as valid on the GPU.
func is_render_texture_valid(target: render_texture) -> bool:
    var value = native.is_render_texture_valid(target.owner)
    _check()
    return value

## Unload render texture from GPU memory (VRAM).
## @param target Owner consumed by this release. Its aliases become unusable.
## @return The resource-ledger close status. This operation consumes the supplied owner.
func unload_render_texture(target: render_texture) -> i32:
    return native.owner_render_texture_close(target.owner)

## Update GPU texture with new data (pixels should be able to fill texture).
## @param texture_value Texture resource, borrowed for this call.
## @param pixels Pixel data in a live byte buffer.
func update_texture(texture_value: texture, pixels: byte_buffer):
    native.update_texture(texture_value.owner, pixels.owner)
    _check()

## Update GPU texture rectangle with new data (pixels and rec should fit in texture).
## @param texture_value Texture resource, borrowed for this call.
## @param rec Rectangle.
## @param pixels Pixel data in a live byte buffer.
func update_texture_rec(texture_value: texture, rec: native.rectangle, pixels: byte_buffer):
    native.update_texture_rec(texture_value.owner, rec, pixels.owner)
    _check()

## Generate GPU mipmaps for a texture.
## This mutation requires an exclusive owning resource and invalidates earlier views.
## @param texture_value Texture resource, borrowed for this call.
func gen_texture_mipmaps(texture_value: texture):
    native.gen_texture_mipmaps(texture_value.owner)
    _check()

