## Internal memory allocator.
## @param size Number of bytes to allocate.
## @return An owning byte buffer, or null if acquisition fails. Release with buffer_close.
func mem_alloc(size: u32) -> byte_buffer?:
    var value = native.buffer_new(size as u64, 0 as u32)
    _check()
    if value == null:
        return null
    return byte_buffer(owner = value as native.owner_buffer)

## Resize an exclusive byte allocation while preserving its owner.
## This mutation requires an exclusive owning resource and invalidates earlier views.
## @param ptr Exclusive byte allocation. The same owner is resized on success and preserved on allocation failure.
## @param size New allocation size in bytes.
## @return The original owner after resizing, or null on allocation failure. Failure leaves the original allocation valid.
func mem_realloc(ptr: byte_buffer, size: u32) -> byte_buffer?:
    var resized = native.mem_realloc(ptr.owner, size)
    _check()
    if not resized:
        return null
    return ptr

## Take an owning snapshot of dropped file paths and acknowledge the native drop event.
## @return An owning file path list, or null if acquisition fails. Release with unload_directory_files.
func load_dropped_files() -> file_path_list?:
    var value = native.load_dropped_files()
    return _wrap_file_path_list(value)

## Unload dropped filepaths.
## @param files Owner consumed by this release. Its aliases become unusable.
