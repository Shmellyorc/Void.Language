struct gallery_window:
    owner: native.window

## Open the historical gallery demonstration window.
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param width Width in pixels.
## @param height Height in pixels.
## @param title UTF-8 window title.
## @return An owning gallery window, or null if acquisition fails. Release with close_gallery.
func open_gallery(width: i32, height: i32, title: string) -> gallery_window?:
    var bytes = title.to_utf8()
    if native.title(bytes, 0, bytes.count as u64) < 0:
        return null
    var acquired = native.open(width, height)
    if acquired == null:
        return null
    return gallery_window(owner = acquired as native.window)

## Close the historical gallery demonstration window owner.
## @param gallery Owner consumed by this release. Its aliases become unusable.
## @return The resource-ledger close status. This operation consumes the supplied owner.
func close_gallery(gallery: gallery_window) -> i32:
    return native.close(gallery.owner)

## Draw a frame of the historical gallery demonstration.
## @param gallery Gallery window owner, borrowed for this call.
## @param x Horizontal position of the gallery sprite in pixels.
## @param frame Frame counter used to animate the gallery circle.
## @param background Background color.
## @return 0 after drawing the gallery frame.
func draw_gallery(gallery: gallery_window, x: i32, frame: i32, background: native.color) -> i32:
    return native.draw(gallery.owner, x, frame, background.r, background.g, background.b)

## Check whether the gallery window has received a close request or its configured exit key was pressed.
## @param gallery Gallery window borrowed for this query.
## @return True when the gallery should close. The gallery owner stays valid for explicit cleanup.
func gallery_should_close(gallery: gallery_window) -> bool:
    return native.should_close(gallery.owner)

## Get horizontal keyboard movement for the gallery demonstration.
## @param gallery Gallery window owner, borrowed for this call.
## @return -1 while only Left is held, 1 while only Right is held, or 0 when neither or both are held.
func gallery_direction(gallery: gallery_window) -> i32:
    return native.direction(gallery.owner)


# G77 fallible companions. Physical source; native declarations and ABI are unchanged.

## Observable failures from fallible raylib operations, without guessing an OS or decoder cause.
enum load_error_kind:
    ## The existing loader returned no acquired owner.
    acquisition_failed
    ## Raylib rejected the acquired resource's validity; the temporary owner was released.
    invalid_resource
    ## A requested font or custom shader resolved to raylib's built-in default instead.
    default_fallback
    ## A file/data operation explicitly returned false.
    operation_failed

## Recoverable raylib operation failure. Native contract violations retain their existing checked failure behavior.
struct load_error extends core_error.error:
    ## Exact existing raylib wrapper name that reported the failure.
    operation: string
    ## Observable failure category; it does not distinguish absent files, permissions or unsupported formats.
    kind: load_error_kind

private func _load_failure(operation: string, kind: load_error_kind) -> load_error:
    var message = "Raylib did not acquire a resource"
    var code: i32 = 1
    if kind is load_error_kind.invalid_resource:
        message = "Raylib reported an invalid acquired resource"
        code = 2
    else if kind is load_error_kind.default_fallback:
        message = "Raylib returned its built-in default instead of the requested resource"
        code = 3
    else if kind is load_error_kind.operation_failed:
        message = "Raylib reported that the operation failed"
        code = 4
    return load_error(message = message, code = code, operation = operation, kind = kind)

private func _try_image(candidate: image?, operation: string) -> result<image, load_error>:
    if candidate == null:
        return Err(_load_failure(operation, load_error_kind.acquisition_failed))
    var acquired = candidate as image
    if not is_image_valid(acquired):
        unload_image(acquired)
        return Err(_load_failure(operation, load_error_kind.invalid_resource))
    return Ok(acquired)

private func _try_texture(candidate: texture?, operation: string) -> result<texture, load_error>:
    if candidate == null:
        return Err(_load_failure(operation, load_error_kind.acquisition_failed))
    var acquired = candidate as texture
    if not is_texture_valid(acquired):
        unload_texture(acquired)
        return Err(_load_failure(operation, load_error_kind.invalid_resource))
    return Ok(acquired)

private func _try_render_texture(candidate: render_texture?, operation: string) -> result<render_texture, load_error>:
    if candidate == null:
        return Err(_load_failure(operation, load_error_kind.acquisition_failed))
    var acquired = candidate as render_texture
    if not is_render_texture_valid(acquired):
        unload_render_texture(acquired)
        return Err(_load_failure(operation, load_error_kind.invalid_resource))
    return Ok(acquired)

private func _try_wave(candidate: wave?, operation: string) -> result<wave, load_error>:
    if candidate == null:
        return Err(_load_failure(operation, load_error_kind.acquisition_failed))
    var acquired = candidate as wave
    if not is_wave_valid(acquired):
        unload_wave(acquired)
        return Err(_load_failure(operation, load_error_kind.invalid_resource))
    return Ok(acquired)

private func _try_sound(candidate: sound?, operation: string) -> result<sound, load_error>:
    if candidate == null:
        return Err(_load_failure(operation, load_error_kind.acquisition_failed))
    var acquired = candidate as sound
    if not is_sound_valid(acquired):
        unload_sound(acquired)
        return Err(_load_failure(operation, load_error_kind.invalid_resource))
    return Ok(acquired)

private func _try_music(candidate: music?, operation: string) -> result<music, load_error>:
    if candidate == null:
        return Err(_load_failure(operation, load_error_kind.acquisition_failed))
    var acquired = candidate as music
    if not is_music_valid(acquired):
        unload_music_stream(acquired)
        return Err(_load_failure(operation, load_error_kind.invalid_resource))
    return Ok(acquired)

private func _try_audio_stream(candidate: audio_stream?, operation: string) -> result<audio_stream, load_error>:
    if candidate == null:
        return Err(_load_failure(operation, load_error_kind.acquisition_failed))
    var acquired = candidate as audio_stream
    if not is_audio_stream_valid(acquired):
        unload_audio_stream(acquired)
        return Err(_load_failure(operation, load_error_kind.invalid_resource))
    return Ok(acquired)

private func _try_model(candidate: model?, operation: string) -> result<model, load_error>:
    if candidate == null:
        return Err(_load_failure(operation, load_error_kind.acquisition_failed))
    var acquired = candidate as model
    if not is_model_valid(acquired):
        unload_model(acquired)
        return Err(_load_failure(operation, load_error_kind.invalid_resource))
    return Ok(acquired)

private func _try_byte_buffer(candidate: byte_buffer?, operation: string) -> result<byte_buffer, load_error>:
    if candidate == null:
        return Err(_load_failure(operation, load_error_kind.acquisition_failed))
    var acquired = candidate as byte_buffer
    return Ok(acquired)

private func _try_font(candidate: font?, operation: string) -> result<font, load_error>:
    if candidate == null:
        return Err(_load_failure(operation, load_error_kind.acquisition_failed))
    var acquired = candidate as font
    if not is_font_valid(acquired):
        unload_font(acquired)
        return Err(_load_failure(operation, load_error_kind.invalid_resource))
    var candidate_texture = acquired.texture
    if candidate_texture == null:
        unload_font(acquired)
        return Err(_load_failure(operation, load_error_kind.invalid_resource))
    var acquired_texture = candidate_texture as texture
    defer unload_texture(acquired_texture)
    if not is_texture_valid(acquired_texture):
        unload_font(acquired)
        return Err(_load_failure(operation, load_error_kind.invalid_resource))
    var default_candidate = get_font_default()
    if default_candidate == null:
        unload_font(acquired)
        return Err(_load_failure(operation, load_error_kind.acquisition_failed))
    var default_font = default_candidate as font
    defer unload_font(default_font)
    var default_texture_candidate = default_font.texture
    if default_texture_candidate == null:
        unload_font(acquired)
        return Err(_load_failure(operation, load_error_kind.acquisition_failed))
    var default_texture = default_texture_candidate as texture
    defer unload_texture(default_texture)
    if acquired_texture.id == default_texture.id:
        unload_font(acquired)
        return Err(_load_failure(operation, load_error_kind.default_fallback))
    return Ok(acquired)

private func _try_shader(candidate: shader?, operation: string, allow_default: bool) -> result<shader, load_error>:
    if candidate == null:
        return Err(_load_failure(operation, load_error_kind.acquisition_failed))
    var acquired = candidate as shader
    if not is_shader_valid(acquired):
        unload_shader(acquired)
        return Err(_load_failure(operation, load_error_kind.invalid_resource))
    if not allow_default:
        var default_candidate = load_shader(null, null)
        if default_candidate == null:
            unload_shader(acquired)
            return Err(_load_failure(operation, load_error_kind.acquisition_failed))
        var default_shader = default_candidate as shader
        defer unload_shader(default_shader)
        if acquired.id == default_shader.id:
            unload_shader(acquired)
            return Err(_load_failure(operation, load_error_kind.default_fallback))
    return Ok(acquired)

## Try to load image from file into CPU memory (RAM).
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param file_name Path to the file. Relative paths use the process working directory.
## Native lifetime, thread, input-extent and required device/context checks retain their checked failures.
## @return Ok with one image owner to release using unload_image; Err(load_error) if no owner is acquired or resource validation fails. Rejected temporary owners are released.
func try_load_image(file_name: string) -> result<image, load_error>:
    return _try_image(load_image(file_name), "load_image")

## Try to load image from RAW file data.
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param file_name Path to the file. Relative paths use the process working directory.
## @param width Width in pixels.
## @param height Height in pixels.
## @param format Pixel format from the pixel-format constants.
## @param header_size Number of file-header bytes skipped before the raw pixels.
## Native lifetime, thread, input-extent and required device/context checks retain their checked failures.
## @return Ok with one image owner to release using unload_image; Err(load_error) if no owner is acquired or resource validation fails. Rejected temporary owners are released.
func try_load_image_raw(file_name: string, width: i32, height: i32, format: i32, header_size: i32) -> result<image, load_error>:
    return _try_image(load_image_raw(file_name, width, height, format, header_size), "load_image_raw")

## Try to load all frames of an animated image and retain the frame count.
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param file_name Path to the file. Relative paths use the process working directory.
## Native lifetime, thread, input-extent and required device/context checks retain their checked failures.
