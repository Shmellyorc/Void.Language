## Load UTF-8 text encoded from codepoints array.
## @param codepoints Unicode codepoint array, borrowed for this call.
## @param length Number of Unicode codepoints to encode from the codepoints array.
## @return An owning byte buffer, or null if acquisition fails. Release with buffer_close.
func load_utf8(codepoints: int_array, length: i32) -> byte_buffer?:
    var value = native.load_utf8(codepoints.owner, length)
    _check()
    if value == null:
        return null
    var owner = value as native.owner_buffer
    return byte_buffer(owner = owner)

## Unload UTF-8 text encoded from codepoints array.
## @param text Owner consumed by this release. Its aliases become unusable.
## @return The resource-ledger close status. This operation consumes the supplied owner.
func unload_utf8(text: byte_buffer) -> i32:
    return native.buffer_close(text.owner)

## Load all codepoints from a UTF-8 text string, codepoints count returned by parameter.
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param text Text supplied to this operation.
## @return An owning int array, or null if acquisition fails. Release with int_array_close.
func load_codepoints(text: string) -> int_array?:
    var text_bytes = _string_buffer(text)
    defer native.buffer_close(text_bytes)
    var value = native.load_codepoints(text_bytes)
    _check()
    if value == null:
        return null
    var owner = value as native.owner_buffer
    return int_array(owner = owner)

## Unload codepoints data from memory.
## @param codepoints Owner consumed by this release. Its aliases become unusable.
## @return The resource-ledger close status. This operation consumes the supplied owner.
func unload_codepoints(codepoints: int_array) -> i32:
    return native.buffer_close(codepoints.owner)

## Count Unicode codepoints in UTF-8 text.
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param text Text supplied to this operation.
## @return Number of Unicode codepoints in the UTF-8 text.
func get_codepoint_count(text: string) -> i32:
    var text_bytes = _string_buffer(text)
    defer native.buffer_close(text_bytes)
    var value = native.get_codepoint_count(text_bytes)
    _check()
    return value

## Decode the next UTF-8 codepoint and return its value and byte count.
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param text UTF-8 text beginning at the codepoint to decode.
## @return A record with value (codepoint) and size (consumed UTF-8 bytes).
func get_codepoint(text: string) -> native.int_out:
    var text_bytes = _string_buffer(text)
    defer native.buffer_close(text_bytes)
    var value = native.get_codepoint(text_bytes)
    _check()
    return value

## Decode the next UTF-8 codepoint and return its value and byte count.
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param text UTF-8 text beginning at the codepoint to decode.
## @return A record with value (codepoint) and size (consumed UTF-8 bytes).
func get_codepoint_next(text: string) -> native.int_out:
    var text_bytes = _string_buffer(text)
    defer native.buffer_close(text_bytes)
    var value = native.get_codepoint_next(text_bytes)
    _check()
    return value

## Encode one Unicode codepoint into an owning UTF-8 byte buffer.
## @param codepoint Unicode codepoint value.
## @return An owning byte buffer containing the encoded UTF-8 sequence, or null on failure. Release with buffer_close.
func codepoint_to_utf8(codepoint: i32) -> byte_buffer?:
    var value = native.codepoint_to_utf8(codepoint)
    _check()
    if value == null:
        return null
    var owner = value as native.owner_buffer
    return byte_buffer(owner = owner)

## Load text as separate lines ('\n').
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param text Text supplied to this operation.
## @return An owning string array, or null if acquisition fails. Release with string_array_close.
func load_text_lines(text: string) -> string_array?:
    var text_bytes = _string_buffer(text)
    defer native.buffer_close(text_bytes)
    var value = native.load_text_lines(text_bytes)
    _check()
    if value == null:
        return null
    var owner = value as native.owner_buffer
    return string_array(owner = owner)

## Unload text lines.
## @param text Owner consumed by this release. Its aliases become unusable.
## @param line_count Line count. Must match the allocated array when unloading.
## @return The resource-ledger close status. This operation consumes the supplied owner.
func unload_text_lines(text: string_array, line_count: i32) -> i32:
    _require(line_count as u64 == native.buffer_count(text.owner))
    return native.buffer_close(text.owner)

## Check whether two UTF-8 text strings are equal.
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param text1 First text to compare.
## @param text2 Second text to compare.
## @return True when the two UTF-8 text strings are equal.
func text_is_equal(text1: string, text2: string) -> bool:
    var text1_bytes = _string_buffer(text1)
    defer native.buffer_close(text1_bytes)
    var text2_bytes = _string_buffer(text2)
    defer native.buffer_close(text2_bytes)
    var value = native.text_is_equal(text1_bytes, text2_bytes)
    _check()
    return value

