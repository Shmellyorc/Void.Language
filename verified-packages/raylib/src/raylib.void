func try_load_shader_from_memory(vs_code: c_string?, fs_code: c_string?) -> result<shader, load_error>:
    return _try_shader(load_shader_from_memory(vs_code, fs_code), "load_shader_from_memory", vs_code == null and fs_code == null)

