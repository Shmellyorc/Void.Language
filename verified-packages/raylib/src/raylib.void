## Load color data from image as a Color array (RGBA - 32bit).
## @param image_value Image resource, borrowed for this call.
## @return An owning color array, or null if acquisition fails. Release with color_array_close.
func load_image_colors(image_value: image) -> color_array?:
    var value = native.load_image_colors(image_value.owner)
    _check()
    if value == null:
        return null
    var owner = value as native.owner_buffer
    return color_array(owner = owner)

## Load colors palette from image as a Color array (RGBA - 32bit).
## @param image_value Image resource, borrowed for this call.
## @param max_palette_size Maximum number of colors to extract.
## @return An owning color array, or null if acquisition fails. Release with color_array_close.
func load_image_palette(image_value: image, max_palette_size: i32) -> color_array?:
    var value = native.load_image_palette(image_value.owner, max_palette_size)
    _check()
    if value == null:
        return null
    var owner = value as native.owner_buffer
    return color_array(owner = owner)

## Unload color data loaded with load_image_colors().
## @param colors Owner consumed by this release. Its aliases become unusable.
## @return The resource-ledger close status. This operation consumes the supplied owner.
func unload_image_colors(colors: color_array) -> i32:
    return native.buffer_close(colors.owner)

## Unload colors palette loaded with load_image_palette().
## @param colors Owner consumed by this release. Its aliases become unusable.
## @return The resource-ledger close status. This operation consumes the supplied owner.
func unload_image_palette(colors: color_array) -> i32:
    return native.buffer_close(colors.owner)

