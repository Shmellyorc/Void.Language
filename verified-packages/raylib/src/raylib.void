## @param col2 Second color.
## @return An owning image, or null if acquisition fails. Release with unload_image.
func gen_image_checked(width: i32, height: i32, checks_x: i32, checks_y: i32, col1: native.color, col2: native.color) -> image?:
    var value = native.gen_image_checked(width, height, checks_x, checks_y, col1, col2)
    return _wrap_image(value)

