    native.set_audio_stream_pitch(stream.owner, pitch)
    _check()

## Set pan for audio stream (-1.0 to 1.0 range, 0.0 is centered).
## @param stream Audio stream resource, borrowed for this call.
## @param pan Stereo pan from -1.0 (left) through 0.0 (center) to 1.0 (right).
func set_audio_stream_pan(stream: audio_stream, pan: f32):
    native.set_audio_stream_pan(stream.owner, pan)
    _check()

# The runtime owns the closure and generation. Invocation I/O is scoped to its callback thread.
struct callback_registration:
    owner: native.callback_registration

private func _callback_read(which: u32) -> [u8]:
    var length = native.callback_input_size(which) as i64
    _check()
    var bytes: [u8] = []
    for index in 0..<length:
        bytes.push(0)
    var at: i64 = 0
    for at < length:
        var count = length - at
        if count > 65536:
            count = 65536
        native.callback_read(which, at as u64, bytes, at as u64, count as u64)
        _check()
        at += count
    return bytes

private func _callback_name() -> string:
    return conversion.unwrap(string.from_utf8(_callback_read(0)))

private func _callback_write(const bytes: [u8]):
    native.callback_output_size(bytes.count as u64)
    _check()
    var at: i64 = 0
    for at < bytes.count:
        var count = bytes.count - at
        if count > 65536:
            count = 65536
        native.callback_write(at as u64, bytes, at as u64, count as u64)
        _check()
        at += count

private func _callback_register(target: native.callback_target, handler: func(u32, i32) -> i32) -> callback_registration:
    native.callback_activate(target)
    _check()
    var acquired = native.callback_register(func(frames: u32, level: i32) -> i32:
        return handler(frames, level)
    )
    _check()
    _require(acquired != null)
    return callback_registration(owner = acquired as native.callback_registration)

## Consume the callback owner and release its native reference.
## @param registration Owner consumed by this release. Its aliases become unusable.
## @return The resource-ledger close status. This operation consumes the supplied owner.
func callback_close(registration: callback_registration) -> i32:
    return native.callback_close(registration.owner)

## Get the number of successful callback invocations.
## @param registration Callback registration whose lifetime is controlled by this operation.
## @return Number of successful callback invocations. Recorded callback faults are reported.
func callback_count(registration: callback_registration) -> u64:
    var count = native.callback_count(registration.owner)
    _check()
    return count

## Check whether a callback registration remains active.
## @param registration Callback registration whose lifetime is controlled by this operation.
## @return Whether this registration is currently active. Recorded callback faults are reported.
func callback_active(registration: callback_registration) -> bool:
    var active = native.callback_active(registration.owner)
    _check()
    return active

## Log UTF-8 text at the requested severity. Percent sequences remain literal text.
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param log_level Log severity from the log constants.
## @param text Text supplied to this operation.
func trace_log(log_level: i32, text: string):
    var text_local = _string_buffer(text)
    defer native.buffer_close(text_local)
    native.trace_log(log_level, text_local)
    _check()

# Same supported types/hooks as the builtin formatter. Multiple values use ordinary
# VOID interpolation before this call. This is deliberately not C printf varargs.
## Format one typed value with VOID format rules.
## @param value Value formatted using the existing VOID format rules.
## @param spec VOID format specification, with an empty string selecting the default.
## @return Ok(formatted_text), or Err(message) when the format specification is invalid.
func text_format<t>(value: t, spec: string = "") -> result<string, string>:
    return format(value, spec)

## Set custom trace log.
## The runtime retains the handler until callback_close or shutdown unregisters and drains it.
## Register and invoke global hooks on the application thread with audio closed.
## @param handler Handler receiving log level and formatted text on the application thread.
## @return An owning callback registration. Release with callback_close.
func set_trace_log_callback(handler: func(i32, string)) -> callback_registration:
    var target = native.callback_target_new(1) as native.callback_target
    defer native.callback_target_close(target)
    return _callback_register(target, func(frames: u32, level: i32) -> i32:
        handler(level, _callback_name())
        return 1
    )

## Set custom file binary data loader.
## The runtime retains the handler until callback_close or shutdown unregisters and drains it.
## Register and invoke global hooks on the application thread with audio closed.
## @param handler Handler receiving a file name. Return Ok(bytes) or Err(message) for load failure.
## @return An owning callback registration. Release with callback_close.
func set_load_file_data_callback(handler: func(string) -> result<[u8], string>) -> callback_registration:
    var target = native.callback_target_new(2) as native.callback_target
    defer native.callback_target_close(target)
    return _callback_register(target, func(frames: u32, level: i32) -> i32:
        var outcome = handler(_callback_name())
        if outcome is Ok(var bytes):
            _callback_write(bytes)
            return 1
        return 2
    )

## Set custom file binary data saver.
## The runtime retains the handler until callback_close or shutdown unregisters and drains it.
## Register and invoke global hooks on the application thread with audio closed.
## @param handler Handler receiving a file name and copied file bytes. Return whether saving succeeded.
## @return An owning callback registration. Release with callback_close.
func set_save_file_data_callback(handler: func(string, [u8]) -> bool) -> callback_registration:
    var target = native.callback_target_new(3) as native.callback_target
    defer native.callback_target_close(target)
    return _callback_register(target, func(frames: u32, level: i32) -> i32:
        if handler(_callback_name(), _callback_read(1)):
            return 1
        return 2
    )

## Set custom file text data loader.
## The runtime retains the handler until callback_close or shutdown unregisters and drains it.
## Register and invoke global hooks on the application thread with audio closed.
## @param handler Handler receiving a file name. Return Ok(NUL-free UTF-8 text) or Err(message).
## @return An owning callback registration. Release with callback_close.
func set_load_file_text_callback(handler: func(string) -> result<string, string>) -> callback_registration:
    var target = native.callback_target_new(4) as native.callback_target
    defer native.callback_target_close(target)
    return _callback_register(target, func(frames: u32, level: i32) -> i32:
        var outcome = handler(_callback_name())
        if outcome is Ok(var text):
            var bytes = text.to_utf8()
            for byte in bytes:
                _require(byte != 0)
            _callback_write(bytes)
            return 1
        return 2
    )

## Set custom file text data saver.
## The runtime retains the handler until callback_close or shutdown unregisters and drains it.
## Register and invoke global hooks on the application thread with audio closed.
## @param handler Handler receiving a file name and copied UTF-8 text. Return whether saving succeeded.
## @return An owning callback registration. Release with callback_close.
func set_save_file_text_callback(handler: func(string, string) -> bool) -> callback_registration:
    var target = native.callback_target_new(5) as native.callback_target
    defer native.callback_target_close(target)
    return _callback_register(target, func(frames: u32, level: i32) -> i32:
        if handler(_callback_name(), conversion.unwrap(string.from_utf8(_callback_read(1)))):
            return 1
        return 2
    )

# PCM generation uses the stream's native format. Processors always receive
# frames * 2 float32 samples, as specified by the upstream public declarations.
# Byte representations use the qualified x64 little-endian native format.
## Audio thread callback to request new data.
## The runtime retains the handler until callback_close or shutdown unregisters and drains it.
## The registration retains its audio parent. Calling raylib inside an audio handler is rejected.
## @param stream Audio stream resource, borrowed for this call.
## @param handler PCM generator receiving frame count, channels and bits per sample. Return exactly the requested byte count in the stream format.
## @return An owning callback registration. Release with callback_close.
func set_audio_stream_callback(stream: audio_stream, handler: func(u32, u32, u32) -> [u8]) -> callback_registration:
    var channels = stream.channels
    var sample_size = stream.sample_size
    var target = native.callback_target_stream(stream.owner, 6) as native.callback_target
    defer native.callback_target_close(target)
    return _callback_register(target, func(frames: u32, level: i32) -> i32:
        var bytes = handler(frames, channels, sample_size)
        _require(bytes.count as u64 == native.callback_input_size(1))
        _callback_write(bytes)
        return 1
    )

## Attach audio stream processor to stream, receives frames x 2 samples as 'float' (stereo).
## The runtime retains the handler until callback_close or shutdown unregisters and drains it.
## The registration retains its audio parent. Calling raylib inside an audio handler is rejected.
## @param stream Audio stream resource, borrowed for this call.
## @param handler Processor receiving float32 stereo PCM bytes and a frame count. Return the same byte count. Calling raylib from this handler is rejected.
## @return An owning callback registration. Release with callback_close.
func attach_audio_stream_processor(stream: audio_stream, handler: func([u8], u32) -> [u8]) -> callback_registration:
    var target = native.callback_target_stream(stream.owner, 7) as native.callback_target
    defer native.callback_target_close(target)
    return _callback_register(target, func(frames: u32, level: i32) -> i32:
        var bytes = handler(_callback_read(1), frames)
        _require(bytes.count as u64 == native.callback_input_size(1))
        _callback_write(bytes)
        return 1
    )

## Detach audio stream processor from stream.
## @param registration Owner consumed by this release. Its aliases become unusable.
## @return The resource-ledger close status. This operation consumes the supplied owner.
func detach_audio_stream_processor(registration: callback_registration) -> i32:
    _require(native.callback_kind(registration.owner) == 7)
    return callback_close(registration)

## Attach audio stream processor to the entire audio pipeline, receives frames x 2 samples as 'float' (stereo).
## The runtime retains the handler until callback_close or shutdown unregisters and drains it.
## The registration retains its audio parent. Calling raylib inside an audio handler is rejected.
## @param handler Processor receiving float32 stereo PCM bytes and a frame count. Return the same byte count. Calling raylib from this handler is rejected.
## @return An owning callback registration. Release with callback_close.
func attach_audio_mixed_processor(handler: func([u8], u32) -> [u8]) -> callback_registration:
    var target = native.callback_target_mixed() as native.callback_target
    defer native.callback_target_close(target)
    return _callback_register(target, func(frames: u32, level: i32) -> i32:
        var bytes = handler(_callback_read(1), frames)
        _require(bytes.count as u64 == native.callback_input_size(1))
        _callback_write(bytes)
        return 1
    )

## Detach audio stream processor from the entire audio pipeline.
## @param registration Owner consumed by this release. Its aliases become unusable.
## @return The resource-ledger close status. This operation consumes the supplied owner.
func detach_audio_mixed_processor(registration: callback_registration) -> i32:
    _require(native.callback_kind(registration.owner) == 8)
    return callback_close(registration)
