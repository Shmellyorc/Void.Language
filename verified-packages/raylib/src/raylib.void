## @param texture_value Texture resource, borrowed for this call.
## @param filter Texture scaling filter selected from the texture_filter_* constants.
func set_texture_filter(texture_value: texture, filter: i32):
    native.set_texture_filter(texture_value.owner, filter)
    _check()

## Set texture wrapping mode.
## @param texture_value Texture resource, borrowed for this call.
