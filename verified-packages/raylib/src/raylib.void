## Set texture and rectangle to be used on shapes drawing.
## @param texture_value Texture retained until replacement or window close.
## @param source Source region of the texture in pixels.
func set_shapes_texture(texture_value: texture, source: native.rectangle):
    native.set_shapes_texture(texture_value.owner, source)
    _check()

## Set icon for window (multiple images, RGBA 32bit).
## @param images Image array, borrowed for this call.
## @param count Number of elements to use, within the supplied array.
func set_window_icons(images: image_array, count: i32):
    native.set_window_icons(images.owner, count)
    _check()

## Decode the UTF-8 codepoint immediately before a byte position.
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param text Text supplied to this operation.
## @param position UTF-8 byte position immediately after the codepoint. A negative value selects the end of the text.
## @return A record with value (codepoint) and size (consumed UTF-8 bytes).
func get_codepoint_previous(text: string, position: i64 = -1) -> native.int_out:
    var bytes = _string_buffer(text)
    defer native.buffer_close(bytes)
    if position < 0:
        position = text.to_utf8().count
    var value = native.get_codepoint_previous(bytes, position as u64)
    _check()
    return value

## Copy one string to another, returns bytes copied.
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## This mutation requires an exclusive owning resource and invalidates earlier views.
## @param dst Writable byte buffer with capacity for the copied UTF-8 text and its terminating NUL.
## @param src NUL-free UTF-8 text to copy.
## @return Number of bytes copied, excluding the terminating NUL.
func text_copy(dst: byte_buffer, src: string) -> i32:
    var src_local = _string_buffer(src)
    defer native.buffer_close(src_local)
    var count = native.text_copy(dst.owner, src_local)
    _check()
    return count

## Append UTF-8 text to a writable buffer and return the updated byte cursor.
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## This mutation requires an exclusive owning resource and invalidates earlier views.
## @param text Writable byte buffer with capacity for the existing text, appended bytes and terminating NUL.
## @param append NUL-free UTF-8 text to append.
## @param position Current byte cursor in the writable destination. The updated cursor is returned.
## @return The updated byte cursor after appending.
func text_append(text: byte_buffer, append: string, position: i32) -> i32:
    var src = _string_buffer(append)
    defer native.buffer_close(src)
    var at = native.text_append(text.owner, src, position)
    _check()
    return at

## Join text strings with delimiter.
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param text_list String array, borrowed for this call.
## @param count Number of elements to use, within the supplied array.
## @param delimiter Delimiter between text items.
