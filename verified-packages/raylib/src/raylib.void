## @param factor Fraction of white pixels, from 0.0 to 1.0.
## @return An owning image, or null if acquisition fails. Release with unload_image.
func gen_image_white_noise(width: i32, height: i32, factor: f32) -> image?:
    var value = native.gen_image_white_noise(width, height, factor)
    return _wrap_image(value)

## Generate image: perlin noise.
## @param width Width in pixels.
## @param height Height in pixels.
## @param offset_x Horizontal offset.
## @param offset_y Vertical offset.
## @param scale Scale used by this operation.
## @return An owning image, or null if acquisition fails. Release with unload_image.
func gen_image_perlin_noise(width: i32, height: i32, offset_x: i32, offset_y: i32, scale: f32) -> image?:
    var value = native.gen_image_perlin_noise(width, height, offset_x, offset_y, scale)
    return _wrap_image(value)

## Generate image: cellular algorithm, bigger tileSize means bigger cells.
## @param width Width in pixels.
## @param height Height in pixels.
## @param tile_size Cell size in pixels.
## @return An owning image, or null if acquisition fails. Release with unload_image.
func gen_image_cellular(width: i32, height: i32, tile_size: i32) -> image?:
    var value = native.gen_image_cellular(width, height, tile_size)
    return _wrap_image(value)

## Generate image: grayscale image from text data.
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param width Width in pixels.
## @param height Height in pixels.
## @param text Text supplied to this operation.
## @return An owning image, or null if acquisition fails. Release with unload_image.
func gen_image_text(width: i32, height: i32, text: string) -> image?:
    var text_bytes = _string_buffer(text)
    defer native.buffer_close(text_bytes)
    var value = native.gen_image_text(width, height, text_bytes)
    return _wrap_image(value)

