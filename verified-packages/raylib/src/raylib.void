## Return the predefined lightgray color.
## @return The computed color value.
func lightgray() -> native.color:
    return color(200, 200, 200, 255)

## Return the predefined gray color.
## @return The computed color value.
func gray() -> native.color:
    return color(130, 130, 130, 255)

## Return the predefined darkgray color.
## @return The computed color value.
func darkgray() -> native.color:
    return color(80, 80, 80, 255)

## Return the predefined yellow color.
## @return The computed color value.
func yellow() -> native.color:
    return color(253, 249, 0, 255)

## Return the predefined gold color.
## @return The computed color value.
func gold() -> native.color:
    return color(255, 203, 0, 255)

## Return the predefined orange color.
## @return The computed color value.
func orange() -> native.color:
    return color(255, 161, 0, 255)

## Return the predefined pink color.
## @return The computed color value.
func pink() -> native.color:
    return color(255, 109, 194, 255)

## Return the predefined red color.
## @return The computed color value.
