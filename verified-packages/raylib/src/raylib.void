func get_codepoint_previous(text: string, position: i64 = -1) -> native.int_out:
    var bytes = _string_buffer(text)
    defer native.buffer_close(bytes)
    if position < 0:
        position = text.to_utf8().count
    var value = native.get_codepoint_previous(bytes, position as u64)
    _check()
    return value

func text_copy(dst: byte_buffer, text: string) -> i32:
    var src = _string_buffer(text)
    defer native.buffer_close(src)
    var count = native.text_copy(dst.owner, src)
    _check()
    return count

