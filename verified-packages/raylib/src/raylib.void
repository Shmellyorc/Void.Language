## Create an image from text (default font).
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param text Text supplied to this operation.
## @param font_size Font size in pixels.
## @param color_value Color including its alpha channel.
## @return An owning image, or null if acquisition fails. Release with unload_image.
func image_text(text: string, font_size: i32, color_value: native.color) -> image?:
    var text_bytes = _string_buffer(text)
    defer native.buffer_close(text_bytes)
    var value = native.image_text(text_bytes, font_size, color_value)
    return _wrap_image(value)

## Create an image from text (custom sprite font).
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param font_value Font resource, borrowed for this call.
## @param text Text supplied to this operation.
## @param font_size Font size in pixels.
## @param spacing Extra spacing between characters in pixels.
## @param tint Color multiplied with the source colors.
## @return An owning image, or null if acquisition fails. Release with unload_image.
func image_text_ex(font_value: font, text: string, font_size: f32, spacing: f32, tint: native.color) -> image?:
    var text_bytes = _string_buffer(text)
    defer native.buffer_close(text_bytes)
    var value = native.image_text_ex(font_value.owner, text_bytes, font_size, spacing, tint)
    return _wrap_image(value)

