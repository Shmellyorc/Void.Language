## @return Ok with one model owner to release using unload_model; Err(load_error) if no owner is acquired or resource validation fails. Rejected temporary owners are released.
func try_load_model(file_name: string) -> result<model, load_error>:
    return _try_model(load_model(file_name), "load_model")

## Try to load file data as byte array (read).
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param file_name Path to the file. Relative paths use the process working directory.
## Native lifetime, thread, input-extent and required device/context checks retain their checked failures.
## @return Ok with one byte_buffer owner to release using buffer_close; Err(load_error) if no owner is acquired or resource validation fails. Rejected temporary owners are released.
func try_load_file_data(file_name: string) -> result<byte_buffer, load_error>:
    return _try_byte_buffer(load_file_data(file_name), "load_file_data")

## Try to load text data from file (read), returns a '\0' terminated string.
