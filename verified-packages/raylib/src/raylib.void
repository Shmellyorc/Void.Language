## Get (evaluate) spline point: Linear.
## @param start_pos Starting position.
## @param end_pos Ending position.
## @param t Interpolation parameter from the pinned declaration.
## @return The computed vector2 value.
func get_spline_point_linear(start_pos: native.vector2, end_pos: native.vector2, t: f32) -> native.vector2:
    var value = native.get_spline_point_linear(start_pos, end_pos, t)
    _check()
    return value

## Evaluate a B-spline point at t using the four points in declaration order.
## @param p1 First point, named p1 in the pinned declaration.
## @param p2 Second point, named p2 in the pinned declaration.
## @param p3 Third point, named p3 in the pinned declaration.
## @param p4 Fourth point, named p4 in the pinned declaration.
## @param t Interpolation parameter from the pinned declaration.
## @return The computed vector2 value.
func get_spline_point_basis(p1: native.vector2, p2: native.vector2, p3: native.vector2, p4: native.vector2, t: f32) -> native.vector2:
    var value = native.get_spline_point_basis(p1, p2, p3, p4, t)
    _check()
    return value

## Evaluate a Catmull-Rom spline point at t using the four points in declaration order.
## @param p1 First point, named p1 in the pinned declaration.
## @param p2 Second point, named p2 in the pinned declaration.
## @param p3 Third point, named p3 in the pinned declaration.
## @param p4 Fourth point, named p4 in the pinned declaration.
## @param t Interpolation parameter from the pinned declaration.
## @return The computed vector2 value.
func get_spline_point_catmull_rom(p1: native.vector2, p2: native.vector2, p3: native.vector2, p4: native.vector2, t: f32) -> native.vector2:
    var value = native.get_spline_point_catmull_rom(p1, p2, p3, p4, t)
    _check()
    return value

## Evaluate a quadratic Bezier point at t using the declared endpoints and control point.
## @param p1 Starting endpoint of the quadratic Bezier segment.
## @param c2 Control point between the two endpoints.
## @param p3 Ending endpoint of the quadratic Bezier segment.
## @param t Interpolation parameter from the pinned declaration.
## @return The computed vector2 value.
func get_spline_point_bezier_quad(p1: native.vector2, c2: native.vector2, p3: native.vector2, t: f32) -> native.vector2:
    var value = native.get_spline_point_bezier_quad(p1, c2, p3, t)
    _check()
    return value

## Evaluate a cubic Bezier point at t using the declared endpoints and control points.
## @param p1 Starting endpoint of the cubic Bezier segment.
## @param c2 First control point, following p1.
## @param c3 Second control point, preceding p4.
## @param p4 Ending endpoint of the cubic Bezier segment.
## @param t Interpolation parameter from the pinned declaration.
## @return The computed vector2 value.
func get_spline_point_bezier_cubic(p1: native.vector2, c2: native.vector2, c3: native.vector2, p4: native.vector2, t: f32) -> native.vector2:
    var value = native.get_spline_point_bezier_cubic(p1, c2, c3, p4, t)
    _check()
    return value

## Check collision between two rectangles.
## @param rec1 First rectangle.
## @param rec2 Second rectangle.
## @return True when the rectangles overlap.
func check_collision_recs(rec1: native.rectangle, rec2: native.rectangle) -> bool:
    var value = native.check_collision_recs(rec1, rec2)
    _check()
    return value

## Check collision between two circles.
## @param center1 Center of the first circle or sphere.
## @param radius1 Radius of the first circle or sphere.
## @param center2 Center of the second circle or sphere.
## @param radius2 Radius of the second circle or sphere.
## @return True when the circles overlap.
func check_collision_circles(center1: native.vector2, radius1: f32, center2: native.vector2, radius2: f32) -> bool:
    var value = native.check_collision_circles(center1, radius1, center2, radius2)
    _check()
    return value

## Check collision between circle and rectangle.
## @param center Center position.
## @param radius Radius in pixels.
## @param rec Rectangle.
## @return True when the circle and rectangle overlap.
func check_collision_circle_rec(center: native.vector2, radius: f32, rec: native.rectangle) -> bool:
    var value = native.check_collision_circle_rec(center, radius, rec)
    _check()
    return value

## Check whether a circle intersects the line segment between p1 and p2.
## @param center Center position.
## @param radius Radius in pixels.
## @param p1 First endpoint of the line segment.
## @param p2 Second endpoint of the line segment.
## @return True when the circle intersects the line segment.
func check_collision_circle_line(center: native.vector2, radius: f32, p1: native.vector2, p2: native.vector2) -> bool:
    var value = native.check_collision_circle_line(center, radius, p1, p2)
    _check()
    return value

## Check if point is inside rectangle.
## @param point Point to test or draw.
## @param rec Rectangle.
## @return True when the point is inside the rectangle.
func check_collision_point_rec(point: native.vector2, rec: native.rectangle) -> bool:
    var value = native.check_collision_point_rec(point, rec)
    _check()
    return value

## Check if point is inside circle.
## @param point Point to test or draw.
## @param center Center position.
## @param radius Radius in pixels.
## @return True when the point is inside the circle.
func check_collision_point_circle(point: native.vector2, center: native.vector2, radius: f32) -> bool:
    var value = native.check_collision_point_circle(point, center, radius)
    _check()
    return value

## Check if point is inside a triangle.
## @param point Point to test or draw.
## @param p1 First vertex in the pinned declaration order.
## @param p2 Second vertex in the pinned declaration order.
## @param p3 Third vertex in the pinned declaration order.
## @return True when the point is inside the triangle.
func check_collision_point_triangle(point: native.vector2, p1: native.vector2, p2: native.vector2, p3: native.vector2) -> bool:
    var value = native.check_collision_point_triangle(point, p1, p2, p3)
    _check()
    return value

## Check if point belongs to line created between two points [p1] and [p2] with defined margin in pixels [threshold].
## @param point Point to test or draw.
## @param p1 First endpoint of the line segment.
## @param p2 Second endpoint of the line segment.
## @param threshold Allowed distance from the line segment in pixels.
## @return True when the point lies within threshold pixels of the line segment.
func check_collision_point_line(point: native.vector2, p1: native.vector2, p2: native.vector2, threshold: i32) -> bool:
    var value = native.check_collision_point_line(point, p1, p2, threshold)
    _check()
    return value

