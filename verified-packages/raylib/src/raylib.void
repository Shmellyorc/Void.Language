func try_load_file_text(file_name: string) -> result<byte_buffer, load_error>:
    return _try_byte_buffer(load_file_text(file_name), "load_file_text")

## Try to encode an image into a byte buffer using the selected file format.
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
