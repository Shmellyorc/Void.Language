func bone_info_array_count(value: bone_info_array) -> i64:
    var count = native.buffer_count(value.owner)
    _check()
    return count as i64

func bone_info_array_close(value: bone_info_array) -> i32:
    return native.buffer_close(value.owner)

func bone_info_array_get(array: bone_info_array, index: i64) -> native.bone_info:
    var value = native.buffer_bone_info_get(array.owner, index as u64)
    _check()
    return value

func bone_info_array_from(const values: [native.bone_info]) -> bone_info_array:
    var array = native.buffer_bone_info_new(values.count as u64) as native.owner_buffer
    _check()
    for index in 0..<values.count:
        var value = values[index]
        native.buffer_bone_info_set(array, index as u64, value)
        _check()
    return bone_info_array(owner = array)

