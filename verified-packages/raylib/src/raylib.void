func raywhite() -> native.color:
    return color(245, 245, 245, 255)


struct gallery_window:
    owner: native.window

func open_gallery(width: i32, height: i32, title: string) -> gallery_window?:
    var bytes = title.to_utf8()
    if native.title(bytes, 0, bytes.count as u64) < 0:
        return null
    var acquired = native.open(width, height)
    if acquired == null:
        return null
    return gallery_window(owner = acquired as native.window)

func close_gallery(gallery: gallery_window) -> i32:
    return native.close(gallery.owner)

func draw_gallery(gallery: gallery_window, x: i32, frame: i32, background: native.color) -> i32:
    return native.draw(gallery.owner, x, frame, background.r, background.g, background.b)

func gallery_should_close(gallery: gallery_window) -> bool:
    return native.should_close(gallery.owner)

func gallery_direction(gallery: gallery_window) -> i32:
    return native.direction(gallery.owner)
