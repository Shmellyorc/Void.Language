# Public, editable raylib 6.0 implementation. See OWNERSHIP.md for resource and callback contracts.
use "./raylib_native.void" as native
use convert as conversion
use error as core_error

## Construct a vector2 value with the exact native field layout.
## @param x Horizontal component.
## @param y Vertical component.
## @return The computed vector2 value.
func vector2(x: f32, y: f32) -> native.vector2:
    return native.vector2(x = x, y = y)

## Construct a vector3 value with the exact native field layout.
## @param x Horizontal component.
## @param y Vertical component.
## @param z Depth component.
## @return The computed vector3 value.
func vector3(x: f32, y: f32, z: f32) -> native.vector3:
    return native.vector3(x = x, y = y, z = z)

## Construct a vector4 value with the exact native field layout.
## @param x Horizontal component.
## @param y Vertical component.
## @param z Depth component.
## @param w Fourth vector component.
## @return The computed vector4 value.
func vector4(x: f32, y: f32, z: f32, w: f32) -> native.vector4:
    return native.vector4(x = x, y = y, z = z, w = w)

## Construct a matrix value with the exact native field layout.
## @param m0 Matrix element m0 in raylib column-major layout.
## @param m4 Matrix element m4 in raylib column-major layout.
## @param m8 Matrix element m8 in raylib column-major layout.
## @param m12 Matrix element m12 in raylib column-major layout.
## @param m1 Matrix element m1 in raylib column-major layout.
## @param m5 Matrix element m5 in raylib column-major layout.
## @param m9 Matrix element m9 in raylib column-major layout.
## @param m13 Matrix element m13 in raylib column-major layout.
## @param m2 Matrix element m2 in raylib column-major layout.
## @param m6 Matrix element m6 in raylib column-major layout.
## @param m10 Matrix element m10 in raylib column-major layout.
## @param m14 Matrix element m14 in raylib column-major layout.
## @param m3 Matrix element m3 in raylib column-major layout.
## @param m7 Matrix element m7 in raylib column-major layout.
## @param m11 Matrix element m11 in raylib column-major layout.
## @param m15 Matrix element m15 in raylib column-major layout.
## @return The computed matrix value.
func matrix(m0: f32, m4: f32, m8: f32, m12: f32, m1: f32, m5: f32, m9: f32, m13: f32, m2: f32, m6: f32, m10: f32, m14: f32, m3: f32, m7: f32, m11: f32, m15: f32) -> native.matrix:
    return native.matrix(m0 = m0, m4 = m4, m8 = m8, m12 = m12, m1 = m1, m5 = m5, m9 = m9, m13 = m13, m2 = m2, m6 = m6, m10 = m10, m14 = m14, m3 = m3, m7 = m7, m11 = m11, m15 = m15)

## Construct a color value with the exact native field layout.
## @param r Red channel from 0 to 255.
## @param g Green channel from 0 to 255.
## @param b Blue channel from 0 to 255.
## @param a Alpha channel from 0 to 255.
## @return The computed color value.
func color(r: u8, g: u8, b: u8, a: u8) -> native.color:
    return native.color(r = r, g = g, b = b, a = a)

## Construct a rectangle value with the exact native field layout.
## @param x Horizontal component.
## @param y Vertical component.
## @param width Width in the coordinates used by this operation.
## @param height Height in the coordinates used by this operation.
## @return The computed rectangle value.
func rectangle(x: f32, y: f32, width: f32, height: f32) -> native.rectangle:
    return native.rectangle(x = x, y = y, width = width, height = height)

## Construct a n patch info value with the exact native field layout.
## @param source Source region of the texture in pixels.
## @param left Left border or coordinate.
## @param top Top border or coordinate.
## @param right Right border or coordinate.
## @param bottom Bottom border or coordinate.
## @param layout Layout selector from the constants for this operation.
## @return The computed n patch info value.
func n_patch_info(source: native.rectangle, left: i32, top: i32, right: i32, bottom: i32, layout: i32) -> native.n_patch_info:
    return native.n_patch_info(source = source, left = left, top = top, right = right, bottom = bottom, layout = layout)

## Construct a camera3 d value with the exact native field layout.
## @param position Camera position in world coordinates.
## @param target Point in world coordinates toward which the camera looks.
## @param up Camera up vector.
## @param fovy Vertical field of view in degrees for perspective, or near-plane height in world units for orthographic projection.
## @param projection Projection mode selected from camera_perspective or camera_orthographic.
## @return The computed camera3 d value.
func camera3_d(position: native.vector3, target: native.vector3, up: native.vector3, fovy: f32, projection: i32) -> native.camera3_d:
    return native.camera3_d(position = position, target = target, up = up, fovy = fovy, projection = projection)

## Construct a camera2 d value with the exact native field layout.
## @param offset Screen-space camera offset in pixels.
## @param target Target position in 2D world coordinates.
## @param rotation Rotation for this operation, in degrees for 2D drawing.
## @param zoom Dimensionless camera zoom factor.
## @return The computed camera2 d value.
func camera2_d(offset: native.vector2, target: native.vector2, rotation: f32, zoom: f32) -> native.camera2_d:
    return native.camera2_d(offset = offset, target = target, rotation = rotation, zoom = zoom)

## Construct a transform value with the exact native field layout.
## @param translation Translation in world coordinates.
## @param rotation Rotation quaternion in native x, y, z, w component order.
## @param scale Scale used by this operation.
## @return The computed transform value.
func transform(translation: native.vector3, rotation: native.vector4, scale: native.vector3) -> native.transform:
    return native.transform(translation = translation, rotation = rotation, scale = scale)

## Construct a bone info value with the exact native field layout.
## @param name Bone name stored in the fixed native character array.
## @param parent Parent bone index, with -1 for a root bone.
## @return The computed bone info value.
func bone_info(name: [i8, 32], parent: i32) -> native.bone_info:
    return native.bone_info(name = name, parent = parent)

## Construct a ray value with the exact native field layout.
## @param position Position used by this operation.
## @param direction Direction vector.
## @return The computed ray value.
func ray(position: native.vector3, direction: native.vector3) -> native.ray:
    return native.ray(position = position, direction = direction)

## Construct a ray collision value with the exact native field layout.
## @param hit Whether a collision occurred.
## @param distance Distance from the ray origin to the collision.
## @param point Point to test or draw.
## @param normal Surface normal at the collision.
## @return The computed ray collision value.
func ray_collision(hit: bool, distance: f32, point: native.vector3, normal: native.vector3) -> native.ray_collision:
    return native.ray_collision(hit = hit, distance = distance, point = point, normal = normal)

## Construct a bounding box value with the exact native field layout.
## @param min Lower bound.
## @param max Upper bound.
## @return The computed bounding box value.
func bounding_box(min: native.vector3, max: native.vector3) -> native.bounding_box:
    return native.bounding_box(min = min, max = max)

## Construct a vr device info value with the exact native field layout.
## @param h_resolution Horizontal screen resolution in pixels.
## @param v_resolution Vertical screen resolution in pixels.
## @param h_screen_size Horizontal physical screen size in meters.
## @param v_screen_size Vertical physical screen size in meters.
## @param eye_to_screen_distance Distance from the eyes to the display in meters.
## @param lens_separation_distance Distance between the lens centers in meters.
## @param interpupillary_distance Distance between the pupils in meters.
## @param lens_distortion_values Four radial lens distortion coefficients.
## @param chroma_ab_correction Four chromatic aberration correction coefficients.
## @return The computed vr device info value.
func vr_device_info(h_resolution: i32, v_resolution: i32, h_screen_size: f32, v_screen_size: f32, eye_to_screen_distance: f32, lens_separation_distance: f32, interpupillary_distance: f32, lens_distortion_values: [f32, 4], chroma_ab_correction: [f32, 4]) -> native.vr_device_info:
    return native.vr_device_info(h_resolution = h_resolution, v_resolution = v_resolution, h_screen_size = h_screen_size, v_screen_size = v_screen_size, eye_to_screen_distance = eye_to_screen_distance, lens_separation_distance = lens_separation_distance, interpupillary_distance = interpupillary_distance, lens_distortion_values = lens_distortion_values, chroma_ab_correction = chroma_ab_correction)

## Construct a vr stereo config value with the exact native field layout.
## @param projection Projection matrix for each eye.
## @param view_offset View offset matrix for each eye.
## @param left_lens_center Left lens center coordinates.
## @param right_lens_center Right lens center coordinates.
## @param left_screen_center Left screen center coordinates.
## @param right_screen_center Right screen center coordinates.
## @param scale Scale used by this operation.
## @param scale_in Input scaling factors for stereo distortion.
## @return The computed vr stereo config value.
func vr_stereo_config(projection: [native.matrix, 2], view_offset: [native.matrix, 2], left_lens_center: [f32, 2], right_lens_center: [f32, 2], left_screen_center: [f32, 2], right_screen_center: [f32, 2], scale: [f32, 2], scale_in: [f32, 2]) -> native.vr_stereo_config:
    return native.vr_stereo_config(projection = projection, view_offset = view_offset, left_lens_center = left_lens_center, right_lens_center = right_lens_center, left_screen_center = left_screen_center, right_screen_center = right_screen_center, scale = scale, scale_in = scale_in)

## Construct a automation event value with the exact native field layout.
## @param frame Animation or automation frame.
## @param type Type selector from the constants for this operation.
## @param params Four event-specific integer parameters.
## @return The computed automation event value.
func automation_event(frame: u32, type: u32, params: [i32, 4]) -> native.automation_event:
    return native.automation_event(frame = frame, type = type, params = params)

## Check whether the window has received a close request or its configured exit key was pressed.
## @return True when the application should close its window. This query borrows the window state.
func window_should_close() -> bool:
    var value = native.window_should_close()
    _check()
    return value

## Check if window has been initialized successfully.
## @return True when the window initialized successfully.
func is_window_ready() -> bool:
    var value = native.is_window_ready()
    _check()
    return value

## Check if window is currently fullscreen.
## @return True when the window is in fullscreen mode.
func is_window_fullscreen() -> bool:
    var value = native.is_window_fullscreen()
    _check()
    return value

## Check if window is currently hidden.
## @return True when the window is hidden.
func is_window_hidden() -> bool:
    var value = native.is_window_hidden()
    _check()
    return value

## Check if window is currently minimized.
## @return True when the window is minimized.
func is_window_minimized() -> bool:
    var value = native.is_window_minimized()
    _check()
    return value

## Check if window is currently maximized.
## @return True when the window is maximized.
func is_window_maximized() -> bool:
    var value = native.is_window_maximized()
    _check()
    return value

## Check if window is currently focused.
## @return True when the window has input focus.
func is_window_focused() -> bool:
    var value = native.is_window_focused()
    _check()
    return value

## Check if window has been resized last frame.
## @return True when the window was resized during the last frame.
func is_window_resized() -> bool:
    var value = native.is_window_resized()
    _check()
    return value

## Check if one specific window flag is enabled.
## @param flag Flag or bit mask to test.
## @return True when the requested window flag is enabled.
func is_window_state(flag: u32) -> bool:
    var value = native.is_window_state(flag)
    _check()
    return value

## Set window configuration state using flags.
## @param flags Bitwise combination of flags for this operation.
func set_window_state(flags: u32):
    native.set_window_state(flags)
    _check()

## Clear window configuration state flags.
## @param flags Bitwise combination of flags for this operation.
func clear_window_state(flags: u32):
    native.clear_window_state(flags)
    _check()

## Toggle window state: fullscreen/windowed, resizes monitor to match window resolution.
func toggle_fullscreen():
    native.toggle_fullscreen()
    _check()

## Toggle window state: borderless windowed, resizes window to match monitor resolution.
func toggle_borderless_windowed():
    native.toggle_borderless_windowed()
    _check()

## Set window state: maximized, if resizable.
func maximize_window():
    native.maximize_window()
    _check()

## Set window state: minimized, if resizable.
func minimize_window():
    native.minimize_window()
    _check()

## Restore window from being minimized/maximized.
func restore_window():
    native.restore_window()
    _check()

## Set window position on screen.
## @param x Horizontal component.
## @param y Vertical component.
func set_window_position(x: i32, y: i32):
    native.set_window_position(x, y)
    _check()

## Set monitor for the current window.
## @param monitor Zero-based monitor index.
func set_window_monitor(monitor: i32):
    native.set_window_monitor(monitor)
    _check()

## Set window minimum dimensions (for FLAG_WINDOW_RESIZABLE).
## @param width Width in pixels.
## @param height Height in pixels.
func set_window_min_size(width: i32, height: i32):
    native.set_window_min_size(width, height)
    _check()

## Set window maximum dimensions (for FLAG_WINDOW_RESIZABLE).
## @param width Width in pixels.
## @param height Height in pixels.
func set_window_max_size(width: i32, height: i32):
    native.set_window_max_size(width, height)
    _check()

## Set window dimensions.
## @param width Width in pixels.
## @param height Height in pixels.
func set_window_size(width: i32, height: i32):
    native.set_window_size(width, height)
    _check()

## Set window opacity [0.0f..1.0f].
## @param opacity Window opacity from 0.0 (transparent) to 1.0 (opaque).
func set_window_opacity(opacity: f32):
    native.set_window_opacity(opacity)
    _check()

## Set window focused.
func set_window_focused():
    native.set_window_focused()
    _check()

## Get current screen width.
## @return Current screen width in pixels.
func get_screen_width() -> i32:
    var value = native.get_screen_width()
    _check()
    return value

## Get current screen height.
## @return Current screen height in pixels.
func get_screen_height() -> i32:
    var value = native.get_screen_height()
    _check()
    return value

## Get current render width (it considers HiDPI).
## @return Current render width in pixels, including the native HiDPI scaling.
func get_render_width() -> i32:
    var value = native.get_render_width()
    _check()
    return value

## Get current render height (it considers HiDPI).
## @return Current render height in pixels, including the native HiDPI scaling.
func get_render_height() -> i32:
    var value = native.get_render_height()
    _check()
    return value

## Get the number of connected monitors.
## @return Number of connected monitors.
func get_monitor_count() -> i32:
    var value = native.get_monitor_count()
    _check()
    return value

## Get current monitor where window is placed.
## @return Index of the monitor on which the window is placed.
func get_current_monitor() -> i32:
    var value = native.get_current_monitor()
    _check()
    return value

## Get specified monitor position.
## @param monitor Zero-based monitor index.
## @return The computed vector2 value.
func get_monitor_position(monitor: i32) -> native.vector2:
    var value = native.get_monitor_position(monitor)
    _check()
    return value

## Get specified monitor width (current video mode used by monitor).
## @param monitor Zero-based monitor index.
## @return Width in pixels of the selected monitor video mode.
func get_monitor_width(monitor: i32) -> i32:
    var value = native.get_monitor_width(monitor)
    _check()
    return value

## Get specified monitor height (current video mode used by monitor).
## @param monitor Zero-based monitor index.
## @return Height in pixels of the selected monitor video mode.
func get_monitor_height(monitor: i32) -> i32:
    var value = native.get_monitor_height(monitor)
    _check()
    return value

## Get specified monitor physical width in millimetres.
## @param monitor Zero-based monitor index.
## @return The specified monitor physical width in millimetres.
func get_monitor_physical_width(monitor: i32) -> i32:
    var value = native.get_monitor_physical_width(monitor)
    _check()
    return value

## Get specified monitor physical height in millimetres.
## @param monitor Zero-based monitor index.
## @return The specified monitor physical height in millimetres.
func get_monitor_physical_height(monitor: i32) -> i32:
    var value = native.get_monitor_physical_height(monitor)
    _check()
    return value

## Get specified monitor refresh rate.
## @param monitor Zero-based monitor index.
## @return Refresh rate of the selected monitor in hertz.
func get_monitor_refresh_rate(monitor: i32) -> i32:
    var value = native.get_monitor_refresh_rate(monitor)
    _check()
    return value

## Get window position XY on monitor.
## @return The computed vector2 value.
func get_window_position() -> native.vector2:
    var value = native.get_window_position()
    _check()
    return value

## Get window scale DPI factor.
## @return The computed vector2 value.
func get_window_scale_dpi() -> native.vector2:
    var value = native.get_window_scale_dpi()
    _check()
    return value

## Enable waiting for events on end_drawing(), no automatic event polling.
func enable_event_waiting():
    native.enable_event_waiting()
    _check()

## Disable waiting for events on end_drawing(), automatic events polling.
func disable_event_waiting():
    native.disable_event_waiting()
    _check()

## Shows cursor.
func show_cursor():
    native.show_cursor()
    _check()

## Hides cursor.
func hide_cursor():
    native.hide_cursor()
    _check()

## Check if cursor is not visible.
## @return True when the mouse cursor is hidden.
func is_cursor_hidden() -> bool:
    var value = native.is_cursor_hidden()
    _check()
    return value

## Enables cursor (unlock cursor).
func enable_cursor():
    native.enable_cursor()
    _check()

## Disables cursor (lock cursor).
func disable_cursor():
    native.disable_cursor()
    _check()

## Check if cursor is on the screen.
## @return True when the mouse cursor is inside the screen area.
func is_cursor_on_screen() -> bool:
    var value = native.is_cursor_on_screen()
    _check()
    return value

## Set background color (framebuffer clear color).
## @param color_value Color including its alpha channel.
func clear_background(color_value: native.color):
    native.clear_background(color_value)
    _check()

## Setup canvas (framebuffer) to start drawing.
func begin_drawing():
    native.begin_drawing()
    _check()

## End canvas drawing and swap buffers (double buffering).
func end_drawing():
    native.end_drawing()
    _check()

## Begin 2D mode with custom camera (2D).
## @param camera Camera value used by this operation.
func begin_mode2_d(camera: native.camera2_d):
    native.begin_mode2_d(camera)
    _check()

## Ends 2D mode with custom camera.
func end_mode2_d():
    native.end_mode2_d()
    _check()

## Begin 3D mode with custom camera (3D).
## @param camera Camera value used by this operation.
func begin_mode3_d(camera: native.camera3_d):
    native.begin_mode3_d(camera)
    _check()

## Ends 3D mode and returns to default 2D orthographic mode.
func end_mode3_d():
    native.end_mode3_d()
    _check()

## Ends drawing to render texture.
func end_texture_mode():
    native.end_texture_mode()
    _check()

## End custom shader drawing (use default shader).
func end_shader_mode():
    native.end_shader_mode()
    _check()

## Begin blending mode (alpha, additive, multiplied, subtract, custom).
## @param mode Mode selector from the constants for this operation.
func begin_blend_mode(mode: i32):
    native.begin_blend_mode(mode)
    _check()

## End blending mode (reset to default: alpha blending).
func end_blend_mode():
    native.end_blend_mode()
    _check()

## Begin scissor mode (define screen area for following drawing).
## @param x Horizontal component.
## @param y Vertical component.
## @param width Width in pixels.
## @param height Height in pixels.
func begin_scissor_mode(x: i32, y: i32, width: i32, height: i32):
    native.begin_scissor_mode(x, y, width, height)
    _check()

## End scissor mode.
func end_scissor_mode():
    native.end_scissor_mode()
    _check()

## Begin stereo rendering (requires VR simulator).
## @param config Stereo rendering configuration.
func begin_vr_stereo_mode(config: native.vr_stereo_config):
    native.begin_vr_stereo_mode(config)
    _check()

## End stereo rendering (requires VR simulator).
func end_vr_stereo_mode():
    native.end_vr_stereo_mode()
    _check()

## Load VR stereo config for VR simulator device parameters.
## @param device VR device description.
## @return The computed vr stereo config value.
func load_vr_stereo_config(device: native.vr_device_info) -> native.vr_stereo_config:
    var value = native.load_vr_stereo_config(device)
    _check()
    return value

## Unload VR stereo config.
## @param config Stereo rendering configuration.
func unload_vr_stereo_config(config: native.vr_stereo_config):
    native.unload_vr_stereo_config(config)
    _check()

## Get a ray trace from screen position (i.e mouse).
## @param position Screen-space position in pixels.
## @param camera Camera value used by this operation.
## @return The computed ray value.
func get_screen_to_world_ray(position: native.vector2, camera: native.camera3_d) -> native.ray:
    var value = native.get_screen_to_world_ray(position, camera)
    _check()
    return value

## Get a ray trace from screen position (i.e mouse) in a viewport.
## @param position Screen-space position in pixels.
## @param camera Camera value used by this operation.
## @param width Width in pixels.
## @param height Height in pixels.
## @return The computed ray value.
func get_screen_to_world_ray_ex(position: native.vector2, camera: native.camera3_d, width: i32, height: i32) -> native.ray:
    var value = native.get_screen_to_world_ray_ex(position, camera, width, height)
    _check()
    return value

## Get the screen space position for a 3d world space position.
## @param position Position in world coordinates to project onto the screen.
## @param camera Camera value used by this operation.
## @return The computed vector2 value.
func get_world_to_screen(position: native.vector3, camera: native.camera3_d) -> native.vector2:
    var value = native.get_world_to_screen(position, camera)
    _check()
    return value

## Get size position for a 3d world space position.
## @param position Position in world coordinates to project onto the screen.
## @param camera Camera value used by this operation.
## @param width Width in pixels.
## @param height Height in pixels.
## @return The computed vector2 value.
func get_world_to_screen_ex(position: native.vector3, camera: native.camera3_d, width: i32, height: i32) -> native.vector2:
    var value = native.get_world_to_screen_ex(position, camera, width, height)
    _check()
    return value

## Get the screen space position for a 2d camera world space position.
## @param position Position in world coordinates to project onto the screen.
## @param camera Camera value used by this operation.
## @return The computed vector2 value.
func get_world_to_screen2_d(position: native.vector2, camera: native.camera2_d) -> native.vector2:
    var value = native.get_world_to_screen2_d(position, camera)
    _check()
    return value

## Get the world space position for a 2d camera screen space position.
## @param position Screen-space position in pixels.
## @param camera Camera value used by this operation.
## @return The computed vector2 value.
func get_screen_to_world2_d(position: native.vector2, camera: native.camera2_d) -> native.vector2:
    var value = native.get_screen_to_world2_d(position, camera)
    _check()
    return value

## Get camera transform matrix (view matrix).
## @param camera Camera value used by this operation.
## @return The computed matrix value.
func get_camera_matrix(camera: native.camera3_d) -> native.matrix:
    var value = native.get_camera_matrix(camera)
    _check()
    return value

## Get camera 2d transform matrix.
## @param camera Camera value used by this operation.
## @return The computed matrix value.
func get_camera_matrix2_d(camera: native.camera2_d) -> native.matrix:
    var value = native.get_camera_matrix2_d(camera)
    _check()
    return value

## Set target FPS (maximum).
## @param fps Target frames per second.
func set_target_fps(fps: i32):
    native.set_target_fps(fps)
    _check()

## Get time in seconds for last frame drawn (delta time).
## @return The time in seconds for last frame drawn.
func get_frame_time() -> f32:
    var value = native.get_frame_time()
    _check()
    return value

## Get elapsed time in seconds since init_window().
## @return Elapsed time in seconds since init_window.
func get_time() -> f64:
    var value = native.get_time()
    _check()
    return value

## Get current FPS.
## @return Current frames per second.
func get_fps() -> i32:
    var value = native.get_fps()
    _check()
    return value

## Swap back buffer with front buffer (screen drawing).
func swap_screen_buffer():
    native.swap_screen_buffer()
    _check()

## Register all input events.
func poll_input_events():
    native.poll_input_events()
    _check()

## Wait for some time (halt program execution).
## @param seconds Time interval in seconds.
func wait_time(seconds: f64):
    native.wait_time(seconds)
    _check()

## Set the seed for the random number generator.
