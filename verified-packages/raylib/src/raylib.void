## Native lifetime, thread, input-extent and required device/context checks retain their checked failures.
## @return Ok with one music owner to release using unload_music_stream; Err(load_error) if no owner is acquired or resource validation fails. Rejected temporary owners are released.
func try_load_music_stream(file_name: string) -> result<music, load_error>:
    return _try_music(load_music_stream(file_name), "load_music_stream")

## Try to load streaming music from a private copy of the encoded audio bytes.
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param file_type Audio format extension, including the leading dot, such as ".wav".
## @param data Input data, borrowed for this call.
## @param data_size Number of input bytes to read, within the supplied buffer.
## Native lifetime, thread, input-extent and required device/context checks retain their checked failures.
## @return Ok with one music owner to release using unload_music_stream; Err(load_error) if no owner is acquired or resource validation fails. Rejected temporary owners are released. The successful stream retains its own native copy of the input bytes.
func try_load_music_stream_from_memory(file_type: string, data: byte_buffer, data_size: i32) -> result<music, load_error>:
    return _try_music(load_music_stream_from_memory(file_type, data, data_size), "load_music_stream_from_memory")

## Try to load audio stream (to stream raw audio pcm data).
## @param sample_rate Samples per second.
## @param sample_size Bits per audio sample.
## @param channels Audio channel count.
## Native lifetime, thread, input-extent and required device/context checks retain their checked failures.
## @return Ok with one audio_stream owner to release using unload_audio_stream; Err(load_error) if no owner is acquired or resource validation fails. Rejected temporary owners are released.
func try_load_audio_stream(sample_rate: u32, sample_size: u32, channels: u32) -> result<audio_stream, load_error>:
    return _try_audio_stream(load_audio_stream(sample_rate, sample_size, channels), "load_audio_stream")

## Try to load model from files (meshes and materials).
