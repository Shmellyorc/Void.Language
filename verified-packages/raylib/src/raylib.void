## @param saturation Color saturation from 0.0 to 1.0.
## @param value Color brightness from 0.0 to 1.0.
## @return The computed color value.
func color_from_hsv(hue: f32, saturation: f32, value: f32) -> native.color:
    var value_local = native.color_from_hsv(hue, saturation, value)
    _check()
    return value_local

## Get color multiplied with another color.
