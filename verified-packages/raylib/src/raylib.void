# Public, editable raylib 6.0 implementation. See inventory.json and OWNERSHIP.md.
use "./raylib_native.void" as native
use convert as conversion
use error as core_error

func vector2(x: f32, y: f32) -> native.vector2:
    return native.vector2(x = x, y = y)

func vector3(x: f32, y: f32, z: f32) -> native.vector3:
    return native.vector3(x = x, y = y, z = z)

func vector4(x: f32, y: f32, z: f32, w: f32) -> native.vector4:
    return native.vector4(x = x, y = y, z = z, w = w)

func matrix(m0: f32, m4: f32, m8: f32, m12: f32, m1: f32, m5: f32, m9: f32, m13: f32, m2: f32, m6: f32, m10: f32, m14: f32, m3: f32, m7: f32, m11: f32, m15: f32) -> native.matrix:
    return native.matrix(m0 = m0, m4 = m4, m8 = m8, m12 = m12, m1 = m1, m5 = m5, m9 = m9, m13 = m13, m2 = m2, m6 = m6, m10 = m10, m14 = m14, m3 = m3, m7 = m7, m11 = m11, m15 = m15)

func color(r: u8, g: u8, b: u8, a: u8) -> native.color:
    return native.color(r = r, g = g, b = b, a = a)

func rectangle(x: f32, y: f32, width: f32, height: f32) -> native.rectangle:
    return native.rectangle(x = x, y = y, width = width, height = height)

func n_patch_info(source: native.rectangle, left: i32, top: i32, right: i32, bottom: i32, layout: i32) -> native.n_patch_info:
    return native.n_patch_info(source = source, left = left, top = top, right = right, bottom = bottom, layout = layout)

func camera3_d(position: native.vector3, target: native.vector3, up: native.vector3, fovy: f32, projection: i32) -> native.camera3_d:
    return native.camera3_d(position = position, target = target, up = up, fovy = fovy, projection = projection)

func camera2_d(offset: native.vector2, target: native.vector2, rotation: f32, zoom: f32) -> native.camera2_d:
    return native.camera2_d(offset = offset, target = target, rotation = rotation, zoom = zoom)

func transform(translation: native.vector3, rotation: native.vector4, scale: native.vector3) -> native.transform:
    return native.transform(translation = translation, rotation = rotation, scale = scale)

func bone_info(name: [i8, 32], parent: i32) -> native.bone_info:
    return native.bone_info(name = name, parent = parent)

func ray(position: native.vector3, direction: native.vector3) -> native.ray:
    return native.ray(position = position, direction = direction)

func ray_collision(hit: bool, distance: f32, point: native.vector3, normal: native.vector3) -> native.ray_collision:
    return native.ray_collision(hit = hit, distance = distance, point = point, normal = normal)

func bounding_box(min: native.vector3, max: native.vector3) -> native.bounding_box:
    return native.bounding_box(min = min, max = max)

func vr_device_info(h_resolution: i32, v_resolution: i32, h_screen_size: f32, v_screen_size: f32, eye_to_screen_distance: f32, lens_separation_distance: f32, interpupillary_distance: f32, lens_distortion_values: [f32, 4], chroma_ab_correction: [f32, 4]) -> native.vr_device_info:
    return native.vr_device_info(h_resolution = h_resolution, v_resolution = v_resolution, h_screen_size = h_screen_size, v_screen_size = v_screen_size, eye_to_screen_distance = eye_to_screen_distance, lens_separation_distance = lens_separation_distance, interpupillary_distance = interpupillary_distance, lens_distortion_values = lens_distortion_values, chroma_ab_correction = chroma_ab_correction)

func vr_stereo_config(projection: [native.matrix, 2], view_offset: [native.matrix, 2], left_lens_center: [f32, 2], right_lens_center: [f32, 2], left_screen_center: [f32, 2], right_screen_center: [f32, 2], scale: [f32, 2], scale_in: [f32, 2]) -> native.vr_stereo_config:
    return native.vr_stereo_config(projection = projection, view_offset = view_offset, left_lens_center = left_lens_center, right_lens_center = right_lens_center, left_screen_center = left_screen_center, right_screen_center = right_screen_center, scale = scale, scale_in = scale_in)

func automation_event(frame: u32, type: u32, params: [i32, 4]) -> native.automation_event:
    return native.automation_event(frame = frame, type = type, params = params)

