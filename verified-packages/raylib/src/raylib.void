func try_load_image_anim(file_name: string) -> result<image, load_error>:
    return _try_image(load_image_anim(file_name), "load_image_anim")

## Try to load all frames from encoded animation bytes and retain the frame count.
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
## @param file_type Animated image format extension, including the leading dot, such as ".gif".
## @param file_data Encoded file bytes in a live buffer.
## @param data_size Number of input bytes to read, within the supplied buffer.
## Native lifetime, thread, input-extent and required device/context checks retain their checked failures.
## @return Ok with one image owner to release using unload_image; Err(load_error) if no owner is acquired or resource validation fails. Rejected temporary owners are released.
func try_load_image_anim_from_memory(file_type: string, file_data: byte_buffer, data_size: i32) -> result<image, load_error>:
    return _try_image(load_image_anim_from_memory(file_type, file_data, data_size), "load_image_anim_from_memory")

## Try to load image from memory buffer, fileType refers to extension: i.e. '.png'.
## Text passed to native code is copied as UTF-8 and rejects embedded NUL.
