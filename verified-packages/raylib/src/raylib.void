## Check if a key has been pressed once.
## @param key Keyboard key code from the key constants.
## @return True when the key was pressed once during this frame.
func is_key_pressed(key: i32) -> bool:
    var value = native.is_key_pressed(key)
    _check()
    return value

## Check if a key has been pressed again.
## @param key Keyboard key code from the key constants.
## @return True when a repeated key-press event is reported.
func is_key_pressed_repeat(key: i32) -> bool:
    var value = native.is_key_pressed_repeat(key)
    _check()
    return value

## Check if a key is being pressed.
## @param key Keyboard key code from the key constants.
## @return True when the key is currently held down.
func is_key_down(key: i32) -> bool:
    var value = native.is_key_down(key)
    _check()
    return value

## Check if a key has been released once.
## @param key Keyboard key code from the key constants.
## @return True when the key was released during this frame.
func is_key_released(key: i32) -> bool:
    var value = native.is_key_released(key)
    _check()
    return value

## Check if a key is NOT being pressed.
## @param key Keyboard key code from the key constants.
## @return True when the key is currently up.
func is_key_up(key: i32) -> bool:
    var value = native.is_key_up(key)
    _check()
    return value

## Read the next queued key code.
## @return Next queued key code, or 0 when the queue is empty. Call repeatedly to drain queued key presses.
func get_key_pressed() -> i32:
    var value = native.get_key_pressed()
    _check()
    return value

## Read the next queued Unicode codepoint.
