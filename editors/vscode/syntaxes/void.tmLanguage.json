{
  "name": "VOID", "scopeName": "source.void",
  "patterns": [
    {"name":"comment.line.number-sign.void", "match":"#.*$"},
    {"begin":"\\b(use)\\s+(\")", "beginCaptures":{"1":{"name":"keyword.control.import.void"},"2":{"name":"punctuation.definition.string.begin.void"}}, "end":"\"|$", "name":"string.quoted.double.import.void"},
    {"name":"storage.type.void", "match":"\\b(?:i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool)\\b"},
    {"name":"keyword.control.void", "match":"\\b(?:func|var|const|return|if|else|for|break|continue|as|public|private|internal)\\b"},
    {"name":"keyword.operator.logical.void", "match":"\\b(?:and|or|not)\\b"},
    {"name":"constant.language.void", "match":"\\b(?:true|false)\\b"},
    {"name":"constant.numeric.void", "match":"\\b[0-9]+(?:\\.[0-9]+)?[fd]?\\b"},
    {"name":"keyword.operator.void", "match":"->|==|!=|<=|>=|\\+=|-=|\\*=|/=|%=|\\+\\+|--|[+*/%=<>-]"}
  ]
}
