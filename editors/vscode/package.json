{
  "name": "void-language",
  "displayName": "VOID Language",
  "description": "VOID compiler language assistance, navigation, guarded rename, formatting and diagnostics.",
  "version": "0.1.0",
  "publisher": "void-language",
  "license": "MIT",
  "engines": {
    "vscode": "^1.141.0",
    "node": ">=24.19.0 <25"
  },
  "categories": [
    "Programming Languages"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:void",
    "onLanguage:toml",
    "workspaceContains:void.project.toml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax highlighting works; native server execution requires workspace trust."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "voidls requires a local filesystem project on the extension host."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "void",
        "aliases": [
          "VOID",
          "void"
        ],
        "extensions": [
          ".void"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "void-string"
      }
    ],
    "grammars": [
      {
        "language": "void",
        "scopeName": "source.void",
        "path": "./syntaxes/void.tmLanguage.json",
        "embeddedLanguages": {
          "string.quoted.triple.void": "void-string",
          "meta.interpolation.void": "void"
        }
      }
    ],
    "commands": [
      {
        "command": "void.restartLanguageServer",
        "title": "VOID: Restart Language Server"
      },
      {
        "command": "void.selectEntry",
        "title": "VOID: Select Project Entry"
      },
      {
        "command": "void.refreshProject",
        "title": "VOID: Refresh Project"
      },
      {
        "command": "void.checkProject",
        "title": "VOID: Check Project",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "void.buildProject",
        "title": "VOID: Build Project",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "void.runProject",
        "title": "VOID: Run Project",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "void.createProject",
        "title": "VOID: Create Project"
      },
      {
        "command": "void.resetCreationPrompt",
        "title": "VOID: Reset Project Creation Prompt"
      }
    ],
    "problemMatchers": [
      {
        "name": "void-compiler",
        "owner": "void-compiler",
        "source": "VOID compiler",
        "fileLocation": "absolute",
        "pattern": [
          {
            "regexp": "^(.+):(\\d+):(\\d+): (error|warning|info): (.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          },
          {
            "regexp": "^    code: (VOID\\d+)$",
            "code": 1
          }
        ]
      }
    ],
    "configuration": {
      "title": "VOID",
      "properties": {
        "void.compiler.path": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Literal path to the matching voidc executable. Empty uses voidc next to the selected voidls."
        },
        "void.tasks.profile": {
          "type": "string",
          "enum": ["debug", "release"],
          "default": "debug",
          "scope": "window",
          "description": "Compiler profile used by VOID project commands."
        },
        "void.tasks.runArguments": {
          "type": "array",
          "items": {"type": "string"},
          "default": [],
          "scope": "window",
          "description": "Literal arguments passed to the application by VOID: Run Project."
        },
        "void.editor.useTabs": {
          "type": "boolean",
          "default": true,
          "scope": "language-overridable",
          "description": "Indent VOID code with tabs. Disable to insert four spaces. Changing this setting does not convert existing text."
        },
        "void.server.path": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Native voidls executable, absolute or workspace-relative. Empty checks a bundled native server, then PATH. No shell expansion or downloads."
        },
        "void.project.entry": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Literal entry source, absolute or workspace-relative. With project.root: an in-root manifest entry override. Alone: legacy entry-parent mode. Empty uses compiler-owned project preflight with legacy main.void/standalone fallback only when no manifest is selected."
        },
        "void.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Optional LSP trace in the VOID output channel. Verbose logs can include source text."
        },
        "void.project.root": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Literal manifest root, absolute or workspace-relative. Pins project mode even for malformed TOML or no main. With project.entry, that entry must stay inside this root. Empty uses compiler-owned nearest-manifest discovery unless a legacy entry is configured."
        }
      }
    },
    "configurationDefaults": {
      "[void]": {
        "editor.insertSpaces": false,
        "editor.tabSize": 4,
        "editor.detectIndentation": false
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "compile": "tsc && node build.cjs",
    "build": "npm run typecheck && npm run compile",
    "test": "npm run build && node --test out/test/config.test.js",
    "test:host": "node out/test/runHost.js",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license --out dist/void-language-0.1.0.vsix",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
