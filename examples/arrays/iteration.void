value struct item:
    fixed: [i32, 2] = [1, 2]
func entry(value: i32) -> i32:
    var a: [i32, 3] = [1, 2, 3]
    var sum = 0
    for n, index in a:
        if index == 0:
            a[1] = 20
        sum += n
        n = 1000
        index = 1000
    if sum != 24 or a[0] != 1:
        return -100
    var order = 0
    for element, original in reverse a:
        order = order * 10 + original as i32
    if order != 210:
        return -200
    var lists: [[i32]] = [[1], [2]]
    for list in lists:
        list.push(3)
    if lists[0].count != 2 or lists[1][1] != 3:
        return -300
    var items: [item, 2]
    for copy in items:
        copy.fixed[0] = 90
    if items[0].fixed[0] != 1:
        return -400
    var managed = ["a", "b", "c"]
    var seen = 0
    for text, i in managed:
        if i == 0:
            managed[1] = "changed"
            continue
        if i == 1 and text != "changed":
            return -500
        seen++
    var empty: [string]
    for never in reverse empty:
        return -600
    var nested = 0
    for outer in 0..<3:
        for inner in reverse 0..2:
            if inner == 1:
                continue
            if outer == 2:
                break
            nested++
    return value + sum + seen + nested
