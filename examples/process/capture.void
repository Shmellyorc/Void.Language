use convert
use os
use process

func main() -> i32:
    var arguments = convert.unwrap(os.args())
    if arguments.count != 2:
        print("Usage: capture <absolute executable> <absolute working directory>")
        return 2
    var limits = process.capture_options(stdout_limit = 4096, stderr_limit = 4096, total_limit = 8192, timeout_ms = 5000)
    var result = process.capture(arguments[0], [], [], arguments[1], limits)
    if result is Err(var problem):
        print(problem.message)
        return 1
    var captured = convert.unwrap(result)
    print("Captured bytes", captured.stdout.count, captured.stderr.count)
    if string.from_utf8(captured.stdout) is Ok(var text):
        if text != "":
            print(text)
    if captured.exited:
        print("Exit code", captured.status.code, "signal", captured.status.signal)
    if captured.outcome != process.capture_end.complete:
        print("Incomplete capture", captured.os_code, captured.cleanup_code)
        return 1
    return 0
