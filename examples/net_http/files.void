use net/http
use io
use os

func transfer_files(base: string) -> i32:
    var client_result = http.open_client()
    if client_result is Ok(var owner):
        with owner:
            var file_result = io.open("http-example-payload.bin", io.open_mode.create)
            if file_result is Ok(var payload_file):
                with payload_file:
                    # Native bulk download writes at the current cursor and never closes the file.
                    if owner.download(http.request(target = base + "/large?1048576"), payload_file) is Err(var failure):
                        print("HTTP download {failure.kind}; partial bytes {failure.downloaded}")
                        if not (failure.io_cause is null):
                            var cause = failure.io_cause as io.error
                            print("IO {cause.kind}; native code {cause.os_code}")
                        return 1
                    if payload_file.seek(0) is Err(var failure):
                        print("IO seek {failure.kind}")
                        return 1
                    if owner.upload(http.request(method = "POST", target = base + "/echo"), payload_file) is Err(var failure):
                        print("HTTP upload {failure.kind}; uploaded {failure.uploaded}")
                        return 1
                    if payload_file.seek(0) is Err(var failure):
                        print("IO seek {failure.kind}")
                        return 1
                    var file_part = http.part(name = "payload_file", filename = "payload.bin",
                        content_type = "application/octet-stream", data = http.part_data.file(payload_file, -1))
                    var response_result = owner.send(http.request(method = "POST", target = base + "/multipart",
                        body = http.body.multipart([file_part])))
                    if response_result is Ok(var reply):
                        if reply.require_success() is Ok(var passed):
                            print("Native download, upload and multipart complete")
                            return 0
                    else if response_result is Err(var failure):
                        print("HTTP multipart {failure.kind}")
            else if file_result is Err(var failure):
                print("IO open {failure.kind}; native code {failure.os_code}")
    else if client_result is Err(var failure):
        print("HTTP configuration {failure.kind}")
    return 1

if os.env("VOID_HTTP_URL") is Ok(var base):
    return transfer_files(base)
print("Set VOID_HTTP_URL to a base exposing /large, /echo and /multipart; see the example README")
return 1
