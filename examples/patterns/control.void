enum step:
    done
    next(value: i32)
func entry(value: i32) -> i32:
    var current = step.next(value)
    var total = 0
    for current is step.next(var n) and n > 0:
        current = step.next(n - 1)
        if n == 2:
            continue
        total += n
        if total > 100:
            break
    match current:
        step.done:
            total = -1
        step.next(0):
            total += 1
    return total
