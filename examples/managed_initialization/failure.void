struct counter:
    value: i32

struct parent:
    owner: counter
    quotient: i32

func (p parent) init(c: counter, value: i32):
    p.owner = c
    c.value++
    var i = 0
    for i < 300:
        var garbage = counter()
        i++
    p.quotient = 100 / value

func entry(value: i32) -> i32:
    var c = counter(value = 7)
    var p = parent(c, value)
    return p.quotient + c.value
