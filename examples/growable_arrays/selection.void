struct box:
    data: [i32]

func change(object: box) -> i32:
    object.data = [100, 200]
    return 7

func edit(values: [i32]) -> i32:
    values[1] = 30
    return 5

func entry(value: i32) -> i32:
    var object = box()
    object.data = [1, 2]
    var original = object.data
    object.data[0] = change(object)
    original[0] += edit(original)
    if original[1] != 30 or object.data[0] != 100:
        return -100
    return original[0] + value
