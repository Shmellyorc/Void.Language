func eligible(value: i32, positive: bool) -> bool:
    return positive and value >= 0

func factorial(value: i32) -> i32:
    if value <= 1:
        return 1
    return value * factorial(value - 1)

func no_op():
    return

func entry(value: i32) -> i32:
    no_op()
    if eligible(value, true) and value <= 10:
        return factorial(value)
    else if value < 0:
        return 9
    else:
        return 0
