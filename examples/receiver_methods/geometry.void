value struct point:
    x: i32 = 2
    y: i32 = 3

func (p point) move(dx: i32, dy: i32):
    p.x += dx
    p.y += dy

func (p point) distance_squared() -> i32:
    return p.x * p.x + p.y * p.y

func (p point) shifted(amount: i32) -> point:
    var copy = p
    copy.move(amount, 0)
    return copy

func (p point) walk(amount: i32):
    var left = amount
    for left > 0:
        p.move(1, 0)
        left--

private func (p point) hidden() -> i32:
    return p.x

value struct box:
    position: point
    enabled: bool

func (b box) translate(amount: i32):
    b.position.move(amount, 1)

func (b box) squared() -> i32:
    return b.position.distance_squared()
