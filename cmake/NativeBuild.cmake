# Same-build, host-only native link resources; never search the caller's cwd.
find_program(VOID_CLANG NAMES clang clang-23 NAMES_PER_DIR HINTS "${LLVM_TOOLS_BINARY_DIR}" REQUIRED)
execute_process(COMMAND "${VOID_CLANG}" --version OUTPUT_VARIABLE native_version RESULT_VARIABLE native_status)
if(NOT native_status EQUAL 0 OR NOT native_version MATCHES "clang version 23\\.1\\.4([^0-9]|$)")
  message(FATAL_ERROR "Native builds require Clang 23.1.4; set VOID_CLANG")
endif()
set(native_flags "-pthread\n")
if(WIN32)
  string(APPEND native_flags "-fms-runtime-lib=dll\n-llegacy_stdio_definitions\n-lbcrypt\n-lshell32\n-lole32\n-luuid\n")
elseif(APPLE)
  string(APPEND native_flags "-framework\nFoundation\n-lobjc\n")
  # Xcode may retain an SDK name where other generators resolve a physical
  # directory. Clang's stage working directory must never reinterpret that name.
  set(native_sysroot "${CMAKE_OSX_SYSROOT}")
  if(NOT native_sysroot OR NOT IS_ABSOLUTE "${native_sysroot}")
    set(native_sdk_selection)
    if(native_sysroot)
      list(APPEND native_sdk_selection --sdk "${native_sysroot}")
    endif()
    execute_process(COMMAND xcrun ${native_sdk_selection} --show-sdk-path
      OUTPUT_VARIABLE native_sysroot OUTPUT_STRIP_TRAILING_WHITESPACE
      RESULT_VARIABLE native_sdk_status)
    if(NOT native_sdk_status EQUAL 0)
      message(FATAL_ERROR "Cannot resolve the configured native macOS SDK")
    endif()
  endif()
  if(native_sysroot)
    if(NOT IS_DIRECTORY "${native_sysroot}")
      message(FATAL_ERROR "Native macOS SDK directory is unavailable: ${native_sysroot}")
    endif()
    string(APPEND native_flags "-isysroot\n${native_sysroot}\n")
  endif()
  foreach(arch IN LISTS CMAKE_OSX_ARCHITECTURES)
    string(APPEND native_flags "-arch\n${arch}\n")
  endforeach()
  if(CMAKE_OSX_DEPLOYMENT_TARGET)
    string(APPEND native_flags "-mmacosx-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}\n")
  endif()
endif()
if(VOID_SANITIZERS AND NOT MSVC)
  string(APPEND native_flags "-fsanitize=address,undefined\n")
endif()
set(native_header "VOID native 23.1.4 v1\n${VOID_CLANG}\n${VOID_LINKER}\n")
file(GENERATE OUTPUT "$<TARGET_FILE_DIR:voidc>/void-native.txt"
  CONTENT "${native_header}$<TARGET_FILE:void_runtime>\n$<TARGET_FILE:void_native_fixture>\n${native_flags}")
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/native-install-$<CONFIG>.txt"
  CONTENT "${native_header}../lib/void/$<TARGET_FILE_NAME:void_runtime>\n../lib/void/$<TARGET_FILE_NAME:void_native_fixture>\n${native_flags}")
install(TARGETS voidc RUNTIME DESTINATION bin COMPONENT compiler)
install(TARGETS void_runtime void_native_fixture ARCHIVE DESTINATION lib/void COMPONENT compiler)
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/native-install-$<CONFIG>.txt" DESTINATION bin RENAME void-native.txt COMPONENT compiler)
