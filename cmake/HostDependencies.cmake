# Exact-source, profile-specific static providers on every supported host.
# Missing receipts fail configuration; never substitute ambient providers.
find_package(Python3 3.12 REQUIRED COMPONENTS Interpreter)
if(VOID_SANITIZERS)
  set(host_profile strict)
elseif(CMAKE_BUILD_TYPE STREQUAL "Debug")
  set(host_profile Debug)
else()
  set(host_profile Release)
endif()
string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" host_arch)
if(host_arch STREQUAL "amd64")
  set(host_arch x86_64)
elseif(host_arch STREQUAL "aarch64")
  set(host_arch arm64)
endif()
if(APPLE AND CMAKE_OSX_ARCHITECTURES)
  set(host_arch "${CMAKE_OSX_ARCHITECTURES}")
endif()
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  set(host_bundle "") # Retain the accepted Linux prefix layout.
elseif(WIN32 AND host_arch STREQUAL "x86_64")
  set(host_bundle windows-x86_64/)
elseif(APPLE AND host_arch STREQUAL "arm64")
  set(host_bundle macos-arm64/)
else()
  message(FATAL_ERROR "Host providers require Linux x64, Windows x64 or macOS ARM64")
endif()
set(VOID_HOST_DEPS_ROOT "${PROJECT_SOURCE_DIR}/.toolchains/host/prefix/${host_bundle}${host_profile}" CACHE PATH "Pinned host primitive dependency prefix")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/verify_host_deps.py"
  --prefix "${VOID_HOST_DEPS_ROOT}" --profile "${host_profile}" --platform "${CMAKE_SYSTEM_NAME}" --architecture "${host_arch}"
  RESULT_VARIABLE host_status OUTPUT_VARIABLE host_output ERROR_VARIABLE host_error)
if(NOT host_status EQUAL 0)
  message(FATAL_ERROR "Pinned host providers invalid: ${host_output}${host_error}\nRun python3 tools/setup_host_deps.py --profile ${host_profile} on the native host")
endif()
message(STATUS "${host_output}")
file(READ "${VOID_HOST_DEPS_ROOT}/VOID-HOST-DEPENDENCIES.json" receipt)
string(JSON zlib_hash GET "${receipt}" zlib_sha256)
file(SHA256 "${VOID_HTTP_ZLIB}" actual)
if(NOT actual STREQUAL zlib_hash)
  message(FATAL_ERROR "Host providers must use this build's existing pinned zlib")
endif()
if(WIN32)
  set(VOID_HOST_LINK_FILES "${VOID_HOST_DEPS_ROOT}/lib/archive.lib" "${VOID_HOST_DEPS_ROOT}/lib/libsodium.lib")
  target_compile_definitions(void_runtime PRIVATE SODIUM_STATIC LIBARCHIVE_STATIC _WIN32_WINNT=0x0A00)
  target_link_libraries(void_runtime PUBLIC advapi32 bcrypt)
else()
  set(VOID_HOST_LINK_FILES "${VOID_HOST_DEPS_ROOT}/lib/libarchive.a" "${VOID_HOST_DEPS_ROOT}/lib/libsodium.a")
endif()
if(APPLE)
  string(JSON host_minimum GET "${receipt}" deployment_target)
  if(CMAKE_OSX_DEPLOYMENT_TARGET AND CMAKE_OSX_DEPLOYMENT_TARGET VERSION_LESS host_minimum)
    message(FATAL_ERROR "Host prefix deployment target exceeds the application minimum")
  endif()
endif()
target_include_directories(void_runtime PRIVATE "${VOID_HOST_DEPS_ROOT}/include")
target_link_libraries(void_runtime PUBLIC ${VOID_HOST_LINK_FILES})
