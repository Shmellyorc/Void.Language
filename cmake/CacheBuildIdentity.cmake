cmake_minimum_required(VERSION 3.24)
file(STRINGS "${INPUTS}" inputs)
set(material "VOID debug object cache build v1\n")
foreach(input IN LISTS inputs)
  if(EXISTS "${input}")
    file(SHA256 "${input}" hash)
    string(APPEND material "${input}:${hash}\n")
  else()
    string(APPEND material "${input}\n")
  endif()
endforeach()
string(SHA256 identity "${material}")
if("UNIDENTIFIED_SHARED_COMPILER" IN_LIST inputs)
  set(identity "")
endif()
set(content "#include <string_view>\nnamespace vd { std::string_view compiler_build_identity() { return \"${identity}\"; } }\n")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" previous)
else()
  set(previous "")
endif()
if(NOT content STREQUAL previous)
  file(WRITE "${OUTPUT}" "${content}")
else()
  file(TOUCH "${OUTPUT}")
endif()
