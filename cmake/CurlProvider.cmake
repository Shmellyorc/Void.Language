# The checked-in release is the only curl source. Options are scoped so curl's
# BUILD_TESTING/BUILD_SHARED_LIBS do not change VOID's own target configuration.
function(void_add_curl_provider profile)
  include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/Sanitizers.cmake")
  if(TARGET libcurl_static)
    message(FATAL_ERROR "VOID curl provider already configured")
  endif()
  find_package(Python3 REQUIRED COMPONENTS Interpreter)
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools/verify_curl_source.py"
    RESULT_VARIABLE verified OUTPUT_VARIABLE verification ERROR_VARIABLE verification_error)
  if(NOT verified EQUAL 0)
    message(FATAL_ERROR "Vendored curl verification failed: ${verification}${verification_error}")
  endif()
  message(STATUS "${verification}")
  set(BUILD_CURL_EXE OFF)
  set(BUILD_SHARED_LIBS OFF)
  set(BUILD_STATIC_LIBS ON)
  set(BUILD_TESTING OFF)
  set(BUILD_EXAMPLES OFF)
  set(BUILD_LIBCURL_DOCS OFF)
  set(BUILD_MISC_DOCS OFF)
  set(ENABLE_CURL_MANUAL OFF)
  set(CURL_DISABLE_INSTALL ON)
  set(CURL_ENABLE_EXPORT_TARGET OFF)
  set(CMAKE_DEBUG_POSTFIX "")
  set(CMAKE_POSITION_INDEPENDENT_CODE ON)
  set(CURL_USE_PKGCONFIG OFF)
  set(CURL_USE_LIBSSH2 OFF)
  set(CURL_USE_LIBSSH OFF)
  set(CURL_USE_GSSAPI OFF)
  set(CURL_USE_GSASL OFF)
  set(CURL_BROTLI OFF CACHE STRING "VOID provider: bounded decoding only" FORCE)
  set(CURL_ZSTD OFF CACHE STRING "VOID provider: bounded decoding only" FORCE)
  # VOID performs bounded gzip/deflate decoding outside the provider callback.
  set(CURL_ZLIB OFF CACHE STRING "VOID provider: bounded decoding only" FORCE)
  set(ENABLE_THREADED_RESOLVER OFF)
  set(ENABLE_UNIX_SOCKETS OFF)
  set(ENABLE_IPV6 ON)
  foreach(feature IN ITEMS ALTSVC HSTS DICT DOH FILE FTP GOPHER IMAP LDAP LDAPS
      MQTT POP3 RTSP SMTP TELNET TFTP WEBSOCKETS IPFS NETRC AWS KERBEROS_AUTH
      NEGOTIATE_AUTH PROGRESS_METER)
    set(CURL_DISABLE_${feature} ON)
  endforeach()
  if(profile STREQUAL "COOKIE" OR profile STREQUAL "NO_COOKIES" OR profile STREQUAL "NO_HTTP")
    # Isolated regression configurations, never the production transport profile.
    set(CURL_ENABLE_SSL OFF)
    set(CURL_USE_LIBPSL OFF)
    set(USE_LIBIDN2 OFF)
    set(USE_NGHTTP2 OFF)
    set(ENABLE_ARES OFF)
    if(profile STREQUAL "NO_COOKIES")
      set(CURL_DISABLE_COOKIES ON)
    elseif(profile STREQUAL "NO_HTTP")
      set(CURL_DISABLE_HTTP ON)
    endif()
  elseif(profile STREQUAL "HTTP")
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/HttpDependencies.cmake")
    void_import_http_dependencies()
  else()
    message(FATAL_ERROR "Unknown VOID curl profile: ${profile}")
  endif()
  add_subdirectory("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../third_party/curl" "${CMAKE_CURRENT_BINARY_DIR}/curl")
  if(profile STREQUAL "HTTP")
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND NOT EXISTS "${CURL_CA_BUNDLE}" AND NOT IS_DIRECTORY "${CURL_CA_PATH}")
      message(FATAL_ERROR "Linux HTTP requires configured distribution CA locations")
    endif()
    get_target_property(curl_sources libcurl_static SOURCES)
    list(FILTER curl_sources EXCLUDE REGEX "(^|/)vtls/keylog\\.c$")
    set_property(TARGET libcurl_static PROPERTY SOURCES "${curl_sources}")
    target_sources(libcurl_static PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/runtime/curl_keylog_disabled.c")
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
      target_link_libraries(libcurl_static PRIVATE "${VOID_HTTP_DEPS_ROOT}/lib/libunistring.so")
    endif()
    if(WIN32)
      target_compile_definitions(libcurl_static PRIVATE PSL_STATIC NGHTTP2_STATICLIB CARES_STATICLIB)
      target_compile_definitions(libcurl_static PUBLIC _WIN32_WINNT=0x0A00 NOMINMAX WIN32_LEAN_AND_MEAN)
    elseif(APPLE)
      set_target_properties(libcurl_static PROPERTIES C_VISIBILITY_PRESET hidden)
      if(NOT HAVE_APPLE_IDN OR NOT USE_APPLE_SECTRUST OR NOT USE_OPENSSL)
        message(FATAL_ERROR "macOS HTTP requires native ICU IDN, SecTrust and the pinned TLS provider")
      endif()
    endif()
    target_link_libraries(libcurl_static PUBLIC ${VOID_HTTP_SYSTEM_LINK_LIBRARIES})
    set(VOID_HTTP_LINK_FILES "$<TARGET_FILE:libcurl_static>;${VOID_HTTP_LINK_FILES}" PARENT_SCOPE)
    set(VOID_HTTP_DEPS_ROOT "${VOID_HTTP_DEPS_ROOT}" PARENT_SCOPE)
    set(VOID_HTTP_SYSTEM_LINK_LIBRARIES "${VOID_HTTP_SYSTEM_LINK_LIBRARIES}" PARENT_SCOPE)
    add_library(void_http_compression STATIC IMPORTED GLOBAL)
    set_target_properties(void_http_compression PROPERTIES
      IMPORTED_LOCATION "${VOID_HTTP_ZLIB}"
      INTERFACE_INCLUDE_DIRECTORIES "${VOID_HTTP_DEPS_ROOT}/include")
  endif()
  void_enable_sanitizers(libcurl_static PUBLIC)
endfunction()
