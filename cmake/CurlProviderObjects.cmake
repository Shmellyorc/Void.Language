# Compile policy belongs to the source target, not just its consuming archive.
function(void_configure_curl_objects profile)
  include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/Sanitizers.cmake")
  set(compilation libcurl_static)
  if(TARGET libcurl_object)
    set(compilation libcurl_object)
  endif()
  if(profile STREQUAL "HTTP")
    get_target_property(sources ${compilation} SOURCES)
    list(FILTER sources EXCLUDE REGEX "(^|/)vtls/keylog\\.c$")
    set_property(TARGET ${compilation} PROPERTY SOURCES "${sources}")
    target_sources(${compilation} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/runtime/curl_keylog_disabled.c")
    if(WIN32)
      target_compile_definitions(${compilation} PRIVATE PSL_STATIC NGHTTP2_STATICLIB CARES_STATICLIB
        _WIN32_WINNT=0x0A00 NOMINMAX WIN32_LEAN_AND_MEAN)
      target_compile_definitions(libcurl_static PUBLIC _WIN32_WINNT=0x0A00 NOMINMAX WIN32_LEAN_AND_MEAN)
    elseif(APPLE)
      set_target_properties(${compilation} PROPERTIES C_VISIBILITY_PRESET hidden)
    endif()
  endif()
  void_enable_sanitizers(libcurl_static PUBLIC)
  if(NOT compilation STREQUAL "libcurl_static")
    void_enable_sanitizers(${compilation} PRIVATE)
  endif()
endfunction()
