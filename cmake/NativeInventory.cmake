cmake_minimum_required(VERSION 3.24)
# Two physical spellings per resource: build tree and relocated installation.
file(STRINGS "${INPUTS}" paths)
list(LENGTH paths count)
math(EXPR remainder "${count} % 2")
if(NOT remainder EQUAL 0)
  message(FATAL_ERROR "Invalid native resource inventory inputs")
endif()
set(build "VOID native resources 1\n")
set(install "VOID native resources 1\n")
while(paths)
  list(POP_FRONT paths physical relative)
  if(NOT EXISTS "${physical}")
    message(FATAL_ERROR "Missing native link resource: ${physical}")
  endif()
  file(SHA256 "${physical}" digest)
  string(APPEND build "${digest}\t${physical}\n")
  string(APPEND install "${digest}\t${relative}\n")
endwhile()
file(WRITE "${BUILD_OUTPUT}.tmp" "${build}")
file(RENAME "${BUILD_OUTPUT}.tmp" "${BUILD_OUTPUT}")
file(WRITE "${INSTALL_OUTPUT}.tmp" "${install}")
file(RENAME "${INSTALL_OUTPUT}.tmp" "${INSTALL_OUTPUT}")
