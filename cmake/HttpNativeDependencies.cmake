# Fixed native filenames; no ambient TLS, curl, resolver or protocol fallback.
macro(void_import_native_http_dependencies)
  if(NOT WIN32 AND NOT APPLE)
    message(FATAL_ERROR "No native HTTP recipe for ${CMAKE_SYSTEM_NAME}")
  endif()
  if(CMAKE_CONFIGURATION_TYPES)
    message(FATAL_ERROR "HTTP native dependencies require separate single-configuration Debug/Release/strict build directories")
  endif()
  if(VOID_SANITIZERS)
    set(_http_profile strict)
  elseif(CMAKE_BUILD_TYPE STREQUAL "Debug")
    set(_http_profile Debug)
  else()
    set(_http_profile Release)
  endif()
  string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _http_arch)
  if(_http_arch STREQUAL "amd64")
    set(_http_arch x86_64)
  elseif(_http_arch STREQUAL "aarch64")
    set(_http_arch arm64)
  endif()
  if(APPLE AND CMAKE_OSX_ARCHITECTURES)
    list(LENGTH CMAKE_OSX_ARCHITECTURES _http_arch_count)
    if(NOT _http_arch_count EQUAL 1)
      message(FATAL_ERROR "HTTP requires one native architecture per build/prefix")
    endif()
    set(_http_arch "${CMAKE_OSX_ARCHITECTURES}")
  endif()
  if(NOT _http_arch MATCHES "^(x86_64|arm64)$")
    message(FATAL_ERROR "Native HTTP architecture unavailable: ${_http_arch}")
  endif()
  if(WIN32)
    set(CURL_TARGET_WINDOWS_VERSION 0x0A00)
    set(_http_bundle "windows-schannel-${_http_arch}")
  else()
    set(_http_bundle "macos-aws-lc-5.12.0-${_http_arch}")
  endif()
  set(VOID_HTTP_DEPS_ROOT "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.toolchains/http/prefix/${_http_bundle}/${_http_profile}"
    CACHE PATH "Verified pinned native HTTP dependency prefix")
  get_filename_component(VOID_HTTP_DEPS_ROOT "${VOID_HTTP_DEPS_ROOT}" ABSOLUTE)
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools/verify_http_dependencies.py"
    "${VOID_HTTP_DEPS_ROOT}" "${_http_profile}" "${CMAKE_SYSTEM_NAME}" "${_http_arch}"
    RESULT_VARIABLE _http_verified OUTPUT_VARIABLE _http_verification ERROR_VARIABLE _http_error)
  if(NOT _http_verified EQUAL 0)
    message(FATAL_ERROR "${_http_verification}${_http_error}\nRun python3 tools/setup_http_deps.py --profile ${_http_profile} on the native host")
  endif()
  message(STATUS "${_http_verification}")
  set(CURL_USE_CMAKECONFIG OFF)
  set(CURL_ENABLE_SSL ON)
  set(USE_NGHTTP2 ON)
  set(NGHTTP2_USE_STATIC_LIBS ON)
  set(ENABLE_ARES ON)
  set(CARES_USE_STATIC_LIBS ON)
  set(USE_LIBIDN2 OFF)
  set(CURL_USE_LIBPSL ON)
  foreach(_http_name NGHTTP2 CARES LIBPSL)
    set(${_http_name}_INCLUDE_DIR "${VOID_HTTP_DEPS_ROOT}/include")
  endforeach()
  if(WIN32)
    set(CURL_USE_SCHANNEL ON)
    set(CURL_USE_OPENSSL OFF)
    set(ENABLE_UNICODE ON)
    set(USE_WIN32_IDN ON)
    set(NGHTTP2_LIBRARY "${VOID_HTTP_DEPS_ROOT}/lib/nghttp2.lib")
    set(CARES_LIBRARY "${VOID_HTTP_DEPS_ROOT}/lib/cares_static.lib")
    set(LIBPSL_LIBRARY "${VOID_HTTP_DEPS_ROOT}/lib/psl.lib")
    if(_http_profile STREQUAL "Release")
      set(VOID_HTTP_ZLIB "${VOID_HTTP_DEPS_ROOT}/lib/zs.lib")
    else()
      set(VOID_HTTP_ZLIB "${VOID_HTTP_DEPS_ROOT}/lib/zsd.lib")
    endif()
    set(VOID_HTTP_LINK_FILES "${LIBPSL_LIBRARY}" "${NGHTTP2_LIBRARY}" "${CARES_LIBRARY}" "${VOID_HTTP_ZLIB}")
    set(VOID_HTTP_SYSTEM_LINK_LIBRARIES ws2_32 crypt32 secur32 normaliz iphlpapi advapi32 bcrypt)
  else()
    set(CURL_USE_OPENSSL ON)
    set(USE_APPLE_SECTRUST ON)
    set(USE_APPLE_IDN ON)
    set(CURL_DISABLE_OPENSSL_AUTO_LOAD_CONFIG ON)
    set(OPENSSL_USE_STATIC_LIBS ON)
    set(OPENSSL_INCLUDE_DIR "${VOID_HTTP_DEPS_ROOT}/include")
    set(OPENSSL_SSL_LIBRARY "${VOID_HTTP_DEPS_ROOT}/lib/libssl.a")
    set(OPENSSL_CRYPTO_LIBRARY "${VOID_HTTP_DEPS_ROOT}/lib/libcrypto.a")
    set(NGHTTP2_LIBRARY "${VOID_HTTP_DEPS_ROOT}/lib/libnghttp2.a")
    set(CARES_LIBRARY "${VOID_HTTP_DEPS_ROOT}/lib/libcares.a")
    set(LIBPSL_LIBRARY "${VOID_HTTP_DEPS_ROOT}/lib/libpsl.a")
    set(VOID_HTTP_ZLIB "${VOID_HTTP_DEPS_ROOT}/lib/libz.a")
    set(CURL_CA_BUNDLE none CACHE STRING "SecTrust owns system trust" FORCE)
    set(CURL_CA_PATH none CACHE STRING "SecTrust owns system trust" FORCE)
    set(VOID_HTTP_LINK_FILES "${LIBPSL_LIBRARY}" "${NGHTTP2_LIBRARY}" "${OPENSSL_SSL_LIBRARY}"
      "${OPENSSL_CRYPTO_LIBRARY}" "${CARES_LIBRARY}" "${VOID_HTTP_ZLIB}")
    set(VOID_HTTP_SYSTEM_LINK_LIBRARIES "-framework Security" "-framework CoreFoundation" "-framework CoreServices" icucore iconv)
    file(READ "${VOID_HTTP_DEPS_ROOT}/VOID-HTTP-DEPENDENCIES.json" _http_manifest)
    string(JSON _http_minimum GET "${_http_manifest}" deployment_target)
    if(CMAKE_OSX_DEPLOYMENT_TARGET AND CMAKE_OSX_DEPLOYMENT_TARGET VERSION_LESS _http_minimum)
      message(FATAL_ERROR "HTTP prefix deployment target ${_http_minimum} exceeds the application minimum")
    endif()
  endif()
  foreach(_http_file IN LISTS VOID_HTTP_LINK_FILES)
    if(NOT EXISTS "${_http_file}")
      message(FATAL_ERROR "Pinned native HTTP library missing: ${_http_file}")
    endif()
  endforeach()
endmacro()
