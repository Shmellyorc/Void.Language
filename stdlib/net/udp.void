use net/address
use net/error as net_error

## Owned unicast UDP socket bound to one numeric address family.
struct socket:
    private _identity: bool

private func (self socket) init():
    pass

## One complete datagram and its numeric sender. Empty bytes are valid.
struct datagram:
    bytes: [u8]
    peer: address.endpoint

private value struct _network_reply:
    kind: i64
    phase: i64
    domain: i64
    native_code: i64
    cleanup: i64
    number: i64
    detail: i64
    port: i64
    family_code: i64
    flag: bool
    text: string
    bytes: [u8]

private func _error(operation: string, reply: _network_reply) -> net_error.error:
    return net_error.make(operation, reply.kind, reply.phase, reply.domain, reply.native_code,
        reply.cleanup, reply.number, reply.bytes, reply.text, reply.flag, reply.detail, 0)

private func _bool(operation: string, reply: _network_reply) -> result<bool, net_error.error>:
    if reply.kind != 0:
        return Err(_error(operation, reply))
    return Ok(true)

private func _count(operation: string, reply: _network_reply) -> result<i64, net_error.error>:
    if reply.kind != 0:
        return Err(_error(operation, reply))
    return Ok(reply.number)

private func _packet(operation: string, reply: _network_reply) -> result<datagram, net_error.error>:
    if reply.kind != 0:
        return Err(_error(operation, reply))
    return Ok(datagram(bytes = reply.bytes, peer = address._endpoint(reply.text, reply.port)))

## Bind one explicit numeric UDP endpoint.
func bind(local: address.endpoint) -> result<socket, net_error.error>:
    var owned = socket()
    var reply = _net_bind(owned, address.format_ip(local.ip), local.port as i64)
    if reply.kind != 0:
        return Err(_error("udp.bind", reply))
    return Ok(owned)

## Bind one explicit numeric UDP endpoint. Uses external native completion.
async func bind_async(local: address.endpoint) -> result<socket, net_error.error>:
    var owned = socket()
    var reply = await _net_bind_async(owned, address.format_ip(local.ip), local.port as i64)
    if reply.kind != 0:
        return Err(_error("udp.bind_async", reply))
    return Ok(owned)

## Send one datagram, including an empty datagram.
func (self socket) send_to(const bytes: [u8], remote: address.endpoint, timeout_ms: i64 = 30000) -> result<i64, net_error.error>:
    var reply = _net_send(self, bytes, address.format_ip(remote.ip), remote.port as i64, timeout_ms)
    return _count("udp.send_to", reply)

## Send one datagram, including an empty datagram. Uses external native completion.
async func (self socket) send_to_async(const bytes: [u8], remote: address.endpoint, timeout_ms: i64 = 30000) -> result<i64, net_error.error>:
    var reply = await _net_send_async(self, bytes, address.format_ip(remote.ip), remote.port as i64, timeout_ms)
    return _count("udp.send_to_async", reply)

## Consume one datagram and report an oversized message as a checked error.
func (self socket) receive_from(max_count: i64 = 65527, timeout_ms: i64 = 30000) -> result<datagram, net_error.error>:
    var reply = _net_receive(self, max_count, timeout_ms)
    return _packet("udp.receive_from", reply)

## Consume one datagram and report an oversized message as a checked error. Uses external native completion.
async func (self socket) receive_from_async(max_count: i64 = 65527, timeout_ms: i64 = 30000) -> result<datagram, net_error.error>:
    var reply = await _net_receive_async(self, max_count, timeout_ms)
    return _packet("udp.receive_from_async", reply)

## Close the owned UDP socket and wake pending operations.
func (self socket) close() -> result<bool, net_error.error>:
    var reply = _net_close_udp(self)
    return _bool("udp.close", reply)

## Close the owned UDP socket and wake pending operations. Uses external native completion.
async func (self socket) close_async() -> result<bool, net_error.error>:
    var reply = await _net_close_udp_async(self)
    return _bool("udp.close_async", reply)

## Report the bound address and port.
func (self socket) local_endpoint() -> result<address.endpoint, net_error.error>:
    var reply = _net_udp_local(self)
    if reply.kind != 0:
        return Err(_error("udp.local_endpoint", reply))
    return Ok(address._endpoint(reply.text, reply.port))

func (self socket) deinit():
    _net_cleanup_udp(self)
