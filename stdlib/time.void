value struct offset_datetime:
    private const _year: i64
    private const _month: i64
    private const _day: i64
    private const _hour: i64
    private const _minute: i64
    private const _second: i64
    private const _nanosecond: u32
    private const _offset_seconds: i64
private func (self offset_datetime) init(year: i64, month: i64, day: i64, hour: i64, minute: i64, second: i64, nanosecond: u32, offset_seconds: i64):
    self._year = year
    self._month = month
