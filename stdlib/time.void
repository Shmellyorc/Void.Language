value struct monotonic_tick:
    private const _seconds: i64
    private const _nanosecond: i64
    private const _context: i64
private func (self monotonic_tick) init(seconds: i64, nanosecond: i64, context: i64):
    self._seconds = seconds
    self._nanosecond = nanosecond
    self._context = context
private property (self monotonic_tick) seconds: i64:
    get:
        return self._seconds
private property (self monotonic_tick) nanosecond: i64:
    get:
        return self._nanosecond
private property (self monotonic_tick) context: i64:
    get:
        return self._context
private value struct _clock_sample:
    private const _seconds: i64
    private const _nanosecond: i64
    private const _context: i64
private func (self _clock_sample) init(seconds: i64, nanosecond: i64, context: i64):
    self._seconds = seconds
    self._nanosecond = nanosecond
    self._context = context
property (self _clock_sample) seconds: i64:
    get:
        return self._seconds
property (self _clock_sample) nanosecond: i64:
    get:
        return self._nanosecond
property (self _clock_sample) context: i64:
    get:
        return self._context
property (self zone) rules_version: string:
    get:
        return "2026e"
enum local_choice:
    reject
    earlier
    later
## @param year The calendar year.
## @param month The month from 1 through 12.
## @param day The day of the month.
func make_date(year: i64, month: i64, day: i64) -> result<date, string>:
    var checked = _date_check(year, month, day)?
    return Ok(date(year, month, day))
func make_time(hour: i64, minute: i64, second: i64, nanosecond: i64 = 0) -> result<time_of_day, string>:
    var checked = _time_check(hour, minute, second, nanosecond)?
    return Ok(time_of_day(hour, minute, second, nanosecond as u32))
func make_local_datetime(day: date, clock: time_of_day) -> result<local_datetime, string>:
    return Ok(local_datetime(day.year, day.month, day.day, clock.hour, clock.minute, clock.second, clock.nanosecond))
func make_instant(seconds: i64, nanosecond: i64 = 0) -> result<instant, string>:
    var checked = _time_check(0, 0, 0, nanosecond)?
    return Ok(instant(seconds, nanosecond as u32))
func make_duration(seconds: i64, nanosecond: i64 = 0) -> result<duration, string>:
    var checked = _time_check(0, 0, 0, nanosecond)?
    return Ok(duration(seconds, nanosecond as u32))
func find_zone(name: string) -> result<zone, string>:
    var canonical = _zone(name)?
    return Ok(zone(canonical))
func at_offset(value: instant, offset_seconds: i64) -> result<offset_datetime, string>:
    var packed = _project(value.seconds, offset_seconds)?
    var second = packed % 100
    packed = packed / 100
    var minute = packed % 100
    packed = packed / 100
    var hour = packed % 100
    packed = packed / 100
    var day = packed % 100
    packed = packed / 100
    var month = packed % 100
    var year = packed / 100
    return Ok(offset_datetime(year, month, day, hour, minute, second, value.nanosecond, offset_seconds))
func in_zone(value: instant, selected: zone) -> result<zoned_datetime, string>:
    var offset = _zone_offset(value.seconds, selected.name)?
    var checked = _project(value.seconds, offset)?
    return Ok(zoned_datetime(value.seconds, value.nanosecond, selected.name))
func resolve_local(value: local_datetime, selected: zone, choice: local_choice = local_choice.reject) -> result<zoned_datetime, string>:
    var seconds = _civil_seconds(value.year, value.month, value.day, value.hour, value.minute, value.second)?
    var selection: i64 = 0
    if choice is local_choice.earlier:
        selection = 1
    if choice is local_choice.later:
        selection = 2
    var resolved = _resolve(seconds, selected.name, selection)?
    return Ok(zoned_datetime(resolved, value.nanosecond, selected.name))
func now_utc() -> result<instant, string>:
    var sample = _now()?
    return make_instant(sample.seconds, sample.nanosecond)
func monotonic_now() -> result<monotonic_tick, string>:
    var sample = _monotonic()?
    return Ok(monotonic_tick(sample.seconds, sample.nanosecond, sample.context))
func utc_precision_ns() -> result<i64, string>:
    return _utc_precision()
func monotonic_precision_ns() -> result<i64, string>:
    return _monotonic_precision()
private func _combine(a: i64, an: i64, b: i64, bn: i64, subtract: bool) -> result<_clock_sample, string>:
    var ns: i64 = an + bn
    var carry: i64 = 0
    var operation: i64 = 0
    if subtract:
        operation = 1
        ns = an - bn
        if ns < 0:
            ns += 1000000000
            carry = -1
    else:
        if ns >= 1000000000:
            ns -= 1000000000
            carry = 1
    var seconds = _seconds(a, b, operation, carry)?
    return Ok(_clock_sample(seconds, ns, 0))
func (self instant) add(delta: duration) -> result<instant, string>:
    var value = _combine(self.seconds, self.nanosecond as i64, delta.seconds, delta.nanosecond as i64, false)?
    return make_instant(value.seconds, value.nanosecond)
func (self instant) subtract(delta: duration) -> result<instant, string>:
    var value = _combine(self.seconds, self.nanosecond as i64, delta.seconds, delta.nanosecond as i64, true)?
    return make_instant(value.seconds, value.nanosecond)
func (self instant) difference(other: instant) -> result<duration, string>:
    var value = _combine(self.seconds, self.nanosecond as i64, other.seconds, other.nanosecond as i64, true)?
    return make_duration(value.seconds, value.nanosecond)
func (self duration) add(other: duration) -> result<duration, string>:
    var value = _combine(self.seconds, self.nanosecond as i64, other.seconds, other.nanosecond as i64, false)?
    return make_duration(value.seconds, value.nanosecond)
func (self duration) subtract(other: duration) -> result<duration, string>:
    var value = _combine(self.seconds, self.nanosecond as i64, other.seconds, other.nanosecond as i64, true)?
    return make_duration(value.seconds, value.nanosecond)
func elapsed(start: monotonic_tick, end: monotonic_tick) -> result<duration, string>:
    if start.context != end.context:
        return Err("Monotonic values belong to different Runtime clock contexts")
    var value = _combine(end.seconds, end.nanosecond, start.seconds, start.nanosecond, true)?
    return make_duration(value.seconds, value.nanosecond)
func (self zoned_datetime) components() -> result<offset_datetime, string>:
    var point = make_instant(self.seconds, self.nanosecond as i64)?
    var offset = _zone_offset(self.seconds, self.zone_name)?
    return at_offset(point, offset)

func (self date) format(spec: string) -> result<string, string>:
    return _date_format(self.year, self.month, self.day, spec)
func (self date) string() -> string:
    return _temporal_unwrap(self.format(""))
func (self time_of_day) format(spec: string) -> result<string, string>:
    return _time_format(self.hour, self.minute, self.second, self.nanosecond as i64, spec)
func (self time_of_day) string() -> string:
    return _temporal_unwrap(self.format(""))
func (self local_datetime) format(spec: string) -> result<string, string>:
    return _local_format(self.year, self.month, self.day, self.hour, self.minute, self.second, self.nanosecond as i64, spec)
func (self local_datetime) string() -> string:
    return _temporal_unwrap(self.format(""))
func (self instant) format(spec: string) -> result<string, string>:
    return _instant_format(self.seconds, self.nanosecond as i64, spec)
func (self instant) string() -> string:
    return _temporal_unwrap(self.format(""))
func (self duration) format(spec: string) -> result<string, string>:
    return _duration_format(self.seconds, self.nanosecond as i64, spec)
func (self duration) string() -> string:
    return _temporal_unwrap(self.format(""))
func (self offset_datetime) format(spec: string) -> result<string, string>:
    return _offset_format(self.year, self.month, self.day, self.hour, self.minute, self.second, self.nanosecond as i64, self.offset_seconds, spec)
func (self offset_datetime) string() -> string:
    return _temporal_unwrap(self.format(""))
func (self zoned_datetime) format(spec: string) -> result<string, string>:
    return _zoned_format(self.seconds, self.nanosecond as i64, self.zone_name, spec)
func (self zoned_datetime) string() -> string:
    return _temporal_unwrap(self.format(""))
property (self local_datetime) date: date:
    get:
        return date(self.year, self.month, self.day)
property (self local_datetime) time: time_of_day:
    get:
        return time_of_day(self.hour, self.minute, self.second, self.nanosecond)
property (self offset_datetime) local: local_datetime:
    get:
        return local_datetime(self.year, self.month, self.day, self.hour, self.minute, self.second, self.nanosecond)
func (self offset_datetime) to_instant() -> result<instant, string>:
    var seconds = _civil_seconds(self.year, self.month, self.day, self.hour, self.minute, self.second)?
    var shifted = _seconds(seconds, self.offset_seconds, 1, 0)?
    return make_instant(shifted, self.nanosecond as i64)
property (self zoned_datetime) instant: instant:
    get:
        return instant(self.seconds, self.nanosecond)
property (self zoned_datetime) zone: zone:
    get:
        return zone(self.zone_name)
func (self monotonic_tick) compare(other: monotonic_tick) -> result<i32, string>:
    if self.context != other.context:
        return Err("Monotonic values belong to different Runtime clock contexts")
    if self.seconds < other.seconds:
        return Ok(-1)
    if self.seconds > other.seconds:
        return Ok(1)
    if self.nanosecond < other.nanosecond:
        return Ok(-1)
    if self.nanosecond > other.nanosecond:
        return Ok(1)
    return Ok(0)
