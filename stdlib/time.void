private func (self time_of_day) init(hour: i64, minute: i64, second: i64, nanosecond: u32):
    self._hour = hour
    self._minute = minute
    self._second = second
    self._nanosecond = nanosecond
property (self time_of_day) hour: i64:
    get:
        return self._hour
property (self time_of_day) minute: i64:
    get:
        return self._minute
property (self time_of_day) second: i64:
    get:
        return self._second
property (self time_of_day) nanosecond: u32:
    get:
        return self._nanosecond
