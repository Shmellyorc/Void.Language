namespace AliasTargets353
{
    public class Base
    {
        public virtual int Get()
        {
            return 7;
        }
    }

    public interface IValue
    {
        int Value();
    }

    public sealed class Box<T>
    {
        public T Item;

        public Box(T item)
        {
            Item = item;
        }
    }

    public static class StaticData
    {
        public static int Number = 9;

        public static int Get()
        {
            return Number;
        }
    }
}

using BaseAlias = AliasTargets353.Base;
using InterfaceAlias = AliasTargets353.IValue;
using BoxAlias = AliasTargets353.Box;
using TypesAlias = AliasTargets353;
using StaticAlias = AliasTargets353.StaticData;
using IndexAlias = Void.Index;
using IndexChain = IndexAlias;

public sealed class Child353 : BaseAlias, InterfaceAlias
{
    public override int Get()
    {
        return 8;
    }

    public int Value()
    {
        return 10;
    }
}

public static class Program
{
    public static T Identity<T>(T value)
    {
        return value;
    }

    public static int Constrained<T>(T value) where T : InterfaceAlias
    {
        return value.Value();
    }

    public static void Main()
    {
        IndexAlias index = new IndexAlias(3);
        IndexChain chained = index;
        Console.WriteLine(chained.Value == 3);

        Child353 child = new Child353();
        BaseAlias aliasBase = child;
        AliasTargets353.Base fullBase = aliasBase;
        InterfaceAlias contract = child;
        Console.WriteLine(aliasBase.Get() == 8);
        Console.WriteLine(fullBase.Get() == 8);
        Console.WriteLine(contract.Value() == 10);
        Console.WriteLine(Constrained<Child353>(child) == 10);

        BoxAlias<BaseAlias> aliasBox = new BoxAlias<BaseAlias>(aliasBase);
        AliasTargets353.Box<AliasTargets353.Base> fullBox = aliasBox;
        TypesAlias.Box<TypesAlias.Base> namespaceBox = fullBox;
        Console.WriteLine(aliasBox.Item.Get() == 8);
        Console.WriteLine(namespaceBox.Item.Get() == 8);

        BaseAlias first = Identity<BaseAlias>(aliasBase);
        AliasTargets353.Base second = Identity<AliasTargets353.Base>(aliasBase);
        Console.WriteLine(first.Get() == second.Get());

        Console.WriteLine(StaticAlias.Number == 9);
        Console.WriteLine(StaticAlias.Get() == 9);
        Console.WriteLine(TypesAlias.StaticData.Get() == 9);
    }
}
