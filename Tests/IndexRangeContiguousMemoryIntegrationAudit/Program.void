using Void;
using Void.Collections;
using Void.Threading.Tasks;

public sealed class Node240
{
    public int Value;

    public Node240(int value)
    {
        Value = value;
    }
}

public sealed class AuditException240 : Exception
{
    public int Code;

    public AuditException240(string message, int code) : base(message)
    {
        Code = code;
    }
}

public sealed class Window240
{
    private int[] _values;
    private int _start;
    private int _length;

    public Window240(int[] values, int start, int length)
    {
        _values = values;
        _start = start;
        _length = length;
    }

    public int Length => _length;

    public ref int get_Item(int index)
    {
        return ref _values[_start + index];
    }

    public Window240 Slice(int start, int length)
    {
        return new Window240(_values, _start + start, length);
    }
}

public static class Program
{
    private static int ReceiverCalls;
    private static int StartCalls;
    private static int EndCalls;
    private static int IndexCalls;
    private static int ForeachCalls;

    private static void Check(bool value)
    {
        Console.WriteLine(value);
    }

    private static Memory<int> CountedMemory(int[] values)
    {
        ReceiverCalls++;
        return values;
    }

    private static int CountedStart()
    {
        StartCalls++;
        return 1;
    }

    private static int CountedEnd()
    {
        EndCalls++;
        return 1;
    }

    private static int CountedIndex()
    {
        IndexCalls++;
        return 1;
    }

    private static Span<int> CountedSpan(int[] values)
    {
        ForeachCalls++;
        return values;
    }

    private static bool CopyMiddle<T>(Memory<T> source, Memory<T> destination)
    {
        Memory<T> middle = source[1..^1];
        return middle.TryCopyTo(destination);
    }

    private static T FirstMiddle<T>(ReadOnlyMemory<T> source)
    {
        ReadOnlyMemory<T> middle = source[1..^1];
        return middle.Span[0];
    }

    private static int ExceptionFlow(Memory<int> memory)
    {
        int observed = 0;
        try
        {
            memory.Span[1..^1].Fill(7);
            throw new AuditException240("audit", 9);
        }
        catch (AuditException240 error)
        {
            Span<int> span = memory.Span;
            ref int value = ref span[^2];
            value += error.Code;
            observed = value;
        }
        finally
        {
            memory.Span[0] += 100;
        }
        return observed;
    }

    private static async Task<int> ReadAfter(Task gate, Memory<Node240> memory)
    {
        Memory<Node240> middle = memory[1..^1];
        await gate;
        GC.Collect();
        return middle.Span[0].Value + middle.Span[^1].Value;
    }

    private static IEnumerator<int> IterateAfter(ReadOnlyMemory<Node240> memory)
    {
        ReadOnlyMemory<Node240> middle = memory[1..^1];
        yield return middle.Length;
        GC.Collect();
        yield return middle.Span[^1].Value;
    }

    public static void Main()
    {
        int[] structuralValues = new int[] { 10, 20, 30, 40, 50 };
        Window240 window = new Window240(structuralValues, 0, structuralValues.Length);
        ref int structuralTail = ref window[^1];
        structuralTail = 55;
        Check(structuralValues[4] == 55);
        Window240 structuralMiddle = window[1..^1];
        Check(structuralMiddle.Length == 3);
        structuralMiddle[1] = 33;
        Check(structuralValues[2] == 33);

        int[] arrayValues = new int[] { 1, 2, 3, 4, 5, 6 };
        int[] arrayCopy = arrayValues[1..^1];
        Check(arrayCopy.Length == 4 && arrayCopy[0] == 2 && arrayCopy[3] == 5);
        arrayCopy[0] = 200;
        Check(arrayValues[1] == 2);

        Memory<int> memory = arrayValues;
        Memory<int> memoryRange = memory[1..^1];
        Check(memoryRange.Length == 4);
        memoryRange.Span[0] = 20;
        Check(arrayValues[1] == 20);

        Span<int> spanRange = memoryRange.Span[1..^1];
        Check(spanRange.Length == 2);
        spanRange[0] = 30;
        Check(arrayValues[2] == 30);
        Memory<int> chainedMemory = memory[1..^1];
        Span<int> chainedSpan = chainedMemory.Span;
        ref int chainedAlias = ref chainedSpan[^1];
        chainedAlias = 44;
        Check(arrayValues[4] == 44);

        ReadOnlyMemory<int> readOnlyMemory = memory;
        ReadOnlySpan<int> readOnlySpan = readOnlyMemory[1..^1].Span;
        ref readonly int readOnlyAlias = ref readOnlySpan[^1];
        Check(readOnlyAlias == 44);
        int readOnlySum = 0;
        foreach (ref readonly int value in readOnlySpan)
            readOnlySum += value;
        Check(readOnlySum == 20 + 30 + 4 + 44);

        foreach (ref int value in memoryRange.Span)
            value += 1;
        Check(arrayValues[1] == 21 && arrayValues[2] == 31 && arrayValues[3] == 5 && arrayValues[4] == 45);

        Span<int> stack = stackalloc int[6];
        stack.Fill(1);
        Span<int> stackMiddle = stack[1..^1];
        int stackOffset = 0;
        foreach (ref int value in stackMiddle)
        {
            value += stackOffset;
            stackOffset++;
        }
        Check(stack[0] == 1 && stack[1] == 1 && stack[2] == 2 && stack[3] == 3 && stack[4] == 4 && stack[5] == 1);
        stackMiddle.CopyTo(stack[0..4]);
        Check(stack[0] == 1 && stack[1] == 2 && stack[2] == 3 && stack[3] == 4);
        stack[2..^1].Clear();
        Check(stack[2] == 0 && stack[3] == 0 && stack[4] == 0);

        int[] overlap = new int[] { 1, 2, 3, 4, 5 };
        Memory<int> overlapSource = new Memory<int>(overlap, 0, 4);
        Memory<int> overlapDestination = new Memory<int>(overlap, 1, 4);
        overlapSource.CopyTo(overlapDestination);
        Check(overlap[0] == 1 && overlap[1] == 1 && overlap[2] == 2 && overlap[3] == 3 && overlap[4] == 4);

        int[] shortBacking = new int[] { 8, 9, 10 };
        Memory<int> tooLong = new Memory<int>(shortBacking, 0, 3);
        Memory<int> tooShort = new Memory<int>(shortBacking, 0, 2);
        bool copied = tooLong.TryCopyTo(tooShort);
        Check(!copied && shortBacking[0] == 8 && shortBacking[1] == 9 && shortBacking[2] == 10);

        ReceiverCalls = 0;
        StartCalls = 0;
        EndCalls = 0;
        IndexCalls = 0;
        int[] onceValues = new int[] { 5, 6, 7, 8, 9, 10 };
        CountedMemory(onceValues)[CountedStart()..^CountedEnd()].Span[CountedIndex()] = 77;
        Check(ReceiverCalls == 1 && StartCalls == 1 && EndCalls == 1 && IndexCalls == 1);
        Check(onceValues[2] == 77);

        ForeachCalls = 0;
        int[] foreachValues = new int[] { 1, 2, 3 };
        int foreachSum = 0;
        foreach (ref readonly int value in CountedSpan(foreachValues)[..])
            foreachSum += value;
        Check(ForeachCalls == 1);
        Check(foreachSum == 6);

        int[] genericSourceValues = new int[] { 1, 2, 3, 4, 5 };
        int[] genericDestinationValues = new int[] { 0, 0, 0 };
        Memory<int> genericSource = genericSourceValues;
        Memory<int> genericDestination = genericDestinationValues;
        Check(CopyMiddle<int>(genericSource, genericDestination));
        Check(genericDestinationValues[0] == 2 && genericDestinationValues[1] == 3 && genericDestinationValues[2] == 4);
        ReadOnlyMemory<int> genericReadOnly = genericSource;
        Check(FirstMiddle<int>(genericReadOnly) == 2);

        Node240[] genericNodes = new Node240[] { new Node240(10), new Node240(20), new Node240(30) };
        ReadOnlyMemory<Node240> genericNodeMemory = genericNodes;
        Check(FirstMiddle<Node240>(genericNodeMemory).Value == 20);

        Node240[] ownerNodes = new Node240[] { new Node240(100), new Node240(200), new Node240(300), new Node240(400) };
        Memory<Node240> ownerMemory = ownerNodes;
        Memory<Node240> ownerMiddle = ownerMemory[1..^1];
        Span<Node240> ownerSpan = ownerMiddle.Span;
        ref Node240 ownerAlias = ref ownerSpan[0];
        ownerNodes = null;
        ownerMemory = default(Memory<Node240>);
        ownerMiddle = default(Memory<Node240>);
        ownerSpan = default(Span<Node240>);
        GC.Collect();
        GC.Collect();
        Check(ownerAlias != null && ownerAlias.Value == 200);
        ownerAlias = new Node240(250);
        GC.Collect();
        Check(ownerAlias.Value == 250);

        Node240[] foreachNodes = new Node240[] { new Node240(1), new Node240(2), new Node240(3) };
        Span<Node240> foreachNodeSpan = foreachNodes;
        foreach (ref Node240 node in foreachNodeSpan[1..])
            node = new Node240(node.Value + 10);
        GC.Collect();
        Check(foreachNodes[0].Value == 1 && foreachNodes[1].Value == 12 && foreachNodes[2].Value == 13);

        int[] exceptionValues = new int[] { 1, 2, 3, 4, 5 };
        int exceptionObserved = ExceptionFlow(exceptionValues);
        Check(exceptionObserved == 16);
        Check(exceptionValues[0] == 101);
        Check(exceptionValues[1] == 7 && exceptionValues[2] == 7 && exceptionValues[3] == 16 && exceptionValues[4] == 5);

        TaskCompletionSource gate = new TaskCompletionSource();
        Node240[] asyncNodes = new Node240[] { new Node240(11), new Node240(22), new Node240(33), new Node240(44) };
        Memory<Node240> asyncMemory = asyncNodes;
        Task<int> pending = ReadAfter(gate.Task, asyncMemory);
        asyncNodes = null;
        asyncMemory = default(Memory<Node240>);
        GC.Collect();
        Check(!pending.IsCompleted);
        gate.SetResult();
        Check(pending.Result == 55);

        Node240[] iteratorNodes = new Node240[] { new Node240(7), new Node240(8), new Node240(9), new Node240(10) };
        ReadOnlyMemory<Node240> iteratorMemory = iteratorNodes;
        IEnumerator<int> iterator = IterateAfter(iteratorMemory);
        iteratorNodes = null;
        iteratorMemory = default(ReadOnlyMemory<Node240>);
        GC.Collect();
        Check(iterator.MoveNext() && iterator.Current == 2);
        GC.Collect();
        Check(iterator.MoveNext() && iterator.Current == 9);
        Check(!iterator.MoveNext());
        iterator.Dispose();

        Span<int> emptyStack = stackalloc int[0];
        Check(emptyStack.IsEmpty);
        Memory<int> emptyMemory = default(Memory<int>);
        Check(emptyMemory.IsEmpty && emptyMemory.Span.IsEmpty);
    }
}
