using Void.Collections;

public sealed class Item
{
    public int Value { get; private set; }

    public Item(int value)
    {
        Value = value;
    }
}

public sealed class Counter
{
    private int _start;

    public Counter(int start)
    {
        _start = start;
    }

    public IEnumerator<int> Count(int limit)
    {
        int current = _start;

        for (int i = 0; i < limit; i++)
        {
            if (i == 1)
                current += 10;

            yield return current;
            current++;
        }
    }
}

public static class Program
{
    public static IEnumerator<int> Numbers()
    {
        yield return 1;
        yield return 2;
        yield return 3;
        yield break;
    }

    public static IEnumerator<int> Filtered(int limit)
    {
        int i = 0;

        while (i < limit)
        {
            if (i == 1)
            {
                i++;
                continue;
            }

            if (i == 4)
                break;

            yield return i;
            i++;
        }
    }

    public static IEnumerator<int> KeepManagedLocal()
    {
        Item item = new Item(77);
        yield return item.Value;
        yield return item.Value;
    }

    public static IEnumerator<Item> Items()
    {
        yield return new Item(7);
        yield return new Item(8);
    }

    public static IEnumerator<Item> Echo(Item item)
    {
        yield return item;
        yield return item;
    }

    public static void Main()
    {
        IEnumerator<int> numbers = Numbers();
        int total = 0;
        while (numbers.MoveNext())
            total += numbers.Current;

        Console.WriteLine(total);

        IEnumerator<Item> items = Items();
        GC.Collect();

        while (items.MoveNext())
        {
            GC.Collect();
            Item item = items.Current;
            Console.WriteLine(item.Value);
        }

        Counter counter = new Counter(5);
        IEnumerator<int> count = counter.Count(3);
        counter = null;
        GC.Collect();
        while (count.MoveNext())
            Console.WriteLine(count.Current);

        IEnumerator<int> filtered = Filtered(6);
        while (filtered.MoveNext())
            Console.WriteLine(filtered.Current);

        IEnumerator<int> managed = KeepManagedLocal();
        managed.MoveNext();
        Console.WriteLine(managed.Current);
        GC.Collect();
        managed.MoveNext();
        Console.WriteLine(managed.Current);

        Item captured = new Item(88);
        IEnumerator<Item> echo = Echo(captured);
        captured = null;
        GC.Collect();
        echo.MoveNext();
        Console.WriteLine(echo.Current.Value);
        GC.Collect();
        echo.MoveNext();
        Console.WriteLine(echo.Current.Value);
    }
}
