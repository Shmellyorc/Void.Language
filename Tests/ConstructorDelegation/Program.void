using Void;

public sealed class Node
{
    public int Value;

    public Node(int value)
    {
        Value = value;
    }
}

public class OrderBase
{
    public static int Trace;
    private int _baseInit = Mark(1);

    public OrderBase(int value)
    {
        Mark(2);
    }

    public static int Mark(int value)
    {
        Trace = Trace * 10 + value;
        return value;
    }
}

public sealed class Ordered : OrderBase
{
    private int _derivedInit = OrderBase.Mark(3);

    public Ordered() : this(7)
    {
        OrderBase.Mark(5);
    }

    public Ordered(int value) : base(value)
    {
        OrderBase.Mark(4);
    }
}

public sealed class Overloaded
{
    private int _marker;

    public Overloaded() : this("text") { }
    public Overloaded(int value) { _marker = value; }
    public Overloaded(string value) { _marker = 20; }

    public int Marker() { return _marker; }
}

public sealed class Named
{
    private int _combined;

    public Named() : this(right: 4, left: 3) { }

    public Named(int left, int right = 5)
    {
        _combined = left * 10 + right;
    }

    public int Combined() { return _combined; }
}

public sealed class Packed
{
    private int _sum;

    public Packed() : this(1, 2, 3) { }

    public Packed(int first, params int[] rest)
    {
        _sum = first + rest[0] + rest[1];
    }

    public int Sum() { return _sum; }
}

public sealed class Optional
{
    private int _value;

    public Optional(string tag) : this() { }

    public Optional(int value = 15)
    {
        _value = value;
    }

    public int Value() { return _value; }
}

public sealed class MultiHop
{
    public static int Trace;
    private int _init = Mark(1);

    public MultiHop() : this(2)
    {
        Mark(5);
    }

    public MultiHop(int value) : this(value, 3)
    {
        Mark(4);
    }

    public MultiHop(int left, int right)
    {
        Mark(2);
        Mark(3);
    }

    private static int Mark(int value)
    {
        Trace = Trace * 10 + value;
        return value;
    }
}

public sealed class EvaluateOnce
{
    public static int Calls;
    private int _value;

    public EvaluateOnce() : this(Next()) { }

    public EvaluateOnce(int value)
    {
        _value = value;
    }

    private static int Next()
    {
        Calls += 1;
        return Calls;
    }

    public int Value() { return _value; }
}

public sealed class GenericBox<T>
{
    private T _value;

    public GenericBox() : this(default) { }

    public GenericBox(T value)
    {
        _value = value;
    }

    public T Value() { return _value; }
}

public sealed class GcDelegated
{
    private Node _node;

    public GcDelegated() : this(new Node(91)) { }

    public GcDelegated(Node node)
    {
        GC.Collect();
        _node = node;
    }

    public int Value() { return _node.Value; }
}

public struct Point
{
    public int X = 2;
    public int Y;

    public Point() : this(5)
    {
        Y += 1;
    }

    public Point(int y)
    {
        Y = y;
    }
}

public static class Program
{
    public static void Main()
    {
        OrderBase.Trace = 0;
        Ordered ordered = new Ordered();
        Console.WriteLine(OrderBase.Trace == 12345);

        Overloaded overloaded = new Overloaded();
        Console.WriteLine(overloaded.Marker() == 20);

        Named named = new Named();
        Console.WriteLine(named.Combined() == 34);

        Packed packed = new Packed();
        Console.WriteLine(packed.Sum() == 6);

        Optional optional = new Optional("x");
        Console.WriteLine(optional.Value() == 15);

        MultiHop.Trace = 0;
        MultiHop multi = new MultiHop();
        Console.WriteLine(MultiHop.Trace == 12345);

        EvaluateOnce.Calls = 0;
        EvaluateOnce once = new EvaluateOnce();
        Console.WriteLine(EvaluateOnce.Calls == 1);
        Console.WriteLine(once.Value() == 1);

        GenericBox<int> generic = new GenericBox<int>();
        Console.WriteLine(generic.Value() == 0);

        GcDelegated gc = new GcDelegated();
        GC.Collect();
        Console.WriteLine(gc.Value() == 91);

        Point point = new Point();
        Console.WriteLine(point.X == 2);
        Console.WriteLine(point.Y == 6);
    }
}
