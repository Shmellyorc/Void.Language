using Void;

public sealed class Node
{
    public int Value;

    public Node(int value)
    {
        Value = value;
    }
}

public interface IReadable
{
    int Read();
}

public interface IValue
{
    int Value { get; }
}

public delegate int Reader();

public struct Counter
{
    public int Value;

    public Counter(int value)
    {
        Value = value;
    }

    public void Add(int amount)
    {
        Value += amount;
    }

    public readonly int Read()
    {
        return Value;
    }

    public readonly int LocalMutationStillWorks()
    {
        Counter copy = new Counter(4);
        copy.Value = 5;
        copy.Add(3);
        return copy.Value;
    }

    public readonly int ReadonlyProperty => Value;

    public int SplitProperty
    {
        readonly get { return Value; }
        set { Value = value; }
    }
}

public readonly struct Point
{
    public readonly int X;
    public readonly int Y;

    public Point(int x, int y)
    {
        X = x;
        Y = y;
    }

    public int Sum()
    {
        return X + Y;
    }

    public int Total => X + Y;
}

public readonly struct Segment
{
    public readonly Point Start;
    public readonly Point End;

    public Segment(Point start, Point end)
    {
        Start = start;
        End = end;
    }

    public int LengthLike()
    {
        return End.Sum() - Start.Sum();
    }
}

public readonly struct Box<T>
{
    public readonly T Value;

    public Box(T value)
    {
        Value = value;
    }

    public T Get()
    {
        return Value;
    }
}

public readonly struct ReferenceHolder
{
    public readonly Node Value;

    public ReferenceHolder(Node value)
    {
        Value = value;
    }

    public int TouchReference()
    {
        Value.Value += 1;
        return Value.Value;
    }
}

public struct CounterHolder
{
    public readonly Counter Value;

    public CounterHolder(Counter value)
    {
        Value = value;
    }

    public int Read()
    {
        return Value.Read();
    }
}

public readonly struct StaticHolder
{
    public readonly int Value;
    public static int Calls;

    public StaticHolder(int value)
    {
        Value = value;
    }

    public int Tick()
    {
        Calls += 1;
        return Value;
    }
}

public readonly struct Readable : IReadable
{
    public readonly int Value;

    public Readable(int value)
    {
        Value = value;
    }

    public int Read()
    {
        return Value;
    }
}

public readonly struct PropertyReadable : IValue
{
    private readonly int _value;

    public PropertyReadable(int value)
    {
        _value = value;
    }

    public int Value => _value;
}

public static class Program
{
    public static int ReadCounter(in Counter value)
    {
        return value.Read();
    }

    public static int ReadCounterProperty(in Counter value)
    {
        return value.ReadonlyProperty + value.SplitProperty;
    }

    public static int ReadPoint(in Point value)
    {
        return value.Sum() + value.Total;
    }

    public static int ReadSegment(in Segment value)
    {
        return value.LengthLike();
    }

    public static T ReadBox<T>(in Box<T> value)
    {
        return value.Get();
    }

    public static void Main()
    {
        Point point = new Point(3, 4);
        Console.WriteLine(point.X == 3);
        Console.WriteLine(point.Y == 4);
        Console.WriteLine(point.Sum() == 7);
        Console.WriteLine(point.Total == 7);
        Console.WriteLine(ReadPoint(in point) == 14);
        Point empty = default;
        Console.WriteLine(empty.Sum() == 0);

        Segment segment = new Segment(new Point(1, 2), new Point(5, 7));
        Console.WriteLine(segment.Start.Sum() == 3);
        Console.WriteLine(segment.End.Sum() == 12);
        Console.WriteLine(ReadSegment(in segment) == 9);

        Counter counter = new Counter(10);
        Console.WriteLine(counter.Read() == 10);
        Console.WriteLine(ReadCounter(in counter) == 10);
        Console.WriteLine(ReadCounterProperty(in counter) == 20);
        Console.WriteLine(counter.LocalMutationStillWorks() == 8);
        counter.SplitProperty = 12;
        Console.WriteLine(counter.Read() == 12);

        CounterHolder holder = new CounterHolder(counter);
        Console.WriteLine(holder.Read() == 12);

        Box<int> box = new Box<int>(42);
        Console.WriteLine(box.Get() == 42);
        Console.WriteLine(ReadBox<int>(in box) == 42);

        Box<Point> pointBox = new Box<Point>(new Point(8, 9));
        Point boxedPoint = ReadBox<Point>(in pointBox);
        Console.WriteLine(boxedPoint.Sum() == 17);

        ReferenceHolder reference = new ReferenceHolder(new Node(50));
        GC.Collect();
        Console.WriteLine(reference.Value.Value == 50);
        Console.WriteLine(reference.TouchReference() == 51);
        Console.WriteLine(reference.Value.Value == 51);

        StaticHolder.Calls = 0;
        StaticHolder staticHolder = new StaticHolder(9);
        Console.WriteLine(staticHolder.Tick() == 9);
        Console.WriteLine(StaticHolder.Calls == 1);

        IReadable readable = new Readable(33);
        Console.WriteLine(readable.Read() == 33);

        Readable delegateSource = new Readable(44);
        Reader reader = delegateSource.Read;
        Console.WriteLine(reader() == 44);

        IValue propertyReadable = new PropertyReadable(55);
        Console.WriteLine(propertyReadable.Value == 55);
    }
}
