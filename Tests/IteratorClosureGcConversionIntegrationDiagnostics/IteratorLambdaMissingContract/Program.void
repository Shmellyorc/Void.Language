using Void;
using Void.Collections;
public interface IMarker<T> { }
public struct Number : IMarker<Number>
{
    public int Value;
    public Number(int value) { Value = value; }
    public static implicit operator int(Number value) { return value.Value; }
}
public static class Program
{
    private static IEnumerator<int> Bad<T>(T value) where T : IMarker<T>
    {
        var copy = value;
        Func<int> getter = () => copy;
        yield return 1;
        yield return getter();
    }
    public static void Main() { IEnumerator<int> it = Bad<Number>(new Number(1)); }
}
