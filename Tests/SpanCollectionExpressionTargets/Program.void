using Void;
public sealed class Cell365<T> { public T Value; public Cell365(T value) { Value = value; } }
public ref struct SpanHolder365
{
    public Span<int> Items;
    public SpanHolder365(int value) { Items = [value, value + 1]; }
}
public static class Program
{
    private static int _calls;
    static int Next() { _calls++; return _calls; }
    static int[] Make() { _calls++; return [4, 5]; }
    static int Fail() { _calls++; throw new Exception("span-failure"); }
    static int Sum(ReadOnlySpan<int> items)
    {
        int total = 0;
        for (int i=0; i<items.Length; i++) total += items[i];
        return total;
    }
    static Span<int> GetValues() { return [9, 10]; }
    static ReadOnlySpan<int> GetReadonly() { return [11, 12]; }
    static int Select(int[] items) { return 1; }
    static int Select(Span<int> items) { return 2; }
    static int Select(ReadOnlySpan<int> items) { return 3; }
    static int SpanOnly(Span<int> items) { return items.Length; }
    static int ReadonlyOnly(ReadOnlySpan<int> items) { return items.Length; }
    static int SelectString(ReadOnlySpan<string> items) { return items.Length; }
    public static void Main()
    {
        Span<int> values = [1,2,3];
        Console.WriteLine(values.Length == 3 && values[2] == 3);
        values[1] = 99;
        Console.WriteLine(values[1] == 99);
        ReadOnlySpan<int> ro = [4,5,6];
        Console.WriteLine(ro.Length == 3 && ro[0] == 4);
        Span<int> empty = [];
        ReadOnlySpan<int> emptyro = [];
        Console.WriteLine(empty.Length == 0 && emptyro.Length == 0);
        int[] source = [2,3];
        Span<int> combined = [1, ..source, 4];
        Console.WriteLine(combined.Length == 4 && combined[2] == 3);
        Span<int> copied = [..source];
        copied[0] = 25;
        Console.WriteLine(source[0] == 2 && copied[0] == 25);
        Console.WriteLine(Sum([1, 2, 3]) == 6);
        _calls = 0;
        Span<int> ordered = [Next(), ..Make(), Next()];
        Console.WriteLine(_calls == 3 && ordered[0] == 1 && ordered[3] == 3);
        Span<Cell365<int>> refs = [new Cell365<int>(12), new Cell365<int>(13)];
        GC.Collect();
        Console.WriteLine(refs[0].Value == 12 && refs[1].Value == 13);
        Span<int> returned = GetValues();
        GC.Collect();
        Console.WriteLine(returned[0] == 9 && returned[1] == 10);
        ReadOnlySpan<int> fromReturn = GetReadonly();
        GC.Collect();
        Console.WriteLine(fromReturn[0] == 11 && fromReturn[1] == 12);
        Span<string> words = ["alpha", "beta"];
        GC.Collect();
        Console.WriteLine(words.Length == 2 && words[1] == "beta");
        ReadOnlySpan<long> widened = [1, 2, 3];
        Console.WriteLine(widened[2] == 3);
        Span<Cell365<int>> otherRefs = [..new Cell365<int>[] { new Cell365<int>(15) }, new Cell365<int>(16)];
        GC.Collect();
        Console.WriteLine(otherRefs[0].Value == 15 && otherRefs[1].Value == 16);
        Console.WriteLine(Select([1, 2]) == 1 && SpanOnly([1, 2]) == 2 &&
            ReadonlyOnly([]) == 0 && SelectString(["one", "two"]) == 2);
        Span<int> assigned = [];
        assigned = [42,43];
        Console.WriteLine(assigned[0] == 42 && assigned.Length == 2);
        Console.WriteLine(new Span<int>(new int[] { 4, 5 })[1] == 5);
        SpanHolder365 holder = new SpanHolder365(70);
        GC.Collect();
        Console.WriteLine(holder.Items[0] == 70 && holder.Items[1] == 71);
        int[] rangeSource = [8, 9, 10];
        ReadOnlySpan<int> rangeCopy = [..rangeSource[1..3]];
        Console.WriteLine(rangeCopy.Length == 2 && rangeCopy[0] == 9 && rangeCopy[1] == 10);
        _calls = 0;
        bool caught = false;
        try
        {
            Span<int> unused = [Next(), ..Make(), Fail()];
            Console.WriteLine(unused.Length == 0);
        }
        catch (Exception error)
        {
            caught = error.Message == "span-failure" && _calls == 3;
        }
        Console.WriteLine(caught);
    }
}
