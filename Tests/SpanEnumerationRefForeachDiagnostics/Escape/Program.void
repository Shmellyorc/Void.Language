using Void;
public static class Program
{
    public static ref int First(Span<int> s)
    {
        foreach (ref int x in s)
            return ref x;
        return ref s[0];
    }
    public static void Main()
    {
        int[] a = new int[] { 1 };
        Span<int> s = a;
        ref int r = ref First(s);
        Console.WriteLine(r);
    }
}
