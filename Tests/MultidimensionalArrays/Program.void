using Void;

public sealed class Node
{
    public int Value;
    public Node(int value) { Value = value; }
}

public struct Cell
{
    public int Value;
    public Cell(int value) { Value = value; }
}

public sealed class Holder
{
    public Node[,] Nodes;
    public Holder(Node[,] nodes) { Nodes = nodes; }
}

public static class Program
{
    public static Node[,] StaticNodes;

    public static T[,] MakePair<T>(T first, T second)
    {
        T[,] result = new T[1, 2];
        result[0, 0] = first;
        result[0, 1] = second;
        return result;
    }

    public static void Main()
    {
        int[,] grid = new int[2, 3];
        Console.WriteLine(grid.Rank == 2);
        Console.WriteLine(grid.Length == 6);
        Console.WriteLine(grid.GetLength(0) == 2 && grid.GetLength(1) == 3);
        Console.WriteLine(grid[0, 0] == 0 && grid[1, 2] == 0);

        grid[0, 0] = 1;
        grid[0, 1] = 2;
        grid[0, 2] = 3;
        grid[1, 0] = 4;
        grid[1, 1] = 5;
        grid[1, 2] = 6;
        Console.WriteLine(grid[0, 2] == 3 && grid[1, 0] == 4 && grid[1, 2] == 6);
        grid[0, 0] += 4;
        Console.WriteLine(grid[0, 0] == 5);

        int sum = 0;
        foreach (int value in grid)
            sum += value;
        Console.WriteLine(sum == 25);

        int[,,] cube = new int[2, 2, 2];
        cube[1, 0, 1] = 9;
        Console.WriteLine(cube.Rank == 3 && cube.Length == 8);
        Console.WriteLine(cube.GetLength(0) == 2 && cube.GetLength(1) == 2 && cube.GetLength(2) == 2);
        Console.WriteLine(cube[1, 0, 1] == 9 && cube[0, 0, 0] == 0);

        Cell[,] cells = new Cell[1, 2];
        cells[0, 0] = new Cell(7);
        cells[0, 1] = new Cell(8);
        Console.WriteLine(cells[0, 0].Value == 7 && cells[0, 1].Value == 8);

        Node[,] nodes = new Node[2, 2];
        nodes[0, 0] = new Node(10);
        nodes[1, 1] = new Node(20);
        GC.Collect();
        Console.WriteLine(nodes[0, 0].Value == 10 && nodes[1, 1].Value == 20);
        Console.WriteLine(nodes[0, 1] == null && nodes[1, 0] == null);

        Node[,] maybeNodes = nodes;
        Console.WriteLine(maybeNodes?[1, 1].Value == 20);
        maybeNodes = null;
        Console.WriteLine(maybeNodes?[1, 1] == null);

        Holder holder = new Holder(nodes);
        nodes = null;
        GC.Collect();
        Console.WriteLine(holder.Nodes[1, 1].Value == 20);

        Node[,] generic = MakePair<Node>(new Node(31), new Node(32));
        GC.Collect();
        Console.WriteLine(generic.Rank == 2 && generic[0, 0].Value == 31 && generic[0, 1].Value == 32);

        StaticNodes = new Node[1, 1];
        StaticNodes[0, 0] = new Node(41);
        GC.Collect();
        Console.WriteLine(StaticNodes[0, 0].Value == 41);

        int[,] same = grid;
        same[1, 2] = 99;
        Console.WriteLine(grid[1, 2] == 99);

        int[,] empty = new int[0, 4];
        Console.WriteLine(empty.Length == 0 && empty.GetLength(0) == 0 && empty.GetLength(1) == 4);

        bool[,] flags = new bool[2, 2];
        Console.WriteLine(!flags[0, 0] && !flags[1, 1]);

        int[] line = new int[3];
        Console.WriteLine(line.Rank == 1 && line.GetLength(0) == 3);

        int[,,,] hyper = new int[1, 1, 1, 1];
        hyper[0, 0, 0, 0] = 12;
        Console.WriteLine(hyper.Rank == 4 && hyper.Length == 1 && hyper[0, 0, 0, 0] == 12);

        int[,][] layers = new int[,][] { new int[1, 2], new int[2, 1] };
        layers[0][0, 1] = 61;
        layers[1][1, 0] = 62;
        Console.WriteLine(layers.Length == 2 && layers[0].Rank == 2 &&
            layers[0][0, 1] == 61 && layers[1][1, 0] == 62);

        int count = 0;
        foreach (Node node in generic)
        {
            if (node != null)
                count++;
        }
        Console.WriteLine(count == 2);
    }
}
