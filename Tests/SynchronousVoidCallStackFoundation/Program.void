namespace V
{
    public class Monster
    {
        public string Name;
    }

    public class Game
    {
        public void Run()
        {
            this.Loop();
        }

        private void Loop()
        {
            this.PlayerTurn();
        }

        private void PlayerTurn()
        {
            Monster monster = null;
            Console.WriteLine(monster.Name);
        }
    }
}

public static class Program
{
    public static void Main()
    {
        V.Game game = new V.Game();
        game.Run();
    }
}
