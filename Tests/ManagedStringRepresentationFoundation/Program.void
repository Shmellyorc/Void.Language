using Void;
using Void.Threading.Tasks;

public sealed class StringHolder
{
    public string Value;

    public StringHolder(string value)
    {
        Value = value;
    }
}

public sealed class Box<T>
{
    public T Value;

    public Box(T value)
    {
        Value = value;
    }
}

public struct StringPair
{
    public string Left;
    public string Right;

    public StringPair(string left, string right)
    {
        Left = left;
        Right = right;
    }
}

public static class Native291
{
    public static unsafe extern int strcmp(string left, string right);
}

public static class Program
{
    private static string StaticText = "static-root";

    private static Func<string> Capture(string value)
    {
        return () => value;
    }

    private static async Task<string> AwaitString(Task<string> task)
    {
        string held = "async-held";
        string value = await task;
        GC.Collect();
        if (held == "async-held")
            return value;
        return "async-lost";
    }

    public static unsafe void Main()
    {
        string local = "local-root";
        StringHolder holder = new StringHolder("field-root");
        string[] array = new string[] { "array-zero", "array-one" };
        Box<string> generic = new Box<string>("generic-root");
        StringPair pair = new StringPair("pair-left", "pair-right");
        Func<string> closure = Capture("closure-root");
        string embedded = "A\0B";
        TaskCompletionSource<string> source = new TaskCompletionSource<string>();
        Task<string> pending = AwaitString(source.Task);

        GC.Collect();
        GC.Collect();

        Console.WriteLine(local == "local-root");
        Console.WriteLine(holder.Value == "field-root");
        Console.WriteLine(array[1] == "array-one");
        Console.WriteLine(generic.Value == "generic-root");
        Console.WriteLine(pair.Left == "pair-left");
        Console.WriteLine(pair.Right == "pair-right");
        Console.WriteLine(closure() == "closure-root");
        Console.WriteLine(StaticText == "static-root");
        Console.WriteLine(embedded == embedded);
        Console.WriteLine(Native291.strcmp(local, "local-root") == 0);

        source.SetResult("async-result");
        pending.Wait();
        Console.WriteLine(pending.Result == "async-result");

        try
        {
            throw new Exception("exception-root");
        }
        catch (Exception error)
        {
            GC.Collect();
            Console.WriteLine(error.Message == "exception-root");
        }
    }
}
