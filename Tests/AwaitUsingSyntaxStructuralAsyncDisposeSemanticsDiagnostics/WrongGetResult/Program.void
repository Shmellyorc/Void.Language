using Void; using Void.Threading.Tasks; public struct A { public W GetAwaiter(){return default;} } public struct W { public bool IsCompleted { get { return true; } } public void OnCompleted(Action c){c();} public int GetResult(){return 1;} } public sealed class R { public A DisposeAsync(){return default;} } public static class Program { private static async Task M(){ await using (R r = new R()) { } } public static void Main(){} }
