using Void;
namespace Void.Threading.Tasks;

public struct TaskAwaiter
{
    public bool IsCompleted { get { return true; } }
    public void OnCompleted(Action continuation) { }
    public void GetResult() { }
}

public class Task
{
    public TaskAwaiter GetAwaiter() { return default; }
}

public struct ValueTaskAwaiter
{
    public bool IsCompleted { get { return true; } }
    public void OnCompleted(Action continuation) { }
    public void GetResult() { }
}

public readonly struct ValueTask
{
    public ValueTaskAwaiter GetAwaiter() { return default; }
}
