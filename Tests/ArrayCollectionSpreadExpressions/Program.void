using Void;

public struct Source364
{
    public int Value;
    public Source364(int value) { Value = value; }
    public static implicit operator Target364(Source364 value)
    { return new Target364(value.Value + 10); }
}

public struct Target364
{
    public int Value;
    public Target364(int value) { Value = value; }
}

public struct Meters364
{
    public int Value;
    public Meters364(int value) { Value = value; }
    public static implicit operator Meters364(int value) { return new Meters364(value); }
}

public sealed class Cell364<T>
{
    public T Value;
    public Cell364(T value) { Value = value; }
}

public sealed class Store364
{
    private int[] _items = [0, ..new[] { 1, 2 }, 3];
    private static int[] _static = [..new[] { 4, 5 }];
    public bool Check() { return _items.Length == 4 && _items[2] == 2 && _static[1] == 5; }
}

public static class Program
{
    private static int _counter;
    private static int Next() { _counter++; return _counter; }
    private static int[] Make() { _counter++; return [4, 5]; }
    private static int[] Take(int[] items) { return [..items]; }
    private static Cell364<int>[] AllocatingCells()
    {
        GC.Collect();
        return [new Cell364<int>(21)];
    }
    private static int Pick(int[] values) { return values.Length; }
    private static int Pick(string[] values) { return 100 + values.Length; }
    private static int Fail()
    {
        _counter++;
        throw new Exception("spread-failure");
    }
    public static void Main()
    {
        int[] first = [1, 2, 3];
        int[] second = [4, 5];
        int[] combined = [0, ..first, 10, ..second];
        Console.WriteLine(combined.Length == 7 && combined[0] == 0 && combined[3] == 3 && combined[4] == 10 && combined[6] == 5);
        int[] copy = [..first];
        copy[0] = 90;
        Console.WriteLine(first[0] == 1 && copy[0] == 90);
        int[] empty = [];
        int[] emptyCopy = [..empty];
        int[] mixedEmpty = [1, ..empty, 2]; Console.WriteLine(emptyCopy.Length == 0 && mixedEmpty.Length == 2);
        int[][] groups = [[1, 2], [3, 4]];
        int[][] groupCopy = [..groups];
        Console.WriteLine(groupCopy.Length == 2 && groupCopy[0] == groups[0]);
        long[] widened = [..first];
        Console.WriteLine(widened[2] == 3);
        Meters364[] converted = [..first];
        Console.WriteLine(converted.Length == 3 && converted[0].Value == 1 && converted[2].Value == 3);
        Source364?[] nullableSource = [new Source364(1), null, new Source364(3)];
        Target364?[] nullableDest = [..nullableSource];
        Console.WriteLine(nullableDest.Length == 3 && nullableDest[0].Value.Value == 11 &&
            !nullableDest[1].HasValue && nullableDest[2].Value.Value == 13);
        int[][] nestedSpreads = [[..first], [..second]];
        Console.WriteLine(nestedSpreads[0].Length == 3 && nestedSpreads[1][1] == 5);
        Console.WriteLine(Pick([0, ..first]) == 4 && Pick(["x", ..new[] { "y" }]) == 102);
        string[] stringValues = ["prefix", ..new[] { "a", "b" }];
        Console.WriteLine(stringValues.Length == 3 && stringValues[2] == "b");
        object[] objects = [..stringValues];
        GC.Collect();
        Console.WriteLine(objects.Length == 3 && objects[0] != null);
        Cell364<int>[] survived = [new Cell364<int>(20), ..AllocatingCells(), new Cell364<int>(22)];
        GC.Collect();
        Console.WriteLine(survived[0].Value == 20 && survived[1].Value == 21 && survived[2].Value == 22);
        int[] fromRange = [..first[1..3]];
        Console.WriteLine(fromRange.Length == 2 && fromRange[0] == 2 && fromRange[^1] == 3);
        Cell364<int>[] refs = [new Cell364<int>(12), new Cell364<int>(13)];
        Cell364<int>[] refCopy = [..refs, new Cell364<int>(14)];
        GC.Collect();
        Console.WriteLine(refCopy.Length == 3 && refCopy[0].Value == 12 && refCopy[2].Value == 14);
        Console.WriteLine(new Store364().Check());
        int[] result = Take([9, ..first]);
        Console.WriteLine(result[0] == 9 && result.Length == 4);
        _counter = 0;
        int[] ordered = [Next(), ..Make(), Next()];
        Console.WriteLine(_counter == 3 && ordered[0] == 1 && ordered[1] == 4 && ordered[2] == 5 && ordered[3] == 3);
        _counter = 0;
        bool caught = false;
        try
        {
            int[] unused = [Next(), ..Make(), Fail()];
            Console.WriteLine(unused.Length == 0);
        }
        catch (Exception error)
        {
            caught = error.Message == "spread-failure" && _counter == 3;
        }
        Console.WriteLine(caught && _counter == 3);
    }
}
