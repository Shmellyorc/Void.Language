using Void;

public struct Cell361
{
    public int Value;
    public Cell361(int value) { Value = value; }
}

public struct Measure361
{
    public int Value;
    public Measure361(int value) { Value = value; }
    public static implicit operator Measure361(int value) { return new Measure361(value); }
}

public sealed class Box361<T>
{
    public T Value;
    public Box361(T value) { Value = value; }
}

public sealed class Holder361
{
    private int[] _numbers = { 10, 20, 30 };
    private string[] _labels = { "first", "second" };
    private int[,] _grid = { { 1, 2 }, { 3, 4 } };
    private int[] _empty = {};
    private static int[] _static = { 40, 50 };
    private static string[] _staticEmpty = {};

    public bool Verify()
    {
        return _numbers[1] == 20 && _labels[0] == "first" &&
            _grid[1, 0] == 3 && _empty.Length == 0 &&
            _static[1] == 50 && _staticEmpty.Length == 0;
    }
}

public static class Program
{
    private static int _next;
    private static int[] _field = { 71, 72 };
    private static int[,] _rect = { { 81, 82 }, { 83, 84 } };

    private static int Next()
    {
        _next++;
        return _next;
    }

    private static Box361<int> BoxAndCollect(int value)
    {
        GC.Collect();
        return new Box361<int>(value);
    }

    public static void Main()
    {
        int[] a = { 1, 2, 3 };
        Console.WriteLine(a.Length == 3 && a[0] == 1 && a[2] == 3);
        string[] strings = { "Alice", "Bob" };
        Console.WriteLine(strings.Length == 2 && strings[1] == "Bob");
        bool[] flags = { true, false, true };
        Console.WriteLine(flags[0] && !flags[1] && flags[2]);
        int[] empty = {};
        string[] emptyStrings = {};
        Console.WriteLine(empty != null && empty.Length == 0);
        Console.WriteLine(emptyStrings != null && emptyStrings.Length == 0);
        long[] extended = { 1, 2, 3 };
        Console.WriteLine(extended.Length == 3 && extended[2] == 3L);
        Measure361[] measures = { 7, 8 };
        Console.WriteLine(measures[0].Value == 7 && measures[1].Value == 8);
        Cell361[] cells = { new Cell361(11), new Cell361(12) };
        Console.WriteLine(cells[0].Value == 11 && cells[1].Value == 12);
        int[][] jagged = { new[] { 1, 2 }, new int[] { 3 } };
        Console.WriteLine(jagged.Length == 2 && jagged[0][1] == 2 && jagged[1][0] == 3);
        int[,] rectangular = { { 1, 2, 3 }, { 4, 5, 6 } };
        Console.WriteLine(rectangular.Rank == 2 && rectangular.Length == 6);
        Console.WriteLine(rectangular.GetLength(0) == 2 && rectangular.GetLength(1) == 3);
        Console.WriteLine(rectangular[1, 2] == 6);
        int[,,] deep = { { { 1, 2 } }, { { 3, 4 } } };
        Console.WriteLine(deep.Rank == 3 && deep[1, 0, 1] == 4);
        int[,] emptyRect = {};
        Console.WriteLine(emptyRect.Rank == 2 && emptyRect.Length == 0);
        int[,] zeroWidth = { {}, {} };
        Console.WriteLine(zeroWidth.GetLength(0) == 2 && zeroWidth.GetLength(1) == 0);
        Box361<int>[] boxes = { new Box361<int>(21), BoxAndCollect(22) };
        GC.Collect();
        Console.WriteLine(boxes.Length == 2 && boxes[0].Value == 21 && boxes[1].Value == 22);
        Box361<int>[] emptyGeneric = {};
        Console.WriteLine(emptyGeneric.Length == 0);
        Box361<int>[,] genericRect = { { BoxAndCollect(31), BoxAndCollect(32) } };
        GC.Collect();
        Console.WriteLine(genericRect[0, 0].Value == 31 && genericRect[0, 1].Value == 32);
        _next = 0;
        int[] order = { Next(), Next(), Next() };
        Console.WriteLine(_next == 3 && order[0] == 1 && order[1] == 2 && order[2] == 3);
        _next = 0;
        int[,] rectOrder = { { Next(), Next() }, { Next(), Next() } };
        Console.WriteLine(_next == 4 && rectOrder[1, 1] == 4);
        Console.WriteLine(new Holder361().Verify());
        Console.WriteLine(_field[0] == 71 && _rect[1, 1] == 84);
        int[] inferred = new[] { 100, 101 };
        int[] explicitArray = new int[] { 102, 103 };
        Console.WriteLine(inferred[1] == 101 && explicitArray[0] == 102);
    }
}
