using Void;
using Void.Threading.Tasks;

public struct IntAwaiter271
{
    public bool IsCompleted { get { return true; } }
    public void OnCompleted(Action continuation) { }
    public int GetResult() { return 271; }
}

public struct IntAwaitable271
{
    public IntAwaiter271 GetAwaiter() { return default; }
}

public struct VoidAwaiter271
{
    public bool IsCompleted { get { return true; } }
    public void OnCompleted(Action continuation) { }
    public void GetResult() { }
}

public struct VoidAwaitable271
{
    public VoidAwaiter271 GetAwaiter() { return default; }
}

public static class Program
{
    public static void Main()
    {
        Func<Task> taskVoid = async () =>
        {
            await new VoidAwaitable271();
            return;
        };

        Func<Task<int>> taskResult = async () =>
        {
            int value = await new IntAwaitable271();
            return value;
        };

        Func<int, Task<int>> taskParameter = async (value) =>
        {
            await new VoidAwaitable271();
            return value;
        };

        Func<ValueTask> valueTaskVoid = async () =>
        {
            await new VoidAwaitable271();
            return;
        };

        Func<int, ValueTask<int>> valueTaskResult = async value =>
        {
            int extra = await new IntAwaitable271();
            return value + extra;
        };

        Func<Task<int>> expressionTask = async () => 271;
        Func<int, int> ordinary = value => value + 1;
        Func<int, int> namedAsync = async => async + 1;

        taskVoid;
        taskResult;
        taskParameter;
        valueTaskVoid;
        valueTaskResult;
        expressionTask;
        ordinary;
        namedAsync;
    }
}
