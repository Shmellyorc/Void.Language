using Void.Threading.Tasks;

public sealed class BadEnumerator269
{
    public int Current => 1;
    public ValueTask<int> MoveNextAsync() { return new ValueTask<int>(1); }
    public ValueTask DisposeAsync() { return default; }
}

public sealed class BadEnumerable269
{
    public BadEnumerator269 GetAsyncEnumerator() { return new BadEnumerator269(); }
}

public static class Program
{
    private static async ValueTask Run()
    {
        await foreach (var value in new BadEnumerable269()) { }
    }

    public static void Main() { }
}
