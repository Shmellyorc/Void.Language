using Void;
using Void.Collections;

public interface IToInt<T>
{
    static implicit operator int(T value);
}

public interface IFromInt<T>
{
    static implicit operator T(int value);
}

public interface IExplicitToInt<T>
{
    static explicit operator int(T value);
}

public interface IToPayload<T>
{
    static implicit operator Payload(T value);
}

public struct Number : IToInt<Number>, IFromInt<Number>
{
    public int Value;

    public Number(int value)
    {
        Value = value;
    }

    public static implicit operator int(Number value)
    {
        return value.Value;
    }

    public static implicit operator Number(int value)
    {
        return new Number(value + 100);
    }
}

public struct ExplicitNumber : IExplicitToInt<ExplicitNumber>
{
    public int Value;

    public ExplicitNumber(int value)
    {
        Value = value;
    }

    public static explicit operator int(ExplicitNumber value)
    {
        return value.Value;
    }
}

public sealed class Payload
{
    public int Value;

    public Payload(int value)
    {
        Value = value;
    }
}

public sealed class ManagedSource : IToPayload<ManagedSource>
{
    public Payload Payload;
    public bool Fail;

    public ManagedSource(Payload payload, bool fail)
    {
        Payload = payload;
        Fail = fail;
    }

    public static implicit operator Payload(ManagedSource value)
    {
        Program.ConversionCalls++;
        if (value.Fail)
            throw new ConversionError("conversion", 159);
        return value.Payload;
    }
}

public sealed class ConversionError : Exception
{
    public int Code;

    public ConversionError(string message, int code) : base(message)
    {
        Code = code;
    }
}

public sealed class Resource : IDisposable
{
    public int Id;

    public Resource(int id)
    {
        Id = id;
        Program.ResourceCount++;
    }

    public void Dispose()
    {
        GC.Collect();
        Program.DisposeCount++;
    }
}

public sealed class GenericSequence<T> where T : IToInt<T>
{
    private T _value;

    public GenericSequence(T value)
    {
        _value = value;
    }

    public IEnumerator<int> Values()
    {
        Func<int> getter = () => _value;
        yield return 3;
        GC.Collect();
        yield return getter();
    }
}

public static class Program
{
    public static int ConversionCalls;
    public static int FinallyCount;
    public static int DisposeCount;
    public static int ResourceCount;

    private static IEnumerator<int> ImplicitValues<T>(T first, T second) where T : IToInt<T>
    {
        var copy = first;
        Func<int> getter = () => copy;
        yield return 1;
        GC.Collect();
        yield return getter();
        copy = second;
        GC.Collect();
        yield return getter();
    }

    private static IEnumerator<T> TargetValues<T>(int first, int second) where T : IFromInt<T>
    {
        Func<T> maker = () => first;
        yield return maker();
        first = second;
        GC.Collect();
        yield return maker();
    }

    private static IEnumerator<int> ExplicitValues<T>(T value) where T : IExplicitToInt<T>
    {
        var copy = value;
        Func<int> getter = () => (int)copy;
        yield return 2;
        GC.Collect();
        yield return getter();
    }

    private static Func<int> MakeGetter<T>(T value) where T : IToInt<T>
    {
        var copy = value;
        return () => copy;
    }

    private static Func<Payload> MakePayloadGetter<T>(T value) where T : IToPayload<T>
    {
        var copy = value;
        return () => copy;
    }

    private static IEnumerator<int> ManagedValues<T>(T value) where T : IToPayload<T>
    {
        var copy = value;
        Func<Payload> getter = () => copy;
        yield return 4;
        GC.Collect();
        Payload payload = getter();
        yield return payload.Value;
    }

    private static IEnumerator<int> FaultValues<T>(T value) where T : IToPayload<T>
    {
        var copy = value;
        Func<Payload> getter = () => copy;
        using (Resource resource = new Resource(7))
        {
            try
            {
                yield return resource.Id;
                GC.Collect();
                Payload payload = getter();
                yield return payload.Value;
            }
            finally
            {
                GC.Collect();
                Program.FinallyCount++;
            }
        }
    }

    private static IEnumerator<int> DisposeValues<T>(T value) where T : IToPayload<T>
    {
        var copy = value;
        Func<Payload> getter = () => copy;
        using (Resource resource = new Resource(8))
        {
            try
            {
                yield return resource.Id;
                GC.Collect();
                Payload payload = getter();
                yield return payload.Value;
            }
            finally
            {
                GC.Collect();
                Program.FinallyCount++;
            }
        }
    }

    public static void Main()
    {
        IEnumerator<int> implicitValues = ImplicitValues<Number>(new Number(10), new Number(20));
        Console.WriteLine(implicitValues.MoveNext() && implicitValues.Current == 1);
        Console.WriteLine(implicitValues.MoveNext() && implicitValues.Current == 10);
        Console.WriteLine(implicitValues.MoveNext() && implicitValues.Current == 20);
        Console.WriteLine(!implicitValues.MoveNext());

        IEnumerator<Number> targetValues = TargetValues<Number>(5, 6);
        Console.WriteLine(targetValues.MoveNext() && targetValues.Current.Value == 105);
        Console.WriteLine(targetValues.MoveNext() && targetValues.Current.Value == 106);
        Console.WriteLine(!targetValues.MoveNext());

        IEnumerator<int> explicitValues = ExplicitValues<ExplicitNumber>(new ExplicitNumber(31));
        Console.WriteLine(explicitValues.MoveNext() && explicitValues.Current == 2);
        Console.WriteLine(explicitValues.MoveNext() && explicitValues.Current == 31);
        Console.WriteLine(!explicitValues.MoveNext());

        IEnumerator<int> ownerValues = new GenericSequence<Number>(new Number(32)).Values();
        Console.WriteLine(ownerValues.MoveNext() && ownerValues.Current == 3);
        GC.Collect();
        Console.WriteLine(ownerValues.MoveNext() && ownerValues.Current == 32);
        Console.WriteLine(!ownerValues.MoveNext());

        Func<int> getter = MakeGetter<Number>(new Number(33));
        GC.Collect();
        Console.WriteLine(getter() == 33);

        ConversionCalls = 0;
        Func<Payload> payloadGetter = MakePayloadGetter<ManagedSource>(
            new ManagedSource(new Payload(41), false));
        GC.Collect();
        Payload closurePayload = payloadGetter();
        Console.WriteLine(closurePayload.Value == 41);
        Console.WriteLine(ConversionCalls == 1);

        ConversionCalls = 0;
        IEnumerator<int> managed = ManagedValues<ManagedSource>(
            new ManagedSource(new Payload(42), false));
        Console.WriteLine(managed.MoveNext() && managed.Current == 4);
        GC.Collect();
        Console.WriteLine(managed.MoveNext() && managed.Current == 42);
        Console.WriteLine(ConversionCalls == 1);
        Console.WriteLine(!managed.MoveNext());

        ConversionCalls = 0;
        FinallyCount = 0;
        DisposeCount = 0;
        ResourceCount = 0;
        IEnumerator<int> fault = FaultValues<ManagedSource>(
            new ManagedSource(new Payload(50), true));
        Console.WriteLine(fault.MoveNext() && fault.Current == 7);
        bool caught = false;
        try
        {
            fault.MoveNext();
        }
        catch (ConversionError error)
        {
            caught = error.Code == 159;
        }
        Console.WriteLine(caught);
        Console.WriteLine(ConversionCalls == 1);
        Console.WriteLine(FinallyCount == 1);
        Console.WriteLine(DisposeCount == 1);
        Console.WriteLine(ResourceCount == 1);
        Console.WriteLine(!fault.MoveNext());

        ConversionCalls = 0;
        FinallyCount = 0;
        DisposeCount = 0;
        ResourceCount = 0;
        IEnumerator<int> disposed = DisposeValues<ManagedSource>(
            new ManagedSource(new Payload(60), false));
        Console.WriteLine(disposed.MoveNext() && disposed.Current == 8);
        GC.Collect();
        disposed.Dispose();
        Console.WriteLine(ConversionCalls == 0);
        Console.WriteLine(FinallyCount == 1);
        Console.WriteLine(DisposeCount == 1);
        Console.WriteLine(ResourceCount == 1);
        Console.WriteLine(!disposed.MoveNext());
    }
}
