using Void;
using Void.Threading;
using Void.Threading.Tasks;

public sealed class AuditBoundaryResource290
{
    public static int DisposeCount;

    public async ValueTask DisposeAsync()
    {
        await Task.Delay(5);
        DisposeCount++;
    }
}

public static class AuditBoundary290
{
    private static async Task<int> Compute(int value)
    {
        await using var resource = new AuditBoundaryResource290();
        CancellationTokenSource parent = new CancellationTokenSource();
        CancellationTokenSource deadline = new CancellationTokenSource();
        deadline.CancelAfter(500);
        CancellationTokenSource linked = CancellationTokenSource.CreateLinkedTokenSource(parent.Token, deadline.Token);
        Task<int> work = Task.Run<int>(async () =>
        {
            await Task.Delay(10, linked.Token);
            return value + 1;
        });
        int result = await work.WaitAsync(250, linked.Token);
        linked.Dispose();
        parent.Dispose();
        deadline.Dispose();
        return result;
    }

    [Export("void290_async_timing_cancellation_audit")]
    public static int Run(int value)
    {
        AuditBoundaryResource290.DisposeCount = 0;
        int result = Compute(value).Result;
        int disposed = AuditBoundaryResource290.DisposeCount;
        ThreadPool.Shutdown();
        return result == 42 && disposed == 1 ? 42 : -1;
    }
}
