public sealed class Item
{
    public int Value;

    public Item(int value)
    {
        Value = value;
    }
}

public interface IBox<T>
{
    T Get();
}

public sealed class Box<T> : IBox<T>
{
    public T Value { get; set; }

    public Box(T value)
    {
        Value = value;
    }

    public T Get()
    {
        return Value;
    }
}

public struct Pair<T>
{
    public T First;
    public T Second;

    public Pair(T first, T second)
    {
        First = first;
        Second = second;
    }
}

public struct Duo<TLeft, TRight>
{
    public TLeft Left;
    public TRight Right;

    public Duo(TLeft left, TRight right)
    {
        Left = left;
        Right = right;
    }
}

public sealed class Buffer<T>
{
    private T[] _items;

    public Buffer(int count)
    {
        _items = new T[count];
    }

    public void Set(int index, T value)
    {
        _items[index] = value;
    }

    public T Get(int index)
    {
        return _items[index];
    }
}

public static class Program
{
    public static T Identity<T>(T value)
    {
        return value;
    }

    public static void Main()
    {
        Box<int> number = new Box<int>(42);
        Console.WriteLine(number.Get());
        IBox<int> numberInterface = number;
        Console.WriteLine(numberInterface.Get());

        Box<Box<int>> nested = new Box<Box<int>>(number);
        Box<int> inner = nested.Get();
        Console.WriteLine(inner.Get());

        Duo<int, float> duo = new Duo<int, float>(8, 2f);
        Console.WriteLine(duo.Left);
        Console.WriteLine(duo.Right);

        Pair<float> pair = new Pair<float>(3f, 4f);
        Console.WriteLine(pair.First);
        Console.WriteLine(pair.Second);

        Buffer<int> values = new Buffer<int>(3);
        values.Set(0, 10);
        values.Set(1, 20);
        Console.WriteLine(values.Get(0) + values.Get(1));

        Item item = new Item(77);
        Box<Item> holder = new Box<Item>(item);
        Buffer<Item> items = new Buffer<Item>(1);
        items.Set(0, item);
        item = null;

        Console.WriteLine(Identity<int>(9));
        Item identityItem = Identity<Item>(holder.Get());
        Console.WriteLine(identityItem.Value);

        GC.Collect();
        Console.WriteLine(numberInterface.Get());
        Console.WriteLine(holder.Get().Value);
        Console.WriteLine(items.Get(0).Value);
    }
}
