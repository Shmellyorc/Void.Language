using Void;
public delegate int InvalidCallback301([NativeString(NativeStringKind.BorrowedPointerLength)] string text);
public static class Native301InvalidCallback
{
    [Native("void301_call_invalid_view")]
    public static unsafe extern int Call(InvalidCallback301 callback);
}
public static class Program
{
    private static int Check(string text) { return text == null ? 0 : 1; }
    public static unsafe void Main() { Console.WriteLine(Native301InvalidCallback.Call(Check)); }
}
