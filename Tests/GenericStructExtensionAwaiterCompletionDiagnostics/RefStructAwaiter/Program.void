using Void;
using Void.Threading.Tasks;

public ref struct RefAwaiter264
{
    public bool IsCompleted { get { return false; } }
    public void OnCompleted(Action continuation) { continuation(); }
    public int GetResult() { return 1; }
}

public struct RefAwaitable264
{
    public RefAwaiter264 GetAwaiter() { return default(RefAwaiter264); }
}

public static class Program
{
    private static async Task<int> Run()
    {
        return await new RefAwaitable264();
    }

    public static void Main() { }
}
