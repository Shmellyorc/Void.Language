using Void;
using Void.Threading.Tasks;

public struct Awaiter264
{
    public bool IsCompleted { get { return true; } }
    public void OnCompleted(Action continuation) { continuation(); }
    public int GetResult() { return 1; }
}

public struct Awaitable264 { }

namespace HiddenAwaitExtensions264
{
    public static class Extensions264
    {
        public static Awaiter264 GetAwaiter(this Awaitable264 value) { return default(Awaiter264); }
    }
}

public static class Program
{
    private static async Task<int> Run() { return await new Awaitable264(); }
    public static void Main() { }
}
