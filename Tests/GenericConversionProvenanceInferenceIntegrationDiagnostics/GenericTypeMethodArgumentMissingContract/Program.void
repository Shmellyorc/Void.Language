public interface IMarker<T> { }
public struct Number : IMarker<Number>
{
    public int Value;
    public Number(int value) { Value = value; }
    public static implicit operator int(Number value) { return value.Value; }
    public static implicit operator Number(int value) { return new Number(value); }
}
public sealed class Box<T>
{
    public T Value;
    public Box(T value) { Value = value; }
    public void Accept(T value) { Value = value; }
}
public static class Program
{
    private static void Bad<T>(Box<T> box) where T : IMarker<T> { box.Accept(1); }
    public static void Main()
    {
        Box<Number> concrete = new Box<Number>(new Number(1));
        Bad<Number>(concrete);
    }
}
