using Void;
using Void.Collections;
using Void.Threading.Tasks;

public sealed class Node368<T>
{
    public T Value;
    public Node368(T value) { Value = value; }
}
public class ParentBag368<T>
{
    public List<T> Values = new List<T>();
    public virtual void Add(T item) { GC.Collect(); Values.Add(item); }
}
public sealed class ChildBag368<T> : ParentBag368<T>
{
    public override void Add(T item) { base.Add(item); }
}
public sealed class Owner368
{
    public List<int> Items = [3, 4];
    public static int[][] Groups = [[1], [], [2, 3]];
    public int[] Make(int[] source) { return [0, ..source, 9]; }
}
public interface IReader368
{
    int Read(int[] values);
}
public class BaseReader368
{
    public virtual int Read(int[] values) { return values.Length; }
}
public sealed class Reader368 : BaseReader368, IReader368
{
    public override int Read(int[] values) { return values[0] + values[1]; }
}
public sealed class FailingBag368
{
    public static int AddCalls;
    public void Add(int value)
    {
        AddCalls++;
        GC.Collect();
        if (value == 2) throw new Exception("insert-368");
    }
}
public static class Program
{
    private static int _counter;
    private static int Next() { _counter++; return _counter; }
    private static int[] MakeSource() { _counter++; return [20, 21]; }
    private static Node368<int> MakeNode(int value) { GC.Collect(); return new Node368<int>(value); }
    private static T[] Extend<T>(T[] existing, T item) { return [..existing, item]; }
    private static ChildBag368<T> MakeBag<T>(T first, T second) { return [first, second]; }
    private static int Pick(int[] values) { return 1; }
    private static int Pick(List<string> values) { return 2; }
    private static int Pick(List<int> values) { return 3; }
    private static int Apply(Func<int[], int> callback, int[] values) { return callback(values); }
    private static int SumArray(int[] values) { return values[0] + values[1]; }
    private static Func<int> CaptureArray(int[] existing)
    {
        int[] copied = [..existing, 17];
        return () => copied[0] + copied[2];
    }
    private static IEnumerator<int> Sequence(int[] existing)
    {
        int[] before = [0, ..existing];
        yield return before[1];
        List<int> after = [..existing, 7];
        yield return after[2];
    }
    private static async IAsyncEnumerable<int> AsyncSequence(int[] existing, Task<int> gate)
    {
        int[] before = [..existing, 9];
        yield return before[0];
        int value = await gate;
        List<int> after = [value, ..existing];
        yield return after[0] + after[2];
    }
    private static async Task<int> AfterAwait(int[] source, Task<int> gate)
    {
        Node368<int>[] refs = [MakeNode(12), MakeNode(13)];
        List<Node368<int>> before = [..refs];
        int value = await gate;
        GC.Collect();
        int[] after = [value, ..source];
        return before[0].Value + before[1].Value + after[0] + after[2];
    }
    private static Func<Task<int>> AsyncClosure(int[] source)
    {
        return async () =>
        {
            int[] before = [..source, 2];
            TaskCompletionSource<int> gate = new TaskCompletionSource<int>();
            gate.SetResult(4);
            int value = await gate.Task;
            List<int> after = [value, ..before];
            return after[0] + after[1] + after[3];
        };
    }
    private static int _finallyCount;
    private static int _added;
    private static int FailValue()
    {
        throw new Exception("element-368");
    }
    private static int NextFailed()
    {
        _added++;
        return _added;
    }
    private static int FailConstruction()
    {
        int[] source = [1, 2];
        try
        {
            int[] unused = [NextFailed(), ..source, FailValue(), NextFailed()];
            return unused.Length;
        }
        catch (Exception ex)
        {
            return ex.Message == "element-368" ? _added : -100;
        }
        finally
        {
            _finallyCount++;
        }
    }
    private static int Sum(ReadOnlySpan<int> values)
    {
        int total = 0;
        for (int i = 0; i < values.Length; i++) total += values[i];
        return total;
    }
    public static void Main()
    {
        int[][] nested = [[1,2], [], [3,4,5]];
        Console.WriteLine(nested.Length == 3 && nested[0][1] == 2 && nested[1].Length == 0 && nested[2][2] == 5);
        string[][] strings = [["a", "b"], ["c"]];
        Console.WriteLine(strings[0][1] == "b" && strings[1][0] == "c");
        Node368<int>[][] managed = [[MakeNode(1)], [MakeNode(2), MakeNode(3)]];
        GC.Collect();
        Console.WriteLine(managed[0][0].Value == 1 && managed[1][1].Value == 3);
        List<int>[] collections = [[1, 2], [], [3]];
        Console.WriteLine(collections[0].Count == 2 && collections[1].Count == 0 && collections[2][0] == 3);
        ChildBag368<int>[] nestedBags = [[8, 9], []];
        Console.WriteLine(nestedBags.Length == 2 && nestedBags[0].Values[1] == 9 &&
            nestedBags[1].Values.Count == 0);
        int[] source = [6, 7];
        int[] extended = Extend<int>(source, 8);
        Console.WriteLine(extended.Length == 3 && extended[0] == 6 && extended[2] == 8);
        Node368<int>[] nodes = [new Node368<int>(4)];
        Node368<int>[] extendedNodes = Extend<Node368<int>>(nodes, MakeNode(5));
        GC.Collect();
        Console.WriteLine(extendedNodes[0].Value == 4 && extendedNodes[1].Value == 5);
        ChildBag368<string> bag = MakeBag<string>("x", "y");
        Console.WriteLine(bag.Values.Count == 2 && bag.Values[1] == "y");
        Owner368 owner = new Owner368();
        Console.WriteLine(owner.Items[0] == 3 && Owner368.Groups[2][1] == 3 && owner.Make(source)[3] == 9);
        Reader368 concrete = new Reader368();
        IReader368 interfaceReader = concrete;
        BaseReader368 baseReader = concrete;
        Console.WriteLine(interfaceReader.Read([4, 5]) == 9 && baseReader.Read([6, 7]) == 13);
        Console.WriteLine(Pick([1,2]) == 1 && Pick(["x"]) == 2);
        Func<int[], int> callback = SumArray;
        Console.WriteLine(Apply(callback, [11, 12]) == 23);
        Func<int> closure = CaptureArray([8, 9]);
        GC.Collect();
        Console.WriteLine(closure() == 25);
        _counter = 0;
        int[] ordered = [Next(), ..MakeSource(), Next()];
        Console.WriteLine(_counter == 3 && ordered[0] == 1 && ordered[1] == 20 && ordered[3] == 3);
        IEnumerator<int> iter = Sequence([10, 11]);
        Console.WriteLine(iter.MoveNext() && iter.Current == 10);
        GC.Collect();
        Console.WriteLine(iter.MoveNext() && iter.Current == 7 && !iter.MoveNext());
        iter.Dispose();
        TaskCompletionSource<int> gate = new TaskCompletionSource<int>();
        Task<int> pending = AfterAwait(source, gate.Task);
        Console.WriteLine(!pending.IsCompleted);
        GC.Collect();
        gate.SetResult(20);
        Console.WriteLine(pending.Result == 52);
        TaskCompletionSource<int> asyncGate = new TaskCompletionSource<int>();
        IAsyncEnumerator<int> asyncIter = AsyncSequence([3, 4], asyncGate.Task).GetAsyncEnumerator();
        Console.WriteLine(asyncIter.MoveNextAsync().Result && asyncIter.Current == 3);
        asyncGate.SetResult(10);
        Console.WriteLine(asyncIter.MoveNextAsync().Result && asyncIter.Current == 14);
        Console.WriteLine(!asyncIter.MoveNextAsync().Result);
        asyncIter.DisposeAsync().Wait();
        Func<Task<int>> asyncClosure = AsyncClosure([5, 6]);
        Console.WriteLine(asyncClosure().Result == 11);
        _added = 0;
        _finallyCount = 0;
        Console.WriteLine(FailConstruction() == 1 && _added == 1 && _finallyCount == 1);
        _added = 0;
        FailingBag368.AddCalls = 0;
        bool addCaught = false;
        try
        {
            FailingBag368 partiallyBuilt = [NextFailed(), 2, NextFailed()];
            Console.WriteLine(partiallyBuilt == null);
        }
        catch (Exception ex) { addCaught = ex.Message == "insert-368"; }
        Console.WriteLine(addCaught && _added == 1 && FailingBag368.AddCalls == 2);
        Span<int> span = [5, 6];
        GC.Collect();
        Console.WriteLine(Sum([..source, span[0]]) == 18 && span[1] == 6);
    }
}
