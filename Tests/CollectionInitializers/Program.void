using Void.Collections;

public sealed class Node
{
    public int Value;

    public Node(int value)
    {
        Value = value;
    }
}

public struct Damage
{
    public int Value;

    public Damage(int value)
    {
        Value = value;
    }

    public static implicit operator Damage(int value)
    {
        return new Damage(value);
    }
}

public sealed class Bag
{
    public int Total;

    public void Add(int value, int bonus = 1)
    {
        Total += value + bonus;
    }
}

public sealed class ParamsBag
{
    public int Total;

    public void Add(int first, params int[] rest)
    {
        Total += first;
        for (int i = 0; i < rest.Length; i++)
            Total += rest[i];
    }
}

public sealed class OrderProbe
{
    private int _order;

    public int Next(int expected)
    {
        _order++;
        Console.WriteLine(_order == expected);
        return expected * 10;
    }
}

public static class Program
{
    public static Node MakeNode(int value, bool collect = false)
    {
        if (collect)
            GC.Collect();
        return new Node(value);
    }

    public static void Main()
    {
        int[] explicitArray = new int[] { 10, 20, 30 };
        Console.WriteLine(explicitArray.Length == 3);
        Console.WriteLine(explicitArray[0] == 10);
        Console.WriteLine(explicitArray[2] == 30);

        var inferredArray = new[] { 4, 5, 6 };
        Console.WriteLine(inferredArray.Length == 3);
        Console.WriteLine(inferredArray[1] == 5);

        int[] emptyArray = new int[] { };
        Console.WriteLine(emptyArray.Length == 0);

        int[] targetEmptyArray = new[] { };
        Console.WriteLine(targetEmptyArray.Length == 0);

        int[] defaultArray = new int[] { default, 2 };
        Console.WriteLine(defaultArray[0] == 0);
        Console.WriteLine(defaultArray[1] == 2);

        int?[] nullableArray = new int?[] { 1, null, 3 };
        Console.WriteLine(nullableArray.Length == 3);
        Console.WriteLine(nullableArray[0].Value == 1);
        Console.WriteLine(!nullableArray[1].HasValue);
        Console.WriteLine(nullableArray[2].Value == 3);

        OrderProbe probe = new OrderProbe();
        int[] ordered = new int[] { probe.Next(1), probe.Next(2), probe.Next(3) };
        Console.WriteLine(ordered[0] == 10);
        Console.WriteLine(ordered[1] == 20);
        Console.WriteLine(ordered[2] == 30);

        Node[] managedArray = new Node[]
        {
            MakeNode(11),
            MakeNode(22, true)
        };
        GC.Collect();
        Console.WriteLine(managedArray[0].Value == 11);
        Console.WriteLine(managedArray[1].Value == 22);

        List<int> values = new List<int> { 1, 2, 3 };
        Console.WriteLine(values.Count == 3);
        Console.WriteLine(values[0] == 1);
        Console.WriteLine(values[2] == 3);

        List<int> targetTyped = new() { 4, 5, 6 };
        Console.WriteLine(targetTyped.Count == 3);
        Console.WriteLine(targetTyped[1] == 5);

        HashSet<int> numberSet = new HashSet<int> { 7, 7, 8 };
        Console.WriteLine(numberSet.Count == 2);
        Console.WriteLine(numberSet.Contains(7));
        Console.WriteLine(numberSet.Contains(8));

        Dictionary<string, int> dictionary = new Dictionary<string, int>
        {
            { "one", 1 },
            { "two", 2 }
        };
        Console.WriteLine(dictionary.Count == 2);
        Console.WriteLine(dictionary["one"] == 1);
        Console.WriteLine(dictionary["two"] == 2);

        List<Damage> converted = new List<Damage> { 9, 12 };
        Console.WriteLine(converted.Count == 2);
        Console.WriteLine(converted[0].Value == 9);
        Console.WriteLine(converted[1].Value == 12);

        Damage[] convertedArray = new Damage[] { 14, 15 };
        Console.WriteLine(convertedArray[0].Value == 14);
        Console.WriteLine(convertedArray[1].Value == 15);

        Bag bag = new Bag
        {
            { 10 },
            { 20, 5 }
        };
        Console.WriteLine(bag.Total == 36);

        ParamsBag paramsBag = new ParamsBag
        {
            { 1, 2, 3 },
            { 4 }
        };
        Console.WriteLine(paramsBag.Total == 10);

        List<Node> retained = new List<Node>
        {
            MakeNode(31),
            MakeNode(32, true)
        };
        GC.Collect();
        Console.WriteLine(retained[0].Value == 31);
        Console.WriteLine(retained[1].Value == 32);
    }
}
