using Void.Collections;
using Void.Threading;
using Void.Threading.Tasks;

public sealed class BadEnumerator218
{
    public int Current { get { return 1; } }
    public Task<int> MoveNextAsync()
    {
        TaskCompletionSource<int> source = new TaskCompletionSource<int>();
        source.SetResult(0);
        return source.Task;
    }
    public Task DisposeAsync()
    {
        TaskCompletionSource source = new TaskCompletionSource();
        source.SetResult();
        return source.Task;
    }
}

public sealed class BadEnumerable218
{
    public BadEnumerator218 GetAsyncEnumerator(CancellationToken cancellationToken = default)
    {
        return new BadEnumerator218();
    }
}

public static class Program
{
    private static async IAsyncEnumerable<int> Bad(BadEnumerable218 source)
    {
        await foreach (var value in source)
            yield return value;
    }
    public static void Main() { }
}
