namespace Tests.RefOutIn;

public struct Pair
{
    public int X;
    public int Y;

    public Pair(int x, int y)
    {
        X = x;
        Y = y;
    }
}

public static class Program
{
    public static void Add(ref int value, int amount)
    {
        value += amount;
    }

    public static bool TryGet(out int value)
    {
        value = 42;
        return true;
    }

    public static int Sum(in Pair value)
    {
        return value.X + value.Y;
    }

    public static void Main()
    {
        int number = 10;
        Add(ref number, 5);

        int result = 0;
        bool found = TryGet(out result);

        Pair pair = new(10, 15);
        int total = Sum(in pair);

        Console.WriteLine(number);
        Console.WriteLine(found);
        Console.WriteLine(result);
        Console.WriteLine(total);
    }
}
