using Void;
using Void.Threading;
using Void.Threading.Tasks;

public sealed class AsyncLambdaFault272 : Exception
{
    public AsyncLambdaFault272(string message)
        : base(message)
    {
    }
}

public struct InlineIntAwaiter272
{
    private int _value;

    public InlineIntAwaiter272(int value)
    {
        _value = value;
    }

    public bool IsCompleted
    {
        get { return true; }
    }

    public void OnCompleted(Action continuation)
    {
        continuation();
    }

    public int GetResult()
    {
        return _value;
    }
}

public struct InlineIntAwaitable272
{
    private int _value;

    public InlineIntAwaitable272(int value)
    {
        _value = value;
    }

    public InlineIntAwaiter272 GetAwaiter()
    {
        return new InlineIntAwaiter272(_value);
    }
}

public sealed class WorkerIntAwaiter272
{
    private int _value;

    public WorkerIntAwaiter272(int value)
    {
        _value = value;
    }

    public bool IsCompleted
    {
        get { return false; }
    }

    public void OnCompleted(Action continuation)
    {
        ThreadPool.QueueUserWorkItem(continuation);
    }

    public int GetResult()
    {
        return _value;
    }
}

public struct WorkerIntAwaitable272
{
    private int _value;

    public WorkerIntAwaitable272(int value)
    {
        _value = value;
    }

    public WorkerIntAwaiter272 GetAwaiter()
    {
        return new WorkerIntAwaiter272(_value);
    }
}

public static class Program
{
    private static int _stage;
    private static int _finallyCount;

    private static async Task<int> ComposeInsideAsyncMethod()
    {
        Func<Task<int>> nested = async () =>
        {
            await Task.Yield();
            return 21;
        };
        int value = await nested();
        return value * 2;
    }

    public static void Main()
    {
        Func<Task<int>> completed = async () => 42;
        Task<int> completedTask = completed();
        Console.WriteLine(completedTask.IsCompleted);
        Console.WriteLine(completedTask.Result == 42);

        Func<Task<int>> inline = async () => await new InlineIntAwaitable272(42);
        Console.WriteLine(inline().Result == 42);

        Func<Task, Task> suspendedVoid = async signal =>
        {
            _stage = 1;
            await signal;
            _stage = 2;
        };
        TaskCompletionSource gate = new TaskCompletionSource();
        Task pendingVoid = suspendedVoid(gate.Task);
        Console.WriteLine(_stage == 1);
        Console.WriteLine(!pendingVoid.IsCompleted);
        gate.SetResult();
        pendingVoid.Wait();
        Console.WriteLine(_stage == 2);

        Func<Task<int>, Task<int>> multiple = async signal =>
        {
            int value = await signal;
            await Task.Yield();
            return value + 2;
        };
        TaskCompletionSource<int> numberGate = new TaskCompletionSource<int>();
        Task<int> pendingInt = multiple(numberGate.Task);
        Console.WriteLine(!pendingInt.IsCompleted);
        numberGate.SetResult(40);
        Console.WriteLine(pendingInt.Result == 42);

        Func<Task<int>> customWorker = async () =>
        {
            int value = await new WorkerIntAwaitable272(40);
            return value + 2;
        };
        Console.WriteLine(customWorker().Result == 42);

        Func<ValueTask<int>> valueResult = async () =>
        {
            await Task.Yield();
            return 42;
        };
        ValueTask<int> valueTask = valueResult();
        Console.WriteLine(valueTask.GetAwaiter().GetResult() == 42);

        Func<ValueTask> valueVoid = async () =>
        {
            await Task.Yield();
        };
        ValueTask valueVoidTask = valueVoid();
        valueVoidTask.GetAwaiter().GetResult();
        Console.WriteLine(valueVoidTask.IsCompleted);

        Func<Task> faulting = async () =>
        {
            await Task.Yield();
            throw new AsyncLambdaFault272("lambda-fault-272");
        };
        Task fault = faulting();
        bool faultObserved = false;
        try
        {
            fault.Wait();
        }
        catch (AsyncLambdaFault272 error)
        {
            faultObserved = fault.IsFaulted && error.Message == "lambda-fault-272";
        }
        Console.WriteLine(faultObserved);

        CancellationTokenSource cancellation = new CancellationTokenSource();
        cancellation.Cancel();
        Func<CancellationToken, Task> canceling = async token =>
        {
            await Task.Yield();
            throw new OperationCanceledException(token);
        };
        Task canceled = canceling(cancellation.Token);
        bool cancelObserved = false;
        try
        {
            canceled.Wait();
        }
        catch (OperationCanceledException error)
        {
            cancelObserved = canceled.IsCanceled &&
                error.CancellationToken.IsSameSource(cancellation.Token);
        }
        Console.WriteLine(cancelObserved);

        Func<Task, Task<int>> withFinally = async signal =>
        {
            try
            {
                await signal;
                return 42;
            }
            finally
            {
                _finallyCount++;
            }
        };
        TaskCompletionSource finallyGate = new TaskCompletionSource();
        Task<int> finallyTask = withFinally(finallyGate.Task);
        Console.WriteLine(_finallyCount == 0);
        finallyGate.SetResult();
        Console.WriteLine(finallyTask.Result == 42);
        Console.WriteLine(_finallyCount == 1);

        Console.WriteLine(ComposeInsideAsyncMethod().Result == 42);

        ThreadPool.Shutdown();
        Console.WriteLine(true);
    }
}
