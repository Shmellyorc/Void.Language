using Void;
using Void.Threading;
using Void.Threading.Tasks;

public static class Program
{
    public static void Main()
    {
        Task<int> task = new Task<int>();
        Thread worker = new Thread(() =>
        {
            Thread.Sleep(20);
            task.TrySetResult(195);
        });
        worker.Start();
        int value = task.Result;
        worker.Join();
        Console.WriteLine(value == 195);
    }
}
