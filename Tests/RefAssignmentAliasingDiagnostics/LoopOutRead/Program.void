public static class Program
{
    public static void Bad(out int value, bool run)
    {
        int other = 2;
        ref int alias = ref value;
        while (run)
        {
            alias = ref other;
            run = false;
        }
        Console.WriteLine(alias);
        value = 1;
    }
    public static void Main() { int value; Bad(out value, true); }
}
