        _disposeSignal = disposeSignal;
    }

    public BodyFaultEnumerator269 GetAsyncEnumerator()
    {
        return new BodyFaultEnumerator269(_disposeSignal);
    }
}

public static class Program
{
    public static int DisposeCount;
    public static int FinallyCount;

    private static async ValueTask<int> SumInline()
    {
        int sum = 0;
        await foreach (var value in new InlineEnumerable269())
            sum += value;
        return sum;
    }

    private static async ValueTask<int> ConsumeManaged(ManagedPendingEnumerable269 source)
    {
        int result = 0;
        await foreach (var payload in source)
        {
            GC.Collect();
            result += payload.Value;
            await Task.Yield();
        }
        return result;
    }

    private static async ValueTask<int> ConsumePendingDispose(PendingDisposeEnumerable269 source)
    {
        int result = 0;
        await foreach (var value in source)
            result += value;
        return result;
    }

    private static async ValueTask ObserveMoveFault(FaultingMoveEnumerable269 source)
    {
        try
        {
            await foreach (var value in source)
            {
            }
        }
        finally
        {
            FinallyCount++;
        }
    }

    private static async ValueTask ObserveCancellation(CancelingMoveEnumerable269 source)
    {
        try
        {
            await foreach (var value in source)
            {
            }
        }
        finally
        {
            FinallyCount++;
        }
    }

    private static async ValueTask BodyFaultAfterPendingDispose(BodyFaultEnumerable269 source)
    {
        try
        {
            await foreach (var value in source)
                throw new Fault269("body-269");
        }
        finally
        {
            FinallyCount++;
        }
    }

    private static async IAsyncEnumerable<int> PassThrough(InlineEnumerable269 source)
    {
        await foreach (var value in source)
        {
            await Task.Yield();
            yield return value * 10;
        }
    }

    private static async ValueTask<int> SumGeneratedIterator()
    {
        int sum = 0;
        await foreach (var value in PassThrough(new InlineEnumerable269()))
            sum += value;
        return sum;
    }

    private static async ValueTask<int> MixedAwait(Task<int> task)
    {
        int first = await task;
        int second = await new ValueTask<int>(2);
        await Task.Yield();
        return first + second;
    }

    public static void Main()
    {
        DisposeCount = 0;
        FinallyCount = 0;

        ValueTask<int> inline = SumInline();
        Console.WriteLine(inline.GetAwaiter().GetResult() == 6);
        Console.WriteLine(DisposeCount == 1);

        TaskCompletionSource<bool> moveSignal = new TaskCompletionSource<bool>();
        Payload269 payload = new Payload269(269);
        ManagedPendingEnumerable269 managedSource = new ManagedPendingEnumerable269(payload, moveSignal);
        ValueTask<int> managed = ConsumeManaged(managedSource);
        Console.WriteLine(!managed.IsCompleted);
        payload = null;
        managedSource = null;
        GC.Collect();
        Thread moveWorker = new Thread(() => moveSignal.SetResult(true));
        moveWorker.Start();
        moveWorker.Join();
        Console.WriteLine(managed.GetAwaiter().GetResult() == 269);
        Console.WriteLine(DisposeCount == 2);

        TaskCompletionSource disposeSignal = new TaskCompletionSource();
        ValueTask<int> pendingDispose = ConsumePendingDispose(new PendingDisposeEnumerable269(disposeSignal));
        Console.WriteLine(!pendingDispose.IsCompleted);
        Console.WriteLine(DisposeCount == 3);
        Thread disposeWorker = new Thread(() => disposeSignal.SetResult());
        disposeWorker.Start();
        disposeWorker.Join();
        Console.WriteLine(pendingDispose.GetAwaiter().GetResult() == 9);

        TaskCompletionSource<bool> faultSignal = new TaskCompletionSource<bool>();
        ValueTask faulted = ObserveMoveFault(new FaultingMoveEnumerable269(faultSignal));
        Console.WriteLine(!faulted.IsCompleted);
        faultSignal.SetException(new Fault269("move-269"));
        bool moveFaultObserved = false;
        try
        {
            faulted.GetAwaiter().GetResult();
        }
        catch (Fault269 error)
        {
            moveFaultObserved = error.Message == "move-269";
        }
        Console.WriteLine(moveFaultObserved);
        Console.WriteLine(FinallyCount == 1);
        Console.WriteLine(DisposeCount == 4);

        CancellationTokenSource cancellation = new CancellationTokenSource();
        cancellation.Cancel();
        TaskCompletionSource<bool> cancelSignal = new TaskCompletionSource<bool>();
        ValueTask canceled = ObserveCancellation(new CancelingMoveEnumerable269(cancelSignal));
        cancelSignal.SetCanceled(cancellation.Token);
        bool canceledObserved = false;
        try
        {
            canceled.GetAwaiter().GetResult();
        }
        catch (OperationCanceledException error)
        {
            canceledObserved = error.CancellationToken.IsSameSource(cancellation.Token);
        }
        Console.WriteLine(canceledObserved);
        Console.WriteLine(FinallyCount == 2);
        Console.WriteLine(DisposeCount == 5);

        TaskCompletionSource bodyDisposeSignal = new TaskCompletionSource();
        ValueTask bodyFault = BodyFaultAfterPendingDispose(new BodyFaultEnumerable269(bodyDisposeSignal));
        Console.WriteLine(!bodyFault.IsCompleted);
        Console.WriteLine(DisposeCount == 6);
        bodyDisposeSignal.SetResult();
        bool bodyFaultObserved = false;
        try
        {
            bodyFault.GetAwaiter().GetResult();
        }
        catch (Fault269 error)
        {
            bodyFaultObserved = error.Message == "body-269";
        }
        Console.WriteLine(bodyFaultObserved);
        Console.WriteLine(FinallyCount == 3);

        Console.WriteLine(SumGeneratedIterator().GetAwaiter().GetResult() == 60);

        TaskCompletionSource<int> mixedSignal = new TaskCompletionSource<int>();
        ValueTask<int> mixed = MixedAwait(mixedSignal.Task);
        Console.WriteLine(!mixed.IsCompleted);
        Thread mixedWorker = new Thread(() => mixedSignal.SetResult(40));
        mixedWorker.Start();
        mixedWorker.Join();
        Console.WriteLine(mixed.GetAwaiter().GetResult() == 42);

        GC.Collect();
        Console.WriteLine(true);

        ThreadPool.Shutdown();
        Console.WriteLine(true);
    }
}
