{
    private TaskCompletionSource<bool> _faultSignal;

    public FaultingMoveEnumerator269(TaskCompletionSource<bool> faultSignal)
    {
        _faultSignal = faultSignal;
    }

    public int Current => 0;

    public ValueTask<bool> MoveNextAsync()
    {
        return new ValueTask<bool>(_faultSignal.Task);
    }

    public ValueTask DisposeAsync()
    {
        Program.DisposeCount++;
        return default;
    }
}

public sealed class FaultingMoveEnumerable269
{
    private TaskCompletionSource<bool> _faultSignal;

    public FaultingMoveEnumerable269(TaskCompletionSource<bool> faultSignal)
    {
        _faultSignal = faultSignal;
    }

    public FaultingMoveEnumerator269 GetAsyncEnumerator()
    {
        return new FaultingMoveEnumerator269(_faultSignal);
    }
}

public sealed class CancelingMoveEnumerator269
{
    private TaskCompletionSource<bool> _cancelSignal;

    public CancelingMoveEnumerator269(TaskCompletionSource<bool> cancelSignal)
    {
        _cancelSignal = cancelSignal;
    }

    public int Current => 0;

    public ValueTask<bool> MoveNextAsync()
    {
        return new ValueTask<bool>(_cancelSignal.Task);
    }

    public ValueTask DisposeAsync()
    {
        Program.DisposeCount++;
        return default;
    }
}

public sealed class CancelingMoveEnumerable269
{
    private TaskCompletionSource<bool> _cancelSignal;

    public CancelingMoveEnumerable269(TaskCompletionSource<bool> cancelSignal)
    {
        _cancelSignal = cancelSignal;
    }

    public CancelingMoveEnumerator269 GetAsyncEnumerator()
    {
        return new CancelingMoveEnumerator269(_cancelSignal);
    }
}

public sealed class BodyFaultEnumerator269
{
    private TaskCompletionSource _disposeSignal;
    private int _step;

    public BodyFaultEnumerator269(TaskCompletionSource disposeSignal)
    {
        _disposeSignal = disposeSignal;
        _step = 0;
    }

    public int Current => 17;

    public ValueTask<bool> MoveNextAsync()
    {
        if (_step == 0)
        {
            _step = 1;
            return new ValueTask<bool>(true);
        }
        return new ValueTask<bool>(false);
    }

    public ValueTask DisposeAsync()
    {
        Program.DisposeCount++;
        return new ValueTask(_disposeSignal.Task);
    }
}

