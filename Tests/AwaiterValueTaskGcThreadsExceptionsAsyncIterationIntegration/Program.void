using Void;
using Void.Collections;
using Void.Threading;
using Void.Threading.Tasks;

public sealed class Payload269
{
    public int Value;

    public Payload269(int value)
    {
        Value = value;
    }
}

public sealed class Fault269 : Exception
{
    public Fault269(string message) : base(message)
    {
    }
}

public sealed class InlineEnumerator269
{
    private int _index;

    public InlineEnumerator269()
    {
        _index = 0;
    }

    public int Current => _index;

    public ValueTask<bool> MoveNextAsync()
    {
        _index++;
        return new ValueTask<bool>(_index <= 3);
    }

    public ValueTask DisposeAsync()
    {
        Program.DisposeCount++;
        return default;
    }
}

public sealed class InlineEnumerable269
{
    public InlineEnumerator269 GetAsyncEnumerator()
    {
        return new InlineEnumerator269();
    }
}

public sealed class ManagedPendingEnumerator269
{
    private Payload269 _payload;
    private TaskCompletionSource<bool> _signal;
    private int _step;

    public ManagedPendingEnumerator269(Payload269 payload, TaskCompletionSource<bool> signal)
    {
        _payload = payload;
        _signal = signal;
        _step = 0;
    }

    public Payload269 Current => _payload;

    public ValueTask<bool> MoveNextAsync()
    {
        if (_step == 0)
        {
            _step = 1;
            return new ValueTask<bool>(_signal.Task);
        }
        return new ValueTask<bool>(false);
    }

    public ValueTask DisposeAsync()
    {
        Program.DisposeCount++;
        return default;
    }
}

public sealed class ManagedPendingEnumerable269
{
    private Payload269 _payload;
    private TaskCompletionSource<bool> _signal;

    public ManagedPendingEnumerable269(Payload269 payload, TaskCompletionSource<bool> signal)
    {
        _payload = payload;
        _signal = signal;
    }

    public ManagedPendingEnumerator269 GetAsyncEnumerator()
    {
        return new ManagedPendingEnumerator269(_payload, _signal);
    }
}

public sealed class PendingDisposeEnumerator269
{
    private TaskCompletionSource _disposeSignal;
    private int _step;

    public PendingDisposeEnumerator269(TaskCompletionSource disposeSignal)
    {
        _disposeSignal = disposeSignal;
        _step = 0;
    }

    public int Current => 9;

    public ValueTask<bool> MoveNextAsync()
    {
        if (_step == 0)
        {
            _step = 1;
            return new ValueTask<bool>(true);
        }
        return new ValueTask<bool>(false);
    }

    public ValueTask DisposeAsync()
    {
        Program.DisposeCount++;
        return new ValueTask(_disposeSignal.Task);
    }
}

public sealed class PendingDisposeEnumerable269
{
    private TaskCompletionSource _disposeSignal;

    public PendingDisposeEnumerable269(TaskCompletionSource disposeSignal)
    {
        _disposeSignal = disposeSignal;
    }

    public PendingDisposeEnumerator269 GetAsyncEnumerator()
    {
        return new PendingDisposeEnumerator269(_disposeSignal);
    }
}

