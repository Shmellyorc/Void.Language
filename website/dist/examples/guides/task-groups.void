struct progress:
    completed: i32 = 0

async func record_work(report: progress, amount: i32):
    report.completed += amount

async func entry(amount: i32) -> i32:
    var report = progress()
    with tasks.group() as jobs:
        var first = record_work(report, amount)
        var second = record_work(report, amount + 1)
    return report.completed
