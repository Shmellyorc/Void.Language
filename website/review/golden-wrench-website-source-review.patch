+    <span class="keyword">return</span> <span class="keyword">match</span> board:
+        departure.on_time: <span class="number">0</span>
+        departure.delayed(<span class="keyword">var</span> wait): wait</code></pre><div class="guide-result" data-source="/examples/guides/patterns.void" data-input="5" data-expected="5">Input <strong>5</strong><span aria-hidden="true"> · </span>Expected result <strong>5</strong></div></figure></article><article class="gallery-example" id="strings" data-example="strings"><div class="gallery-copy"><p class="eyebrow">LANGUAGE EXAMPLE</p><h2>Unicode scalars</h2><p>Count the letters in a short destination name before adding the route number.</p><a href="/docs/strings/">Read the guide</a></div><figure class="guide-code"><figcaption>strings.void<a href="/examples/guides/strings.void" download>Download source</a></figcaption><pre tabindex="0" aria-label="strings source"><code data-source="/examples/guides/strings.void"><span class="keyword">func</span> entry(route: <span class="keyword">i32</span>) -&gt; <span class="keyword">i32</span>:
+    <span class="keyword">var</span> stop = <span class="string">&quot;林道駅&quot;</span>
+    <span class="keyword">return</span> route + (stop.length <span class="keyword">as</span> <span class="keyword">i32</span>)</code></pre><div class="guide-result" data-source="/examples/guides/strings.void" data-input="5" data-expected="8">Input <strong>5</strong><span aria-hidden="true"> · </span>Expected result <strong>8</strong></div></figure></article><article class="gallery-example" id="nullable" data-example="nullable"><div class="gallery-copy"><p class="eyebrow">LANGUAGE EXAMPLE</p><h2>Optional values</h2><p>Use the platform number if one was assigned, or zero for an unassigned platform.</p><a href="/docs/nullable/">Read the guide</a></div><figure class="guide-code"><figcaption>nullable.void<a href="/examples/guides/nullable.void" download>Download source</a></figcaption><pre tabindex="0" aria-label="nullable source"><code data-source="/examples/guides/nullable.void"><span class="keyword">struct</span> platform_assignment:
+    number: <span class="keyword">i32</span>
+
+<span class="keyword">func</span> entry(number: <span class="keyword">i32</span>) -&gt; <span class="keyword">i32</span>:
+    <span class="keyword">var</span> platform: platform_assignment?
+    <span class="keyword">if</span> number &gt; <span class="number">0</span>:
+        platform = platform_assignment(number = number)
+    <span class="keyword">return</span> <span class="keyword">match</span> platform:
+        Ok(<span class="keyword">var</span> assigned): assigned.number
+        null: <span class="number">0</span></code></pre><div class="guide-result" data-source="/examples/guides/nullable.void" data-input="5" data-expected="5">Input <strong>5</strong><span aria-hidden="true"> · </span>Expected result <strong>5</strong></div></figure></article><article class="gallery-example" id="composition" data-example="composition"><div class="gallery-copy"><p class="eyebrow">LANGUAGE EXAMPLE</p><h2>Composition</h2><p>Promote a contained reading into a weather station.</p><a href="/docs/composition/">Read the guide</a></div><figure class="guide-code"><figcaption>composition.void<a href="/examples/guides/composition.void" download>Download source</a></figcaption><pre tabindex="0" aria-label="composition source"><code data-source="/examples/guides/composition.void"><span class="keyword">value</span> <span class="keyword">struct</span> reading:
+    degrees: <span class="keyword">i32</span>
+
+<span class="keyword">struct</span> station:
+    <span class="keyword">using</span> latest: reading
+
+<span class="keyword">func</span> entry(degrees: <span class="keyword">i32</span>) -&gt; <span class="keyword">i32</span>:
+    <span class="keyword">var</span> roof = station(latest = reading(degrees = degrees))
+    <span class="keyword">return</span> roof.degrees</code></pre><div class="guide-result" data-source="/examples/guides/composition.void" data-input="5" data-expected="5">Input <strong>5</strong><span aria-hidden="true"> · </span>Expected result <strong>5</strong></div></figure></article><article class="gallery-example" id="inheritance" data-example="inheritance"><div class="gallery-copy"><p class="eyebrow">LANGUAGE EXAMPLE</p><h2>Virtual methods</h2><p>Ask a base ticket reference for a group ticket’s seat count.</p><a href="/docs/inheritance/">Read the guide</a></div><figure class="guide-code"><figcaption>inheritance.void<a href="/examples/guides/inheritance.void" download>Download source</a></figcaption><pre tabindex="0" aria-label="inheritance source"><code data-source="/examples/guides/inheritance.void"><span class="keyword">struct</span> admission:
+    seats: <span class="keyword">i32</span>
+
+<span class="keyword">virtual</span> <span class="keyword">func</span> (item admission) capacity() -&gt; <span class="keyword">i32</span>:
+    <span class="keyword">return</span> item.seats
+
+<span class="keyword">struct</span> group_pass <span class="keyword">extends</span> admission:
+    guests: <span class="keyword">i32</span>
+
+<span class="keyword">override</span> <span class="keyword">func</span> (item group_pass) capacity() -&gt; <span class="keyword">i32</span>:
+    <span class="keyword">return</span> super.capacity() + item.guests
+
+<span class="keyword">func</span> entry(guests: <span class="keyword">i32</span>) -&gt; <span class="keyword">i32</span>:
+    <span class="keyword">var</span> passholder = group_pass(seats = <span class="number">2</span>, guests = guests)
+    <span class="keyword">var</span> booking: admission = passholder
+    <span class="keyword">return</span> booking.capacity()</code></pre><div class="guide-result" data-source="/examples/guides/inheritance.void" data-input="5" data-expected="7">Input <strong>5</strong><span aria-hidden="true"> · </span>Expected result <strong>7</strong></div></figure></article><article class="gallery-example" id="initialization" data-example="initialization"><div class="gallery-copy"><p class="eyebrow">LANGUAGE EXAMPLE</p><h2>Initializers</h2><p>Set a bookmark’s starting page during construction.</p><a href="/docs/initialization/">Read the guide</a></div><figure class="guide-code"><figcaption>initialization.void<a href="/examples/guides/initialization.void" download>Download source</a></figcaption><pre tabindex="0" aria-label="initialization source"><code data-source="/examples/guides/initialization.void"><span class="keyword">value</span> <span class="keyword">struct</span> bookmark:
+    page: <span class="keyword">i32</span>
+
+<span class="keyword">func</span> (mark bookmark) init(chapter_start: <span class="keyword">i32</span>):
+    mark.page = chapter_start + <span class="number">1</span>
+
+<span class="keyword">func</span> entry(start: <span class="keyword">i32</span>) -&gt; <span class="keyword">i32</span>:
+    <span class="keyword">var</span> mark = bookmark(start)
+    <span class="keyword">return</span> mark.page</code></pre><div class="guide-result" data-source="/examples/guides/initialization.void" data-input="5" data-expected="6">Input <strong>5</strong><span aria-hidden="true"> · </span>Expected result <strong>6</strong></div></figure></article><article class="gallery-example" id="dictionaries" data-example="dictionaries"><div class="gallery-copy"><p class="eyebrow">LANGUAGE EXAMPLE</p><h2>Dictionary lookup</h2><p>Retrieve the stock of a named ingredient with a recoverable lookup.</p><a href="/docs/dictionaries/">Read the guide</a></div><figure class="guide-code"><figcaption>dictionaries.void<a href="/examples/guides/dictionaries.void" download>Download source</a></figcaption><pre tabindex="0" aria-label="dictionaries source"><code data-source="/examples/guides/dictionaries.void"><span class="keyword">func</span> entry(lemons: <span class="keyword">i32</span>) -&gt; <span class="keyword">i32</span>:
+    <span class="keyword">var</span> pantry: {<span class="keyword">string</span>: <span class="keyword">i32</span>} = {<span class="string">&quot;lemon&quot;</span>: lemons}
+    <span class="keyword">if</span> pantry.get(<span class="string">&quot;lemon&quot;</span>) is Ok(<span class="keyword">var</span> quantity):
+        <span class="keyword">return</span> quantity
+    <span class="keyword">return</span> <span class="number">0</span></code></pre><div class="guide-result" data-source="/examples/guides/dictionaries.void" data-input="5" data-expected="5">Input <strong>5</strong><span aria-hidden="true"> · </span>Expected result <strong>5</strong></div></figure></article><article class="gallery-example" id="callables" data-example="callables"><div class="gallery-copy"><p class="eyebrow">LANGUAGE EXAMPLE</p><h2>Callable values</h2><p>Store the size of a packet and call it to calculate a shipment.</p><a href="/docs/callables/">Read the guide</a></div><figure class="guide-code"><figcaption>callables.void<a href="/examples/guides/callables.void" download>Download source</a></figcaption><pre tabindex="0" aria-label="callables source"><code data-source="/examples/guides/callables.void"><span class="keyword">value</span> <span class="keyword">struct</span> packet:
+    size: <span class="keyword">i32</span>
+
+<span class="keyword">func</span> (unit packet) call(quantity: <span class="keyword">i32</span>) -&gt; <span class="keyword">i32</span>:
+    <span class="keyword">return</span> unit.size * quantity
+
+<span class="keyword">func</span> entry(quantity: <span class="keyword">i32</span>) -&gt; <span class="keyword">i32</span>:
+    <span class="keyword">var</span> postcards = packet(size = <span class="number">4</span>)
+    <span class="keyword">return</span> postcards(quantity)</code></pre><div class="guide-result" data-source="/examples/guides/callables.void" data-input="5" data-expected="20">Input <strong>5</strong><span aria-hidden="true"> · </span>Expected result <strong>20</strong></div></figure></article></div></section></main><footer><div class="container footer-inner"><a class="brand" href="/"><svg viewBox="0 0 44 44" aria-hidden="true"><path fill="currentColor" d="M2 5h12l13 23-6 11z"/><path fill="#6b779b" d="M17 5h11l-6 10z"/><path fill="#303b64" d="M31 5h11L29 28l-6-10z"/></svg><span>VOID <small>LANGUAGE</small></span></a><p>Native code. Clear intent.</p><div><a href="/docs/syntax/">Docs</a><a href="/docs/">All guides</a><a href="/github/">GitHub ↗</a></div></div></footer><div class="sr-only" id="announcement" role="status"></div></body></html>
