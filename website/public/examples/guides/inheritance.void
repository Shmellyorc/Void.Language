struct admission:
    seats: i32

virtual func (item admission) capacity() -> i32:
    return item.seats

struct group_pass extends admission:
    guests: i32

override func (item group_pass) capacity() -> i32:
    return super.capacity() + item.guests

func entry(guests: i32) -> i32:
    var passholder = group_pass(seats = 2, guests = guests)
    var booking: admission = passholder
    return booking.capacity()
