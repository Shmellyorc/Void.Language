diff --git a/include/void/binary_audit.hpp b/include/void/binary_audit.hpp
new file mode 100644
index 00000000..bb8e6941
--- /dev/null
+++ b/include/void/binary_audit.hpp
@@ -0,0 +1,30 @@
+#pragma once
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace vd::audit {
+struct Finding { std::string code, detail; std::uint64_t offset = 0; };
+struct Policy {
+    unsigned revision = 1;
+    std::string target; // exactly linux-x64, windows-x64 or macos-arm64
+    bool reject_debug = true, reject_symbols = true, reject_loader_paths = true;
+    std::vector<std::string> forbidden_strings;
+};
+struct Report {
+    unsigned schema = 1;
+    bool inspected = false; // structural inspection, never closure/protection approval
+    std::string format, architecture, image_kind, sha256, interpreter;
+    std::vector<std::string> dependencies, versions, loader_paths;
+    bool symbols = false, debug = false;
+    std::vector<Finding> findings;
+};
+inline constexpr std::size_t byte_limit = 64 * 1024 * 1024;
+inline constexpr std::size_t record_limit = 4096;
+// Owned report from caller-owned bytes. No file opening, loading, execution,
+// subprocesses, environment access or mutation. ELF64LE, PE32+ and thin Mach-O64LE
+// declarations only. Archives/universal images and other variants fail closed.
+Report inspect(std::string_view bytes, const Policy&);
+std::string json(const Report&);
+}
diff --git a/include/void/publish.hpp b/include/void/publish.hpp
new file mode 100644
index 00000000..d584c9a1
--- /dev/null
+++ b/include/void/publish.hpp
@@ -0,0 +1,47 @@
+#pragma once
+#include "void/project.hpp"
+#include <filesystem>
+#include <span>
+
+namespace vd::publish {
+inline constexpr std::string_view policy_revision = "stage-a-contract-1";
+struct Request {
+    std::filesystem::path project = ".";
+    std::optional<std::string> entry, target, profile;
+    std::optional<std::filesystem::path> output;
+};
+// Pure CLI parsing. No source operands, consent flags, subprocesses or writes.
+Request parse_arguments(std::span<const std::string_view>);
+
+// This stage records a contract, never an admitted graph or emission authority.
+// Later stages must capture/revalidate source, lock, toolchain, native and resource
+// snapshots before constructing an executable publication plan.
+class PublishPlan final {
+    std::string target_, profile_, manifest_sha256_;
+    std::filesystem::path output_;
+    std::string project_id_;
+    std::optional<std::string> entry_;
+    std::vector<std::string> required_capabilities_;
+    PublishPlan(const Request&, const project::Manifest&, std::string_view host);
+    friend PublishPlan plan_contract(const Request&, const project::Manifest&, std::string_view);
+public:
+    PublishPlan(const PublishPlan&) = default;
+    PublishPlan(PublishPlan&&) = default;
+    PublishPlan& operator=(const PublishPlan&) = delete;
+    PublishPlan& operator=(PublishPlan&&) = delete;
+    const auto& target() const { return target_; }
+    const auto& profile() const { return profile_; }
+    const auto& manifest_sha256() const { return manifest_sha256_; }
+    const auto& output() const { return output_; }
+    const auto& project_id() const { return project_id_; }
+    const auto& entry() const { return entry_; }
+    const auto& required_capabilities() const { return required_capabilities_; }
+    constexpr auto revision() const { return policy_revision; }
+    constexpr bool admitted() const { return false; }
+};
+PublishPlan plan_contract(const Request&, const project::Manifest&, std::string_view host);
+// Always throws in Stage A. Native execution approvals cannot authorize publish.
+void require_capabilities(const PublishPlan&);
+// Bounded read-only manifest preflight; always fails before any output creation.
+void preflight(const Request&, std::string_view host);
+}
