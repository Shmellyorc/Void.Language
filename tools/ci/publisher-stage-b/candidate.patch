diff --git a/src/private_diagnostics.cpp b/src/private_diagnostics.cpp
new file mode 100644
--- /dev/null
+++ b/src/private_diagnostics.cpp
@@ -0,0 +1,94 @@
+#include "void/private_diagnostics.hpp"
+#include "frontend/project_digest.hpp"
+#include <algorithm>
+#include <charconv>
+#include <cctype>
+#include <stdexcept>
+
+namespace vd::diagnostics {
+namespace {
+using namespace std::string_view_literals;
+constexpr std::string_view magic = "VOID-PRIVATE-DIAGNOSTICS\0\1"sv;
+bool digest(std::string_view s) {
+    return s.size() == 64 && std::all_of(s.begin(), s.end(), [](char c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'); });
+}
+std::string hash(std::string_view s) { project::Digest d; d.bytes(s); return d.finish(); }
+void number(std::string& out, std::uint32_t n) { for (unsigned i=0;i<4;++i) out += char(n >> (8*i)); }
+void field(std::string& out, std::string_view s) { number(out,static_cast<std::uint32_t>(s.size())); out += s; }
+struct Reader {
+    std::string_view bytes;
+    std::uint32_t number() {
+        if (bytes.size()<4) throw std::invalid_argument("Truncated private diagnostic map.");
+        std::uint32_t n=0; for(unsigned i=0;i<4;++i)n|=std::uint32_t(static_cast<unsigned char>(bytes[i]))<<(8*i);
+        bytes.remove_prefix(4); return n;
+    }
+    std::string field() {
+        auto n=number(); if(n>bytes.size() || n>1024*1024)throw std::invalid_argument("Invalid private diagnostic map field.");
+        std::string s(bytes.substr(0,n));bytes.remove_prefix(n);return s;
+    }
+};
+bool valid(Category c) { return c>=Category::runtime && c<=Category::global; }
+std::string token(std::string_view build, std::uint32_t id, Category c) {
+    return "VOID-D1 " + std::string(build) + " " + std::to_string(id) + " " + std::to_string(static_cast<unsigned>(c)) + "\n";
+}
+}
+PrivateMap::PrivateMap(std::string_view inputs) {
+    if(!digest(inputs))throw std::invalid_argument("Private diagnostic inputs require a lowercase SHA-256 digest.");
+    project::Digest d;d.field("void.private-diagnostics.v1");d.field(inputs);build_=d.finish();
+}
+std::string PrivateMap::add(Site s) {
+    if(!image_.empty())throw std::invalid_argument("Private diagnostic map is already image-bound.");
+    if(!valid(s.category) || sites_.size()>=site_limit)throw std::invalid_argument("Invalid private diagnostic site or site limit.");
+    std::size_t size=28;
+    for(const auto* value:{&s.function,&s.path,&s.excerpt,&s.description}) {
+        if(value->size()>1024*1024)throw std::invalid_argument("Private diagnostic field limit.");
+        size+=value->size();
+    }
+    if(size>map_byte_limit-256-bytes_)throw std::invalid_argument("Private diagnostic map byte limit.");
+    auto result=token(build_,static_cast<std::uint32_t>(sites_.size()+1),s.category);
+    bytes_+=size;sites_.push_back(std::move(s));return result;
+}
+void PrivateMap::bind_image(std::string_view bytes) {
+    if(bytes.empty() || !image_.empty())throw std::invalid_argument("Private diagnostic map requires one nonempty final image.");
+    image_=hash(bytes);
+}
+std::string PrivateMap::encode() const {
+    if(!digest(image_))throw std::invalid_argument("Private diagnostic map has no final image identity.");
+    std::string out(magic);field(out,build_);field(out,image_);number(out,static_cast<std::uint32_t>(sites_.size()));
+    for(const auto& s:sites_) {number(out,static_cast<unsigned>(s.category));number(out,s.line);number(out,s.column);field(out,s.function);field(out,s.path);field(out,s.excerpt);field(out,s.description);}
+    return out;
+}
+PrivateMap PrivateMap::decode(std::string_view bytes) {
+    if(bytes.empty())throw std::invalid_argument("Missing private diagnostic map.");
+    if(bytes.size()>map_byte_limit || !bytes.starts_with(magic))throw std::invalid_argument("Unsupported or oversized private diagnostic map.");
+    Reader r{bytes.substr(magic.size())};auto build=r.field(),image=r.field();
+    if(!digest(build) || !digest(image))throw std::invalid_argument("Invalid private diagnostic map identity.");
+    PrivateMap map(std::string(64,'0'));map.build_=std::move(build);
+    auto count=r.number();if(count>site_limit)throw std::invalid_argument("Private diagnostic site limit.");
+    for(std::uint32_t i=0;i<count;++i) {
+        Site s;s.category=static_cast<Category>(r.number());s.line=r.number();s.column=r.number();
+        s.function=r.field();s.path=r.field();s.excerpt=r.field();s.description=r.field();(void)map.add(std::move(s));
+    }
+    if(!r.bytes.empty())throw std::invalid_argument("Trailing private diagnostic map bytes.");
+    map.image_=std::move(image);return map;
+}
+Site PrivateMap::resolve(std::string_view bytes, std::string_view image, std::string_view public_token) {
+    auto map=decode(bytes);
+    if(map.image_!=hash(image))throw std::invalid_argument("Mismatched private diagnostic image.");
+    const auto prefix="VOID-D1 "+map.build_+" ";
+    if(!public_token.starts_with(prefix))throw std::invalid_argument("Mismatched diagnostic build or token version.");
+    auto rest=public_token.substr(prefix.size());std::uint32_t id=0;
+    auto result=std::from_chars(rest.data(),rest.data()+rest.size(),id);
+    if(result.ec!=std::errc{} || !id || id>map.sites_.size() || public_token!=token(map.build_,id,map.sites_[id-1].category))
+        throw std::invalid_argument("Unknown or malformed private diagnostic site.");
+    return map.sites_[id-1];
+}
+Category category(std::string_view value) {
+    std::string lowered(value);for(auto& c:lowered)c=static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+    std::string_view description=lowered;
+    if(description.find("null")!=description.npos)return Category::null_value;
+    if(description.find("bounds")!=description.npos || description.find("index")!=description.npos)return Category::bounds;
+    if(description.find("overflow")!=description.npos || description.find("division")!=description.npos || description.find("shift")!=description.npos || description.find("numeric")!=description.npos)return Category::arithmetic;
+    return Category::runtime;
+}
+}
diff --git a/src/publish.cpp b/src/publish.cpp
new file mode 100644
--- /dev/null
+++ b/src/publish.cpp
@@ -0,0 +1,85 @@
+#include "void/publish.hpp"
+#include "void/path.hpp"
+#include "frontend/project_digest.hpp"
+#include "frontend/project_files.hpp"
+#include <set>
+#include <stdexcept>
+
+namespace vd::publish {
+namespace {
+bool target_name(std::string_view value) {
+    return value == "linux-x64" || value == "windows-x64" || value == "macos-arm64";
+}
+bool profile_name(std::string_view value) {
+    return value == "release" || value == "performance" || value == "protected";
+}
+}
+Request parse_arguments(std::span<const std::string_view> args) {
+    Request request;
+    std::set<std::string_view> seen;
+    for (std::size_t i = 0; i < args.size(); ++i) {
+        const auto key = args[i];
+        if (key != "--project" && key != "--entry" && key != "--target" && key != "--profile" && key != "-o")
+            throw std::invalid_argument("Unsupported publish argument: " + std::string(key) + ". Use --project DIR; publish accepts no source operand or native consent flag.");
+        if (!seen.insert(key).second) throw std::invalid_argument("Duplicate publish argument: " + std::string(key));
+        if (++i == args.size() || args[i].empty() || args[i].starts_with('-') || args[i].find('\0') != args[i].npos)
+            throw std::invalid_argument("Expected one value after " + std::string(key));
+        const auto value = args[i];
+        if (key == "--project") request.project = utf8_path(value);
+        else if (key == "--entry") {
+            auto p = utf8_path(value);
+            if (p.has_root_path() || value.find('\\') != value.npos || value.find(':') != value.npos || !value.ends_with(".void"))
+                throw std::invalid_argument("Publish --entry requires an exact project-relative .void path.");
+            for (const auto& part : p) if (part == "." || part == ".." || part.empty())
+                throw std::invalid_argument("Publish --entry cannot contain dot or parent components.");
+            if (path_utf8(p.lexically_normal()) != value) throw std::invalid_argument("Publish --entry must be normalized.");
+            request.entry = value;
+        } else if (key == "--target") {
+            if (!target_name(value)) throw std::invalid_argument("Unsupported publish target: " + std::string(value));
+            request.target = value;
+        } else if (key == "--profile") {
+            if (!profile_name(value)) throw std::invalid_argument("Unsupported publish profile: " + std::string(value));
+            request.profile = value;
+        } else request.output = utf8_path(value);
+    }
+    return request;
+}
+PublishPlan::PublishPlan(const Request& request, const project::Manifest& manifest, std::string_view host) {
+    if (manifest.kind() != project::Kind::application) throw std::invalid_argument("Publish requires an application project; libraries are ineligible.");
+    const auto& config = manifest.publishing();
+    target_ = request.target.value_or(config.target.value_or(std::string(host)));
+    profile_ = request.profile.value_or(config.default_profile.value_or("release"));
+    project_id_ = manifest.project().id;
+    entry_ = request.entry ? request.entry : manifest.entry();
+    if (!target_name(target_)) throw std::invalid_argument("Unsupported publish target: " + target_);
+    if (!profile_name(profile_)) throw std::invalid_argument("Unsupported publish profile: " + profile_);
+    output_ = request.output.value_or(request.project / "dist" / manifest.application()->id / target_ / profile_);
+    project::Digest digest; digest.bytes(manifest.source().text()); manifest_sha256_ = digest.finish();
+    required_capabilities_ = {"admitted-project-snapshot", "native-target:" + target_, "private-diagnostics", "final-bundle-audit", "fresh-directory-transaction"};
+    if (!manifest.dependencies().empty()) required_capabilities_.push_back("verified-dependency-lock");
+    if (!manifest.resources().empty()) required_capabilities_.push_back("resource-snapshot");
+    if (!manifest.native().empty() || manifest.native_requirement()) required_capabilities_.push_back("publish-native-authorization");
+    if (profile_ == "performance") required_capabilities_.push_back("qualified-performance-policy");
+    if (profile_ == "protected") required_capabilities_.push_back("qualified-protection-policy");
+}
+PublishPlan plan_contract(const Request& request, const project::Manifest& manifest, std::string_view host) {
+    return PublishPlan(request, manifest, host);
+}
+void require_capabilities(const PublishPlan& plan) {
+    throw std::runtime_error("Publish capability unavailable in Stage A for " + plan.target() + "/" + plan.profile() +
+        "; no target is qualified and no output was created. Native approvals, dependency admission and final-binary gates require separate review.");
+}
+void preflight(const Request& request, std::string_view host) {
+    // Reuse the compiler's bounded manifest reader and root alias admission.
+    const auto root = project::inspect_creation_root(request.project);
+    const auto path = root.path / "void.project.toml";
+    auto parsed = project::parse_manifest(SourceFile(path_utf8(path), project::read_project_input(path, project::manifest_byte_limit)));
+    if (!parsed.succeeded()) throw CompilationError(std::move(parsed.diagnostics));
+    auto plan = plan_contract(request, *parsed.manifest, host);
+    std::error_code ec;
+    auto status = std::filesystem::symlink_status(plan.output(), ec);
+    if (ec && ec != std::errc::no_such_file_or_directory) throw std::runtime_error("Cannot inspect publish output destination.");
+    if (std::filesystem::exists(status)) throw std::invalid_argument("Publish output must be a fresh directory; replacement is unavailable.");
+    require_capabilities(plan);
+}
+}
