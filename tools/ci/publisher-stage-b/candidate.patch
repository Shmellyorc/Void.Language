diff --git a/tests/project/private_binary.py b/tests/project/private_binary.py
new file mode 100644
--- /dev/null
+++ b/tests/project/private_binary.py
@@ -0,0 +1,165 @@
+"""Linux Stage B qualification of exact linked, split-debug, stripped bytes.
+
+Uses only controlled temporary sources. Never publishes an application or
+touches the installed compiler, approvals or external projects.
+"""
+from pathlib import Path
+import hashlib
+import json
+import os
+import statistics
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+
+emitter, auditor, compiler, llvm = map(lambda p: Path(p).resolve(), sys.argv[1:])
+def run(args, expected=0):
+    result = subprocess.run(list(map(str, args)), capture_output=True, text=True, timeout=60)
+    assert result.returncode == expected, (args, result.returncode, result.stdout, result.stderr)
+    return result
+
+native = (compiler.parent / 'void-native.txt').read_text().splitlines()
+assert native[0] == 'VOID native 23.1.4 v2'
+assert '23.1.4' in run([llvm / 'llvm-objcopy', '--version']).stdout
+linker = ['--ld-path=' + native[2]]
+canaries = ['PRIVATE_PATH_B_7de94', 'private_function_b_9ac53', 'source_snippet_b_1dfee']
+sync = '''func private_function_b_9ac53(value: i32) -> i32:
+    if value > 0:
+        return private_function_b_9ac53(value - 1)
+    var source_snippet_b_1dfee = value - value
+    return value / source_snippet_b_1dfee
+
+func entry(value: i32) -> i32:
+    defer {
+        print("cleanup executed")
+    }
+    return private_function_b_9ac53(value)
+'''
+async_source = '''async func tick() -> i32:
+    return 1
+
+func private_function_b_9ac53(value: i32) -> i32:
+    if value > 0:
+        return private_function_b_9ac53(value - 1)
+    var source_snippet_b_1dfee = value - value
+    return value / source_snippet_b_1dfee
+
+async func worker(value: i32) -> i32:
+    var ignored = await tick()
+    return private_function_b_9ac53(value)
+
+async func entry(value: i32) -> i32:
+    defer {
+        print("cleanup executed")
+    }
+    return await worker(value)
+'''
+def audit(image, *extra):
+    result = json.loads(run([auditor, 'audit-stage-b', 'linux-x64', image, *canaries, *extra]).stdout)
+    assert result['inspected'], result
+    return result
+
+with tempfile.TemporaryDirectory(prefix='void-private-b-') as temp:
+    root = Path(temp)
+    private = root / 'private'
+    private.mkdir(mode=0o700)
+    source = root / canaries[0] / 'fixture.void'
+    source.parent.mkdir()
+    evidence = []
+    retained_source = sync.replace('    var source_snippet', '    defer {\n        print("retained cleanup")\n    }\n    var source_snippet', 1)
+    for kind, text in [('sync', sync), ('async', async_source), ('retained', retained_source)]:
+        source.write_text(text)
+        for mode in ['O0', 'O2']:
+            stem = kind + '-' + mode
+            obj, linked, final = [root / (stem + ext) for ext in ['.o', '.linked', '.final']]
+            mapfile, symbols = private / (stem + '.vdiag'), private / (stem + '.debug')
+            semantic_digest = hashlib.sha256((text + mode + kind).encode() + hashlib.sha256(compiler.read_bytes()).digest()).hexdigest()
+            process = subprocess.Popen(list(map(str, [emitter, 'emit', source, obj, mapfile, final, mode, kind, semantic_digest])),
+                                       stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+            try:
+                assert process.stdout.readline() == 'READY\n', process.stderr.read()
+                # Existing same-build native inputs and linker policy are reused.
+                run([llvm / 'clang++', *linker, obj, '-o', linked, *native[3:]])
+                run([llvm / 'llvm-objcopy', '--only-keep-debug', linked, symbols])
+                run([llvm / 'llvm-objcopy', '--strip-all', '--remove-section=.comment', linked, final])
+                process.stdin.write('FINAL\n');process.stdin.flush()
+                stdout, stderr = process.communicate(timeout=60)
+                assert process.returncode == 0, (stdout, stderr)
+            finally:
+                if process.poll() is None:
+                    process.kill();process.communicate()
+            result = audit(final)
+            # Native dependencies may retain their existing producer RUNPATH.
+            # Stage B does not grant a portability/closure capability.
+            assert all(f['code'] in ({'loader-path', 'forbidden-string'} if kind == 'retained' else {'loader-path'}) for f in result['findings']), result
+            assert any(f['code'] == 'forbidden-string' for f in result['findings']) == (kind == 'retained'), result
+            assert not result['debug'] and not result['static_symbols'] and result['dynamic_symbols'] and result['unwind'], result
+            assert mapfile.read_bytes() not in final.read_bytes()
+            assert 'VOID-PRIVATE-DIAGNOSTICS'.encode() not in final.read_bytes()
+            before = run([llvm / 'llvm-readobj', '--dyn-symbols', '--unwind', linked]).stdout
+            after = run([llvm / 'llvm-readobj', '--dyn-symbols', '--unwind', final]).stdout
+            assert before.split('Format:', 1)[1] == after.split('Format:', 1)[1], 'Dynamic symbols or unwind records changed during reduction'
+            # Resolve an actual linked function address using the private split
+            # symbols. No source-bearing debuglink is added to the final image.
+            assert canaries[0].encode() in symbols.read_bytes()
+            function = ('/fixture.void::' + canaries[1]).encode().hex()
+            names = run([llvm / 'llvm-nm', '--defined-only', '--format=posix', linked]).stdout.splitlines()
+            selected = next(n.split() for n in names if n.startswith('__vd_' + function + '__void '))
+            symbolicated = run([llvm / 'llvm-symbolizer', '--obj=' + str(symbols), '0x' + selected[2]]).stdout
+            assert str(source) in symbolicated, symbolicated
+            compressed = root / 'compressed-debug'
+            run([llvm / 'llvm-objcopy', '--compress-debug-sections=zlib', linked, compressed])
+            assert any(f['code'] == 'compressed-content' for f in audit(compressed)['findings'])
+            error = run([final, '7'], expected=1)
+            assert error.stdout == ('retained cleanup\n' if kind == 'retained' else '') + 'cleanup executed\n' and 'VOID-D1 ' in error.stderr
+            assert all(c not in error.stderr for c in canaries)
+            deep = run([final, '40'], expected=1)
+            assert 'Source call trace limited to 32 callers' in deep.stderr
+            assert deep.stderr.count('VOID-D1 ') == 33, deep.stderr
+            tokens = root / 'error.txt';tokens.write_text(error.stderr)
+            resolved = run([emitter, 'resolve', mapfile, final, tokens]).stdout
+            assert all(c in resolved for c in canaries), resolved
+            assert 'Division by zero' in resolved and 'source call' in resolved, resolved
+            wrong = root / 'wrong-image';wrong.write_bytes(final.read_bytes() + b'changed')
+            assert 'Mismatched private diagnostic image' in run([emitter, 'resolve', mapfile, wrong, tokens], expected=1).stderr
+            missing = root / 'empty-map';missing.write_bytes(b'')
+            assert 'Missing private diagnostic map' in run([emitter, 'resolve', missing, final, tokens], expected=1).stderr
+            # Same source, normal development lowering: full diagnostics survive.
+            devobj, dev = root / 'development.o', root / 'development'
+            run([emitter, 'development', source, devobj, mode, kind])
+            run([llvm / 'clang++', *linker, devobj, '-o', dev, *native[3:]])
+            dev_error = run([dev, '7'], expected=1)
+            assert all(c in dev_error.stderr for c in canaries), dev_error.stderr
+            assert 'VOID-D1' not in dev_error.stderr
+            assert dev_error.stdout == error.stdout
+            # Stripping alone cannot remove development diagnostic canaries.
+            stripped_dev = root / 'development-stripped'
+            run([llvm / 'llvm-objcopy', '--strip-all', dev, stripped_dev])
+            assert any(f['code'] == 'forbidden-string' for f in audit(stripped_dev)['findings'])
+            samples = {}
+            for label, image in [('development', dev), ('private', final)]:
+                timings = []
+                for _ in range(5):
+                    start = time.perf_counter_ns();run([image, '7'], expected=1);timings.append(time.perf_counter_ns() - start)
+                samples[label] = statistics.median(timings)
+            record = dict(case=stem, sha256=hashlib.sha256(final.read_bytes()).hexdigest(),
+                          development_bytes=dev.stat().st_size, linked_private_bytes=linked.stat().st_size,
+                          final_bytes=final.stat().st_size, private_map_bytes=mapfile.stat().st_size, build_id=stdout.split()[1],
+                          split_debug_bytes=symbols.stat().st_size, process_error_median_ns=samples,
+                          report=result)
+            evidence.append(record)
+            destination = os.environ.get('VOID_STAGE_B_EVIDENCE')
+            if destination:
+                saved = Path(destination) / stem
+                saved.mkdir(parents=True, mode=0o700, exist_ok=True)
+                for artifact in [source, obj, linked, final, mapfile, symbols, tokens]:
+                    shutil.copy2(artifact, saved / artifact.name)
+                (saved / 'evidence.json').write_text(json.dumps(record, indent=2))
+    assert len({item['build_id'] for item in evidence}) == len(evidence), 'Build identities must distinguish semantic inputs'
+    # Audit catches an accidentally appended map, not only source canaries.
+    contaminated = root / 'contaminated';contaminated.write_bytes(final.read_bytes() + mapfile.read_bytes())
+    assert any(f['code'] == 'private-diagnostic-map' for f in audit(contaminated)['findings'])
+    print(json.dumps(evidence, indent=2))
+print('Stage B linked-byte canaries, private maps, ABI failure status and development diagnostics passed')
diff --git a/tests/project/private_diagnostics.cpp b/tests/project/private_diagnostics.cpp
new file mode 100644
--- /dev/null
+++ b/tests/project/private_diagnostics.cpp
@@ -0,0 +1,106 @@
+#include "void/backend.hpp"
+#include "void/frontend.hpp"
+#include "void/project.hpp"
+#include <fstream>
+#include <iostream>
+#include <iterator>
+#include <stdexcept>
+
+namespace {
+void require(bool ok, const char* what) { if(!ok)throw std::runtime_error(what); }
+template<class F> void rejects(F f) { try {f();} catch(const std::invalid_argument&) {return;} throw std::runtime_error("Expected diagnostic rejection"); }
+std::string read(const char* path) {
+    std::ifstream in(path,std::ios::binary);if(!in)throw std::runtime_error("Cannot read qualification input");
+    return {std::istreambuf_iterator<char>(in),{}};
+}
+}
+int main(int argc,char** argv) { try {
+    using namespace vd::diagnostics;
+    if(argc==9 && std::string_view(argv[1])=="emit") {
+        auto analysis=vd::analyze_project(argv[2]);
+        if(!analysis.succeeded())throw vd::CompilationError(analysis.diagnostics);
+        auto module=analysis.program->lower();
+        module.async_root=std::string_view(argv[7])=="async";
+        bool optimize=std::string_view(argv[6])=="O2";
+        auto map=vd::emit_publication_object(module,argv[3],optimize,argv[8]);
+        // Python owns final-link/split/strip/audit sequencing. Keep the draft
+        // in memory until final bytes exist; no draft map goes to disk.
+        std::cout<<"READY\n"<<std::flush;std::string ready;
+        if(!std::getline(std::cin,ready) || ready!="FINAL")throw std::runtime_error("No final image");
+        map.bind_image(read(argv[5]));auto bytes=map.encode();
+        std::ofstream out(argv[4],std::ios::binary);out.write(bytes.data(),bytes.size());out.close();
+        require(bool(out),"Private map write failed");
+        for(const auto& site:map.sites())require(!site.path.empty(),"Lost original source mapping");
+        std::cout<<"MAP "<<map.build_id()<<" "<<map.image_sha256()<<" "<<map.sites().size()<<'\n';return 0;
+    }
+    if(argc==5 && std::string_view(argv[1])=="resolve") {
+        auto map=read(argv[2]),image=read(argv[3]),tokens=read(argv[4]);std::size_t count=0;
+        while(!tokens.empty()) {
+            auto begin=tokens.find("VOID-D1 ");if(begin==tokens.npos)break;
+            tokens.erase(0,begin);auto end=tokens.find('\n');require(end!=tokens.npos,"Truncated public token");
+            auto site=PrivateMap::resolve(map,image,std::string_view(tokens).substr(0,end+1));
+            std::cout<<static_cast<unsigned>(site.category)<<" "<<site.path<<":"<<site.line<<":"<<site.column<<" "<<site.function<<" "<<site.description<<"\n"<<site.excerpt<<"\n";
+            tokens.erase(0,end+1);++count;
+        }
+        require(count>0,"No diagnostic tokens resolved");return 0;
+    }
+    if(argc==6 && std::string_view(argv[1])=="development") {
+        auto analysis=vd::analyze_project(argv[2]);if(!analysis.succeeded())throw vd::CompilationError(analysis.diagnostics);
+        auto module=analysis.program->lower();module.async_root=std::string_view(argv[5])=="async";
+        vd::emit_object(module,argv[3],std::string_view(argv[4])=="O2",true,{},vd::project::DebugInfo::full);return 0;
+    }
+    PrivateMap map(std::string(64,'a'));
+    Site original{Category::arithmetic,"/canary.void::secret","/private/canary.void","return value / zero","Division by zero",7,9};
+    auto failure=map.add(original),frame=map.add({Category::call,"caller","/private/canary.void","return secret()","source call",11,4});
+    require(failure!=frame,"Site identities collide");rejects([&]{map.encode();});
+    map.bind_image("exact final image");auto bytes=map.encode();auto round=PrivateMap::decode(bytes);
+    require(round.encode()==bytes,"Map round trip changed");
+    auto site=PrivateMap::resolve(bytes,"exact final image",failure);
+    require(site.path==original.path && site.excerpt==original.excerpt && site.function==original.function && site.line==7 && site.column==9,"Private mapping changed");
+    rejects([&]{map.add(original);});rejects([&]{map.bind_image("other");});
+    rejects([&]{PrivateMap::resolve({},"exact final image",failure);});
+    rejects([&]{PrivateMap::resolve(bytes,"wrong image",failure);});
+    PrivateMap other(std::string(64,'b'));auto wrong=other.add(original);other.bind_image("exact final image");
+    rejects([&]{PrivateMap::resolve(other.encode(),"exact final image",failure);});
+    rejects([&]{PrivateMap::resolve(bytes,"exact final image",wrong);});
+    require(category("Division by zero")==Category::arithmetic && category("Null supplied")==Category::null_value && category("index out of bounds")==Category::bounds,"Public category contract changed");
+    auto unknown=failure;unknown.replace(unknown.find(" 1 "),3," 999999 ");
+    rejects([&]{PrivateMap::resolve(bytes,"exact final image",unknown);});
+    auto wrong_category=failure;wrong_category[wrong_category.size()-2]='1';
+    rejects([&]{PrivateMap::resolve(bytes,"exact final image",wrong_category);});
+    for(auto token:{failure+"x",std::string("VOID-D2 ")+failure.substr(8),failure.substr(0,failure.size()-1)})rejects([&]{PrivateMap::resolve(bytes,"exact final image",token);});
+    // Exact tokens reject alternate spellings, overflow, separators and NULs.
+    const auto prefix=failure.substr(0,failure.find(" 1 ")+1);
+    for(const auto* tail:{"0 2\n","01 2\n","+1 2\n","-1 2\n","4294967296 2\n","1 02\n","1 +2\n","1 2\r\n","1 2\nextra","1 2 \n","1\t2\n","1  2\n","1 7\n"})
+        rejects([&]{PrivateMap::resolve(bytes,"exact final image",prefix+tail);});
+    rejects([&]{PrivateMap::resolve(bytes,"exact final image",failure+std::string(1,'\0'));});
+    auto upper=failure;upper[8]='A';rejects([&]{PrivateMap::resolve(bytes,"exact final image",upper);});
+    rejects([&]{PrivateMap empty(std::string(64,'a'));empty.bind_image({});});
+    // Serialized identity fields, counts and categories cannot bypass limits.
+    auto put=[](std::string& out,std::size_t offset,std::uint32_t value) {
+        for(unsigned i=0;i<4;++i)out[offset+i]=char(value>>(8*i));
+    };
+    for(auto value:{0u,65u,1024u*1024u+1u,0xffffffffu}) {
+        auto invalid=bytes;put(invalid,24,value);rejects([&]{PrivateMap::decode(invalid);});
+    }
+    for(auto value:{65537u,0xffffffffu}) {
+        auto invalid=bytes;put(invalid,160,value);rejects([&]{PrivateMap::decode(invalid);});
+    }
+    for(auto value:{0u,7u,0xffffffffu}) {
+        auto invalid=bytes;put(invalid,164,value);rejects([&]{PrivateMap::decode(invalid);});
+    }
+    PrivateMap total(std::string(64,'d'));
+    Site large{Category::runtime,std::string(1024*1024,'x')};
+    for(unsigned i=0;i<15;++i)(void)total.add(large);
+    rejects([&]{total.add(large);});
+    total.bind_image("bounded image");require(total.encode().size()<=map_byte_limit,"Encoded total exceeded limit");
+    for(std::size_t n=0;n<bytes.size();++n)rejects([&]{PrivateMap::decode(std::string_view(bytes).substr(0,n));});
+    rejects([&]{PrivateMap::decode(bytes+"x");});
+    auto corrupt=bytes;corrupt[0]='X';rejects([&]{PrivateMap::decode(corrupt);});
+    corrupt=bytes;corrupt[24]=char(0xff);rejects([&]{PrivateMap::decode(corrupt);});
+    rejects([&]{PrivateMap::decode(std::string(map_byte_limit+1,'x'));});
+    rejects([&]{PrivateMap bad("not-a-digest");});
+    PrivateMap bounded(std::string(64,'c'));for(std::size_t i=0;i<site_limit;++i)(void)bounded.add({});rejects([&]{bounded.add({});});
+    rejects([&]{PrivateMap m(std::string(64,'c'));m.add({Category::runtime,{}, {},std::string(1024*1024+1,'x')});});
+    std::cout<<"Private diagnostic map bounds, identities and round trips passed\n";return 0;
+} catch(const std::exception& e) {std::cerr<<e.what()<<'\n';return 1;} }
diff --git a/tests/project/publish.cpp b/tests/project/publish.cpp
new file mode 100644
--- /dev/null
+++ b/tests/project/publish.cpp
@@ -0,0 +1,80 @@
+#include "void/publish.hpp"
+#include "void/binary_audit.hpp"
+#include <algorithm>
+#include <fstream>
+#include <iostream>
+#include <type_traits>
+
+namespace {
+unsigned checks=0;
+void check(bool value,const char* what) {++checks;if(!value)throw std::runtime_error(what);}
+template<class F> void rejected(F action,const char* what) {
+    bool failed=false;try {action();}catch(const std::exception&) {failed=true;}check(failed,what);
