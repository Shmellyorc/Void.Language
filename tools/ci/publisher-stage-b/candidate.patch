diff --git a/include/void/binary_audit.hpp b/include/void/binary_audit.hpp
new file mode 100644
--- /dev/null
+++ b/include/void/binary_audit.hpp
@@ -0,0 +1,31 @@
+#pragma once
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace vd::audit {
+struct Finding { std::string code, detail; std::uint64_t offset = 0; };
+struct Policy {
+    unsigned revision = 1; // v2 permits required dynamic symbols, rejects static symbols
+    std::string target; // exactly linux-x64, windows-x64 or macos-arm64
+    bool reject_debug = true, reject_symbols = true, reject_loader_paths = true;
+    std::vector<std::string> forbidden_strings;
+};
+struct Report {
+    unsigned schema = 1;
+    bool inspected = false; // structural inspection, never closure/protection approval
+    std::string format, architecture, image_kind, sha256, interpreter;
+    std::vector<std::string> dependencies, versions, loader_paths;
+    bool symbols = false, debug = false;
+    bool static_symbols = false, dynamic_symbols = false, unwind = false;
+    std::vector<Finding> findings;
+};
+inline constexpr std::size_t byte_limit = 64 * 1024 * 1024;
+inline constexpr std::size_t record_limit = 4096;
+// Owned report from caller-owned bytes. No file opening, loading, execution,
+// subprocesses, environment access or mutation. ELF64LE, PE32+ and thin Mach-O64LE
+// declarations only. Archives/universal images and other variants fail closed.
+Report inspect(std::string_view bytes, const Policy&);
+std::string json(const Report&);
+}
diff --git a/include/void/private_diagnostics.hpp b/include/void/private_diagnostics.hpp
new file mode 100644
--- /dev/null
+++ b/include/void/private_diagnostics.hpp
@@ -0,0 +1,41 @@
+#pragma once
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace vd::diagnostics {
+inline constexpr std::size_t map_byte_limit = 16 * 1024 * 1024;
+inline constexpr std::size_t site_limit = 65536;
+// Public categories are deliberately independent of source text and ABI names.
+enum class Category : std::uint32_t { runtime = 1, arithmetic, bounds, null_value, call, global };
+struct Site {
+    Category category = Category::runtime;
+    std::string function, path, excerpt, description;
+    std::uint32_t line = 0, column = 0;
+};
+// A draft cannot be serialized/resolved until bound to the exact final image.
+// Contains private plaintext. Persistence/owner-only placement is the caller's
+// responsibility; never put this object or its serialization in an app bundle.
+class PrivateMap {
+    std::string build_, image_;
+    std::vector<Site> sites_;
+    std::size_t bytes_ = 0;
+public:
+    // Digest of normalized semantic inputs supplied by a future admitted plan,
+    // including target/toolchain/policy and source content, excluding host paths.
+    explicit PrivateMap(std::string_view semantic_inputs_sha256);
+    const auto& build_id() const { return build_; }
+    const auto& image_sha256() const { return image_; }
+    const auto& sites() const { return sites_; }
+    std::string add(Site);
+    void bind_image(std::string_view final_image_bytes);
+    std::string encode() const;
+    static PrivateMap decode(std::string_view);
+    // Exact public token, not arbitrary stderr. Throws for a missing map,
+    // malformed/unknown token, wrong build, wrong category or wrong image.
+    static Site resolve(std::string_view map, std::string_view final_image_bytes,
+                        std::string_view token);
+};
+Category category(std::string_view description);
+}
