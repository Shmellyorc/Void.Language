struct box:
    value: i32
struct owner:
    const child: box
struct holder:
    const child: box
func wrap(item: owner) -> i32:
    var alias = item
    var temporary: holder? = holder(child = alias.child)
    var total = 0
    if alias.child.value % 2 == 0:
        if alias.child.value % 3 == 0:
            total += (temporary as holder).child.value + 1
        else:
            total += (temporary as holder).child.value + 2
    else:
        total += (temporary as holder).child.value + 3
    return total
func entry(n: i32) -> i32:
    var total = 0
    for index in 0..<n:
        total += wrap(owner(child = box(value = index % 97)))
    return total
