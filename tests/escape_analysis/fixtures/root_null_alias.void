struct box:
    value: i32
struct holder:
    child: box
func entry(n: i32) -> i32:
    var total = 0
    for index in 0..<n:
        var item: box? = null
        var alias = item
        item = box(value = 5)
        if alias == null:
            total += 1
        total += (item as box).value + holder(child = box(value = index % 97)).child.value
    return total
