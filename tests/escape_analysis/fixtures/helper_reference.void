struct box:
    value: i32
struct holder:
    child: box
private func read(item: holder) -> i32:
    return item.child.value
func entry(n: i32) -> i32:
    var total: i32 = 0
    for index in 0..<n:
        var child = box(value = index % 97)
        var item = holder(child = child)
        total += read(item)
    return total
