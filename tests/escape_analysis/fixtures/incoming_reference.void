struct box:
    value: i32
struct holder:
    child: box
func wrap(child: box) -> i32:
    var item = holder(child = child)
    if item.child.value < 0:
        return -1
    return item.child.value
func entry(n: i32) -> i32:
    var total = 0
    for index in 0..<n:
        total += wrap(box(value = index % 97))
    return total
