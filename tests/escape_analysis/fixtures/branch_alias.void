struct box:
    value: i32
func entry(n: i32) -> i32:
    var total: i32 = 0
    for index in 0..<n:
        var item = box(value = index % 97)
        var alias = item
        if index % 2 == 0:
            alias.value += 1
        else:
            item.value += 2
        total += alias.value
    return total
