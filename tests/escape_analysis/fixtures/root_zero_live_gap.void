struct box:
    value: i32
private func make(value: i32) -> box:
    return box(value = value)
private func read(item: box) -> i32:
    return item.value
func entry(n: i32) -> i32:
    var total = 0
    for index in 0..<n:
        var keeper = make(index % 97 + 3)
        var first = make(index % 97)
        var gap = make(index % 97 + 1)
        var last = make(index % 97 + 2)
        total += first.value + last.value
        total += read(keeper)
        total += gap.value
    return total
