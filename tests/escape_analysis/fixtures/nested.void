struct box:
    value: i32
struct branch:
    child: box
struct tree:
    branch: branch
func entry(n: i32) -> i32:
    var total: i32 = 0
    for index in 0..<n:
        var child = box(value = index % 97)
        var middle = branch(child = child)
        var item = tree(branch = middle)
        if index % 2 == 0:
            total += item.branch.child.value
        else:
            total += item.branch.child.value
    return total
