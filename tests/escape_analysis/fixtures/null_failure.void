struct box:
    value: i32
struct holder:
    child: box?
func entry(n: i32) -> i32:
    var item = holder()
    if n < 0:
        return (item.child as box).value
    var total = 0
    for index in 0..<n:
        item.child = box(value = index % 97)
        total += (item.child as box).value
    return total
