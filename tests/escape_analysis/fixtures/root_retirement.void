struct box:
    value: i32
struct holder:
    child: box
private func make(value: i32) -> box:
    return box(value = value)
private func read(item: holder) -> i32:
    return item.child.value
func entry(n: i32) -> i32:
    var total = 0
    for index in 0..<n:
        var owner = holder(child = make(index % 97))
        total += read(owner)
        if index >= 0:
            var empty: box? = null
            if empty != null:
                total += 100
    return total
