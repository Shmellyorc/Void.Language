struct box:
    value: i32
struct owner:
    child: box
struct holder:
    const child: box
func entry(n: i32) -> i32:
    var total = 0
    for index in 0..<n:
        var local = owner(child = box(value = index % 97))
        var alias = local
        total += holder(child = alias.child).child.value
    return total
