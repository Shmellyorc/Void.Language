var order: i32 = 0
struct box:
    value: i32
struct pair:
    first: box
    second: box
private func make(value: i32) -> box:
    order = order * 10 + value
    return box(value = value)
func entry(n: i32) -> i32:
    var total = 0
    for index in 0..<n:
        order = 0
        var item = pair(first = make(1), second = make(2))
        if index % 2 == 0:
            total += item.first.value + item.second.value + order
        else:
            total += item.first.value + item.second.value + order
    return total
