struct box:
    value: i32
struct holder:
    child: box
func make(value: i32) -> box:
    return box(value = value)
func entry(n: i32) -> i32:
    var total = 0
    for index in 0..<n:
        var item = holder(child = make(index % 97))
        if index % 2 == 0:
            total += item.child.value
        else:
            total += item.child.value
    return total
