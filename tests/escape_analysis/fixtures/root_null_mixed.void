struct box:
    value: i32
struct holder:
    child: box
func entry(n: i32) -> i32:
    var total = 0
    for index in 0..<n:
        var item: box? = null
        if index % 2 == 0:
            item = box(value = 5)
        else:
            item = null
        if item != null:
            total += (item as box).value
        total += holder(child = box(value = index % 97)).child.value
    return total
