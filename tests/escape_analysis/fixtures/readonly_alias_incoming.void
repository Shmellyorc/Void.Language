struct box:
    value: i32
struct owner:
    const child: box
struct holder:
    const child: box
func wrap(item: owner) -> i32:
    var alias = item
    return holder(child = alias.child).child.value
func entry(n: i32) -> i32:
    var total = 0
    for index in 0..<n:
        total += wrap(owner(child = box(value = index % 97)))
    return total
