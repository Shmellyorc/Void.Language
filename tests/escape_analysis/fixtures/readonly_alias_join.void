struct box:
    value: i32
struct owner:
    const child: box
struct holder:
    const child: box
func entry(n: i32) -> i32:
    var total = 0
    for index in 0..<n:
        var local = owner(child = box(value = index % 97))
        if index % 2 == 0:
            local = owner(child = box(value = index % 97 + 1))
        else:
            total += 0
        var alias = local
        total += holder(child = alias.child).child.value
    return total
