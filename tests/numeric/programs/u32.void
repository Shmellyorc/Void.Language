const folded_0: u32 = (4294967295) + (1)
const folded_1: u32 = (0) - (1)
const folded_2: u32 = (4294967295) * (3)
const folded_3: u32 = (0) * (4294967295)
const folded_4: u32 = (7) / (3)
const folded_5: u32 = (7) % (3)
const folded_6: u32 = (4294967295) / (3)
const folded_7: u32 = (4294967295) % (3)
const folded_8: u32 = (4294967295) + (4294967295)
const folded_9: u32 = (0) - (4294967295)

func compute_0(a: u32, b: u32) -> u32:
    return a + b

func compute_1(a: u32, b: u32) -> u32:
    return a - b

func compute_2(a: u32, b: u32) -> u32:
    return a * b

func compute_3(a: u32, b: u32) -> u32:
    return a * b

func compute_4(a: u32, b: u32) -> u32:
    return a / b

func compute_5(a: u32, b: u32) -> u32:
    return a % b

func compute_6(a: u32, b: u32) -> u32:
    return a / b

func compute_7(a: u32, b: u32) -> u32:
    return a % b

func compute_8(a: u32, b: u32) -> u32:
    return a + b

func compute_9(a: u32, b: u32) -> u32:
    return a - b

func entry(value: i32) -> i32:
    var seed: u32 = value as u32
    if folded_0 != 0 or compute_0((4294967295) + seed - seed, 1) != 0:
        return 2
    if folded_1 != 4294967295 or compute_1((0) + seed - seed, 1) != 4294967295:
        return 3
    if folded_2 != 4294967293 or compute_2((4294967295) + seed - seed, 3) != 4294967293:
        return 4
    if folded_3 != 0 or compute_3((0) + seed - seed, 4294967295) != 0:
        return 5
    if folded_4 != 2 or compute_4((7) + seed - seed, 3) != 2:
        return 6
    if folded_5 != 1 or compute_5((7) + seed - seed, 3) != 1:
        return 7
    if folded_6 != 1431655765 or compute_6((4294967295) + seed - seed, 3) != 1431655765:
        return 8
    if folded_7 != 0 or compute_7((4294967295) + seed - seed, 3) != 0:
        return 9
    if folded_8 != 4294967294 or compute_8((4294967295) + seed - seed, 4294967295) != 4294967294:
        return 10
    if folded_9 != 1 or compute_9((0) + seed - seed, 4294967295) != 1:
        return 11
    var default_value: u32
    if default_value != 0:
        return 99
    var counter: u32 = 0
    for counter < 3:
        counter++
    counter *= 2
    counter /= 3
    counter %= 2
    if counter != 0:
        return 98
    var negated: u32 = -seed
    if negated + seed != 0:
        return 97
    return 1
