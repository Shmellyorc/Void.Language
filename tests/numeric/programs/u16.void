const folded_0: u16 = (65535) + (1)
const folded_1: u16 = (0) - (1)
const folded_2: u16 = (65535) * (3)
const folded_3: u16 = (0) * (65535)
const folded_4: u16 = (7) / (3)
const folded_5: u16 = (7) % (3)
const folded_6: u16 = (65535) / (3)
const folded_7: u16 = (65535) % (3)
const folded_8: u16 = (65535) + (65535)
const folded_9: u16 = (0) - (65535)

func compute_0(a: u16, b: u16) -> u16:
    return a + b

func compute_1(a: u16, b: u16) -> u16:
    return a - b

func compute_2(a: u16, b: u16) -> u16:
    return a * b

func compute_3(a: u16, b: u16) -> u16:
    return a * b

func compute_4(a: u16, b: u16) -> u16:
    return a / b

func compute_5(a: u16, b: u16) -> u16:
    return a % b

func compute_6(a: u16, b: u16) -> u16:
    return a / b

func compute_7(a: u16, b: u16) -> u16:
    return a % b

func compute_8(a: u16, b: u16) -> u16:
    return a + b

func compute_9(a: u16, b: u16) -> u16:
    return a - b

func entry(value: i32) -> i32:
    var seed: u16 = value as u16
    if folded_0 != 0 or compute_0((65535) + seed - seed, 1) != 0:
        return 2
    if folded_1 != 65535 or compute_1((0) + seed - seed, 1) != 65535:
        return 3
    if folded_2 != 65533 or compute_2((65535) + seed - seed, 3) != 65533:
        return 4
    if folded_3 != 0 or compute_3((0) + seed - seed, 65535) != 0:
        return 5
    if folded_4 != 2 or compute_4((7) + seed - seed, 3) != 2:
        return 6
    if folded_5 != 1 or compute_5((7) + seed - seed, 3) != 1:
        return 7
    if folded_6 != 21845 or compute_6((65535) + seed - seed, 3) != 21845:
        return 8
    if folded_7 != 0 or compute_7((65535) + seed - seed, 3) != 0:
        return 9
    if folded_8 != 65534 or compute_8((65535) + seed - seed, 65535) != 65534:
        return 10
    if folded_9 != 1 or compute_9((0) + seed - seed, 65535) != 1:
        return 11
    var default_value: u16
    if default_value != 0:
        return 99
    var counter: u16 = 0
    for counter < 3:
        counter++
    counter *= 2
    counter /= 3
    counter %= 2
    if counter != 0:
        return 98
    var negated: u16 = -seed
    if negated + seed != 0:
        return 97
    return 1
