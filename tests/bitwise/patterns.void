enum packet<t>:
    empty
    value(data: t)
value struct box<t>:
    item: t
enum mode<t>(u8):
    one = 1
flags enum mask<t>(u8):
    one
    two
value struct factory<t>:
    item: t?
## Produce a typed-owner value for pattern expressions.
## @return One.
static func factory<t>.one() -> i32:
    return 1
## Preserve a method-generic argument.
## @param value Argument to preserve.
## @return The supplied argument.
static func factory<t>.echo<u>(value: u) -> u:
    return value
var probes = 0
## Supply a runtime value for shifted value-pattern tests.
## @return One, incrementing the observable call count once.
func probe() -> i32:
    probes += 1
    return 1
## Preserve a concrete argument in a value-pattern call.
## @param value Argument to preserve.
## @return The supplied concrete value.
func identity<t>(value: t) -> t:
    return value
func main() -> i32:
    var bits = 1
    match 2:
        probe() << 1:
            pass
        _:
            return 1
    if not (2 is probe() << 1) or not (1 is probe() >> 0):
        return 2
    match 1:
        probe() >> 0:
            pass
        _:
            return 3
    if probes != 4:
        return 4
    if not (1 is bits << 1 >> 1) or not (1 is bits<<1>>1):
        return 5
    match 1:
        bits << 1 >> 1:
            pass
        _:
            return 6
    match 1:
        identity<i32>(1) << 0:
            pass
        _:
            return 7
    if not (1 is identity<i32>(1) >> 0):
        return 8
    # Parenthesized and addition controls keep existing binding.
    if not (2 is (probe() << 1)) or not (2 is probe() + 1):
        return 9
    if not (1 is probe() << 1 >> 1) or not (2 is probe() << identity<i32>(1)):
        return 10
    match 1:
        bits << 2 >> 2:
            pass
        _:
            return 11
    var held = packet<box<i32>>.value(box<i32>(item = 7))
    if held is packet<box<i32>>.value(var payload):
        if payload.item != 7:
            return 12
    else:
        return 13
    match held:
        packet<box<i32>>.empty:
            return 14
        packet<box<i32>>.value(box(item = var inner)):
            if inner != 7:
                return 15
    if held is packet<box<i32>>(var whole):
        if not (whole is packet<box<i32>>.value(_)):
            return 16
    else:
        return 17
    var number = mode<box<i32>>.one
    if not (number is mode<box<i32>>.one) or not (number is mode<box<i32>>(_)):
        return 18
    var flags = mask<box<i32>>.one | mask<box<i32>>.two
    if not (flags is mask<box<i32>>(_)) or not (flags is (mask<box<i32>>.one | mask<box<i32>>.two)):
        return 19
    var nested = identity<box<box<i32>>>(box<box<i32>>(item = box<i32>(item = 9)))
    if nested.item.item != 9:
        return 20
    match 2:
        factory<box<i32>>.one() << 1:
            pass
        _:
            return 21
    if not (1 is factory<i32>.echo<i32>(1) >> 0):
        return 22
    print("shift patterns and generic boundaries preserved")
    return 0
