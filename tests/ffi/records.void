use "/native_records.void" as ffi

func entry(value: i32) -> i32:
    var bytes: [u8] = [10, 20, 30, 40]
    if value == -1:
        return ffi.fill(bytes, 0, 5, 8) as i32
    if value == -2:
        return ffi.move_bytes(bytes, 0, 2, bytes, 1, 2) as i32
    if value == -3:
        return ffi.fill(bytes, 0, 4, 254) as i32
    if value == -4:
        return ffi.fill(bytes, 18446744073709551615 as u64, 1, 8) as i32
    var original = ffi.rgba(r = 4, g = 5, b = 7, a = 255)
    var color = ffi.color(original)
    if color.r != 7 or color.b != 4 or color.g != 5 or color.a != 255 or original.r != 4:
        return 1
    var baseline = ffi.sample(tag = -9, reading = 3.25)
    var sample = ffi.calibrate(baseline, 2.0 as f32)
    if sample.tag != -16 or sample.reading != 6.5:
        return 2
    var channels: [u16, 3] = [100, 200, 60000]
    var payload = ffi.packet(color = original, channels = channels, mode = 17, datum = sample)
    var returned = ffi.packet_mix(baseline, payload, 8)
    if returned.color.r != 7 or returned.channels[0] != 60008 or returned.channels[1] != 200 or returned.channels[2] != 100:
        return 3
    if returned.mode != 25 or returned.datum.tag != -25 or returned.datum.reading != 9.75 or payload.channels[0] != 100:
        return 4
    if ffi.sum(bytes, 1, 2) != 50 or ffi.sum(bytes, 4, 0) != 0 or ffi.fill(bytes, 4, 0, 1) != 0:
        return 5
    if ffi.fill(bytes, 1, 2, 255) != -7 or bytes[1] != 20 or bytes[2] != 30:
        return 6
    if ffi.fill(bytes, 1, 2, 253) != 1 or bytes[1] != 42 or bytes[2] != 30:
        return 7
    if ffi.fill(bytes, 1, 2, 5) != 2 or bytes[0] != 10 or bytes[1] != 5 or bytes[2] != 6 or bytes[3] != 40:
        return 8
    if ffi.adjust(bytes, 1, 2) != 2 or bytes[1] != 80 or bytes[2] != 83:
        return 9
    if ffi.move_bytes(bytes, 0, 2, bytes, 2, 2) != 2 or bytes[2] != 10 or bytes[3] != 80:
        return 10
    var maximum: [u8] = []
    for i in 0..<64:
        maximum.push(0)
    if ffi.fill(maximum, 0, 64, 1) != 64 or ffi.sum(maximum, 0, 64) != 2080 or maximum[63] != 64:
        return 11
    return value + 96
