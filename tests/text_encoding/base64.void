use encoding/base64


func main() -> i32:
    var plain = ["", "f", "fo", "foo", "foob", "fooba", "foobar"]
    var expected = ["", "Zg==", "Zm8=", "Zm9v", "Zm9vYg==", "Zm9vYmE=", "Zm9vYmFy"]

    for index in 0..<plain.count:
        if base64.try_encode(plain[index].to_utf8()) is Ok(var encoded):
            if encoded != expected[index]:
                return 1
        else:
            return 2

        if base64.decode(expected[index]) is Ok(var decoded):
            if string.from_utf8(decoded) is Ok(var restored):
                if restored != plain[index]:
                    return 3
            else:
                return 4
        else:
            return 5

    for malformed in ["A", "AA", "AAA", "AAAA=", "=AAA", "A===", "====", "AA=A", "AB==", "AAB=", "AA==\n", "AA\0=", "--__", "雪"]:
        if base64.decode(malformed) is Ok(var invalid):
            return 6

    for malformed in ["A", "Zg=", "Zg==", "AB", "AAB", "+/8", "AA A"]:
        if base64.decode(malformed, base64.alphabet.url_safe, base64.padding.omitted) is Ok(var invalid):
            return 7

    if base64.try_encode([251, 255, 255], base64.alphabet.url_safe, base64.padding.omitted) is Ok(var url):
        if url != "-___":
            return 8
    else:
        return 9

    if base64.decode("-_8", base64.alphabet.url_safe, base64.padding.omitted) is Ok(var url_bytes):
        if url_bytes.count != 2 or url_bytes[0] != 251 or url_bytes[1] != 255:
            return 10
    else:
        return 11

    if base64.decode("Zg", pad = base64.padding.omitted) is Ok(var single):
        if single.count != 1 or single[0] != 102:
            return 12
    else:
        return 13

    if base64.encode("f".to_utf8()) != "Zg==":
        return 14

    if base64.encode([251, 255], selected = base64.alphabet.url_safe, pad = base64.padding.omitted) != "-_8":
        return 15

    return 0
