use io

struct notification:
    value: i32

async func close_pending(handle: io.file) -> i32:
    var outcome = await handle.close_async()

    if outcome is Err(var reason):
        if reason.kind is io.error_kind.busy:
            var marker = notification(value = 1234567)
            return marker.value

    return 0

async func entry(input: i32) -> i32:
    var opened = await io.open_async("blocked file.bin")

    if opened is Ok(var handle):
        with handle as scope:
            var blocked = handle.read_exact_async(7)
            var other = close_pending(handle)
            var marker = await other
            var outcome = await blocked

            if outcome is Ok(var bytes):
                var closed = await handle.close_async()

                if marker == 1234567 and bytes.count == 7 and closed is Ok(var count):
                    return 7

    return 1
