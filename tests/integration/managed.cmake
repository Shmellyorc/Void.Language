foreach(mode normal optimized)
  set(flags)
  if(mode STREQUAL "normal")
    set(flags --no-opt)
  endif()
  foreach(program main handoffs order imports numeric null_failure)
    set(source "${ROOT}/examples/managed_structs/${program}.void")
    set(executable "${BIN}/void_managed_cli_${program}_${mode}${EXE_SUFFIX}")
    foreach(input -1 0 10)
      foreach(engine jit aot)
        if(engine STREQUAL "jit")
          execute_process(COMMAND "${COMPILER}" run "${source}" "${input}" ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
        else()
          execute_process(COMMAND "${executable}" "${input}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
        endif()
        if(program STREQUAL "null_failure")
          string(APPEND errors "${output}")
          if(NOT status EQUAL 1 OR NOT errors MATCHES "Null managed reference" OR NOT errors MATCHES "null_failure.void:5:" OR NOT errors MATCHES "Called from")
            message(FATAL_ERROR "Missing source null diagnostic: ${mode}/${engine}: ${status}, ${errors}")
          endif()
        else()
          if(program STREQUAL "main")
            math(EXPR expected "${input} * 2 + 3")
          elseif(program STREQUAL "handoffs")
            math(EXPR expected "${input} + 38")
          elseif(program STREQUAL "numeric")
            math(EXPR expected "${input} + 590")
          elseif(program STREQUAL "imports")
            math(EXPR expected "${input} + 2")
          else()
            set(expected 221)
          endif()
          string(STRIP "${output}" output)
          if(NOT status EQUAL 0 OR NOT output STREQUAL "${expected}")
            message(FATAL_ERROR "Managed source ${program}/${mode}/${engine}(${input}): ${status}, ${output}, ${errors}")
          endif()
        endif()
      endforeach()
    endforeach()
  endforeach()
endforeach()
