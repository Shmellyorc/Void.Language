foreach(mode normal optimized)
  set(flags)
  if(mode STREQUAL "normal")
    set(flags --no-opt)
  endif()
  foreach(program copies readonly initialization templates methods staged order imports required stress null_failure)
    foreach(input -1 0 10)
      foreach(engine jit aot)
        if(engine STREQUAL "jit")
          execute_process(COMMAND "${COMPILER}" run "${ROOT}/examples/reference_values/${program}.void" "${input}" ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
        else()
          execute_process(COMMAND "${BIN}/void_reference_values_cli_${program}_${mode}${EXE_SUFFIX}" "${input}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
        endif()
        if(program STREQUAL "null_failure")
          string(APPEND errors "${output}")
          if(NOT status EQUAL 1 OR NOT errors MATCHES "Null managed reference" OR NOT errors MATCHES "null_failure.void:8:" OR NOT errors MATCHES "Called from")
            message(FATAL_ERROR "Missing nested reference diagnostic ${mode}/${engine}: ${status}, ${errors}")
          endif()
        else()
          if(program STREQUAL "copies")
            math(EXPR expected "${input} + 22")
          elseif(program STREQUAL "readonly")
            math(EXPR expected "${input} + 26")
          elseif(program STREQUAL "initialization")
            math(EXPR expected "${input} + 8")
          elseif(program STREQUAL "templates" OR program STREQUAL "required")
            math(EXPR expected "${input} + 1")
          elseif(program STREQUAL "methods")
            math(EXPR expected "${input} + 10")
          elseif(program STREQUAL "staged")
            math(EXPR expected "${input} + 9")
          elseif(program STREQUAL "imports")
            math(EXPR expected "${input} + 2")
          elseif(program STREQUAL "order")
            math(EXPR expected "${input} + 34")
          else()
            math(EXPR expected "${input} * 2 + 2004")
          endif()
          string(STRIP "${output}" output)
          if(NOT status EQUAL 0 OR NOT output STREQUAL "${expected}")
            message(FATAL_ERROR "Reference values ${program}/${mode}/${engine}(${input}): ${status}, ${output}, ${errors}")
          endif()
        endif()
      endforeach()
    endforeach()
  endforeach()
endforeach()
