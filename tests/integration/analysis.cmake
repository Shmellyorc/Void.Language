include("${CMAKE_CURRENT_LIST_DIR}/native_link.cmake")
file(MAKE_DIRECTORY "${OUTPUT}")
file(COPY "${ROOT}/examples/analysis/" DESTINATION "${OUTPUT}/project")
function(check_program expected)
  foreach(mode normal optimized)
    set(flags)
    if(mode STREQUAL "normal")
      set(flags --no-opt)
    endif()
    set(object "${OUTPUT}/analysis-${expected}-${mode}.o")
    set(executable "${OUTPUT}/analysis-${expected}-${mode}${EXE_SUFFIX}")
    execute_process(COMMAND "${COMPILER}" emit "${OUTPUT}/project/main.void" -o "${object}" ${flags} RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Analysis source emission failed")
    endif()
    void_native_link("${object}" "${executable}")
    foreach(engine jit aot)
      if(engine STREQUAL "jit")
        execute_process(COMMAND "${COMPILER}" run "${OUTPUT}/project/main.void" 10 ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
      else()
        execute_process(COMMAND "${executable}" 10 RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
      endif()
      string(STRIP "${result}" result)
      if(NOT status EQUAL 0 OR NOT result STREQUAL "${expected}")
        message(FATAL_ERROR "${engine}/${mode}: expected ${expected}, got ${result}; ${errors}")
      endif()
    endforeach()
  endforeach()
endfunction()
check_program(53)
file(READ "${OUTPUT}/project/worker.void" worker)
string(REPLACE "stable + 1" "stable + 9" worker "${worker}")
file(WRITE "${OUTPUT}/project/worker.void" "${worker}")
check_program(61)
# Constant changes are legal in fresh AOT processes; reload rejection is tested in C++.
file(WRITE "${OUTPUT}/project/values.void" "const base: i32 = 41\n")
check_program(62)
