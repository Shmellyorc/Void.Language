# Invalid source cannot execute or replace an existing output, in either mode.
execute_process(COMMAND "${PYTHON}" "${ROOT}/tests/integration/utf8_diagnostics.py" "${COMPILER}"
  RESULT_VARIABLE utf8_status)
if(NOT utf8_status EQUAL 0)
  message(FATAL_ERROR "Strict UTF-8 diagnostic output regression failed: ${utf8_status}")
endif()
execute_process(COMMAND "${PYTHON}" "${ROOT}/tests/integration/semantic_depth.py" "${COMPILER}"
  RESULT_VARIABLE depth_status)
if(NOT depth_status EQUAL 0)
  message(FATAL_ERROR "Bounded semantic stack regression failed: ${depth_status}")
endif()
foreach(mode normal optimized)
  set(flags)
  if(mode STREQUAL "normal")
    set(flags --no-opt)
  endif()
  set(bad "${ROOT}/examples/diagnostics/errors.void")
  set(object "${OUTPUT}/protected-${mode}.o")
  file(WRITE "${object}" "previous valid object sentinel\n")
  file(SHA256 "${object}" before)
  foreach(command check run emit)
    set(arguments)
    if(command STREQUAL "run")
      set(arguments 10)
    elseif(command STREQUAL "emit")
      set(arguments -o "${object}")
    endif()
    execute_process(COMMAND "${COMPILER}" "${command}" "${bad}" ${arguments} ${flags}
      RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE diagnostic TIMEOUT 10)
    if(NOT status EQUAL 1 OR NOT result STREQUAL "" OR NOT diagnostic MATCHES "VOID2001" OR NOT diagnostic MATCHES "VOID2007" OR NOT diagnostic MATCHES "VOID2003" OR diagnostic MATCHES "LLVM")
      message(FATAL_ERROR "Invalid code gate failed for ${command}/${mode}: ${status}, ${result}, ${diagnostic}")
    endif()
    file(SHA256 "${object}" after)
    if(NOT before STREQUAL after)
      message(FATAL_ERROR "Invalid source replaced the previous object")
    endif()
  endforeach()
  set(fresh "${OUTPUT}/never-created-${mode}.o")
  file(REMOVE "${fresh}")
  execute_process(COMMAND "${COMPILER}" emit "${bad}" -o "${fresh}" ${flags}
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
  if(NOT status EQUAL 1 OR EXISTS "${fresh}")
    message(FATAL_ERROR "Partial invalid object published")
  endif()
  set(good "${ROOT}/examples/diagnostics/corrected.void")
  set(executable "${OUTPUT}/corrected-${mode}${EXE_SUFFIX}")
  execute_process(COMMAND "${COMPILER}" emit "${good}" -o "${object}" ${flags} RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Corrected source emission failed")
  endif()
  void_native_link("${object}" "${executable}")
  foreach(engine jit aot)
    if(engine STREQUAL "jit")
      execute_process(COMMAND "${COMPILER}" run "${good}" 10 ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE result)
    else()
      execute_process(COMMAND "${executable}" 10 RESULT_VARIABLE status OUTPUT_VARIABLE result)
    endif()
    string(STRIP "${result}" result)
    if(NOT status EQUAL 0 OR NOT result STREQUAL "52")
      message(FATAL_ERROR "Corrected source ${engine}/${mode}: ${result}")
    endif()
  endforeach()
endforeach()
execute_process(COMMAND "${COMPILER}" check "${ROOT}/tests/fixtures/diagnostics/multi/main.void"
  RESULT_VARIABLE status ERROR_VARIABLE diagnostic OUTPUT_VARIABLE result)
if(NOT status EQUAL 1 OR NOT result STREQUAL "" OR NOT diagnostic MATCHES "a.void:2:9" OR NOT diagnostic MATCHES "b.void:2:5" OR NOT diagnostic MATCHES "main.void:4:5" OR NOT diagnostic MATCHES "Previously declared")
  message(FATAL_ERROR "Multi-file diagnostic acceptance failed: ${diagnostic}")
endif()
message(STATUS "Diagnostic recovery gates check/run/emit; corrected real source returns 52 in normal/O2 JIT/AOT")
