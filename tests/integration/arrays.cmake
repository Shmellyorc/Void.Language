foreach(mode normal optimized)
  set(flags)
  if(mode STREQUAL "normal")
    set(flags --no-opt)
  endif()
  foreach(program strings values nested defaults interfaces selection tree readonly iteration ranges invalidation nested_failure large cycles empty failures)
    set(inputs 0 7)
    if(program MATCHES "^(strings|values|tree)$")
      set(answers 3 10)
    elseif(program STREQUAL "nested")
      set(answers 17 24)
    elseif(program MATCHES "^(defaults|large)$")
      set(answers 7 14)
    elseif(program STREQUAL "interfaces")
      set(answers 5 19)
    elseif(program STREQUAL "selection")
      set(answers 25 32)
    elseif(program STREQUAL "readonly")
      set(answers 2 9)
    elseif(program STREQUAL "iteration")
      set(answers 30 37)
    elseif(program STREQUAL "ranges")
      set(answers 18 25)
    elseif(program STREQUAL "cycles")
      set(answers 0 14)
    elseif(program STREQUAL "empty")
      set(answers 0 7)
    elseif(program STREQUAL "failures")
      set(answers 10 17)
    elseif(program STREQUAL "invalidation")
      set(inputs 0 1 2 3 4 5 6)
      set(answers 3 error error 1 40 error error)
    else()
      set(inputs 0 1 2)
      set(answers 1 error error)
    endif()
    list(LENGTH inputs count)
    math(EXPR last "${count}-1")
    foreach(index RANGE ${last})
      list(GET inputs ${index} input)
      list(GET answers ${index} expected)
      foreach(engine jit aot)
        if(engine STREQUAL "jit")
          execute_process(COMMAND "${COMPILER}" run "${ROOT}/examples/arrays/${program}.void" "${input}" ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
        else()
          execute_process(COMMAND "${BIN}/void_arrays_cli_${program}_${mode}${EXE_SUFFIX}" "${input}" RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
        endif()
        string(STRIP "${result}" result)
        if(expected STREQUAL "error")
          if(NOT status EQUAL 1 OR NOT "${result}${errors}" MATCHES "${program}.void:" OR NOT "${result}${errors}" MATCHES "(modified|invalidated|index outside extent)")
            message(FATAL_ERROR "${program}/${mode}/${engine}(${input}): missing checked failure; got ${status}: ${result} ${errors}")
          endif()
        elseif(NOT status EQUAL 0 OR NOT result STREQUAL expected)
          message(FATAL_ERROR "${program}/${mode}/${engine}(${input}): expected ${expected}; got ${status}: ${result} ${errors}")
        endif()
      endforeach()
    endforeach()
  endforeach()
endforeach()
message(STATUS "Phase 23 arrays/ranges passed normal/O2 source JIT and native AOT")
