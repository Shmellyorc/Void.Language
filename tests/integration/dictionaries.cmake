set(programs main keys nested order large transactions literal)
set(zero 3 0 20 17 7 0 2)
set(seven 10 7 27 17 14 14 9)
foreach(mode normal optimized)
  set(flags)
  if(mode STREQUAL "normal")
    set(flags --no-opt)
  endif()
  foreach(index RANGE 6)
    list(GET programs ${index} program)
    set(inputs 0 7)
    list(GET zero ${index} z)
    list(GET seven ${index} s)
    set(answers ${z} ${s})
    if(program STREQUAL "literal")
      list(APPEND inputs 1)
      list(APPEND answers 1)
    elseif(program STREQUAL "order")
      list(APPEND inputs 1 2 3 4 5 9 6 8)
      list(APPEND answers error error error error error error 0 1)
    endif()
    list(LENGTH inputs count)
    math(EXPR last "${count}-1")
    foreach(n RANGE ${last})
      list(GET inputs ${n} input)
      list(GET answers ${n} expected)
      foreach(engine jit aot)
        if(engine STREQUAL "jit")
          execute_process(COMMAND "${COMPILER}" run "${ROOT}/examples/dictionaries/${program}.void" "${input}" ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
        else()
          execute_process(COMMAND "${BIN}/void_dictionaries_cli_${program}_${mode}${EXE_SUFFIX}" "${input}" RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
        endif()
        string(STRIP "${result}" result)
        if(expected STREQUAL "error")
          if(NOT status EQUAL 1 OR NOT "${result}${errors}" MATCHES "order.void:" OR NOT "${result}${errors}" MATCHES "(not found|invalidated|modified)")
            message(FATAL_ERROR "${program}/${mode}/${engine}(${input}): missing checked failure; got ${status}: ${result} ${errors}")
          endif()
        elseif(NOT status EQUAL 0 OR NOT result STREQUAL expected)
          message(FATAL_ERROR "${program}/${mode}/${engine}(${input}): expected ${expected}; got ${status}: ${result} ${errors}")
        endif()
      endforeach()
    endforeach()
  endforeach()
endforeach()
message(STATUS "Dictionaries: normal/O2 JIT and independently linked AOT passed")
