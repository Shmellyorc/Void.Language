set(programs main functions types constraints arrays initialization methods failures imports order large reload)
set(zero 0 3 6 2 0 2 3 10 0 4 7 0)
set(seven 7 10 20 16 21 9 10 17 7 11 14 7)
foreach(mode normal optimized)
  set(flags)
  if(mode STREQUAL "normal")
    set(flags --no-opt)
  endif()
  foreach(index RANGE 11)
    list(GET programs ${index} program)
    foreach(input 0 7)
      if(input EQUAL 0)
        list(GET zero ${index} expected)
      else()
        list(GET seven ${index} expected)
      endif()
      foreach(engine jit aot)
        if(engine STREQUAL "jit")
          execute_process(COMMAND "${COMPILER}" run "${ROOT}/examples/generics/${program}.void" "${input}" ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
        else()
          execute_process(COMMAND "${BIN}/void_generics_cli_${program}_${mode}${EXE_SUFFIX}" "${input}" RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
        endif()
        string(STRIP "${result}" result)
        if(NOT status EQUAL 0 OR NOT result STREQUAL expected)
          message(FATAL_ERROR "${program}/${mode}/${engine}(${input}): expected ${expected}; got ${status}: ${result} ${errors}")
        endif()
      endforeach()
    endforeach()
  endforeach()
  foreach(engine jit aot)
    if(engine STREQUAL "jit")
      execute_process(COMMAND "${COMPILER}" run "${ROOT}/examples/generics/failures.void" -1 ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
    else()
      execute_process(COMMAND "${BIN}/void_generics_cli_failures_${mode}${EXE_SUFFIX}" -1 RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
    endif()
    if(NOT status EQUAL 1 OR NOT "${result}${errors}" MATCHES "failures.void:" OR NOT "${result}${errors}" MATCHES "::at")
      message(FATAL_ERROR "generic ${mode}/${engine} did not preserve checked failure source: ${status}: ${result} ${errors}")
    endif()
  endforeach()
endforeach()
message(STATUS "Generic programs passed normal/O2 JIT and linked AOT")
