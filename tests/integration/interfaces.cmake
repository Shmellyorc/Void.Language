foreach(mode normal optimized)
  set(flags)
  if(mode STREQUAL "normal")
    set(flags --no-opt)
  endif()
  foreach(program main stress nullable selection handoffs imports cycles static)
    foreach(input -1 0 10)
      if(program STREQUAL "main")
        math(EXPR expected "(${input} + 4) * 2")
      elseif(program STREQUAL "stress")
        math(EXPR expected "${input} + 1500")
      elseif(program STREQUAL "nullable")
        math(EXPR expected "${input} + 5")
      elseif(program STREQUAL "handoffs")
        math(EXPR expected "${input} + 100")
      elseif(program STREQUAL "imports" OR program STREQUAL "cycles")
        set(expected "${input}")
      elseif(program STREQUAL "static")
        set(expected 720)
      else()
        math(EXPR expected "${input} + 1190")
      endif()
      foreach(engine jit aot)
        if(engine STREQUAL "jit")
          execute_process(COMMAND "${COMPILER}" run "${ROOT}/examples/interfaces/${program}.void" "${input}" ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
        else()
          execute_process(COMMAND "${BIN}/void_interfaces_cli_${program}_${mode}${EXE_SUFFIX}" "${input}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
        endif()
        string(STRIP "${output}" output)
        if(NOT status EQUAL 0 OR NOT output STREQUAL "${expected}")
          message(FATAL_ERROR "Interface ${program}/${mode}/${engine}: ${status}, ${output}, ${errors}; expected ${expected}")
        endif()
      endforeach()
    endforeach()
  endforeach()
endforeach()
