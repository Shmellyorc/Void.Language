foreach(program results main values interfaces generic large nullable control combined unmatched transactions nested types fields)
  if(program STREQUAL "results")
    set(expected 28)
  elseif(program STREQUAL "main")
    set(expected 36)
  elseif(program STREQUAL "values")
    set(expected 10)
  elseif(program STREQUAL "large")
    set(expected 11)
  elseif(program STREQUAL "control")
    set(expected 27)
  elseif(program STREQUAL "combined")
    set(expected 35)
  elseif(program STREQUAL "unmatched")
    set(expected 42)
  elseif(program STREQUAL "transactions")
    set(expected 16)
  elseif(program STREQUAL "types" OR program STREQUAL "fields")
    set(expected 14)
  elseif(program STREQUAL "nested")
    set(expected 17)
  else()
    set(expected 7)
  endif()
  set(input 7)
  if(program STREQUAL "unmatched")
    set(input 1)
  endif()
  foreach(mode normal optimized)
    set(flags)
    if(mode STREQUAL "normal")
      set(flags --no-opt)
    endif()
    foreach(engine jit aot)
      if(engine STREQUAL "jit")
        execute_process(COMMAND "${COMPILER}" run "${ROOT}/examples/patterns/${program}.void" "${input}" ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
      else()
        execute_process(COMMAND "${BIN}/void_patterns_cli_${program}_${mode}${EXE_SUFFIX}" "${input}" RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
      endif()
      string(STRIP "${result}" result)
      if(NOT status EQUAL 0 OR NOT result STREQUAL "${expected}")
        message(FATAL_ERROR "${program}/${mode}/${engine}: expected ${expected}, got ${status}: ${result} ${errors}")
      endif()
    endforeach()
  endforeach()
endforeach()
foreach(mode normal optimized)
  set(flags)
  if(mode STREQUAL "normal")
    set(flags --no-opt)
  endif()
  foreach(engine jit aot)
    foreach(program unmatched transactions)
      set(input 0)
      if(program STREQUAL "unmatched")
        set(input 2)
      endif()
      if(engine STREQUAL "jit")
        execute_process(COMMAND "${COMPILER}" run "${ROOT}/examples/patterns/${program}.void" "${input}" ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
      else()
        execute_process(COMMAND "${BIN}/void_patterns_cli_${program}_${mode}${EXE_SUFFIX}" "${input}" RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
      endif()
      if(NOT status EQUAL 1 OR NOT "${result}${errors}" MATCHES "${program}.void:")
        message(FATAL_ERROR "Missing source-located pattern failure ${program}/${mode}/${engine}: ${status}: ${result} ${errors}")
      endif()
    endforeach()
  endforeach()
endforeach()
