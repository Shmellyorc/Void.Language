foreach(mode normal optimized)
  set(flags)
  if(mode STREQUAL "normal")
    set(flags --no-opt)
  endif()
  foreach(program main stress initialization unicode)
    foreach(input -1 0 10)
      if(program STREQUAL "stress")
        math(EXPR expected "${input} + 300")
      elseif(program STREQUAL "initialization")
        math(EXPR expected "${input} + 2")
      elseif(program STREQUAL "unicode")
        math(EXPR expected "${input} + 3")
      else()
        math(EXPR expected "${input} + 1")
      endif()
      foreach(engine jit aot)
        if(engine STREQUAL "jit")
          execute_process(COMMAND "${COMPILER}" run "${ROOT}/examples/strings/${program}.void" "${input}" ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
        else()
          execute_process(COMMAND "${BIN}/void_strings_cli_${program}_${mode}${EXE_SUFFIX}" "${input}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
        endif()
        string(STRIP "${output}" output)
        if(NOT status EQUAL 0 OR NOT output STREQUAL "${expected}")
          message(FATAL_ERROR "String ${program}/${mode}/${engine}: ${status}, ${output}, ${errors}; expected ${expected}")
        endif()
      endforeach()
    endforeach()
  endforeach()
endforeach()
