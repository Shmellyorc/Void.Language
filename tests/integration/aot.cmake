file(MAKE_DIRECTORY "${OUTPUT}")
set(object "${OUTPUT}/proof.o")
set(executable "${OUTPUT}/proof${EXE_SUFFIX}")
execute_process(COMMAND "${COMPILER}" --emit-proof "${object}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Object generation failed: ${status}")
endif()
if(WINDOWS)
  # Hand-built IR calls the C printf symbol directly, bypassing UCRT header inlines.
  set(native_libraries legacy_stdio_definitions.lib)
endif()
if(LINKER)
  set(native_linker "--ld-path=${LINKER}")
endif()
execute_process(COMMAND "${CLANG}" ${native_linker} "${object}" ${native_libraries} -o "${executable}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Native link failed: ${status}")
endif()
execute_process(COMMAND "${DWARFDUMP}" --verify "${object}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Object debug information is invalid: ${status}")
endif()
execute_process(COMMAND "${DWARFDUMP}" --debug-line "${object}" OUTPUT_VARIABLE lines RESULT_VARIABLE status)
if(NOT status EQUAL 0 OR NOT lines MATCHES "architecture.void")
  message(FATAL_ERROR "Object has no VOID source line table")
endif()
# argc supplies actual runtime input: -1, 0, and 1 to the generated entry.
execute_process(COMMAND "${executable}" OUTPUT_VARIABLE result RESULT_VARIABLE status)
string(STRIP "${result}" result)
if(NOT status EQUAL 0 OR NOT result STREQUAL "7")
  message(FATAL_ERROR "Native negative branch failed: ${status}, ${result}")
endif()
execute_process(COMMAND "${executable}" first OUTPUT_VARIABLE result RESULT_VARIABLE status)
string(STRIP "${result}" result)
if(NOT status EQUAL 0 OR NOT result STREQUAL "42")
  message(FATAL_ERROR "Native function result failed: ${status}, ${result}")
endif()
execute_process(COMMAND "${executable}" first second OUTPUT_VARIABLE result RESULT_VARIABLE status)
string(STRIP "${result}" result)
if(NOT status EQUAL 0 OR NOT result STREQUAL "43")
  message(FATAL_ERROR "Native runtime argument failed: ${status}, ${result}")
endif()
message(STATUS "LLVM object linked, debug information verified, and three native paths executed")
