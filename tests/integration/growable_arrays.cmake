foreach(mode normal optimized)
  set(flags)
  if(mode STREQUAL "normal")
    set(flags --no-opt)
  endif()
  foreach(program main aliases selection numeric large invalidation indexes)
    set(inputs 0 7)
    if(program STREQUAL "main")
      set(answers 13 13)
    elseif(program STREQUAL "aliases")
      set(answers 22 29)
    elseif(program STREQUAL "selection")
      set(answers 12 19)
    elseif(program STREQUAL "numeric")
      set(answers 100 107)
    elseif(program STREQUAL "large")
      set(answers 262144 262151)
    elseif(program STREQUAL "invalidation")
      set(inputs 0 1 2)
      set(answers 38 error error)
    else()
      set(inputs -4 -3 -1 0 1 2 3)
      set(answers error 12 32 12 22 32 error)
    endif()
    list(LENGTH inputs count)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
      list(GET inputs ${index} input)
      list(GET answers ${index} expected)
      foreach(engine jit aot)
        if(engine STREQUAL "jit")
          execute_process(COMMAND "${COMPILER}" run "${ROOT}/examples/growable_arrays/${program}.void" "${input}" ${flags}
            RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
        else()
          execute_process(COMMAND "${BIN}/void_growable_arrays_cli_${program}_${mode}${EXE_SUFFIX}" "${input}"
            RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
        endif()
        string(STRIP "${result}" result)
        if(expected STREQUAL "error")
          if(NOT status EQUAL 1 OR NOT "${result}${errors}" MATCHES "${program}.void:" OR NOT "${result}${errors}" MATCHES "(selected write|index outside extent)")
            message(FATAL_ERROR "${program}/${mode}/${engine}(${input}): expected checked failure; got ${status}: ${result} ${errors}")
          endif()
        elseif(NOT status EQUAL 0 OR NOT result STREQUAL expected)
          message(FATAL_ERROR "${program}/${mode}/${engine}(${input}): expected ${expected}; got ${status}: ${result} ${errors}")
        endif()
      endforeach()
    endforeach()
  endforeach()
endforeach()
message(STATUS "Growable numeric/bool lists passed normal/O2 source JIT and native AOT")
