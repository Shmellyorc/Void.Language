set(programs closures captures callbacks defer with events cleanup_failure propagation event_snapshot nullable large fixed_capture inheritance scope with_transaction combined function_arrays identity generic_callbacks dictionary_closures construction_cleanup composite_defaults)
set(answers 17 127 38 227 186 122 321 17 129 14 17 17 17 13 1 47 28 30 35 21 10 17)
foreach(program answer IN ZIP_LISTS programs answers)
  foreach(mode normal optimized)
    set(flags)
    if(mode STREQUAL "normal")
      set(flags --no-opt)
    endif()
    foreach(engine jit aot)
      if(engine STREQUAL "jit")
        execute_process(COMMAND "${COMPILER}" run "${ROOT}/examples/advanced/${program}.void" 7 ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
      else()
        execute_process(COMMAND "${BIN}/void_advanced_cli_${program}_${mode}${EXE_SUFFIX}" 7 RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
      endif()
      string(STRIP "${result}" result)
      if(NOT status EQUAL 0 OR NOT result STREQUAL "${answer}")
        message(FATAL_ERROR "${program}/${mode}/${engine}: expected ${answer}, got ${status}: ${result} ${errors}")
      endif()
    endforeach()
  endforeach()
endforeach()
foreach(mode normal optimized)
  set(flags)
  if(mode STREQUAL "normal")
    set(flags --no-opt)
  endif()
  foreach(engine jit aot)
    if(engine STREQUAL "jit")
      execute_process(COMMAND "${COMPILER}" run "${ROOT}/examples/advanced/cleanup_failure.void" 0 ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
    else()
      execute_process(COMMAND "${BIN}/void_advanced_cli_cleanup_failure_${mode}${EXE_SUFFIX}" 0 RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
    endif()
    if(NOT status EQUAL 1 OR NOT "${result}${errors}" MATCHES "Additional failure during defer")
      message(FATAL_ERROR "Missing cleanup failure diagnostics ${mode}/${engine}: ${status}: ${result} ${errors}")
    endif()
  endforeach()
