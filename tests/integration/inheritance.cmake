foreach(mode normal optimized)
  set(flags)
  if(mode STREQUAL "normal")
    set(flags --no-opt)
  endif()
  foreach(program main initialization stress order imports receiver_order nested results failure)
    foreach(input -1 0 10)
      if(program STREQUAL "main")
        math(EXPR expected "${input} + 98")
      elseif(program STREQUAL "initialization")
        math(EXPR expected "${input} + 82")
      elseif(program STREQUAL "order")
        math(EXPR expected "${input} + 123592")
      elseif(program STREQUAL "imports")
        math(EXPR expected "${input} + 3")
      elseif(program STREQUAL "receiver_order")
        math(EXPR expected "${input} + 103")
      elseif(program STREQUAL "nested")
        math(EXPR expected "${input} + 7")
      elseif(program STREQUAL "results")
        math(EXPR expected "${input} * 2 + 8")
      elseif(program STREQUAL "failure")
        if(NOT input EQUAL 0)
          math(EXPR expected "100 / ${input} + 9")
        endif()
      else()
        math(EXPR expected "${input} + 1100")
      endif()
      foreach(engine jit aot)
        if(engine STREQUAL "jit")
          execute_process(COMMAND "${COMPILER}" run "${ROOT}/examples/inheritance/${program}.void" "${input}" ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
        else()
          execute_process(COMMAND "${BIN}/void_inheritance_cli_${program}_${mode}${EXE_SUFFIX}" "${input}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
        endif()
        string(STRIP "${output}" output)
        if(program STREQUAL "failure" AND input EQUAL 0)
          if(NOT status EQUAL 1 OR NOT "${output}${errors}" MATCHES "zero" OR NOT "${output}${errors}" MATCHES "base::method::init" OR NOT "${output}${errors}" MATCHES "derived::method::init")
            message(FATAL_ERROR "Inherited initializer failure ${mode}/${engine}: ${status}, ${output}, ${errors}")
          endif()
          continue()
        endif()
        if(NOT status EQUAL 0 OR NOT output STREQUAL "${expected}")
          message(FATAL_ERROR "Inheritance ${program}/${mode}/${engine}: ${status}, ${output}, ${errors}; expected ${expected}")
        endif()
      endforeach()
    endforeach()
  endforeach()
endforeach()
