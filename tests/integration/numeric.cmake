include("${CMAKE_CURRENT_LIST_DIR}/native_link.cmake")
file(MAKE_DIRECTORY "${OUTPUT}")
# Automatic JIT caching creates a .void directory beside these source files.
file(GLOB programs LIST_DIRECTORIES false "${ROOT}/tests/numeric/programs/*.void")
foreach(source IN LISTS programs)
  get_filename_component(name "${source}" NAME_WE)
  foreach(mode normal optimized)
    set(flags)
    if(mode STREQUAL "normal")
      set(flags --no-opt)
    endif()
    set(object "${OUTPUT}/${name}-${mode}.o")
    set(executable "${OUTPUT}/${name}-${mode}${EXE_SUFFIX}")
    execute_process(COMMAND "${COMPILER}" emit "${source}" -o "${object}" ${flags}
      RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Numeric object generation failed: ${name}: ${output}${errors}")
    endif()
    void_native_link("${object}" "${executable}")
    if(name MATCHES "^fail_")
      set(inputs 0)
    else()
      set(inputs 0 1 10)
    endif()
    foreach(input IN LISTS inputs)
      foreach(engine jit aot)
        if(engine STREQUAL "jit")
          execute_process(COMMAND "${COMPILER}" run "${source}" "${input}" ${flags}
            RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
        else()
          execute_process(COMMAND "${executable}" "${input}"
            RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
        endif()
        if(name MATCHES "^fail_")
          if(NOT status EQUAL 1 OR NOT "${output}${errors}" MATCHES "runtime error:" OR NOT "${output}${errors}" MATCHES "Called from")
            message(FATAL_ERROR "Missing checked numeric failure: ${name}/${mode}/${engine}: ${status} ${output}${errors}")
          endif()
        else()
          string(STRIP "${output}" output)
          set(answer 1)
          if(name STREQUAL "dynamic_widths")
            if(input EQUAL 0)
              set(answer 47)
            elseif(input EQUAL 1)
              set(answer -7)
            else()
              set(answer 48)
            endif()
          endif()
          if(NOT status EQUAL 0 OR NOT output STREQUAL "${answer}")
            message(FATAL_ERROR "Numeric mismatch: ${name}/${mode}/${engine}(${input}): ${status} ${output}${errors}")
          endif()
        endif()
      endforeach()
    endforeach()
  endforeach()
endforeach()
message(STATUS "Numeric source constants, JIT and native AOT passed in both optimization modes")
