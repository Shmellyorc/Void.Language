file(COPY "${ROOT}/examples/runtime_errors" DESTINATION "${OUTPUT}/error acceptance")
set(error_root "${OUTPUT}/error acceptance/runtime_errors")
set(source "${error_root}/main.void")
foreach(kind division remainder compound_division compound_remainder no_result boolean recursive)
  if(kind STREQUAL "division")
    set(body "func calculate(value: i32) -> i32:\n    return 100 / value\n")
    set(location "2:16")
    set(reason "Division by zero")
  elseif(kind STREQUAL "remainder")
    set(body "func calculate(value: i32) -> i32:\n    return 100 % value\n")
    set(location "2:16")
    set(reason "Remainder by zero")
  elseif(kind MATCHES "compound")
    if(kind STREQUAL "compound_division")
      set(operator "/=")
      set(reason "Division by zero")
    else()
      set(operator "%=")
      set(reason "Remainder by zero")
    endif()
    set(body "func calculate(value: i32) -> i32:\n    var result = 100\n    result ${operator} value\n    return result\n")
    set(location "3:5")
  elseif(kind STREQUAL "no_result")
    set(body "func fail(value: i32):\n    var result = 100 / value\nfunc calculate(value: i32) -> i32:\n    fail(value)\n    return 1\n")
    set(location "2:22")
    set(reason "Division by zero")
  elseif(kind STREQUAL "boolean")
    set(body "func positive(value: i32) -> bool:\n    return 100 / value > 0\nfunc calculate(value: i32) -> i32:\n    if positive(value):\n        return 1\n    return 0\n")
    set(location "2:16")
    set(reason "Division by zero")
  else()
    set(body "func recurse(value: i32) -> i32:\n    if value > 0:\n        return recurse(value - 1)\n    return 100 / value\nfunc calculate(value: i32) -> i32:\n    return recurse(value + 40)\n")
    set(location "4:16")
    set(reason "Division by zero")
  endif()
  file(WRITE "${error_root}/arithmetic.void" "${body}")
  foreach(mode normal optimized)
    set(flags)
    if(mode STREQUAL "normal")
      set(flags --no-opt)
    endif()
    set(object "${OUTPUT}/error-${kind}-${mode}.o")
    set(executable "${OUTPUT}/error-${kind}-${mode}${EXE_SUFFIX}")
    execute_process(COMMAND "${COMPILER}" emit "${source}" -o "${object}" ${flags} RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Runtime-error source failed to compile")
    endif()
    void_native_link("${object}" "${executable}")
    foreach(engine jit aot)
      if(engine STREQUAL "jit")
        execute_process(COMMAND "${COMPILER}" run "${source}" 0 ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
      else()
        # The diagnostic is an embedded compile snapshot, not a filesystem reread.
        file(WRITE "${error_root}/arithmetic.void" "# source changed after object emission\n")
        execute_process(COMMAND "${executable}" 0 RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
        file(WRITE "${error_root}/arithmetic.void" "${body}")
      endif()
      set(diagnostic "${output}${errors}")
      if(NOT status EQUAL 1 OR NOT diagnostic MATCHES "arithmetic.void:${location}: runtime error: ${reason}" OR NOT diagnostic MATCHES "\\^" OR diagnostic MATCHES "LLVM|__vd_|Assertion")
        message(FATAL_ERROR "${kind}/${mode}/${engine}: wrong runtime failure (${status}): ${diagnostic}")
      endif()
      if(kind STREQUAL "recursive")
        if(NOT diagnostic MATCHES "trace limited to 32 callers")
          message(FATAL_ERROR "Missing honest trace truncation")
        endif()
      elseif(NOT diagnostic MATCHES "Called from /main.void::bridge" OR NOT diagnostic MATCHES "main.void:4:23: source call" OR NOT diagnostic MATCHES "Called from /main.void::entry")
        message(FATAL_ERROR "Missing actual source call trace: ${diagnostic}")
      endif()
    endforeach()
  endforeach()
endforeach()
# Unexecuted branches and dynamic and/or operands must remain safe.
file(WRITE "${error_root}/arithmetic.void" "func calculate(value: i32) -> i32:\n    if false and 100 / value > 0:\n        return 99\n    if true or 100 % value > 0:\n        if value == 0:\n            return 7\n    if value != 0:\n        return 100 / value\n    return 8\n")
program(short_circuit "${source}" "0;2;-2" "7;50;-50")
message(STATUS "Real constants/numeric programs and source-located runtime failures passed normal/O2 JIT/AOT")
