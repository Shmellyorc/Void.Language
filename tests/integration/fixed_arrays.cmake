foreach(mode normal optimized)
  set(flags)
  if(mode STREQUAL "normal")
    set(flags --no-opt)
  endif()
  foreach(program main copies order numeric indexes index_types empty large value_fields bounds_order loops)
    if(program STREQUAL "indexes")
      set(inputs -4 -3 -1 0 1 2 3)
      set(answers error 10 30 10 20 30 error)
    elseif(program STREQUAL "index_types")
      set(inputs -1 0 1)
      set(answers error 56 error)
    elseif(program STREQUAL "empty")
      set(inputs -1 0 7)
      set(answers error 0 7)
    elseif(program STREQUAL "bounds_order")
      set(inputs 0 3)
      set(answers -33 error)
    else()
      set(inputs 0 7)
      if(program STREQUAL "main")
        set(answers 10 17)
      elseif(program STREQUAL "copies")
        set(inputs -1 7)
        set(answers 11 30)
      elseif(program STREQUAL "order")
        set(answers 149 156)
      elseif(program STREQUAL "numeric")
        set(answers 100 107)
      elseif(program STREQUAL "large")
        set(answers 46 53)
      elseif(program STREQUAL "value_fields")
        set(answers 29 36)
      elseif(program STREQUAL "loops")
        set(answers 2 29)
      endif()
    endif()
    list(LENGTH inputs count)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
      list(GET inputs ${index} input)
      list(GET answers ${index} expected)
      foreach(engine jit aot)
        if(engine STREQUAL "jit")
          execute_process(COMMAND "${COMPILER}" run "${ROOT}/examples/fixed_arrays/${program}.void" "${input}" ${flags}
            RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
        else()
          execute_process(COMMAND "${BIN}/void_fixed_arrays_cli_${program}_${mode}${EXE_SUFFIX}" "${input}"
            RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
        endif()
        string(STRIP "${result}" result)
        if(expected STREQUAL "error")
          if(NOT status EQUAL 1 OR NOT "${result}${errors}" MATCHES "Fixed array index outside extent" OR NOT "${result}${errors}" MATCHES "${program}.void:")
            message(FATAL_ERROR "${program}/${mode}/${engine}(${input}): expected checked bounds failure; got ${status}: ${result} ${errors}")
          endif()
        elseif(NOT status EQUAL 0 OR NOT result STREQUAL expected)
          message(FATAL_ERROR "${program}/${mode}/${engine}(${input}): expected ${expected}; got ${status}: ${result} ${errors}")
        endif()
      endforeach()
    endforeach()
  endforeach()
endforeach()
message(STATUS "Real numeric fixed-array programs passed JIT and linked AOT, normal/O2")
