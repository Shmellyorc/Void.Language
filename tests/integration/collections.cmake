set(programs main nested order bounds invalidation large readonly numeric)
set(zero 5 23 12 53 2 7 0 0)
set(seven 12 30 12 53 2 14 14 7)
foreach(mode normal optimized)
  set(flags)
  if(mode STREQUAL "normal")
    set(flags --no-opt)
  endif()
  foreach(index RANGE 7)
    list(GET programs ${index} program)
    set(inputs 0 7)
    list(GET zero ${index} z)
    list(GET seven ${index} s)
    set(answers ${z} ${s})
    if(program STREQUAL "bounds")
      list(APPEND inputs 1 2 3 4 5 6)
      list(APPEND answers error error error error error error)
    elseif(program STREQUAL "order")
      list(APPEND inputs 1 2)
      list(APPEND answers error error)
    elseif(program STREQUAL "invalidation")
      list(APPEND inputs 1 2 3 4 5 6)
      list(APPEND answers error error 0 1 2 error)
    endif()
    list(LENGTH inputs count)
    math(EXPR last "${count}-1")
    foreach(n RANGE ${last})
      list(GET inputs ${n} input)
      list(GET answers ${n} expected)
      foreach(engine jit aot)
        if(engine STREQUAL "jit")
          execute_process(COMMAND "${COMPILER}" run "${ROOT}/examples/collections/${program}.void" "${input}" ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
        else()
          execute_process(COMMAND "${BIN}/void_collections_cli_${program}_${mode}${EXE_SUFFIX}" "${input}" RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
        endif()
        string(STRIP "${result}" result)
        if(expected STREQUAL "error")
          if(NOT status EQUAL 1 OR NOT "${result}${errors}" MATCHES "${program}.void:" OR NOT "${result}${errors}" MATCHES "(outside extent|invalidated|modified)")
            message(FATAL_ERROR "${program}/${mode}/${engine}(${input}): missing checked failure; got ${status}: ${result} ${errors}")
          endif()
        elseif(NOT status EQUAL 0 OR NOT result STREQUAL expected)
          message(FATAL_ERROR "${program}/${mode}/${engine}(${input}): expected ${expected}; got ${status}: ${result} ${errors}")
        endif()
      endforeach()
    endforeach()
  endforeach()
endforeach()
message(STATUS "Collections: normal/O2 JIT and independently linked AOT passed")
