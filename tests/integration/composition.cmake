foreach(mode normal optimized)
  set(flags)
  if(mode STREQUAL "normal")
    set(flags --no-opt)
  endif()
  foreach(program main stress imports order staged receiver_order)
    foreach(input -1 0 10)
      if(program STREQUAL "main")
        math(EXPR expected "${input} + 101")
      elseif(program STREQUAL "imports")
        math(EXPR expected "${input} + 2")
      elseif(program STREQUAL "order")
        math(EXPR expected "${input} + 34")
      elseif(program STREQUAL "staged")
        math(EXPR expected "${input} + 9")
      elseif(program STREQUAL "receiver_order")
        math(EXPR expected "${input} + 93")
      else()
        math(EXPR expected "${input} * 2 + 2004")
      endif()
      foreach(engine jit aot)
        if(engine STREQUAL "jit")
          execute_process(COMMAND "${COMPILER}" run "${ROOT}/examples/composition/${program}.void" "${input}" ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
        else()
          execute_process(COMMAND "${BIN}/void_composition_cli_${program}_${mode}${EXE_SUFFIX}" "${input}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
        endif()
        string(STRIP "${output}" output)
        if(NOT status EQUAL 0 OR NOT output STREQUAL "${expected}")
          message(FATAL_ERROR "Composition ${program}/${mode}/${engine}: ${status}, ${output}, ${errors}; expected ${expected}")
        endif()
      endforeach()
    endforeach()
  endforeach()
endforeach()
