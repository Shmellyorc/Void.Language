include("${CMAKE_CURRENT_LIST_DIR}/native_link.cmake")
file(MAKE_DIRECTORY "${OUTPUT}/foreign cwd")
function(program name source inputs answers)
  foreach(mode normal optimized)
    set(flags)
    if(mode STREQUAL "normal")
      set(flags --no-opt)
    endif()
    set(object "${OUTPUT}/${name}-${mode}.o")
    set(executable "${OUTPUT}/${name}-${mode}${EXE_SUFFIX}")
    execute_process(COMMAND "${COMPILER}" check "${source}" WORKING_DIRECTORY "${OUTPUT}/foreign cwd" RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Multi-file check failed: ${name}")
    endif()
    execute_process(COMMAND "${COMPILER}" emit "${source}" -o "${object}" ${flags} WORKING_DIRECTORY "${OUTPUT}/foreign cwd" RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Multi-file object generation failed: ${name}")
    endif()
    void_native_link("${object}" "${executable}")
    execute_process(COMMAND "${DWARFDUMP}" --verify "${object}" RESULT_VARIABLE status OUTPUT_VARIABLE debug)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Invalid multi-file DWARF: ${debug}")
    endif()
    execute_process(COMMAND "${DWARFDUMP}" --debug-line "${object}" RESULT_VARIABLE status OUTPUT_VARIABLE debug)
    if(NOT status EQUAL 0 OR NOT debug MATCHES "main.void")
      message(FATAL_ERROR "Missing entry source line table")
    endif()
    if(name STREQUAL "acceptance" AND (NOT debug MATCHES "calculator.void" OR NOT debug MATCHES "numbers.void"))
      message(FATAL_ERROR "Lost imported source line tables")
    endif()
    execute_process(COMMAND "${DWARFDUMP}" --debug-info "${object}" RESULT_VARIABLE status OUTPUT_VARIABLE debug)
    string(REGEX MATCH "DW_AT_comp_dir[ \t]+\\(\"([^\"]+)\"\\)" directory_record "${debug}")
    set(debug_directory "${CMAKE_MATCH_1}")
    file(REAL_PATH "${source}" physical_source)
    get_filename_component(directory "${physical_source}" DIRECTORY)
    if(NOT status EQUAL 0 OR NOT directory_record OR NOT IS_DIRECTORY "${debug_directory}")
      message(FATAL_ERROR "Compilation unit lost its physical source directory")
    endif()
    file(REAL_PATH "${debug_directory}" debug_directory)
    if(WINDOWS)
      # Physical root spelling can differ in drive/ancestor case. VFS import
      # components are checked for exact case separately by the frontend.
      string(TOLOWER "${directory}" directory)
      string(TOLOWER "${debug_directory}" debug_directory)
    endif()
    if(NOT debug_directory STREQUAL directory)
      message(FATAL_ERROR "Compilation unit points at ${debug_directory}, expected ${directory}")
    endif()
    list(LENGTH inputs count)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
      list(GET inputs ${index} input)
      list(GET answers ${index} answer)
      foreach(engine jit aot)
        if(engine STREQUAL "jit")
          execute_process(COMMAND "${COMPILER}" run "${source}" "${input}" ${flags} WORKING_DIRECTORY "${OUTPUT}/foreign cwd" RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
        else()
          execute_process(COMMAND "${executable}" "${input}" WORKING_DIRECTORY "${OUTPUT}/foreign cwd" RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
        endif()
        string(STRIP "${result}" result)
        if(NOT status EQUAL 0 OR NOT result STREQUAL answer)
          message(FATAL_ERROR "${name}/${mode}/${engine}(${input}) expected ${answer}, got ${result}; ${status}; ${errors}")
        endif()
      endforeach()
    endforeach()
  endforeach()
endfunction()
file(COPY "${ROOT}/examples/modules" DESTINATION "${OUTPUT}/acceptance project")
set(entry "${OUTPUT}/acceptance project/modules/main.void")
program(acceptance "${entry}" "0;1;10;-1" "1;4;31;-2")
# Run with a relative entry path from an unrelated working directory.
execute_process(COMMAND "${COMPILER}" run "../acceptance project/modules/main.void" 10 WORKING_DIRECTORY "${OUTPUT}/foreign cwd" RESULT_VARIABLE status OUTPUT_VARIABLE result)
string(STRIP "${result}" result)
if(NOT status EQUAL 0 OR NOT result STREQUAL "31")
  message(FATAL_ERROR "Imports depend on caller working directory")
endif()
# Nested relative paths, normalized/repeated imports, same function names, private
# helpers and project-wide internal visibility all survive native object linking.
set(project "${OUTPUT}/nested project")
file(MAKE_DIRECTORY "${project}/math" "${project}/deep/nested" "${project}/shared folder")
file(WRITE "${project}/shared folder/core.void" "private func hidden(x: i32) -> i32:\n    return x + 3\ninternal func update(x: i32) -> i32:\n    return hidden(x)\n")
file(WRITE "${project}/math/core.void" "public func update(x: i32) -> i32:\n    return x * 2\n")
file(WRITE "${project}/deep/nested/wrapper.void" "use \"../../shared folder/core.void\"\nuse \"/shared folder/./core.void\"\nfunc wrapped(x: i32) -> i32:\n    return update(x)\n")
file(WRITE "${project}/main.void" "use \"/math/core.void\" as math\nuse \"./deep/nested/wrapper.void\"\nfunc entry(x: i32) -> i32:\n    return math.update(x) + wrapped(x)\n")
program(nested "${project}/main.void" "0;1;10;-1" "3;6;33;0")
set(project "${OUTPUT}/cyclic project")
file(MAKE_DIRECTORY "${project}/logic")
file(WRITE "${project}/logic/even.void" "use \"./odd.void\"\nfunc even(x: i32) -> bool:\n    if x == 0:\n        return true\n    return odd(x - 1)\n")
file(WRITE "${project}/logic/odd.void" "use \"/logic/even.void\"\nfunc odd(x: i32) -> bool:\n    if x == 0:\n        return false\n    return even(x - 1)\n")
file(WRITE "${project}/main.void" "use \"/logic/even.void\" as parity\nfunc entry(x: i32) -> i32:\n    if parity.even(x):\n        return 1\n    return 0\n")
program(cyclic "${project}/main.void" "0;1;10;11" "1;0;1;0")
# Editing an actual imported file must change both engines, without touching entry.
set(imported "${OUTPUT}/acceptance project/modules/math/calculator.void")
file(WRITE "${imported}" "func double(value: i32) -> i32:\n    return value * 3\n")
program(edited_import "${entry}" "0;1;10;-1" "1;5;41;-3")
# Nested semantic mistakes retain the originating imported file and location.
file(WRITE "${imported}" "func double(value: i32) -> i32:\n    return missing\n")
execute_process(COMMAND "${COMPILER}" run "${entry}" 1 RESULT_VARIABLE status ERROR_VARIABLE diagnostic OUTPUT_QUIET)
if(NOT status EQUAL 1 OR NOT diagnostic MATCHES "calculator.void:2:12: error:" OR NOT diagnostic MATCHES "Unknown identifier" OR diagnostic MATCHES "LLVM|__vd_")
  message(FATAL_ERROR "Imported error lost its source location: ${diagnostic}")
endif()
message(STATUS "Four real source graphs compiled, linked, debug-verified and executed in normal/O2 JIT and AOT")
