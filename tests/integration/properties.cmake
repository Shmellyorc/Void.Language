foreach(program main generic order references methods callable selection imports failure receiver)
  if(program STREQUAL "main")
    set(expected 20)
  elseif(program STREQUAL "order")
    set(expected 19)
  elseif(program STREQUAL "receiver")
    set(expected 7)
  elseif(program STREQUAL "failure")
    set(expected 14)
  elseif(program STREQUAL "imports")
    set(expected 17)
  elseif(program STREQUAL "selection")
    set(expected 22)
  elseif(program STREQUAL "callable")
    set(expected 22)
  elseif(program STREQUAL "references")
    set(expected 12)
  else()
    set(expected 9)
  endif()
  foreach(mode normal optimized)
    set(flags)
    if(mode STREQUAL "normal")
      set(flags --no-opt)
    endif()
    foreach(engine jit aot)
      if(engine STREQUAL "jit")
        execute_process(COMMAND "${COMPILER}" run "${ROOT}/examples/properties/${program}.void" 7 ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
      else()
        execute_process(COMMAND "${BIN}/void_properties_cli_${program}_${mode}${EXE_SUFFIX}" 7 RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
      endif()
      string(STRIP "${result}" result)
      if(NOT status EQUAL 0 OR NOT result STREQUAL "${expected}")
        message(FATAL_ERROR "${program}/${mode}/${engine}: expected ${expected}, got ${status}: ${result} ${errors}")
      endif()
    endforeach()
  endforeach()
endforeach()
foreach(mode normal optimized)
  set(flags)
  if(mode STREQUAL "normal")
    set(flags --no-opt)
  endif()
  foreach(engine jit aot)
    foreach(input 0 -1)
      if(engine STREQUAL "jit")
        execute_process(COMMAND "${COMPILER}" run "${ROOT}/examples/properties/failure.void" "${input}" ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
      else()
        execute_process(COMMAND "${BIN}/void_properties_cli_failure_${mode}${EXE_SUFFIX}" "${input}" RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
      endif()
      if(NOT status EQUAL 1 OR NOT "${result}${errors}" MATCHES "failure.void:" OR NOT "${result}${errors}" MATCHES "zero")
        message(FATAL_ERROR "Missing source-located accessor failure: ${status}: ${result} ${errors}")
      endif()
    endforeach()
  endforeach()
endforeach()
foreach(mode normal optimized)
  set(flags)
  if(mode STREQUAL "normal")
    set(flags --no-opt)
  endif()
  foreach(engine jit aot)
    foreach(input 0 -1)
      if(engine STREQUAL "jit")
        execute_process(COMMAND "${COMPILER}" run "${ROOT}/examples/properties/receiver.void" "${input}" ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
      else()
        execute_process(COMMAND "${BIN}/void_properties_cli_receiver_${mode}${EXE_SUFFIX}" "${input}" RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
      endif()
      string(STRIP "${result}" result)
      if(input EQUAL 0)
        if(NOT status EQUAL 1 OR NOT "${result}${errors}" MATCHES "receiver.void:" OR NOT "${result}${errors}" MATCHES "zero")
          message(FATAL_ERROR "Computed receiver getter ran after RHS: ${status}: ${result} ${errors}")
        endif()
      elseif(NOT status EQUAL 0 OR NOT result STREQUAL "99")
        message(FATAL_ERROR "No-op setter overwrote RHS effects: ${status}: ${result} ${errors}")
      endif()
    endforeach()
  endforeach()
endforeach()
