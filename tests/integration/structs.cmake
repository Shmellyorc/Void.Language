include("${CMAKE_CURRENT_LIST_DIR}/native_link.cmake")
file(MAKE_DIRECTORY "${OUTPUT}")
set(programs main numeric order)
set(folder value_structs)
if(METHODS)
  set(programs main order recursive failure numeric)
  set(folder receiver_methods)
endif()
if(INITIALIZERS)
  set(programs main order required numeric failure stages copies)
  set(folder initialization)
endif()
foreach(program ${programs})
  set(source "${ROOT}/examples/${folder}/${program}.void")
  foreach(mode normal optimized)
    set(flags)
    if(mode STREQUAL "normal")
      set(flags --no-opt)
    endif()
    set(object "${OUTPUT}/${program}-${mode}.o")
    set(executable "${OUTPUT}/${program}-${mode}${EXE_SUFFIX}")
    execute_process(COMMAND "${COMPILER}" emit "${source}" -o "${object}" ${flags} RESULT_VARIABLE status ERROR_VARIABLE errors)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Struct emission failed: ${program}: ${errors}")
    endif()
    void_native_link("${object}" "${executable}")
    execute_process(COMMAND "${DWARFDUMP}" --verify "${object}" RESULT_VARIABLE status OUTPUT_VARIABLE debug ERROR_VARIABLE errors)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Invalid aggregate debug information: ${debug} ${errors}")
    endif()
    if(INITIALIZERS)
      set(inputs 1 2 10)
      if(program STREQUAL "main")
        set(answers 148 150 166)
      elseif(program STREQUAL "order")
        set(answers 14814 15025 16713)
      elseif(program STREQUAL "copies")
        set(answers 216 219 243)
      elseif(program STREQUAL "required")
        set(answers 4 6 22)
      elseif(program STREQUAL "numeric")
        set(answers -3 -2 6)
      else()
        set(answers 100 50 10)
      endif()
    elseif(METHODS)
      set(inputs 0 1 2 10)
      if(program STREQUAL "main")
        set(answers 61 76 93 301)
      elseif(program STREQUAL "order")
        set(answers 324 478 632 1864)
      elseif(program STREQUAL "recursive")
        set(answers 0 1 1 5)
      elseif(program STREQUAL "numeric")
        set(answers 16 18 20 36)
      else()
        set(inputs -1 1 2 10)
        set(answers -11 11 5 1)
      endif()
    elseif(program STREQUAL "main")
      set(inputs -1 0 10)
      set(answers 28 36 46)
    elseif(program STREQUAL "numeric")
      set(inputs -10 0 123)
      set(answers -5 5 128)
    else()
      set(inputs 2 3)
      set(answers 5 4)
    endif()
    list(LENGTH inputs length)
    math(EXPR last "${length} - 1")
    foreach(index RANGE ${last})
      list(GET inputs ${index} input)
      list(GET answers ${index} answer)
      foreach(engine jit aot)
        if(engine STREQUAL "jit")
          execute_process(COMMAND "${COMPILER}" run "${source}" "${input}" ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
        else()
          execute_process(COMMAND "${executable}" "${input}" RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
        endif()
        string(STRIP "${result}" result)
        if(NOT status EQUAL 0 OR NOT result STREQUAL answer)
          message(FATAL_ERROR "${program}/${mode}/${engine}(${input}): expected ${answer}; got ${result}, ${status}, ${errors}")
        endif()
      endforeach()
    endforeach()
    if(METHODS AND program STREQUAL "failure")
      foreach(engine jit aot)
        if(engine STREQUAL "jit")
          execute_process(COMMAND "${COMPILER}" run "${source}" 0 ${flags} RESULT_VARIABLE status ERROR_VARIABLE errors OUTPUT_VARIABLE output)
        else()
          execute_process(COMMAND "${executable}" 0 RESULT_VARIABLE status ERROR_VARIABLE errors OUTPUT_VARIABLE output)
        endif()
        string(APPEND errors "${output}")
        if(NOT status EQUAL 1 OR NOT errors MATCHES "failure.void:6:" OR NOT errors MATCHES "::method::divide" OR NOT errors MATCHES "::method::forward")
          message(FATAL_ERROR "Method failure/source trace broken: ${mode}/${engine}: ${status} ${errors}")
        endif()
      endforeach()
    endif()
    if(INITIALIZERS AND program STREQUAL "failure")
      foreach(engine jit aot)
        if(engine STREQUAL "jit")
          execute_process(COMMAND "${COMPILER}" run "${source}" 0 ${flags} RESULT_VARIABLE status ERROR_VARIABLE errors OUTPUT_VARIABLE output)
        else()
          execute_process(COMMAND "${executable}" 0 RESULT_VARIABLE status ERROR_VARIABLE errors OUTPUT_VARIABLE output)
        endif()
        string(APPEND errors "${output}")
        if(NOT status EQUAL 1 OR NOT errors MATCHES "failure.void:5:" OR NOT errors MATCHES "::method::init")
          message(FATAL_ERROR "Initializer failure/source trace broken: ${mode}/${engine}: ${status} ${errors}")
        endif()
      endforeach()
    endif()
    if(INITIALIZERS AND program STREQUAL "stages")
      foreach(input 0 -1)
        foreach(engine jit aot)
          if(engine STREQUAL "jit")
            execute_process(COMMAND "${COMPILER}" run "${source}" ${input} ${flags} RESULT_VARIABLE status ERROR_VARIABLE errors OUTPUT_VARIABLE output)
          else()
            execute_process(COMMAND "${executable}" ${input} RESULT_VARIABLE status ERROR_VARIABLE errors OUTPUT_VARIABLE output)
          endif()
          string(APPEND errors "${output}")
          if(NOT status EQUAL 1)
            message(FATAL_ERROR "Failed initialization published success: ${mode}/${engine}/${input}: ${status} ${errors}")
          endif()
          if(input EQUAL 0)
            if(NOT errors MATCHES "stages.void:5:" OR NOT errors MATCHES "::method::init")
              message(FATAL_ERROR "Implicit child failure lost source trace: ${errors}")
            endif()
          elseif(NOT errors MATCHES "stages.void:12:" OR errors MATCHES "::method::init")
            message(FATAL_ERROR "Argument failure did not precede child initialization: ${errors}")
          endif()
        endforeach()
      endforeach()
    endif()
    if(NOT METHODS AND NOT INITIALIZERS AND program STREQUAL "order")
      foreach(input 0 1)
        foreach(engine jit aot)
          if(engine STREQUAL "jit")
            execute_process(COMMAND "${COMPILER}" run "${source}" "${input}" ${flags} RESULT_VARIABLE status ERROR_VARIABLE errors OUTPUT_VARIABLE output)
          else()
            execute_process(COMMAND "${executable}" "${input}" RESULT_VARIABLE status ERROR_VARIABLE errors OUTPUT_VARIABLE output)
          endif()
          string(APPEND errors "${output}")
          if(input EQUAL 0)
            set(message "zero")
            set(location "order.void:9:")
          else()
            set(message "conversion")
            set(location "order.void:6:")
          endif()
          if(NOT status EQUAL 1 OR NOT errors MATCHES "${message}" OR NOT errors MATCHES "${location}")
            message(FATAL_ERROR "${mode}/${engine}: constructor evaluation order or failure context broken: ${status} ${errors}")
          endif()
        endforeach()
      endforeach()
    endif()
  endforeach()
endforeach()
message(STATUS "Value source normal/O2 JIT/AOT, target layouts, DWARF and failure traces passed")

if(METHODS)
  set(invalid "${OUTPUT}/invalid-init.void")
  file(WRITE "${invalid}" "value struct point:\n    x: i32\nfunc (p point) init():\n    p.x = 1\nfunc entry(value: i32) -> i32:\n    var p = point()\n    p.init()\n    return value\n")
  set(protected "${OUTPUT}/protected.o")
  file(WRITE "${protected}" "preserve previous output")
  foreach(action check run emit)
    set(arguments)
    if(action STREQUAL "run")
      set(arguments 0)
    elseif(action STREQUAL "emit")
      set(arguments -o "${protected}")
    endif()
    execute_process(COMMAND "${COMPILER}" "${action}" "${invalid}" ${arguments} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT status EQUAL 1 OR NOT errors MATCHES "VOID2020")
      message(FATAL_ERROR "Direct init must reject before native publication: ${action}: ${status} ${output} ${errors}")
    endif()
  endforeach()
  file(READ "${protected}" saved)
  if(NOT saved STREQUAL "preserve previous output")
    message(FATAL_ERROR "Invalid initializer overwrote existing native output")
  endif()
endif()
