include("${CMAKE_CURRENT_LIST_DIR}/native_link.cmake")
file(MAKE_DIRECTORY "${OUTPUT}")
foreach(program main numeric order)
  set(source "${ROOT}/examples/value_structs/${program}.void")
  foreach(mode normal optimized)
    set(flags)
    if(mode STREQUAL "normal")
      set(flags --no-opt)
    endif()
    set(object "${OUTPUT}/${program}-${mode}.o")
    set(executable "${OUTPUT}/${program}-${mode}${EXE_SUFFIX}")
    execute_process(COMMAND "${COMPILER}" emit "${source}" -o "${object}" ${flags} RESULT_VARIABLE status ERROR_VARIABLE errors)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Struct emission failed: ${program}: ${errors}")
    endif()
    void_native_link("${object}" "${executable}")
    execute_process(COMMAND "${DWARFDUMP}" --verify "${object}" RESULT_VARIABLE status OUTPUT_VARIABLE debug ERROR_VARIABLE errors)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Invalid aggregate debug information: ${debug} ${errors}")
    endif()
    if(program STREQUAL "main")
      set(inputs -1 0 10)
      set(answers 28 36 46)
    elseif(program STREQUAL "numeric")
      set(inputs -10 0 123)
      set(answers -5 5 128)
    else()
      set(inputs 2 3)
      set(answers 5 4)
    endif()
    list(LENGTH inputs length)
    math(EXPR last "${length} - 1")
    foreach(index RANGE ${last})
      list(GET inputs ${index} input)
      list(GET answers ${index} answer)
      foreach(engine jit aot)
        if(engine STREQUAL "jit")
          execute_process(COMMAND "${COMPILER}" run "${source}" "${input}" ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
        else()
          execute_process(COMMAND "${executable}" "${input}" RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
        endif()
        string(STRIP "${result}" result)
        if(NOT status EQUAL 0 OR NOT result STREQUAL answer)
          message(FATAL_ERROR "${program}/${mode}/${engine}(${input}): expected ${answer}; got ${result}, ${status}, ${errors}")
        endif()
      endforeach()
    endforeach()
    if(program STREQUAL "order")
      foreach(input 0 1)
        foreach(engine jit aot)
          if(engine STREQUAL "jit")
            execute_process(COMMAND "${COMPILER}" run "${source}" "${input}" ${flags} RESULT_VARIABLE status ERROR_VARIABLE errors OUTPUT_VARIABLE output)
          else()
            execute_process(COMMAND "${executable}" "${input}" RESULT_VARIABLE status ERROR_VARIABLE errors OUTPUT_VARIABLE output)
          endif()
          string(APPEND errors "${output}")
          if(input EQUAL 0)
            set(message "zero")
            set(location "order.void:9:")
          else()
            set(message "conversion")
            set(location "order.void:6:")
          endif()
          if(NOT status EQUAL 1 OR NOT errors MATCHES "${message}" OR NOT errors MATCHES "${location}")
            message(FATAL_ERROR "${mode}/${engine}: constructor evaluation order or failure context broken: ${status} ${errors}")
          endif()
        endforeach()
      endforeach()
    endif()
  endforeach()
endforeach()
message(STATUS "Value struct normal/O2 JIT/AOT, mixed/nested layouts and source-order failures passed")
