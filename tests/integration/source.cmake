include("${CMAKE_CURRENT_LIST_DIR}/native_link.cmake")
file(MAKE_DIRECTORY "${OUTPUT}")
foreach(program architecture loops functions)
  set(source "${ROOT}/examples/${program}.void")
  file(COPY "${source}" DESTINATION "${OUTPUT}/source files")
  set(source "${OUTPUT}/source files/${program}.void")
  execute_process(COMMAND "${COMPILER}" check "${source}" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Source check failed: ${program}")
  endif()
  if(program STREQUAL "architecture")
    set(inputs -1 0 1 10)
    set(expected 7 42 43 52)
  elseif(program STREQUAL "loops")
    set(inputs -1 0 1 10)
    set(expected 21 21 22 25)
  else()
    set(inputs -1 0 1 5 10 11)
    set(expected 9 1 1 120 3628800 0)
  endif()
  foreach(mode normal optimized)
    set(flags)
    if(mode STREQUAL "normal")
      set(flags --no-opt)
    endif()
    set(object "${OUTPUT}/${program}-${mode}.o")
    set(executable "${OUTPUT}/${program}-${mode}${EXE_SUFFIX}")
    execute_process(COMMAND "${COMPILER}" emit "${source}" -o "${object}" ${flags} RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Source object generation failed: ${program}")
    endif()
    void_native_link("${object}" "${executable}")
    execute_process(COMMAND "${DWARFDUMP}" --verify "${object}" RESULT_VARIABLE status OUTPUT_VARIABLE debug)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Invalid source debug metadata: ${debug}")
    endif()
    execute_process(COMMAND "${DWARFDUMP}" --debug-line "${object}" RESULT_VARIABLE status OUTPUT_VARIABLE debug)
    if(NOT status EQUAL 0 OR NOT debug MATCHES "${program}.void")
      message(FATAL_ERROR "Missing actual source line table: ${program}")
    endif()
    list(LENGTH inputs count)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
      list(GET inputs ${index} input)
      list(GET expected ${index} answer)
      foreach(engine jit aot)
        if(engine STREQUAL "jit")
          execute_process(COMMAND "${COMPILER}" run "${source}" "${input}" ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
        else()
          execute_process(COMMAND "${executable}" "${input}" RESULT_VARIABLE status OUTPUT_VARIABLE result ERROR_VARIABLE errors)
        endif()
        string(STRIP "${result}" result)
        if(NOT status EQUAL 0 OR NOT result STREQUAL answer)
          message(FATAL_ERROR "${program}/${mode}/${engine}(${input}): expected ${answer}; got ${result}, ${status}, ${errors}")
        endif()
      endforeach()
    endforeach()
    foreach(bad nope 2147483648 -2147483649 999999999999999999999999999)
      execute_process(COMMAND "${executable}" "${bad}" RESULT_VARIABLE status OUTPUT_QUIET)
      if(NOT status EQUAL 2)
        message(FATAL_ERROR "AOT executable accepted invalid i32 input: ${bad}")
      endif()
    endforeach()
    execute_process(COMMAND "${executable}" 1 2 RESULT_VARIABLE status OUTPUT_QUIET)
    if(NOT status EQUAL 2)
      message(FATAL_ERROR "AOT executable accepted extra arguments")
    endif()
  endforeach()
endforeach()
# Changing both source literals and helper names must change generated behavior.
file(READ "${ROOT}/examples/architecture.void" edited)
string(REPLACE "42" "13" edited "${edited}")
string(REPLACE "calculate" "main" edited "${edited}")
set(changed "${OUTPUT}/edited architecture.void")
file(WRITE "${changed}" "${edited}")
set(object "${OUTPUT}/edited.o")
set(executable "${OUTPUT}/edited${EXE_SUFFIX}")
execute_process(COMMAND "${COMPILER}" emit "${changed}" -o "${object}" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Edited source emission failed")
endif()
void_native_link("${object}" "${executable}")
execute_process(COMMAND "${COMPILER}" run "${changed}" 10 RESULT_VARIABLE status OUTPUT_VARIABLE result)
string(STRIP "${result}" result)
if(NOT status EQUAL 0 OR NOT result STREQUAL "23")
  message(FATAL_ERROR "Edited source did not change JIT behavior")
endif()
execute_process(COMMAND "${executable}" 10 RESULT_VARIABLE status OUTPUT_VARIABLE result)
string(STRIP "${result}" result)
if(NOT status EQUAL 0 OR NOT result STREQUAL "23")
  message(FATAL_ERROR "Edited source did not change AOT behavior")
endif()
set(invalid "${OUTPUT}/invalid source.void")
file(WRITE "${invalid}" "func entry(value: i32) -> i32:\n    while value > 0:\n        return 1\n    return 0\n")
execute_process(COMMAND "${COMPILER}" run "${invalid}" 0 RESULT_VARIABLE status ERROR_VARIABLE diagnostic OUTPUT_QUIET)
if(NOT status EQUAL 1 OR NOT diagnostic MATCHES "invalid source.void:2:5: error:" OR NOT diagnostic MATCHES "for condition:" OR diagnostic MATCHES "LLVM")
  message(FATAL_ERROR "CLI did not render a useful source diagnostic: ${diagnostic}")
endif()
message(STATUS "Actual source compiled, linked, debug-verified and executed with normal/O2 JIT and AOT")
