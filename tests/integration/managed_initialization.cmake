foreach(mode normal optimized)
  set(flags)
  if(mode STREQUAL "normal")
    set(flags --no-opt)
  endif()
  foreach(program main stress numeric imports failure fail_default fail_argument fail_child)
    foreach(input -1 0 10)
      foreach(engine jit aot)
        if(engine STREQUAL "jit")
          execute_process(COMMAND "${COMPILER}" run "${ROOT}/examples/managed_initialization/${program}.void" "${input}" ${flags} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
        else()
          execute_process(COMMAND "${BIN}/void_managed_initialization_cli_${program}_${mode}${EXE_SUFFIX}" "${input}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
        endif()
        if(program STREQUAL "fail_default" OR ((program STREQUAL "failure" OR program STREQUAL "fail_argument" OR program STREQUAL "fail_child") AND input EQUAL 0))
          string(APPEND errors "${output}")
          if(NOT status EQUAL 1 OR NOT errors MATCHES "zero" OR NOT errors MATCHES "${program}.void:" OR NOT errors MATCHES "In function" OR (NOT program STREQUAL "fail_argument" AND NOT errors MATCHES "Called from") OR errors MATCHES "construction::")
            message(FATAL_ERROR "Missing constructor source failure: ${program}/${mode}/${engine}: ${status}, ${errors}")
          endif()
        else()
          if(program STREQUAL "main")
            if(input LESS 0)
              math(EXPR expected "${input} + 6")
            else()
              math(EXPR expected "2 * ${input} + 6")
            endif()
          elseif(program STREQUAL "stress")
            math(EXPR expected "${input} + 236")
          elseif(program STREQUAL "numeric")
            math(EXPR expected "${input} + 590")
          elseif(program STREQUAL "imports")
            math(EXPR expected "${input} + 3")
          elseif(program STREQUAL "failure")
            math(EXPR expected "100 / ${input} + 8")
          elseif(program STREQUAL "fail_argument" OR program STREQUAL "fail_child")
            math(EXPR expected "100 / ${input}")
          endif()
          string(STRIP "${output}" output)
          if(NOT status EQUAL 0 OR NOT output STREQUAL "${expected}")
            message(FATAL_ERROR "Constructor source ${program}/${mode}/${engine}(${input}): ${status}, ${output}, ${errors}")
          endif()
        endif()
      endforeach()
    endforeach()
  endforeach()
endforeach()
