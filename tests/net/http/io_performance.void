use io
use net/http

async func write_file() -> result<bool, io.error>:
    var bytes = (await io.read_bytes_async("@SOURCE@"))?
    with (await io.open_async("@DESTINATION@", io.open_mode.create))? as output:
        for i in 0..<256:
            var count = (await output.write_bytes_async(bytes))?
            if count != 65536:
                return Ok(false)
        return Ok((await output.position_async())? == 16777216)

async func exercise_io() -> i32:
    if (await write_file()) is Ok(var passed):
        if passed:
            return 0
    return 1

async func entry(mode: i32) -> i32:
    if mode == 0:
        return await exercise_io()
    if http.open_client() is Ok(var owner):
        with owner:
            if mode == 1:
                return await exercise_io()
            if owner.start(http.request(target = "@BASE@/large?536870912")) is Ok(var exchange):
                with exchange:
                    if (await exchange.response_async()) is Ok(var info):
                        if info.status == 200:
                            return await exercise_io()
    return 2
