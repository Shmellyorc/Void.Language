var calls: i32 = 0
struct box:
    value: i32
func (self box) init():
    calls += 1
    self.value = 3
func entry(n: i32) -> i32:
    calls = 0
    var total: i32 = 0
    for index in 0..<n:
        var item = box()
        item.value += index % 97
        total += item.value
    return total + calls
