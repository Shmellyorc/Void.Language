use "./support.void" as support
use json as codec
use text
use os
use convert

struct up_signature:
    key_id: string
    signature: string

struct up_signature_envelope:
    schema: i64
    signatures: [up_signature]

struct up_release_selection:
    version: string
    channel: string

struct up_release:
    id: string
    selection: up_release_selection?
    host: string
    build_identity: string
    artifact_url: string
    artifact_bytes: i64
    artifact_sha256: string
    inventory_url: string
    inventory_bytes: i64
    inventory_sha256: string

struct up_target_release:
    target: string
    version: string
    compiler: string
    runtime: string
    revision: string
    payload: up_release

struct up_installed_pack:
    pack: up_target_release
    catalog_digest: string
    catalog_serial: i64

struct up_pack_catalog:
    releases: [up_target_release]

struct up_catalog:
    schema: i64
    domain: string
    serial: i64
    issued: i64
    expires: i64
    min_manager: i64
    llvm_version: string
    revoked: [string]
    releases: [up_release]
    target_packs: up_pack_catalog?

struct up_member:
    name: string
    size: i64
    sha256: string
    executable: bool
    directory: bool

struct up_inventory:
    schema: i64
    release_id: string
    host: string
    build_identity: string
    expanded_bytes: i64
    members: [up_member]

struct up_toolchain_identity:
    schema: i64
    release_id: string
    host: string
    build_identity: string
    llvm_version: string

struct up_installed:
    release: up_release
    catalog_digest: string
    catalog_serial: i64

struct up_control:
    schema: i64 = 1
    generation: i64
    serial: i64
    catalog_digest: string
    last_time: i64
    current: string
    previous: string
    revoked: [string]
    installed: [up_installed]

struct up_pack_state:
    schema: i64 = 1
    installed: [up_installed_pack]

struct up_marker:
    schema: i64
    application: string

func up_host() -> string:
    var platform_name = os.platform()
    var architecture_name = os.architecture()
    if platform_name == "linux" and architecture_name == "x86_64":
        return "linux-x86_64-ubuntu24.04"
    if platform_name == "windows" and architecture_name == "x86_64":
        return "windows-x86_64"
    if platform_name == "macos" and architecture_name == "aarch64":
        return "macos-aarch64-14.0"
    return "unqualified-{platform_name}-{architecture_name}"

func up_is_revoked(const revoked_ids: [string], release_id: string) -> bool:
    for item in revoked_ids:
        if item == release_id:
            return true
    return false

func up_catalog_shape(document: up_catalog) -> result<bool, support.up_error>:
    if document.schema != 1 or document.domain != "voidup-catalog-v1" or document.llvm_version != "23.1.4":
        return Err(support.up_fail("unsupported catalog schema, domain or LLVM identity", "catalog"))
    if document.serial < 1 or document.min_manager < 1 or document.min_manager > support.up_manager_version:
        return Err(support.up_fail("unsupported catalog serial or manager version", "catalog"))
    if document.issued < 1 or document.expires <= document.issued or document.expires - document.issued > 2592000:
        return Err(support.up_fail("catalog validity interval is invalid", "catalog"))
    if document.releases.count < 1 or document.releases.count > 64 or document.revoked.count > 1024:
        return Err(support.up_fail("catalog cardinality exceeds local limit", "catalog"))
    var identities: {string: bool}
    for item in document.releases:
        var checked_release = up_release_shape(item)?
        var combined = item.host + "/" + item.id
        if identities.contains(combined):
            return Err(support.up_fail("duplicate release identity", "catalog"))
        identities[combined] = true
        identities[item.id] = true
    var versions: {string: bool}
    var packs = up_catalog_packs(document)
    if document.target_packs != null and document.min_manager < 3:
        return Err(support.up_fail("target-pack catalogs require manager version 3", "catalog"))
    if packs.count > 64:
        return Err(support.up_fail("target-pack catalog exceeds local limit", "catalog"))
    for pack in packs:
        var checked_pack = up_pack_shape(pack)?
        var selection = pack.target + "/" + pack.compiler + "/" + pack.runtime + "/" + pack.version
        if identities.contains(pack.payload.id) or versions.contains(selection):
            return Err(support.up_fail("duplicate target-pack identity or version", "catalog"))
        identities[pack.payload.id] = true
        versions[selection] = true
    var revoked_seen: {string: bool}
    for item in document.revoked:
        if not support.up_identifier(item) or revoked_seen.contains(item):
            return Err(support.up_fail("invalid or duplicate revocation", "catalog"))
        revoked_seen[item] = true
    return Ok(true)

func up_release_shape(item: up_release) -> result<bool, support.up_error>:
    if not support.up_identifier(item.id) or not support.up_sha_text(item.build_identity) or not support.up_identifier(item.host):
        return Err(support.up_fail("invalid release identity", "catalog"))
    if item.artifact_bytes < 22 or item.artifact_bytes > support.up_package_limit or item.inventory_bytes < 1 or item.inventory_bytes > support.up_metadata_limit:
        return Err(support.up_fail("signed length exceeds local limit", "catalog"))
    if not support.up_sha_text(item.artifact_sha256) or not support.up_sha_text(item.inventory_sha256):
        return Err(support.up_fail("invalid signed digest", "catalog"))
    return Ok(true)

func up_official_target(target: string) -> bool:
    # This catalog format currently carries the redistributable GNU closure.
    # Private MSVC registrations remain custom packs.
    return target == "linux-x64" or target == "linux-arm64"

func up_pack_shape(pack: up_target_release) -> result<bool, support.up_error>:
    var checked_release = up_release_shape(pack.payload)?
    if not up_official_target(pack.target) or pack.payload.host != pack.target or pack.payload.selection != null:
        return Err(support.up_fail("invalid official target-pack identity", "catalog"))
    var checked_version = up_stable_version(pack.version)?
    var checked_compiler = up_stable_version(pack.compiler)?
    var revision = pack.revision.to_utf8()
    if revision.count != 40:
        return Err(support.up_fail("invalid target-pack source revision", "catalog"))
    for byte in revision:
        if not ((byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 102)):
            return Err(support.up_fail("invalid target-pack source revision", "catalog"))
    if pack.runtime != "void-aot-64-v1" or pack.payload.artifact_bytes > 285212672 or pack.payload.inventory_bytes > 65536:
        return Err(support.up_fail("unsupported target-pack ABI or archive bounds", "catalog"))
    return Ok(true)

func up_catalog_packs(document: up_catalog) -> [up_target_release]:
    if document.target_packs is Ok(var packs):
        return packs.releases
    return []

func up_find_release(document: up_catalog, release_id: string) -> result<up_release, support.up_error>:
    for item in document.releases:
        if item.id == release_id and item.host == up_host():
            return Ok(item)
    return Err(support.up_fail("release is absent for this host", "select"))

func up_stable_version(version: string) -> result<[i64], support.up_error>:
    var parts = support.up_txt(text.split(version, "."))?
    if parts.count != 3:
        return Err(support.up_fail("stable version requires three numeric components", "select"))
    var numbers: [i64] = []
    for part in parts:
        var bytes = part.to_utf8()
        if bytes.count == 0 or bytes.count > 9 or (bytes.count > 1 and bytes[0] == 48):
            return Err(support.up_fail("invalid stable version component", "select"))
        for byte in bytes:
            if byte < 48 or byte > 57:
                return Err(support.up_fail("stable versions cannot contain prerelease or build suffixes", "select"))
        if convert.parse<i64>(part) is Ok(var number):
            numbers.push(number)
        else:
            return Err(support.up_fail("invalid stable version number", "select"))
    return Ok(numbers)

func up_version_compare(first: string, second: string) -> result<i32, support.up_error>:
    var a = up_stable_version(first)?
    var b = up_stable_version(second)?
    for index in 0..<3:
        if a[index] < b[index]:
            return Ok(-1)
        if a[index] > b[index]:
            return Ok(1)
    return Ok(0)

func up_latest_stable(document: up_catalog) -> result<up_release, support.up_error>:
    var selected = up_release()
    var versions: {string: bool}
    for item in document.releases:
        if item.host != up_host() or up_release_channel(item) != "stable" or up_is_revoked(document.revoked, item.id):
            continue
        var version = up_release_version(item)?
        var checked = up_stable_version(version)?
        if versions.contains(version):
            return Err(support.up_fail("ambiguous stable version for this host", "select"))
        versions[version] = true
        if selected.id == "":
            selected = item
        else if up_version_compare(version, up_release_version(selected)?)? > 0:
            selected = item
    if selected.id == "":
        return Err(support.up_fail("no compatible stable release is available for this host", "select"))
    return Ok(selected)

func up_release_channel(release: up_release) -> string:
    if release.selection is Ok(var selection):
        return selection.channel
    return ""

func up_release_version(release: up_release) -> result<string, support.up_error>:
    if release.selection is Ok(var selection):
        return Ok(selection.version)
    return Err(support.up_fail("stable release lacks an authenticated version", "select"))

func up_same_selection(first: up_release, second: up_release) -> bool:
    if first.selection is Ok(var a):
        if second.selection is Ok(var b):
            return a.version == b.version and a.channel == b.channel
        return false
    return second.selection == null

func up_member_path(member: up_member) -> result<string, support.up_error>:
    if member.directory:
        if not text.ends_with(member.name, "/"):
            return Err(support.up_fail("directory inventory name lacks slash", "inventory"))
        return support.up_txt(text.substring(member.name, 0, member.name.to_utf8().count - 1))
    return Ok(member.name)

func up_inventory_parse(const raw_inventory: [u8], release: up_release, target_pack: bool = false) -> result<up_inventory, support.up_error>:
    if raw_inventory.count != release.inventory_bytes or support.up_digest(raw_inventory)? != release.inventory_sha256:
        return Err(support.up_fail("inventory digest or length mismatch", "inventory"))
    var document = support.up_json(codec.parse_as<up_inventory>(support.up_text(raw_inventory)?, support.up_json_budget()))?
    if document.schema != 1 or document.release_id != release.id or document.host != release.host or document.build_identity != release.build_identity:
        return Err(support.up_fail("inventory identity differs from catalog", "inventory"))
    if document.expanded_bytes < 0 or document.expanded_bytes > support.up_expanded_limit or document.members.count < 4 or document.members.count > support.up_count_limit:
        return Err(support.up_fail("inventory exceeds local limits", "inventory"))
    if target_pack and (document.expanded_bytes > 268468224 or document.members.count > 100):
        return Err(support.up_fail("target-pack inventory exceeds local limits", "inventory"))
    var names: {string: bool}
    var directories: {string: bool}
    var file_names: {string: bool}
    var total: i64 = 0
    for member in document.members:
        var relative_name = up_member_path(member)?
        var parts = support.up_path_parts(relative_name)?
        if target_pack and member.executable:
            return Err(support.up_fail("target-pack inventory declares an executable", "inventory"))
        var canonical = text.to_lower(relative_name)
        if names.contains(canonical):
            return Err(support.up_fail("duplicate or case-colliding inventory path", "inventory"))
        names[canonical] = true
        if member.directory:
            if member.size != 0 or member.executable or member.sha256 != "":
                return Err(support.up_fail("directory has file metadata", "inventory"))
            directories[relative_name] = true
        else:
            if member.size < 0 or member.size > support.up_file_limit or not support.up_sha_text(member.sha256):
                return Err(support.up_fail("invalid file metadata", "inventory"))
            if member.size > support.up_expanded_limit - total:
                return Err(support.up_fail("expanded size overflow", "inventory"))
            total += member.size
            file_names[relative_name] = member.executable
    for member in document.members:
        var parts = support.up_path_parts(up_member_path(member)?)?
        var ancestor = ""
        for index in 0..<parts.count - 1:
            if index != 0:
                ancestor += "/"
            ancestor += parts[index]
            if not directories.contains(ancestor):
                return Err(support.up_fail("inventory ancestor is not a declared directory", "inventory"))
    if total != document.expanded_bytes:
        return Err(support.up_fail("expanded size does not match inventory", "inventory"))
    if target_pack:
        if not directories.contains("link") or not directories.contains("licenses"):
            return Err(support.up_fail("target-pack inventory lacks link or license directory", "inventory"))
        for member in document.members:
            if member.name == "target-pack.txt" and not member.directory and member.size > 0 and member.size <= 32768 and member.sha256 == release.build_identity:
                return Ok(document)
        return Err(support.up_fail("target-pack manifest differs from authenticated identity", "inventory"))
    var required_executables = ["bin/voidc", "bin/voidls", "sdk/bin/clang", "sdk/bin/ld.lld"]
    if os.platform() == "windows":
        required_executables = ["bin/voidc.exe", "bin/voidls.exe", "sdk/bin/clang.exe", "sdk/bin/lld-link.exe"]
    else if os.platform() == "macos":
        required_executables = ["bin/voidc", "bin/voidls", "sdk/bin/clang", "sdk/bin/ld64.lld"]
    for executable_name in required_executables:
        if not file_names.contains(executable_name) or not file_names[executable_name]:
            return Err(support.up_fail("required executable absent from inventory", "inventory"))
    for required_name in ["toolchain.json", "bin/void-native.txt", "bin/void-native-resources.txt", "share/void/stdlib/io.void"]:
        if not file_names.contains(required_name):
            return Err(support.up_fail("required toolchain resource absent from inventory", "inventory"))
    return Ok(document)
