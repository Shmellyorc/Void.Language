use "./support.void" as support
use net/http as http
use url
use io
use text

func up_same_origin(base: string, destination: string) -> result<bool, support.up_error>:
    var first = support.up_url(url.parse(base))?
    var second = support.up_url(url.parse(destination))?
    if first.scheme != "https" or second.scheme != "https" or second.has_fragment or second.has_query:
        return Err(support.up_fail("HTTPS without query/fragment is required", "download-policy"))
    if first.host != second.host or first.port != second.port:
        return Err(support.up_fail("download origin differs from the explicitly selected catalog origin", "download-policy"))
    return Ok(true)

func up_remote(base: string, reference: string) -> result<string, support.up_error>:
    var destination = support.up_url(url.resolve(base, reference))?
    var checked = up_same_origin(base, destination.to_string())?
    return Ok(destination.to_string())

func up_client(ca_file: string) -> result<http.client, support.up_error>:
    if ca_file != "":
        return support.up_http(http.open_client(http.client_options(tls = http.tls_options(trust = http.trust_source.pem_bundle(ca_file)), user_agent = "VOIDUP/0.2")))
    return support.up_http(http.open_client(http.client_options(user_agent = "VOIDUP/0.2")))

func up_request_options(maximum: i64, timeout: i64, total_timeout: i64 = 0) -> http.request_options:
    var total = timeout
    if total_timeout > 0:
        total = total_timeout
    return http.request_options(redirects = http.redirect_policy.none, max_redirects = 0,
        decoding = http.content_decoding.raw, max_encoded_bytes = maximum,
        max_decoded_bytes = maximum, max_buffer_bytes = maximum,
        connect_timeout_ms = timeout, header_timeout_ms = timeout,
        read_timeout_ms = timeout, total_timeout_ms = total)

# Keep ordinary/private transfers on the existing get/download APIs. GitHub's
# browser asset endpoint supports HEAD: inspect its single handoff without
# downloading an untrusted body, then GET with redirects still disabled.
func up_asset_target(client: http.client, target: string, maximum: i64, timeout: i64) -> result<string, support.up_error>:
    var source = support.up_url(url.parse(target))?
    if source.host != "github.com" or source.port != 443 or not text.starts_with(source.path, "/Shmellyorc/Void.Language/releases/download/"):
        return Ok(target)
    var response = support.up_http(client.send(http.request(method = "HEAD", target = target), up_request_options(maximum, timeout)))?
    var destination = up_redirect(target, response.info)?
    if destination == "":
        return Ok(target)
    return Ok(destination)

func up_fetch(client: http.client, base: string, target: string, maximum: i64, timeout: i64) -> result<[u8], support.up_error>:
    var checked = up_same_origin(base, target)?
    var resolved = up_asset_target(client, target, maximum, timeout)?
    var response = support.up_http(client.get(resolved, up_request_options(maximum, timeout)))?
    if response.info.status != 200 or response.info.content_decoded or response.bytes.count > maximum:
        return Err(support.up_error(message = "metadata response status or representation rejected", operation = "download", kind = "response_rejected", status = response.info.status, progress = response.bytes.count))
    return Ok(response.bytes)

func up_download(client: http.client, base: string, target: string, output_file: io.file, size: i64, timeout: i64, total_timeout: i64 = 0) -> result<bool, support.up_error>:
    var checked = up_same_origin(base, target)?
    var resolved = up_asset_target(client, target, size, timeout)?
    var outcome = support.up_http(client.download(http.request(target = resolved), output_file, up_request_options(size, timeout, total_timeout)))?
    if outcome.info.status != 200 or outcome.info.content_decoded or outcome.downloaded != size or outcome.downloaded_encoded != size:
        return Err(support.up_error(message = "package status or exact byte count mismatch", operation = "download", kind = "response_rejected", status = outcome.info.status, progress = outcome.downloaded))
    var flushed = support.up_io(output_file.flush())?
    return Ok(true)

# GitHub's immutable release URLs use a signed, short-lived CDN query. Only
# this exact HTTPS handoff is supported. Private catalogs still have no redirect
# authority; credentials, arbitrary hosts, ports and HTTP downgrades never pass.
func up_redirect(current: string, const info: http.response_info) -> result<string, support.up_error>:
    if info.status == 200 and not info.content_decoded:
        return Ok("")
    if info.status != 301 and info.status != 302 and info.status != 303 and info.status != 307 and info.status != 308:
        return Err(support.up_error(message = "release response status or representation rejected", operation = "download", status = info.status))
    var source = support.up_url(url.parse(current))?
    if source.scheme != "https" or source.host != "github.com" or source.port != 443 or not text.starts_with(source.path, "/Shmellyorc/Void.Language/releases/download/"):
        return Err(support.up_fail("redirect source is not an official GitHub release asset", "download-policy"))
    var locations = http.header_values(info.headers, "location")
    if locations.count != 1:
        return Err(support.up_fail("release redirect requires one Location", "download-policy"))
    var location = support.up_http(locations[0].text())?
    var destination = support.up_url(url.parse(location))?
    if destination.scheme != "https" or destination.host != "release-assets.githubusercontent.com" or destination.port != 443 or destination.has_fragment or not text.starts_with(destination.path, "/github-production-release-asset/"):
        return Err(support.up_fail("release redirect destination is not the approved GitHub asset CDN", "download-policy"))
    return Ok(destination.to_string())
