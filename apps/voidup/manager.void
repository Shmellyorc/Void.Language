use "./environment.void" as exports
use "./presentation.void" as presentation
use "./support.void" as support
use "./model.void" as model
use "./cli.void" as cli
use "./storage.void" as storage
use "./inventory.void" as inventory
use "./trust.void" as trust
use "./transport.void" as transport
use io
use net/http as http
use console
use os
use process
use time
use text
use json as codec
use "./distribution.void" as distribution

struct up_context:
    presentation: presentation.up_presentation
    options: cli.up_options
    root_cap: io.directory_handle
    versions_cap: io.directory_handle
    metadata_cap: io.directory_handle
    transactions_cap: io.directory_handle
    control_state: model.up_control

func up_say(message: string) -> result<bool, support.up_error>:
    if console.stdout.write(message + "\n") is Err(var cause):
        return Err(support.up_error(message = cause.message, operation = "stdout", kind = cause.kind.name, native_domain = "console", native_code = cause.os_code, progress = cause.bytes_transferred))
    return Ok(true)

func up_cached_catalog(context: up_context, digest: string) -> result<model.up_catalog, support.up_error>:
    if not support.up_sha_text(digest):
        return Err(support.up_fail("invalid cached catalog identity", "metadata"))
    with support.up_io(context.metadata_cap.open_directory("c-" + digest))? as proof:
        var raw_catalog = support.up_read_owned(proof, "catalog.json")?
        var raw_signatures = support.up_read_owned(proof, "catalog.sig", 4096)?
        if support.up_digest(raw_catalog)? != digest:
            return Err(support.up_fail("cached catalog digest mismatch", "metadata"))
        return trust.up_authenticate(raw_catalog, raw_signatures)

func up_check_retained(context: up_context) -> result<bool, support.up_error>:
    var state = context.control_state
    if state.serial == 0:
        return Ok(true)
    var retained = up_cached_catalog(context, state.catalog_digest)?
    if retained.serial != state.serial or retained.revoked.count != state.revoked.count:
        return Err(support.up_fail("control trust floor differs from authenticated metadata", "control"))
    for revoked_id in retained.revoked:
        if not model.up_is_revoked(state.revoked, revoked_id):
            return Err(support.up_fail("control lost an authenticated revocation", "control"))
    return Ok(true)

func up_stage(context: up_context, requested: string = "") -> result<io.directory_handle, support.up_error>:
    var transaction_entries = support.up_io(io.entries(context.options.root_path + "/transactions", max_entries = 1024))?
    if transaction_entries.count >= 256:
        return Err(support.up_fail("retained transaction limit reached; no automatic deletion is performed", "transaction"))
    if requested != "":
        return support.up_io(context.transactions_cap.create_directory(requested))
    for attempt in 0..<16:
        var name = storage.up_nonce()?
        var created = context.transactions_cap.create_directory(name)
        if created is Ok(var directory):
            return Ok(directory)
        if created is Err(var cause):
            if not (cause.kind is io.error_kind.already_exists):
                return Err(support.up_error(message = cause.message, operation = cause.operation, kind = cause.kind.name, native_domain = "filesystem", native_code = cause.os_code))
    return Err(support.up_fail("exclusive transaction name collisions", "transaction"))

func up_cache_catalog(context: up_context, digest: string, const raw_catalog: [u8], const raw_signatures: [u8]) -> result<bool, support.up_error>:
    var found = context.metadata_cap.open_directory("c-" + digest)
    if found is Ok(var existing):
        with existing as proof:
            var stored = support.up_read_owned(proof, "catalog.json")?
            if support.up_digest(stored)? != digest:
                return Err(support.up_fail("conflicting cached catalog", "metadata"))
            var checked = trust.up_authenticate(stored, support.up_read_owned(proof, "catalog.sig", 4096)?)?
            return Ok(true)
    if found is Err(var cause):
        if not (cause.kind is io.error_kind.not_found):
            return Err(support.up_error(message = cause.message, operation = cause.operation, kind = cause.kind.name, native_domain = "filesystem", native_code = cause.os_code))
    with up_stage(context)? as pending:
        var first = support.up_write_new(pending, "catalog.json", raw_catalog)?
        var second = support.up_write_new(pending, "catalog.sig", raw_signatures)?
        return support.up_publication(pending.publish(context.metadata_cap, "c-" + digest), "catalog-publication")

func up_cache_inventory(context: up_context, release: model.up_release, const raw_inventory: [u8]) -> result<bool, support.up_error>:
    var checked = model.up_inventory_parse(raw_inventory, release)?
    var found = context.metadata_cap.open_directory("i-" + release.inventory_sha256)
    if found is Ok(var existing):
        with existing as proof:
            var retained = model.up_inventory_parse(support.up_read_owned(proof, "inventory.json")?, release)?
            return Ok(true)
    if found is Err(var cause):
        if not (cause.kind is io.error_kind.not_found):
            return Err(support.up_error(message = cause.message, operation = cause.operation, kind = cause.kind.name, native_domain = "filesystem", native_code = cause.os_code))
    with up_stage(context)? as pending:
        var written = support.up_write_new(pending, "inventory.json", raw_inventory)?
        return support.up_publication(pending.publish(context.metadata_cap, "i-" + release.inventory_sha256), "inventory-publication")

func up_fetch_catalog(context: up_context) -> result<model.up_catalog, support.up_error>:
    presentation.up_status(context.presentation, "Fetching", "authenticated metadata")
    if context.options.catalog_url == "":
        return Err(support.up_fail("this command requires an explicit private --catalog HTTPS URL", "arguments", 2))
    if context.options.catalog_url == distribution.up_official_catalog and not distribution.up_source_enabled:
        return Err(support.up_fail("official distribution is not enabled in this engineering build; use an isolated authenticated test catalog", "distribution"))
    var checked_origin = transport.up_same_origin(context.options.catalog_url, context.options.catalog_url)?
    with transport.up_client(context.options.ca_file)? as client:
        var raw_catalog = transport.up_fetch(client, context.options.catalog_url, context.options.catalog_url, support.up_metadata_limit, context.options.timeout_ms)?
        var raw_signatures = transport.up_fetch(client, context.options.catalog_url, context.options.catalog_url + ".sig", 4096, context.options.timeout_ms)?
        presentation.up_status(context.presentation, "Verifying", "catalog signatures and freshness")
        var document = trust.up_authenticate(raw_catalog, raw_signatures)?
        var digest = support.up_digest(raw_catalog)?
        var now = support.up_clock(time.now_utc())?.seconds
        var freshness = trust.up_fresh(document, context.control_state, digest, now)?
        for revoked_id in context.control_state.revoked:
            if not model.up_is_revoked(document.revoked, revoked_id):
                return Err(support.up_fail("catalog attempts to remove a retained revocation", "freshness"))
        var retained = up_cache_catalog(context, digest, raw_catalog, raw_signatures)?
        context.control_state.serial = document.serial
        context.control_state.catalog_digest = digest
        context.control_state.last_time = now
        context.control_state.revoked = document.revoked
        # Commit trust before a package/inventory transfer can fail or be killed.
        var saved = storage.up_write_control(context.root_cap, context.control_state)?
        return Ok(document)

func up_record(context: up_context, release_id: string) -> result<model.up_installed, support.up_error>:
    if model.up_is_revoked(context.control_state.revoked, release_id):
        return Err(support.up_fail("release is revoked by retained authenticated metadata", "select"))
    for item in context.control_state.installed:
        if item.release.id == release_id:
            return Ok(item)
    return Err(support.up_fail("release is not installed", "select"))

func up_equivalent(first: model.up_release, second: model.up_release) -> bool:
    return first.id == second.id and model.up_same_selection(first, second) and first.host == second.host and first.build_identity == second.build_identity and first.artifact_bytes == second.artifact_bytes and first.artifact_sha256 == second.artifact_sha256 and first.inventory_bytes == second.inventory_bytes and first.inventory_sha256 == second.inventory_sha256

func up_installed_manifest(context: up_context, record: model.up_installed) -> result<model.up_inventory, support.up_error>:
    var proof = up_cached_catalog(context, record.catalog_digest)?
    if proof.serial != record.catalog_serial:
        return Err(support.up_fail("installation catalog serial mismatch", "verify"))
    var authenticated = model.up_find_release(proof, record.release.id)?
    if not up_equivalent(authenticated, record.release):
        return Err(support.up_fail("installation identity differs from signed catalog", "verify"))
    with support.up_io(context.metadata_cap.open_directory("i-" + record.release.inventory_sha256))? as inventory_cap:
        return model.up_inventory_parse(support.up_read_owned(inventory_cap, "inventory.json")?, authenticated)

func up_verify_version(context: up_context, release_id: string) -> result<model.up_inventory, support.up_error>:
    var record = up_record(context, release_id)?
    var manifest = up_installed_manifest(context, record)?
    with support.up_io(context.versions_cap.open_directory(release_id))? as prefix_cap:
        var verified = inventory.up_verify_prefix(prefix_cap, context.options.root_path + "/toolchains/" + release_id, record.release, manifest)?
    return Ok(manifest)

func up_activate(context: up_context, release_id: string, announce: bool = true) -> result<bool, support.up_error>:
    presentation.up_status(context.presentation, "Verifying", "selected toolchain")
    var verified = up_verify_version(context, release_id)?
    var now = support.up_clock(time.now_utc())?.seconds
    if now < context.control_state.last_time:
        return Err(support.up_fail("clock moved behind retained trusted time during verification", "activation"))
    if context.control_state.current != release_id:
        context.control_state.previous = context.control_state.current
        context.control_state.current = release_id
        context.control_state.last_time = now
        presentation.up_status(context.presentation, "Activating", "VOID toolchain")
        var saved = storage.up_write_control(context.root_cap, context.control_state)?
    if announce:
        return up_say("default {release_id}")
    return Ok(true)

func up_install(context: up_context) -> result<bool, support.up_error>:
    var automatic = context.options.release_id == "" or context.options.release_id == "latest"
    var catalog = up_fetch_catalog(context)?
    var release = model.up_release()
    if context.options.release_id == "" or context.options.release_id == "latest":
        release = model.up_latest_stable(catalog)?
        # Authenticated metadata can retire a release, but an update must not
        # silently downgrade an already selected newer stable toolchain.
        for installed in context.control_state.installed:
            if installed.release.id == context.control_state.current and model.up_release_channel(installed.release) == "stable":
                if model.up_version_compare(model.up_release_version(release)?, model.up_release_version(installed.release)?)? < 0:
                    return Err(support.up_fail("latest stable would downgrade the current toolchain; select an explicit release instead", "select"))
    else:
        release = model.up_find_release(catalog, context.options.release_id)?
    if model.up_is_revoked(context.control_state.revoked, release.id):
        return Err(support.up_fail("requested release is revoked", "install"))
    var raw_inventory: [u8] = []
    with transport.up_client(context.options.ca_file)? as client:
        var target = transport.up_remote(context.options.catalog_url, release.inventory_url)?
        raw_inventory = transport.up_fetch(client, context.options.catalog_url, target, release.inventory_bytes, context.options.timeout_ms)?
    var manifest = model.up_inventory_parse(raw_inventory, release)?
    var cached = up_cache_inventory(context, release, raw_inventory)?
    for item in context.control_state.installed:
        if item.release.id == release.id and not up_equivalent(item.release, release):
            return Err(support.up_fail("installed release ID has conflicting authenticated content", "install"))
    var existing = context.versions_cap.open_directory(release.id)
    if existing is Ok(var prefix_cap):
        with prefix_cap as retained:
            var checked = inventory.up_verify_prefix(retained, context.options.root_path + "/toolchains/" + release.id, release, manifest)?
    else:
        if existing is Err(var cause):
            if not (cause.kind is io.error_kind.not_found):
                return Err(support.up_error(message = cause.message, operation = cause.operation, kind = cause.kind.name, native_domain = "filesystem", native_code = cause.os_code))
        with up_stage(context)? as transaction:
            with support.up_io(transaction.create_directory("payload"))? as payload:
                with support.up_io(transaction.create_file("package.zip"))? as package:
                    with transport.up_client(context.options.ca_file)? as client:
                        var target = transport.up_remote(context.options.catalog_url, release.artifact_url)?
                        presentation.up_status(context.presentation, "Downloading", "toolchain artifact")
                        var downloaded = transport.up_download(client, context.options.catalog_url, target, package, release.artifact_bytes, context.options.timeout_ms, context.options.package_timeout_ms)?
                    presentation.up_status(context.presentation, "Verifying", "archive members and content")
                    var extracted = inventory.up_extract(package, payload, release, manifest)?
                # All exact signed members have been hashed and ZIP CRC-checked.
                presentation.up_status(context.presentation, "Installing", "verified VOID toolchain")
                var published = support.up_publication(payload.publish(context.versions_cap, release.id), "toolchain-publication")?
    var registered = false
    for item in context.control_state.installed:
        if item.release.id == release.id:
            registered = true
    if not registered:
        if context.control_state.installed.count >= 64:
            return Err(support.up_fail("installed release count reached local limit", "install"))
        context.control_state.installed.push(model.up_installed(release = release, catalog_digest = context.control_state.catalog_digest, catalog_serial = catalog.serial))
        var saved = storage.up_write_control(context.root_cap, context.control_state)?
    if not automatic:
        var announced = up_say("installed {release.id} build {release.build_identity}")?
    if context.options.activate:
        var activated = up_activate(context, release.id, not automatic)?
    if automatic:
        var version = model.up_release_version(release)?
        return up_say("VOID {version} is ready.")
    return Ok(true)

func up_environment(context: up_context, release_id: string) -> [string]:
    var environment: [string] = []
    # Preserve consent policy/storage and the user's desktop session. Stable
    # proxies must behave like the selected compiler for these OS inputs.
    for name in ["HOME", "USERPROFILE", "SYSTEMROOT", "WINDIR", "PROGRAMDATA", "TMPDIR", "TMP", "TEMP", "LANG", "LC_ALL", "TERM", "CI", "XDG_DATA_HOME", "XDG_CONFIG_HOME", "XDG_CACHE_HOME", "XDG_STATE_HOME", "XDG_RUNTIME_DIR", "DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY", "DBUS_SESSION_BUS_ADDRESS"]:
        if os.env(name) is Ok(var item):
            environment.push(name + "=" + item)
    environment.push("VOID_TARGET_PACK_ROOT=" + context.options.root_path + "/target-packs")
    # Compiler/loader overrides and caller PATH never select executables or SDKs.
    if os.platform() == "windows":
        environment.push("PATH=" + context.options.root_path + "/toolchains/" + release_id + "/sdk/bin")
    else:
        environment.push("PATH=" + context.options.root_path + "/toolchains/" + release_id + "/sdk/bin:/usr/bin:/bin")
    return environment

func up_compiler_path(context: up_context, release_id: string) -> string:
    var suffix = ""
    if os.platform() == "windows":
        suffix = ".exe"
    return context.options.root_path + "/toolchains/" + release_id + "/bin/voidc" + suffix

func up_pack_compiler(context: up_context, const arguments: [string]) -> result<string, support.up_error>:
    var selected = context.control_state.current
    var limits = process.capture_options(stdout_limit = 4096, stderr_limit = 4096, total_limit = 8192, timeout_ms = 120000)
    var captured = support.up_sys(process.capture(up_compiler_path(context, selected), arguments, up_environment(context, selected), context.options.working_directory, limits))?
    if captured.outcome != process.capture_end.complete or not captured.exited or captured.status.signaled or captured.status.code != 0:
        return Err(support.up_fail("selected compiler could not validate target packs: " + support.up_text(captured.stderr)?, "target-pack"))
    return Ok(text.trim(support.up_text(captured.stdout)?))

func up_same_pack(first: model.up_target_release, second: model.up_target_release) -> bool:
    return first.target == second.target and first.version == second.version and first.compiler == second.compiler and first.runtime == second.runtime and first.revision == second.revision and up_equivalent(first.payload, second.payload)

func up_pack_proof(context: up_context, record: model.up_installed_pack) -> result<bool, support.up_error>:
    var proof = up_cached_catalog(context, record.catalog_digest)?
    if proof.serial == record.catalog_serial and not model.up_is_revoked(proof.revoked, record.pack.payload.id):
        for pack in model.up_catalog_packs(proof):
            if up_same_pack(pack, record.pack):
                return Ok(true)
    return Err(support.up_fail("installed target-pack identity differs from its signed catalog", "target-pack"))

func up_pack_environment(context: up_context) -> result<string, support.up_error>:
    var selectors: [string] = []
    var installed = storage.up_read_packs(context.root_cap, context.control_state.serial)?
    for record in installed:
        var release = record.pack.payload
        if model.up_is_revoked(context.control_state.revoked, release.id):
            continue
        var proof = up_pack_proof(context, record)?
        selectors.push(record.pack.target + ":" + release.inventory_sha256 + ":" + release.build_identity)
    return support.up_txt(text.join(selectors, ","))

func up_pack_compatible(pack: model.up_target_release, compatibility: string) -> bool:
    return compatibility == "VOID target pack 1|" + pack.compiler + "|23.1.4|" + pack.runtime

func up_pack_select(document: model.up_catalog, target: string, compatibility: string) -> result<model.up_target_release, support.up_error>:
    var best = model.up_target_release(payload = model.up_release())
    for candidate in model.up_catalog_packs(document):
        if candidate.target != target or not up_pack_compatible(candidate, compatibility) or model.up_is_revoked(document.revoked, candidate.payload.id):
            continue
        if best.target == "" or model.up_version_compare(candidate.version, best.version)? > 0:
            best = candidate
    if best.target == "":
        return Err(support.up_fail("no compatible authenticated target pack for " + target, "target-pack"))
    return Ok(best)

func up_pack_directory(context: up_context) -> result<io.directory_handle, support.up_error>:
    var opened = context.root_cap.open_directory("official-target-packs")
    if opened is Ok(var existing):
        return Ok(existing)
    if opened is Err(var cause):
        if cause.kind is io.error_kind.not_found:
            var created = support.up_io(context.root_cap.create_directory("official-target-packs"))?
            var synced = context.root_cap.sync()
            if synced is Err(var failure):
                created.deinit()
                return Err(support.up_error(message = failure.message, operation = failure.operation, kind = failure.kind.name, native_domain = "filesystem", native_code = failure.os_code))
            return Ok(created)
    return support.up_io(opened)

func up_pack_validate(context: up_context, pack: model.up_target_release, absolute: string) -> result<bool, support.up_error>:
    var verified = up_pack_compiler(context, ["target", "check-payload", absolute, pack.target, pack.version, pack.revision, pack.payload.build_identity])?
    return Ok(true)

func up_pack_publish(context: up_context, pack: model.up_target_release, packs_cap: io.directory_handle) -> result<bool, support.up_error>:
    var release = pack.payload
    var slot = "p-" + release.inventory_sha256
    var raw_inventory: [u8] = []
    with transport.up_client(context.options.ca_file)? as client:
        var target = transport.up_remote(context.options.catalog_url, release.inventory_url)?
        raw_inventory = transport.up_fetch(client, context.options.catalog_url, target, release.inventory_bytes, context.options.timeout_ms)?
    var manifest = model.up_inventory_parse(raw_inventory, release, true)?
    var existing = packs_cap.open_directory(slot)
    if existing is Ok(var prefix):
        with prefix as retained:
            var absolute = context.options.root_path + "/official-target-packs/" + slot
            var verified = inventory.up_verify_prefix(retained, absolute, release, manifest, true)?
            return up_pack_validate(context, pack, absolute)
    if existing is Err(var cause):
        if not (cause.kind is io.error_kind.not_found):
            return Err(support.up_error(message = cause.message, operation = cause.operation, kind = cause.kind.name, native_domain = "filesystem", native_code = cause.os_code))
    # The content slot is immutable. A later retry verifies a slot left behind
    # between this publication and the separate control-state commit.
    var transaction_name = storage.up_nonce()?
    with up_stage(context, transaction_name)? as transaction:
        with support.up_io(transaction.create_directory("payload"))? as payload:
            with support.up_io(transaction.create_file("package.zip"))? as package:
                with transport.up_client(context.options.ca_file)? as client:
                    var target = transport.up_remote(context.options.catalog_url, release.artifact_url)?
                    presentation.up_status(context.presentation, "Downloading", "target-pack artifact")
                    var downloaded = transport.up_download(client, context.options.catalog_url, target, package, release.artifact_bytes, context.options.timeout_ms, context.options.package_timeout_ms)?
                var extracted = inventory.up_extract(package, payload, release, manifest, true)?
            var checked = up_pack_validate(context, pack, context.options.root_path + "/transactions/" + transaction_name + "/payload")?
            return support.up_publication(payload.publish(packs_cap, slot), "target-pack-publication")

func up_target_online(context: up_context) -> result<bool, support.up_error>:
    if context.options.target_action == "available" and context.options.catalog_url == distribution.up_official_catalog and not distribution.up_source_enabled:
        return up_say("No signed official target packs are enabled on this release channel.")
    if context.options.target_id != "" and not model.up_official_target(context.options.target_id):
        return Err(support.up_fail("this channel supports official GNU Linux target packs", "target-pack"))
    if context.control_state.current == "":
        return Err(support.up_fail("a default toolchain must be installed before acquiring target packs", "target-pack"))
    var document = up_fetch_catalog(context)?
    var checked = up_verify_version(context, context.control_state.current)?
    var compatibility = up_pack_compiler(context, ["target", "compatibility"])?
    if context.options.target_action == "available":
        for pack in model.up_catalog_packs(document):
            if up_pack_compatible(pack, compatibility) and not model.up_is_revoked(document.revoked, pack.payload.id):
                var printed = up_say("{pack.target} {pack.version} source={pack.revision}")?
        return Ok(true)
    var target = context.options.target_id
    var selected = up_pack_select(document, target, compatibility)?
    var records: [model.up_installed_pack] = []
    var was_installed = false
    var installed = storage.up_read_packs(context.root_cap, context.control_state.serial)?
    for record in installed:
        if record.pack.target != target:
            records.push(record)
            continue
        was_installed = true
        var proof = up_pack_proof(context, record)?
        if record.pack.payload.id == selected.payload.id and not up_same_pack(record.pack, selected):
            return Err(support.up_fail("target-pack release ID has conflicting authenticated content", "target-pack"))
        if up_pack_compatible(record.pack, compatibility):
            var order = model.up_version_compare(selected.version, record.pack.version)?
            if order < 0:
                return Err(support.up_fail("target-pack update would downgrade the installed version", "target-pack"))
            if order == 0 and not up_same_pack(record.pack, selected):
                return Err(support.up_fail("same target-pack version has conflicting authenticated content", "target-pack"))
    if context.options.target_action == "update" and not was_installed:
        return Err(support.up_fail("target pack is not installed; use target install", "target-pack"))
    with up_pack_directory(context)? as packs_cap:
        var published = up_pack_publish(context, selected, packs_cap)?
    records.push(model.up_installed_pack(pack = selected, catalog_digest = context.control_state.catalog_digest, catalog_serial = document.serial))
    var saved = storage.up_write_packs(context.root_cap, records)?
    return up_say("installed {target} {selected.version}")

func up_target_remove(context: up_context) -> result<bool, support.up_error>:
    var retained: [model.up_installed_pack] = []
    var removed = false
    var installed = storage.up_read_packs(context.root_cap, context.control_state.serial)?
    for record in installed:
        if record.pack.target == context.options.target_id:
            removed = true
        else:
            retained.push(record)
    if not removed:
        return Err(support.up_fail("target pack is not installed", "target-pack"))
    var saved = storage.up_write_packs(context.root_cap, retained)?
    return up_say("removed " + context.options.target_id)

func up_run(context: up_context, writer: io.directory_lock) -> result<i32, support.up_error>:
    var selected_id = context.options.release_id
    if selected_id == "default":
        selected_id = context.control_state.current
    if selected_id == "":
        return Err(support.up_fail("no default toolchain is selected", "run"))
    var manifest = up_verify_version(context, selected_id)?
    var environment = up_environment(context, selected_id)
    if context.options.tool == "voidc" and context.options.forwarded.count > 0:
        var first = context.options.forwarded[0]
        if first == "target" or first == "publish":
            environment.push("VOIDUP_TARGET_PACKS=" + up_pack_environment(context)?)
    var tool_name = context.options.tool
    if os.platform() == "windows":
        tool_name += ".exe"
    var relative_executable = "bin/" + tool_name
    var expected_digest = ""
    var expected_size: i64 = -1
    for member in manifest.members:
        if member.name == relative_executable and member.executable:
            expected_digest = member.sha256
            expected_size = member.size
    if expected_size < 0:
        return Err(support.up_fail("tool is not an inventoried executable", "run"))
    with support.up_io(context.versions_cap.open_directory(selected_id))? as prefix_cap:
        with storage.up_file_beneath(prefix_cap, relative_executable)? as verified_executable:
            if support.up_hash_file(verified_executable, expected_size)? != expected_digest:
                return Err(support.up_fail("tool changed after prefix verification", "run"))
            var released = support.up_io(writer.close())?
            var absolute_executable = context.options.root_path + "/toolchains/" + selected_id + "/" + relative_executable
            with support.up_sys(process.start(absolute_executable, context.options.forwarded, environment, context.options.working_directory))? as running:
                var status = support.up_sys(running.wait())?
                if status.signaled:
                    return Ok((128 + status.signal) as i32)
                return Ok(status.code as i32)

func up_dispatch(context: up_context, writer: io.directory_lock) -> result<i32, support.up_error>:
    var command_name = context.options.command
    if command_name == "target" and context.options.target_action != "":
        if context.options.target_action == "remove":
            var removed = up_target_remove(context)?
        else:
            var acquired = up_target_online(context)?
        return Ok(0)
    if command_name == "run" or command_name == "target":
        return up_run(context, writer)
    if command_name == "setup" or command_name == "update":
        context.options.release_id = ""
        context.options.activate = true
        var installed = up_install(context)?
    else if command_name == "install":
        var installed = up_install(context)?
    else if command_name == "default":
        var changed = up_activate(context, context.options.release_id)?
    else if command_name == "rollback":
        if context.control_state.previous == "":
            return Err(support.up_fail("no previous selection is retained", "rollback"))
        var changed = up_activate(context, context.control_state.previous)?
    else if command_name == "verify":
        var checked = up_verify_version(context, context.options.release_id)?
        var printed = up_say("verified " + context.options.release_id)?
    else if command_name == "env":
        var selected_id = context.control_state.current
        if selected_id == "":
            return Err(support.up_fail("no default toolchain is selected", "environment"))
        var checked = up_verify_version(context, selected_id)?
        var record = up_record(context, selected_id)?
        var bin_path = context.options.root_path + "/toolchains/" + selected_id + "/bin"
        var suffix = ""
        if os.platform() == "windows":
            suffix = ".exe"
        var paths = exports.up_paths(root = context.options.root_path, release_id = selected_id,
            build_identity = record.release.build_identity, bin = bin_path,
            voidc = bin_path + "/voidc" + suffix, voidls = bin_path + "/voidls" + suffix)
        var printed = up_say(exports.up_environment_text(paths, context.options.output_format)?)?
    else if command_name == "which":
        var selected_id = context.control_state.current
        if selected_id == "":
            return Err(support.up_fail("no default toolchain is selected", "which"))
        var checked = up_verify_version(context, selected_id)?
        var suffix = ""
        if os.platform() == "windows":
            suffix = ".exe"
        var printed = up_say(context.options.root_path + "/toolchains/" + selected_id + "/bin/" + context.options.tool + suffix)?
    else if command_name == "list":
        if context.options.available:
            var catalog = up_fetch_catalog(context)?
            for item in catalog.releases:
                if item.host == model.up_host():
                    var printed = up_say("{item.id} {item.build_identity} revoked={model.up_is_revoked(context.control_state.revoked, item.id)}")?
        else:
            for item in context.control_state.installed:
                var printed = up_say("{item.release.id} {item.release.build_identity} current={item.release.id == context.control_state.current} previous={item.release.id == context.control_state.previous} revoked={model.up_is_revoked(context.control_state.revoked, item.release.id)}")?
    else if command_name == "doctor":
        for item in context.control_state.installed:
            if not model.up_is_revoked(context.control_state.revoked, item.release.id):
                var checked = up_verify_version(context, item.release.id)?
        var pending = support.up_io(io.entries(context.options.root_path + "/transactions", max_entries = 1024))?
        var synchronized = support.up_io(context.root_cap.sync())?
        var printed = up_say("VOIDUP root verified; host={model.up_host()} trust=2-of-3 {distribution.up_trust_label} serial={context.control_state.serial} current={context.control_state.current} previous={context.control_state.previous} retained-transactions={pending.count}; native linking requires the declared host development SDK")?
    return Ok(0)

func up_execute(options: cli.up_options, status: presentation.up_presentation) -> result<i32, support.up_error>:
    with storage.up_root(options.root_path)? as root_cap:
        with support.up_io(root_cap.lock("writer.lock"))? as writer:
            with support.up_io(root_cap.open_directory("toolchains"))? as versions_cap:
                with support.up_io(root_cap.open_directory("metadata"))? as metadata_cap:
                    with support.up_io(root_cap.open_directory("transactions"))? as transactions_cap:
                        var context = up_context(presentation = status, options = options, root_cap = root_cap, versions_cap = versions_cap, metadata_cap = metadata_cap, transactions_cap = transactions_cap, control_state = storage.up_read_control(root_cap)?)
                        var retained = up_check_retained(context)?
                        return up_dispatch(context, writer)
