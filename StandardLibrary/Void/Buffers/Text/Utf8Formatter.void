    {
        if (!format.IsDefault)
            throw new FormatException("non-default StandardFormat is not implemented yet");
        bytesWritten = 0;
        ref byte first = ref destination.GetPinnableReference();
        return Runtime.Utf8TryFormatUInt64((ulong)value, ref first, destination.Length, out bytesWritten);
    }

    public static bool TryFormat(long value, Span<byte> destination, out int bytesWritten, StandardFormat format = default)
    {
        if (!format.IsDefault)
            throw new FormatException("non-default StandardFormat is not implemented yet");
        bytesWritten = 0;
        ref byte first = ref destination.GetPinnableReference();
        return Runtime.Utf8TryFormatInt64(value, ref first, destination.Length, out bytesWritten);
    }

    public static bool TryFormat(ulong value, Span<byte> destination, out int bytesWritten, StandardFormat format = default)
    {
        if (!format.IsDefault)
            throw new FormatException("non-default StandardFormat is not implemented yet");
        bytesWritten = 0;
        ref byte first = ref destination.GetPinnableReference();
        return Runtime.Utf8TryFormatUInt64(value, ref first, destination.Length, out bytesWritten);
    }

    public static bool TryFormat(float value, Span<byte> destination, out int bytesWritten, StandardFormat format = default)
    {
        if (!format.IsDefault)
            throw new FormatException("non-default StandardFormat is not implemented yet");
        bytesWritten = 0;
        ref byte first = ref destination.GetPinnableReference();
        return Runtime.Utf8TryFormatFloat(value, ref first, destination.Length, out bytesWritten);
