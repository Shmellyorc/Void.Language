        if (!format.IsDefault)
            throw new FormatException("non-default StandardFormat is not implemented yet");
        bytesWritten = 0;
        ref byte first = ref destination.GetPinnableReference();
        return Runtime.Utf8TryFormatInt64((long)value, ref first, destination.Length, out bytesWritten);
    }

