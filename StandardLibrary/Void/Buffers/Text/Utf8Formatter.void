    public static bool TryFormat(double value, Span<byte> destination, out int bytesWritten, StandardFormat format = default)
    {
        if (!format.IsDefault)
            throw new FormatException("non-default StandardFormat is not implemented yet");
        bytesWritten = 0;
        ref byte first = ref destination.GetPinnableReference();
