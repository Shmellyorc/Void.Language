using Void;
using Void.Buffers.Text;

namespace Void.Text;

public sealed class StringBuilder
{
    private byte[] _buffer;
    private int _byteLength;
    private int _length;
    private int _capacity;
    private int _maxCapacity;

    public int Length
    {
        get { return _length; }
        set
        {
            if (value < 0)
                throw new ArgumentOutOfRangeException("value", "StringBuilder length cannot be negative");
            if (value > _maxCapacity)
                throw new ArgumentOutOfRangeException("value", "StringBuilder length exceeds MaxCapacity");
            if (value == _length)
                return;
            if (value < _length)
            {
                string truncated = this.ToString().Substring(0, value);
                this.Clear();
                this.Append(truncated);
                return;
            }
            while (_length < value)
                this.Append('\0');
        }
    }

    public int Capacity
    {
        get { return _capacity; }
        set
        {
            if (value < 0)
                throw new ArgumentOutOfRangeException("capacity", "StringBuilder capacity cannot be negative");
            if (value < _length)
                throw new ArgumentOutOfRangeException("capacity", "StringBuilder capacity cannot be less than Length");
            if (value > _maxCapacity)
                throw new ArgumentOutOfRangeException("capacity", "StringBuilder capacity exceeds MaxCapacity");
            _capacity = value;
        }
    }

    public int MaxCapacity => _maxCapacity;

    internal int ByteLength => _byteLength;
    internal int ByteCapacity => _buffer.Length;

    public StringBuilder()
    {
        _buffer = new byte[16];
        _byteLength = 0;
        _length = 0;
        _capacity = 16;
        _maxCapacity = 2147483647;
    }

    public StringBuilder(int capacity)
    {
        if (capacity < 0)
            throw new ArgumentOutOfRangeException("capacity", "StringBuilder capacity cannot be negative");
        _buffer = new byte[capacity];
        _byteLength = 0;
        _length = 0;
        _capacity = capacity;
        _maxCapacity = 2147483647;
    }

    public StringBuilder(int capacity, int maxCapacity)
    {
        if (capacity < 0)
            throw new ArgumentOutOfRangeException("capacity", "StringBuilder capacity cannot be negative");
        if (maxCapacity < 1)
            throw new ArgumentOutOfRangeException("maxCapacity", "StringBuilder MaxCapacity must be positive");
        if (capacity > maxCapacity)
            throw new ArgumentOutOfRangeException("capacity", "StringBuilder capacity exceeds MaxCapacity");
        _buffer = new byte[capacity];
        _byteLength = 0;
        _length = 0;
        _capacity = capacity;
        _maxCapacity = maxCapacity;
    }

    public StringBuilder(string value)
    {
        _buffer = new byte[16];
        _byteLength = 0;
        _length = 0;
        _capacity = 16;
        _maxCapacity = 2147483647;
        this.Append(value);
    }

    public StringBuilder(string value, int capacity)
    {
        if (capacity < 0)
            throw new ArgumentOutOfRangeException("capacity", "StringBuilder capacity cannot be negative");
        int valueLength = value == null ? 0 : value.Length;
        int initialCapacity = capacity < valueLength ? valueLength : capacity;
        _buffer = new byte[initialCapacity];
        _byteLength = 0;
        _length = 0;
        _capacity = initialCapacity;
        _maxCapacity = 2147483647;
        this.Append(value);
    }

    private void EnsureLengthCapacity(int additional)
    {
        if (additional < 0)
            Runtime.Fail("StringBuilder additional length cannot be negative");
        if (_length > _maxCapacity - additional)
            throw new ArgumentOutOfRangeException("value", "StringBuilder length exceeds MaxCapacity");

        int required = _length + additional;
        if (required <= _capacity)
            return;

        int capacity = _capacity;
        if (capacity < 16)
            capacity = _maxCapacity < 16 ? _maxCapacity : 16;
        while (capacity < required)
        {
            if (capacity > _maxCapacity / 2)
            {
                capacity = _maxCapacity;
                break;
            }
            capacity *= 2;
        }
        if (capacity < required)
            throw new ArgumentOutOfRangeException("value", "StringBuilder length exceeds MaxCapacity");
        _capacity = capacity;
    }

    private void EnsureByteCapacity(int additional)
    {
        if (additional < 0)
            Runtime.Fail("StringBuilder additional byte count cannot be negative");
        if (_byteLength < 0 || _byteLength > _buffer.Length)
            Runtime.Fail("StringBuilder byte length invariant failed");
        if (additional <= _buffer.Length - _byteLength)
            return;
        if (_byteLength > 2147483647 - additional)
            throw new OutOfMemoryException("StringBuilder is too large");

        int required = _byteLength + additional;
        int capacity = _buffer.Length;
        if (capacity < 16)
            capacity = 16;
        while (capacity < required)
        {
            if (capacity > 1073741823)
            {
                capacity = required;
                break;
            }
            capacity *= 2;
        }

        byte[] grown = new byte[capacity];
        if (_byteLength > 0)
        {
            Span<byte> source = new Span<byte>(_buffer, 0, _byteLength);
            Span<byte> destination = new Span<byte>(grown, 0, _byteLength);
            source.CopyTo(destination);
        }
        _buffer = grown;
    }

    private StringBuilder AppendFormatted(bool value)
    {
        this.EnsureByteCapacity(5);
        Span<byte> destination = new Span<byte>(_buffer, _byteLength, _buffer.Length - _byteLength);
        int bytesWritten;
        if (!Utf8Formatter.TryFormat(value, destination, out bytesWritten, default(Void.Buffers.StandardFormat)))
            Runtime.Fail("StringBuilder boolean formatting failed");
        this.EnsureLengthCapacity(bytesWritten);
        _byteLength += bytesWritten;
        _length += bytesWritten;
        return this;
    }

    private StringBuilder AppendFormatted(long value)
    {
        this.EnsureByteCapacity(20);
        Span<byte> destination = new Span<byte>(_buffer, _byteLength, _buffer.Length - _byteLength);
        int bytesWritten;
        if (!Utf8Formatter.TryFormat(value, destination, out bytesWritten, default(Void.Buffers.StandardFormat)))
            Runtime.Fail("StringBuilder integer formatting failed");
        this.EnsureLengthCapacity(bytesWritten);
        _byteLength += bytesWritten;
        _length += bytesWritten;
        return this;
    }

    private StringBuilder AppendFormatted(ulong value)
    {
        this.EnsureByteCapacity(20);
        Span<byte> destination = new Span<byte>(_buffer, _byteLength, _buffer.Length - _byteLength);
        int bytesWritten;
        if (!Utf8Formatter.TryFormat(value, destination, out bytesWritten, default(Void.Buffers.StandardFormat)))
            Runtime.Fail("StringBuilder unsigned integer formatting failed");
        this.EnsureLengthCapacity(bytesWritten);
        _byteLength += bytesWritten;
        _length += bytesWritten;
        return this;
    }

    private StringBuilder AppendFormatted(float value)
    {
        this.EnsureByteCapacity(64);
        Span<byte> destination = new Span<byte>(_buffer, _byteLength, _buffer.Length - _byteLength);
        int bytesWritten;
        if (!Utf8Formatter.TryFormat(value, destination, out bytesWritten, default(Void.Buffers.StandardFormat)))
            Runtime.Fail("StringBuilder float formatting failed");
        this.EnsureLengthCapacity(bytesWritten);
        _byteLength += bytesWritten;
        _length += bytesWritten;
        return this;
    }

    private StringBuilder AppendFormatted(double value)
    {
        this.EnsureByteCapacity(96);
        Span<byte> destination = new Span<byte>(_buffer, _byteLength, _buffer.Length - _byteLength);
        int bytesWritten;
        if (!Utf8Formatter.TryFormat(value, destination, out bytesWritten, default(Void.Buffers.StandardFormat)))
            Runtime.Fail("StringBuilder double formatting failed");
        this.EnsureLengthCapacity(bytesWritten);
        _byteLength += bytesWritten;
        _length += bytesWritten;
        return this;
    }

    private StringBuilder AppendFormatted(decimal value)
    {
        this.EnsureByteCapacity(128);
        Span<byte> destination = new Span<byte>(_buffer, _byteLength, _buffer.Length - _byteLength);
        int bytesWritten;
        if (!Utf8Formatter.TryFormat(value, destination, out bytesWritten, default(Void.Buffers.StandardFormat)))
            Runtime.Fail("StringBuilder decimal formatting failed");
        this.EnsureLengthCapacity(bytesWritten);
        _byteLength += bytesWritten;
        _length += bytesWritten;
        return this;
    }

    public StringBuilder Append(string value)
    {
        if (value == null || value.Length == 0)
            return this;
        this.EnsureLengthCapacity(value.Length);
        int byteCount = Runtime.Utf8StringByteCount(value);
        this.EnsureByteCapacity(byteCount);
        int bytesWritten = Runtime.Utf8StringCopy(value, _buffer, _byteLength);
        _byteLength += bytesWritten;
        _length += value.Length;
        return this;
    }

    public StringBuilder Append(char value)
    {
        this.EnsureLengthCapacity(1);
        this.EnsureByteCapacity(4);
        int bytesWritten = Runtime.Utf8EncodeChar(value, _buffer, _byteLength);
        _byteLength += bytesWritten;
        _length++;
        return this;
    }

    public StringBuilder Append(bool value) => this.AppendFormatted(value);
    public StringBuilder Append(byte value) => this.AppendFormatted((ulong)value);
    public StringBuilder Append(sbyte value) => this.AppendFormatted((long)value);
    public StringBuilder Append(short value) => this.AppendFormatted((long)value);
    public StringBuilder Append(ushort value) => this.AppendFormatted((ulong)value);
    public StringBuilder Append(int value) => this.AppendFormatted((long)value);
    public StringBuilder Append(uint value) => this.AppendFormatted((ulong)value);
    public StringBuilder Append(long value) => this.AppendFormatted(value);
    public StringBuilder Append(ulong value) => this.AppendFormatted(value);
    public StringBuilder Append(float value) => this.AppendFormatted(value);
    public StringBuilder Append(double value) => this.AppendFormatted(value);
    public StringBuilder Append(decimal value) => this.AppendFormatted(value);

    public StringBuilder AppendLine()
    {
        return this.Append(Environment.NewLine);
    }

    public StringBuilder AppendLine(string value)
    {
        this.Append(value);
        return this.Append(Environment.NewLine);
    }

    public StringBuilder Clear()
    {
        _byteLength = 0;
        _length = 0;
        return this;
    }

    public string ToString()
    {
        return Runtime.StringFromUtf8(_buffer, _byteLength);
    }
}
