using Void;
using Void.Text;
using Void.Collections;

namespace Void.IO;

public static class Path
{
    internal static bool Windows() { return Runtime.NativePlatformWindows(); }
    public static char DirectorySeparatorChar { get { return Windows() ? (char)92 : (char)47; } }
    public static char AltDirectorySeparatorChar { get { return (char)47; } }
    public static char PathSeparator { get { return Windows() ? (char)59 : (char)58; } }
    private static bool Separator(char value) { return value == (char)47 || (Windows() && value == (char)92); }
    public static bool IsPathRooted(string path)
    {
        if (path == null || path.Length == 0) return false;
        return Separator(path[0]) || (Windows() && path.Length >= 2 && path[1] == (char)58);
    }
    public static string GetFullPath(string path)
    {
        IOErrors.CheckPath(path);
        if (Windows() && (path.StartsWith("\\\\?\\") || path.StartsWith("\\\\.\\")))
            throw new NotSupportedException("Device path normalization is not supported.");
        byte[] bytes = new byte[512];
        int count = Runtime.NativePathResolveAbsolute(path, bytes);
        while (count == -10)
        {
            if (bytes.Length > 1073741823) throw new OutOfMemoryException();
            bytes = new byte[bytes.Length * 2]; count = Runtime.NativePathResolveAbsolute(path, bytes);
        }
        if (count < 0) IOErrors.Throw(-count, path, true);
        string absolute = Encoding.UTF8.GetString(bytes, 0, count);
        int rootLength = RootLength(absolute);
        List<string> parts = new List<string>();
        int start = rootLength;
        for (int i = rootLength; i <= absolute.Length; i++)
        {
            if (i == absolute.Length || Separator(absolute[i]))
            {
                string part = absolute.Substring(start, i - start); start = i + 1;
                if (part == "..") { if (parts.Count > 0) parts.RemoveAt(parts.Count - 1); }
                else if (part.Length != 0 && part != ".") parts.Add(part);
            }
        }
        string root = absolute.Substring(0, rootLength);
        StringBuilder result = new StringBuilder(); result.Append(root);
        for (int i = 0; i < parts.Count; i++)
        {
            if (i > 0 || (root.Length != 0 && !Separator(root[root.Length - 1]))) result.Append(DirectorySeparatorChar);
            result.Append(parts[i]);
        }
        return result.ToString();
    }
    public static string Combine(string path1, string path2)
    {
        if (path1 == null) throw new ArgumentNullException("path1");
        if (path2 == null) throw new ArgumentNullException("path2");
        if (path1.IndexOf((char)0) >= 0 || path2.IndexOf((char)0) >= 0) throw new ArgumentException("Invalid path.");
        if (path2.Length == 0) return path1;
        if (path1.Length == 0 || IsPathRooted(path2)) return path2;
        if (Separator(path1[path1.Length - 1]) || (Windows() && path1[path1.Length - 1] == (char)58)) return path1 + path2;
        return path1 + DirectorySeparatorChar + path2;
    }
    public static string GetFileName(string path)
    {
        if (path == null) return null;
        int start = 0;
        for (int i = 0; i < path.Length; i++)
            if (Separator(path[i]) || (Windows() && path[i] == (char)58)) start = i + 1;
        return path.Substring(start);
    }
    internal static int RootLength(string path)
    {
        if (path.Length == 0) return 0;
        if (!Windows()) return Separator(path[0]) ? 1 : 0;
        if (path.Length >= 2 && path[1] == (char)58)
            return path.Length >= 3 && Separator(path[2]) ? 3 : 2;
        if (path.Length >= 2 && Separator(path[0]) && Separator(path[1]))
        {
            int parts = 0;
            for (int i = 2; i < path.Length; i++)
                if (Separator(path[i])) { parts++; if (parts == 2) return i; }
            return path.Length;
        }
        return Separator(path[0]) ? 1 : 0;
    }
    public static string GetDirectoryName(string path)
    {
        if (path == null || path.Length == 0) return null;
        int root = RootLength(path);
        if (path.Length <= root) return null;
        int end = path.Length;
        while (end > root && !Separator(path[end - 1])) end--;
        if (end <= root) return path.Substring(0, root);
        while (end > root && Separator(path[end - 1])) end--;
        return path.Substring(0, end);
    }
    public static string GetExtension(string path)
    {
        if (path == null) return null;
        string name = GetFileName(path);
        int dot = -1; for (int i = 0; i < name.Length; i++) if (name[i] == (char)46) dot = i;
        return dot < 0 || dot == name.Length - 1 ? string.Empty : name.Substring(dot);
    }
    public static bool HasExtension(string path) { string extension = GetExtension(path); return extension != null && extension.Length != 0; }
    public static string GetFileNameWithoutExtension(string path)
    {
        string name = GetFileName(path); if (name == null) return null;
        int dot = -1; for (int i = 0; i < name.Length; i++) if (name[i] == (char)46) dot = i;
        return dot < 0 ? name : name.Substring(0, dot);
    }
    public static string ChangeExtension(string path, string extension)
    {
        if (path == null) return null;
        int dot = -1;
        for (int i = 0; i < path.Length; i++)
        {
            if (Separator(path[i])) dot = -1;
            else if (path[i] == (char)46) dot = i;
        }
        string stem = dot < 0 ? path : path.Substring(0, dot);
        if (extension == null) return stem;
        if (path.Length == 0) return string.Empty;
        return extension.Length != 0 && extension[0] == (char)46 ? stem + extension : stem + "." + extension;
    }
}
