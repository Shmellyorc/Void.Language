namespace Void.Internal;

// Compiler-associated declaration scopes for VOID's canonical built-in types.
// These are compile-time member owners only; built-in values remain native
// primitive/string/object representations and are never boxed into these types.
[BuiltInAssociated("bool")]
internal static class BooleanAssociatedMembers
{
    public static bool Parse(string value)
    {
        bool result;
        int status = PrimitiveParsing.ParseBoolean(value, out result);
        if (status == PrimitiveParsing.Null) throw new ArgumentNullException("value");
        if (status != PrimitiveParsing.Success) throw new FormatException();
        return result;
    }

    public static bool TryParse(string value, out bool result)
    {
        int status = PrimitiveParsing.ParseBoolean(value, out result);
        if (status != PrimitiveParsing.Success) result = false;
        return status == PrimitiveParsing.Success;
    }
}

[BuiltInAssociated("byte")]
internal static class ByteAssociatedMembers
{
    [PrimitiveConstant("min")] public const byte MinValue = default;
    [PrimitiveConstant("max")] public const byte MaxValue = default;

    public static byte Parse(string value)
    {
        ulong magnitude;
        bool negative;
        int status = PrimitiveParsing.ParseIntegerMagnitude(value, false, 255ul, 0ul, out magnitude, out negative);
        if (status == PrimitiveParsing.Null) throw new ArgumentNullException("value");
        if (status == PrimitiveParsing.Overflow) throw new OverflowException();
        if (status != PrimitiveParsing.Success) throw new FormatException();
        return (byte)magnitude;
    }

    public static bool TryParse(string value, out byte result)
    {
        result = (byte)0;
        ulong magnitude;
        bool negative;
        int status = PrimitiveParsing.ParseIntegerMagnitude(value, false, 255ul, 0ul, out magnitude, out negative);
        if (status != PrimitiveParsing.Success) return false;
        result = (byte)magnitude;
        return true;
    }
}

[BuiltInAssociated("sbyte")]
internal static class SByteAssociatedMembers
{
    [PrimitiveConstant("min")] public const sbyte MinValue = default;
    [PrimitiveConstant("max")] public const sbyte MaxValue = default;

    public static sbyte Parse(string value)
    {
        ulong magnitude;
        bool negative;
        int status = PrimitiveParsing.ParseIntegerMagnitude(value, true, 127ul, 128ul, out magnitude, out negative);
        if (status == PrimitiveParsing.Null) throw new ArgumentNullException("value");
        if (status == PrimitiveParsing.Overflow) throw new OverflowException();
        if (status != PrimitiveParsing.Success) throw new FormatException();
        return negative && magnitude != 0ul ? (sbyte)(-(long)(magnitude - 1ul) - 1l) : (sbyte)magnitude;
    }

    public static bool TryParse(string value, out sbyte result)
    {
        result = (sbyte)0;
        ulong magnitude;
        bool negative;
        int status = PrimitiveParsing.ParseIntegerMagnitude(value, true, 127ul, 128ul, out magnitude, out negative);
        if (status != PrimitiveParsing.Success) return false;
        result = negative && magnitude != 0ul ? (sbyte)(-(long)(magnitude - 1ul) - 1l) : (sbyte)magnitude;
        return true;
    }
}

