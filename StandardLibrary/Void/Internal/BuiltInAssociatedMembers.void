[BuiltInAssociated("float")]
internal static class SingleAssociatedMembers
{
    [PrimitiveConstant("min")] public const float MinValue = default;
    [PrimitiveConstant("max")] public const float MaxValue = default;
    [PrimitiveConstant("epsilon")] public const float Epsilon = default;
    [PrimitiveConstant("nan")] public const float NaN = default;
    [PrimitiveConstant("positive-infinity")] public const float PositiveInfinity = default;
    [PrimitiveConstant("negative-infinity")] public const float NegativeInfinity = default;

    public static float Parse(string value)
    {
        float result;
        int status = PrimitiveParsing.ParseFloat32(value, out result);
        if (status == PrimitiveParsing.Null) throw new ArgumentNullException("value");
        if (status == PrimitiveParsing.Overflow) throw new OverflowException();
        if (status != PrimitiveParsing.Success) throw new FormatException();
        return result;
    }

    public static bool TryParse(string value, out float result)
    {
        int status = PrimitiveParsing.ParseFloat32(value, out result);
        if (status != PrimitiveParsing.Success) result = (float)0;
        return status == PrimitiveParsing.Success;
    }
}

