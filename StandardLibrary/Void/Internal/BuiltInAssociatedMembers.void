        if (status == PrimitiveParsing.Null) throw new ArgumentNullException("value");
        if (status != PrimitiveParsing.Success) throw new FormatException();
        return result;
    }

    public static bool TryParse(string value, out char result)
    {
        int status = PrimitiveParsing.ParseChar(value, out result);
        if (status != PrimitiveParsing.Success) result = char.MinValue;
        return status == PrimitiveParsing.Success;
    }
}

[BuiltInAssociated("string")]
internal static class StringAssociatedMembers
{
    // Existing string surfaces are declared here so receiver/member identity,
    // overloads and tooling use the ordinary static binder. Their established
    // representation-specific lowering remains in the compiler backend.
    public static string Empty { get { return string.Empty; } }

    public static string Concat(string left, string right) { return string.Concat(left, right); }

    public static string Concat(string left, bool right) { return string.Concat(left, right); }
    public static string Concat(bool left, string right) { return string.Concat(left, right); }
    public static string Concat(string left, byte right) { return string.Concat(left, right); }
    public static string Concat(byte left, string right) { return string.Concat(left, right); }
    public static string Concat(string left, sbyte right) { return string.Concat(left, right); }
    public static string Concat(sbyte left, string right) { return string.Concat(left, right); }
    public static string Concat(string left, short right) { return string.Concat(left, right); }
    public static string Concat(short left, string right) { return string.Concat(left, right); }
    public static string Concat(string left, ushort right) { return string.Concat(left, right); }
    public static string Concat(ushort left, string right) { return string.Concat(left, right); }
    public static string Concat(string left, int right) { return string.Concat(left, right); }
    public static string Concat(int left, string right) { return string.Concat(left, right); }
    public static string Concat(string left, uint right) { return string.Concat(left, right); }
    public static string Concat(uint left, string right) { return string.Concat(left, right); }
    public static string Concat(string left, long right) { return string.Concat(left, right); }
    public static string Concat(long left, string right) { return string.Concat(left, right); }
    public static string Concat(string left, ulong right) { return string.Concat(left, right); }
    public static string Concat(ulong left, string right) { return string.Concat(left, right); }
    public static string Concat(string left, float right) { return string.Concat(left, right); }
    public static string Concat(float left, string right) { return string.Concat(left, right); }
    public static string Concat(string left, double right) { return string.Concat(left, right); }
    public static string Concat(double left, string right) { return string.Concat(left, right); }
    public static string Concat(string left, decimal right) { return string.Concat(left, right); }
    public static string Concat(decimal left, string right) { return string.Concat(left, right); }
    public static string Concat(string left, char right) { return string.Concat(left, right); }
    public static string Concat(char left, string right) { return string.Concat(left, right); }

    public static bool Equals(string left, string right) { return string.Equals(left, right); }
    public static int CompareOrdinal(string left, string right) { return string.CompareOrdinal(left, right); }
}

[BuiltInAssociated("object")]
internal static class ObjectAssociatedMembers { }
