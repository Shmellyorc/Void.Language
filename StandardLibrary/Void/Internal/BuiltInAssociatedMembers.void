[BuiltInAssociated("decimal")]
internal static class DecimalAssociatedMembers
{
    [PrimitiveConstant("min")] public const decimal MinValue = default;
    [PrimitiveConstant("max")] public const decimal MaxValue = default;
    [PrimitiveConstant("zero")] public const decimal Zero = default;
    [PrimitiveConstant("one")] public const decimal One = default;
    [PrimitiveConstant("minus-one")] public const decimal MinusOne = default;

    public static decimal Parse(string value)
    {
        decimal result;
        int status = PrimitiveParsing.ParseLongDouble(value, out result);
        if (status == PrimitiveParsing.Null) throw new ArgumentNullException("value");
        if (status == PrimitiveParsing.Overflow) throw new OverflowException();
        if (status != PrimitiveParsing.Success) throw new FormatException();
        return result;
    }

    public static bool TryParse(string value, out decimal result)
    {
        int status = PrimitiveParsing.ParseLongDouble(value, out result);
        if (status != PrimitiveParsing.Success) result = decimal.Zero;
        return status == PrimitiveParsing.Success;
    }
}

