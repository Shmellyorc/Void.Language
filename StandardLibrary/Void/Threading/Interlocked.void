namespace Void.Threading;

public static class Interlocked
{
    public static int Increment(ref int location)
    {
        return Runtime.InterlockedIncrementInt(ref location);
    }

    public static long Increment(ref long location)
    {
        return Runtime.InterlockedIncrementLong(ref location);
    }

    public static int Decrement(ref int location)
    {
        return Runtime.InterlockedDecrementInt(ref location);
    }

    public static long Decrement(ref long location)
    {
        return Runtime.InterlockedDecrementLong(ref location);
    }

    public static int Add(ref int location, int value)
    {
        return Runtime.InterlockedAddInt(ref location, value);
    }

    public static long Add(ref long location, long value)
    {
        return Runtime.InterlockedAddLong(ref location, value);
    }

    public static int Exchange(ref int location, int value)
    {
        return Runtime.InterlockedExchangeInt(ref location, value);
    }

    public static long Exchange(ref long location, long value)
    {
        return Runtime.InterlockedExchangeLong(ref location, value);
    }

    public static int CompareExchange(ref int location, int value, int comparand)
    {
        return Runtime.InterlockedCompareExchangeInt(ref location, value, comparand);
    }

    public static long CompareExchange(ref long location, long value, long comparand)
    {
        return Runtime.InterlockedCompareExchangeLong(ref location, value, comparand);
    }

    public static T Exchange<T>(ref T location, T value) where T : class
    {
        return Runtime.InterlockedExchangeRef(ref location, value);
    }

    public static T CompareExchange<T>(ref T location, T value, T comparand) where T : class
    {
        return Runtime.InterlockedCompareExchangeRef(ref location, value, comparand);
    }
}
