namespace Void.Threading;

private sealed class ManualResetEventGate
{
}

private sealed class ManualResetEventWaiter
{
    public ManualResetEventWaiter Next;
    public bool Released;
    public bool Canceled;

    public ManualResetEventWaiter()
    {
        Next = null;
        Released = false;
        Canceled = false;
    }
}

public sealed class ManualResetEvent
{
    private ManualResetEventGate _gate;
    private bool _signaled;
    private long _generation;
    private ManualResetEventWaiter _head;
    private ManualResetEventWaiter _tail;

    public ManualResetEvent(bool initialState)
    {
        _gate = new ManualResetEventGate();
        _signaled = initialState;
        _generation = 0;
        _head = null;
        _tail = null;
    }

    private void Enqueue(ManualResetEventWaiter waiter)
    {
        if (_tail == null)
            _head = waiter;
        else
            _tail.Next = waiter;
        _tail = waiter;
    }

    private ManualResetEventWaiter Dequeue()
    {
        ManualResetEventWaiter waiter = _head;
        if (waiter == null)
            return null;

        _head = waiter.Next;
        waiter.Next = null;
        if (_head == null)
            _tail = null;
        return waiter;
    }

    private bool Remove(ManualResetEventWaiter waiter)
    {
        ManualResetEventWaiter previous = null;
        ManualResetEventWaiter current = _head;
        while (current != null)
        {
            if (current == waiter)
            {
                if (previous == null)
                    _head = current.Next;
                else
                    previous.Next = current.Next;

                if (_tail == current)
                    _tail = previous;
                current.Next = null;
                return true;
            }

            previous = current;
            current = current.Next;
        }
        return false;
    }

    private void ReleaseWaiter(ManualResetEventWaiter waiter)
    {
        Monitor.Enter(waiter);
        waiter.Released = true;
        Monitor.Pulse(waiter);
        Monitor.Exit(waiter);
    }

    private void CancelWaiter(ManualResetEventWaiter waiter)
    {
        Monitor.Enter(_gate);
        bool removed = this.Remove(waiter);
        if (removed)
        {
            Monitor.Enter(waiter);
            waiter.Canceled = true;
            Monitor.Pulse(waiter);
            Monitor.Exit(waiter);
        }
        Monitor.Exit(_gate);
    }

    public bool Set()
    {
        Monitor.Enter(_gate);
        Interlocked.Increment(ref _generation);
        _signaled = true;

        ManualResetEventWaiter waiter = this.Dequeue();
        while (waiter != null)
        {
            this.ReleaseWaiter(waiter);
            waiter = this.Dequeue();
        }

        Monitor.PulseAll(_gate);
        Monitor.Exit(_gate);
        return true;
    }

    public bool Reset()
    {
        Monitor.Enter(_gate);
        _signaled = false;
        Monitor.Exit(_gate);
        return true;
    }

    public bool WaitOne()
    {
        Monitor.Enter(_gate);
        if (_signaled)
        {
            Monitor.Exit(_gate);
            return true;
        }

        long generation = _generation;
        while (!_signaled && _generation == generation)
            Monitor.Wait(_gate);

        Monitor.Exit(_gate);
        return true;
    }

    public bool WaitOne(int millisecondsTimeout)
    {
        if (millisecondsTimeout < Timeout.Infinite)
            Runtime.Fail("manual reset event wait timeout must be -1 or non-negative");

        Monitor.Enter(_gate);
        if (_signaled)
        {
            Monitor.Exit(_gate);
            return true;
        }

        if (millisecondsTimeout == 0)
        {
            Monitor.Exit(_gate);
            return false;
        }

        long generation = _generation;
        bool notified = Monitor.Wait(_gate, millisecondsTimeout);
        bool released = notified && (_signaled || _generation != generation);
        Monitor.Exit(_gate);
        return released;
    }

    public bool WaitOne(CancellationToken cancellationToken)
    {
        return this.WaitOne(Timeout.Infinite, cancellationToken);
    }

    public bool WaitOne(int millisecondsTimeout, CancellationToken cancellationToken)
    {
        if (millisecondsTimeout < Timeout.Infinite)
            Runtime.Fail("manual reset event wait timeout must be -1 or non-negative");

        cancellationToken.ThrowIfCancellationRequested();
        if (!cancellationToken.CanBeCanceled)
            return this.WaitOne(millisecondsTimeout);

        ManualResetEventWaiter waiter = new ManualResetEventWaiter();

        Monitor.Enter(_gate);
        if (_signaled)
        {
            Monitor.Exit(_gate);
            return true;
        }
        if (millisecondsTimeout == 0)
        {
            Monitor.Exit(_gate);
            cancellationToken.ThrowIfCancellationRequested();
            return false;
        }
        this.Enqueue(waiter);
        Monitor.Exit(_gate);

        CancellationTokenRegistration registration = cancellationToken.Register(() => this.CancelWaiter(waiter));
        try
        {
            Monitor.Enter(waiter);
            if (millisecondsTimeout == Timeout.Infinite)
            {
                while (!waiter.Released && !waiter.Canceled)
                    Monitor.Wait(waiter);
            }
            else if (!waiter.Released && !waiter.Canceled)
            {
                Monitor.Wait(waiter, millisecondsTimeout);
            }

            bool released = waiter.Released;
            bool canceled = waiter.Canceled;
            Monitor.Exit(waiter);

            if (released)
                return true;
            if (canceled)
                throw new OperationCanceledException(cancellationToken);

            Monitor.Enter(_gate);
            bool removed = this.Remove(waiter);
            Monitor.Exit(_gate);
            if (removed)
                return false;

            Monitor.Enter(waiter);
            released = waiter.Released;
            canceled = waiter.Canceled;
            Monitor.Exit(waiter);

            if (released)
                return true;
            if (canceled)
                throw new OperationCanceledException(cancellationToken);

            Runtime.Fail("manual reset event cancellable waiter completed without outcome");
            return false;
        }
        finally
        {
            registration.Dispose();
        }
    }
}
